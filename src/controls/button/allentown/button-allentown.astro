---
import type { CtaStyle } from '../../../shared/content.js'
interface Props {
  href: string
  label: string
  style?: CtaStyle
  size?: 's' | 'm' | 'l'
  class?: string
}

const { href, label, style = 'primary', size = 'm', class: className } = Astro.props
const classes = ['button', `button--${style}`, size !== 'm' && `button--${size}`, className].filter(Boolean).join(' ')
---

<a class={classes} href={href}>{label}<slot /></a>

<style is:global>
  /* Figma Button (4700:58121), Size=medium: padding S / M, icon gap XS, text-l at line-height 1, icon one step smaller.
     Figma draws no stroke, so the border is taken out of the padding to keep its outer size. */
  .button {
    --kiw--section-button-padding-block: var(--space-s);
    --kiw--section-button-padding-inline: var(--space-m);
    --kiw--button-allentown-font-size: var(--text-l);
    --kiw--button-allentown-icon-size: var(--text-m);
    --kiw--button-allentown-gap: var(--space-xs);
    --kiw--button-allentown-border-width: var(--kinekt-component-border-width, var(--border-width));
    min-height: var(--kiw--section-button-height);
    padding: calc(var(--kiw--section-button-padding-block) - var(--kiw--button-allentown-border-width)) calc(var(--kiw--section-button-padding-inline) - var(--kiw--button-allentown-border-width));
    border: var(--kiw--button-allentown-border-width) solid var(--kinekt-component-action);
    border-radius: calc(var(--buttons-has-radius) * var(--kiw--button-allentown-radius, var(--kiw--section-button-radius)));
    color: var(--kinekt-component-action-text);
    background: var(--kinekt-component-action);
    font-size: var(--kiw--button-allentown-font-size);
    font-weight: var(--kinekt-component-heading-font-weight, var(--heading-font-weight));
    line-height: 1;
    cursor: pointer;
    justify-content: center;
    align-items: center;
    gap: var(--kiw--button-allentown-gap);
    text-decoration: none;
    display: inline-flex;
  }

  /* Figma Size=small and Size=large keep the padding and step the text and icon. */
  .button.button--s {
    --kiw--button-allentown-font-size: var(--text-m);
    --kiw--button-allentown-icon-size: var(--text-s);
  }

  .button.button--l {
    --kiw--button-allentown-font-size: var(--text-xl);
    --kiw--button-allentown-icon-size: var(--text-l);
  }

  /* Figma Type=secondary: a light fill with dark text in every theme. */
  .button.button--secondary {
    --kiw--button-allentown-secondary-background: var(--neutral-light);
    --kiw--button-allentown-secondary-text: var(--primary-ultra-dark);
    border-color: var(--kiw--button-allentown-secondary-background);
    color: var(--kiw--button-allentown-secondary-text);
    background: var(--kiw--button-allentown-secondary-background);
  }

  /* Figma clear buttons are text only: no border, so the box is the line height (18 px at medium). */
  :is(.button--clear, .button--clear-base) {
    min-height: auto;
    padding: 0;
    border-width: 0;
    color: var(--kinekt-component-ink);
    background: transparent;
  }

  .button > svg[aria-hidden='true'] {
    flex: none;
    inline-size: var(--kiw--button-allentown-icon-size);
    block-size: var(--kiw--button-allentown-icon-size);
    color: var(--kinekt-component-action-icon, currentColor);
  }

  .button--clear > svg[aria-hidden='true'] {
    color: var(--kinekt-component-accent, currentColor);
  }

  .button--clear-base > svg[aria-hidden='true'] {
    color: currentColor;
  }

  .button--secondary > svg[aria-hidden='true'] {
    color: var(--kiw--button-allentown-secondary-icon, var(--accent-semi-dark));
  }
</style>
