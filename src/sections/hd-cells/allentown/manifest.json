{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.1",
  "id": "sections/hd-cells/allentown",
  "slug": "hd-cells-allentown",
  "title": "HD Cells Allentown",
  "description": "A reusable interactive high-density cells section.",
  "category": "sections",
  "tags": ["engineering", "product", "beta"],
  "role": "hd-cells",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-412556&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:412556"
  },
  "fields": {
    "contentWidth": {
      "kind": "select",
      "required": false,
      "localized": true,
      "defaultValue": "standard",
      "options": ["standard", "80", "70", "50"],
      "description": "Maximum content width: Standard (100%), 80%, 70%, or 50%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "cellItems": {
      "kind": "componentList",
      "componentId": "components/hd-cell-item/allentown",
      "minItems": 1,
      "required": true,
      "localized": true
    }
  },
  "runtimeProps": {
    "activeCell": {
      "kind": "firstListItem",
      "source": "renderer"
    },
    "cellInteraction": {
      "kind": "handImplementedMediaDisclosureTimer",
      "source": "renderer"
    }
  }
}
