---
import MoqLeadTimesAllentown from './moq-lead-times-allentown.astro'
---
<MoqLeadTimesAllentown
  theme="dark"
  intro={{
    accentHeading: 'Ordering & delivery',
    heading: 'Supply that scales with your program',
    description: 'We match your production schedule, from first order to full-scale.',
  }}
  cta={{ cta: { label: 'Book a call', href: '#', icon: 'arrow-right' } }}
  moq={{
    title: 'Minimum quantity',
    description: 'Per order',
    value: { text: 'From €50,000' },
  }}
  leadTimes={[
    { title: 'Sample', description: 'Sample delivery window', value: { text: 'Ask our team' } },
    { title: 'Production', description: 'Production delivery window', value: { text: 'Around your schedule' } },
  ]}
/>
