---
import MoqLeadTimesAllentown from './moq-lead-times-allentown.astro'
---
<MoqLeadTimesAllentown
  theme="dark"
  intro={{
    accentHeading: 'Ordering & delivery',
    heading: 'Supply that scales with your program',
    description: 'We match your production schedule, from first order to full-scale.',
  }}
  ctas={[
    { label: 'Plan your rollout', href: '#', icon: 'arrow-right', style: 'primary' },
    { label: 'View technical guide', href: '#', icon: 'download', style: 'clear' },
  ]}
  infoColumns={[
    {
      title: 'Supply parameters',
      rows: [{ title: 'Order window', value: { text: 'Program review' } }],
    },
    {
      title: 'Planning horizon',
      rows: [
        { title: 'Prototype run', value: { text: '6–8 weeks' } },
        { title: 'Production slot', value: { text: 'Scheduled jointly' } },
      ],
    },
  ]}
/>
