---
import Button from '../../../controls/button/allentown/button-allentown.astro'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, RichText, SectionIntro as SectionIntroContent, SectionTheme } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

type HeadingLevel = 'h1' | 'h2' | 'h3'
type RichTextInput = string | RichText | Record<string, unknown>
type IntroInput = Omit<SectionIntroContent, 'description'> & { description?: RichTextInput | null }
type CtaInput = Partial<Cta> | null | undefined
interface DeliveryFact { title: string; description: string; value: { text: string; icon?: string } }
interface Props {
  id?: string
  theme?: SectionTheme
  headingLevel?: HeadingLevel
  intro: IntroInput
  cta?: { cta?: CtaInput } | CtaInput
  moq: DeliveryFact
  leadTimes?: DeliveryFact[]
}

const { id, theme = 'dark', headingLevel = 'h2', intro, cta, moq, leadTimes = [] } = Astro.props as Props
const toHtml = (value: RichTextInput, field: string): string => {
  if (typeof value === 'string') return value.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean).map((part) => richTextToHtml(part, field)).join('')
  if (typeof value.html === 'string') return value.html
  return richTextToHtml(value, field)
}
const introContent: SectionIntroContent = {
  ...intro,
  description: intro.description == null || typeof intro.description === 'string' ? intro.description ?? undefined : { html: toHtml(intro.description, 'intro.description') },
}
const action = (() => {
  const candidate: CtaInput = typeof cta === 'object' && cta !== null && 'cta' in cta
    ? (cta as { cta?: CtaInput }).cta
    : cta as CtaInput
  return typeof candidate?.label === 'string' && candidate.label.trim() !== '' && typeof candidate.href === 'string' && candidate.href.trim() !== '' ? candidate as Cta : undefined
})()
const actionIcon = action && isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
const visibleLeadTimes = leadTimes.filter((item) => typeof item?.title === 'string' && item.title.trim() !== '' && typeof item.description === 'string' && item.description.trim() !== '' && typeof item.value?.text === 'string' && item.value.text.trim() !== '')
---
<section class="beta-moq-lead-times-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-moq-lead-times-allentown__container">
    <header class="beta-moq-lead-times-allentown__intro">
      <SectionIntro intro={introContent} headingLevel={headingLevel} />
      {action && <Button href={action.href} label={action.label} size="s">{actionIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={actionIcon.viewBox} fill="currentColor"><path d={actionIcon.path} /></svg>}</Button>}
    </header>

    <section class="beta-moq-lead-times-allentown__facts" aria-label="Order requirements">
      <section class="beta-moq-lead-times-allentown__fact">
        <h3>{moq.title}</h3>
        <dl>
          <div>
            <dt>{moq.description}</dt>
            <dd><Label text={moq.value.text} icon={moq.value.icon} size="s" /></dd>
          </div>
        </dl>
      </section>

      <section class="beta-moq-lead-times-allentown__fact">
        <h3>Lead times</h3>
        <dl>
          {visibleLeadTimes.map((leadTime) => (
            <div>
              <dt>{leadTime.title}</dt>
              <dd><Label text={leadTime.value.text} icon={leadTime.value.icon} size="s" /></dd>
            </div>
          ))}
        </dl>
      </section>
    </section>
  </div>
</section>
<style is:global>
  :where(.beta-moq-lead-times-allentown) {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--moq-lead-times-allentown-canvas, var(--primary-ultra-dark)));
    --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--moq-lead-times-allentown-surface, var(--primary-semi-dark)));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--moq-lead-times-allentown-ink, var(--white)));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--moq-lead-times-allentown-muted, var(--primary-ultra-light)));
    --kinekt-component-line: var(--kinekt-section-line, var(--kiw--moq-lead-times-allentown-line, var(--primary)));
    --kinekt-component-action: var(--kinekt-section-action, var(--kiw--moq-lead-times-allentown-action, var(--primary)));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--moq-lead-times-allentown-accent, var(--accent-semi-dark)));
    --kinekt-component-site-width: var(--kinekt-section-site-width, var(--kiw--moq-lead-times-allentown-site-width, var(--website-width)));
    --kinekt-component-content-width: var(--kinekt-section-content-width, var(--kiw--moq-lead-times-allentown-content-width, var(--content-width)));
    --kinekt-component-inline-space: var(--kinekt-section-inline-space, var(--kiw--moq-lead-times-allentown-inline-space, var(--section-gutter)));
    --kinekt-component-block-space: var(--kinekt-section-block-space, var(--kiw--moq-lead-times-allentown-block-space, var(--section-space-l)));
    --kinekt-component-border-width: var(--kinekt-section-border-width, var(--kiw--moq-lead-times-allentown-border-width, var(--border-width)));
    --kinekt-component-heading-line-height: var(--kinekt-section-heading-line-height, var(--kiw--moq-lead-times-allentown-heading-line-height, var(--heading-line-height)));
    --kinekt-component-text-line-height: var(--kinekt-section-text-line-height, var(--kiw--moq-lead-times-allentown-text-line-height, var(--text-line-height)));
    --kiw--moq-lead-times-allentown-column-gap: var(--section-space-xl);
    --kiw--moq-lead-times-allentown-fact-gap: var(--space-m);
    --kiw--moq-lead-times-allentown-value-gap: var(--space-xs);
    --kiw--moq-lead-times-allentown-heading-size: var(--text-l);
    --kiw--moq-lead-times-allentown-description-size: var(--text-s);
    box-sizing: border-box;
    padding-block: var(--kinekt-component-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--kinekt-section-text-font-family, var(--text-font-family));
    font-size: var(--kinekt-section-text-m-size, var(--text-m));
    font-weight: var(--kinekt-section-text-font-weight, var(--text-font-weight));
    line-height: var(--kinekt-component-text-line-height);
    letter-spacing: var(--kinekt-section-text-letter-spacing, var(--text-letter-spacing));
  }

  :where(.beta-moq-lead-times-allentown[data-kinekt-theme='light']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--moq-lead-times-allentown-canvas, var(--neutral-ultra-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--moq-lead-times-allentown-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--moq-lead-times-allentown-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--moq-lead-times-allentown-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--moq-lead-times-allentown-line, var(--primary-ultra-light))); }
  :where(.beta-moq-lead-times-allentown[data-kinekt-theme='semi-light']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--moq-lead-times-allentown-canvas, var(--neutral-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--moq-lead-times-allentown-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--moq-lead-times-allentown-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--moq-lead-times-allentown-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--moq-lead-times-allentown-line, var(--primary-ultra-light))); }
  :where(.beta-moq-lead-times-allentown[data-kinekt-theme='semi-dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--moq-lead-times-allentown-canvas, var(--primary-dark))); }
  :where(.beta-moq-lead-times-allentown) *, :where(.beta-moq-lead-times-allentown) *::before, :where(.beta-moq-lead-times-allentown) *::after { box-sizing: border-box; }

  .beta-moq-lead-times-allentown > .beta-moq-lead-times-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--section-space-l); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro { display: grid; align-content: start; justify-items: start; gap: var(--section-space-s); min-width: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro .section-intro { display: grid; gap: var(--space-xs); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro .section-intro__heading { max-width: none; font-size: var(--kinekt-section-heading-2-size, var(--h2)); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro .section-intro__description { max-width: none; color: var(--kinekt-component-muted); font-size: var(--text-m); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__intro .section-intro__description > * { margin-block: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__facts { display: grid; gap: var(--kiw--moq-lead-times-allentown-column-gap); min-width: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact { min-width: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact > h3 { margin: 0; font-size: var(--kiw--moq-lead-times-allentown-heading-size); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact > dl { display: grid; gap: var(--kiw--moq-lead-times-allentown-fact-gap); margin: var(--space-s) 0 0; padding: var(--space-m) 0 0; border-block-start: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact > dl > div { display: grid; gap: var(--kiw--moq-lead-times-allentown-value-gap); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact :is(dt, dd) { margin: 0; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact dt { color: var(--kinekt-component-ink); font-size: var(--kiw--moq-lead-times-allentown-description-size); }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact dd { display: flex; }
  .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__fact .label-allentown { --kinekt-label-tint: 15%; }
  @media (min-width: 50rem) { .beta-moq-lead-times-allentown > .beta-moq-lead-times-allentown__container { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; column-gap: var(--section-space-xl); } .beta-moq-lead-times-allentown .beta-moq-lead-times-allentown__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); align-self: center; } }
</style>
