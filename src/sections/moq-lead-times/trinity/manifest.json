{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/moq-lead-times/trinity",
  "slug": "moq-lead-times-trinity",
  "title": "MOQ Lead Times Trinity",
  "description": "One to six ordering items with optional icons and labels, followed by an optional shared contact callout.",
  "category": "sections",
  "tags": ["ordering", "logistics", "prerelease"],
  "role": "moq-lead-times",
  "variation": "trinity",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-772930",
    "nodeId": "5744:772930"
  },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "semi-light", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "items": {
      "kind": "componentList", "required": true, "localized": true, "minItems": 1, "maxItems": 6,
      "admin": { "initCollapsed": true },
      "description": "One to six items. Titles render literally; numbering is never added automatically.",
      "fields": {
        "icon": { "kind": "text", "required": false, "localized": true, "description": "Optional Font Awesome 7 Sharp Solid icon name; rendered as SVG, without an icon font." },
        "title": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": true, "localized": true },
        "label": { "kind": "component", "componentId": "atoms/label/allentown", "required": false, "localized": true }
      }
    },
    "callout": { "kind": "component", "componentId": "components/callout/allentown", "required": false, "localized": true, "admin": { "initCollapsed": true } }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" }
  }
}
