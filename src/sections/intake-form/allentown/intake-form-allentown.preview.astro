---
import { fass as fas } from '@fortawesome/sharp-solid-svg-icons'
import IntakeFormAllentown from './intake-form-allentown.astro'

const chevronDown = fas.faChevronDown.icon
// Figma's submit shows Font Awesome calendar-plus; it is not a shared CTA icon yet (src/shared/cta-icons.ts).
const calendarPlus = fas.faCalendarPlus.icon

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ Start your battery intake',
    heading: 'Tell us what your battery has to do',
    description: 'Share a few details about your project and plan a call with a battery engineer. We use your answers to prepare the right questions before we speak.',
  },
  stepsHeading: 'The next steps:',
  steps: [
    { text: 'Book your call' },
    { text: 'Discuss your requirements' },
    { text: 'Receive a clear proposal' },
  ],
  formHeading: 'Plan your call',
  form: '<script src="https://js.hsforms.net/forms/embed/v2.js"></script>',
}
---
<IntakeFormAllentown {...content}>
  <form slot="form" action="#" method="post">
    <div class="form-embed-allentown__fields">
      <div class="form-embed-allentown__row">
        <label>First name <input name="given-name" autocomplete="given-name" placeholder="Morgan" required /></label>
        <label>Last name <input name="family-name" autocomplete="family-name" placeholder="Reed" required /></label>
      </div>
      <label>Email address <input name="email" type="email" autocomplete="email" placeholder="morgan.reed@example.com" required /></label>
      <label>Phone number <input name="phone" type="tel" autocomplete="tel" placeholder="+1 555 010 0199" /></label>
      <div class="form-embed-allentown__row">
        <label>Company name <input name="organization" autocomplete="organization" placeholder="Company X" /></label>
        <label>Country
          <span class="form-embed-allentown__select">
            <select name="country" autocomplete="country"><option value="">Select country</option><option value="NL">Netherlands</option><option value="DE">Germany</option><option value="US">United States</option></select>
            <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={`0 0 ${chevronDown[0]} ${chevronDown[1]}`} fill="currentColor"><path d={chevronDown[4] as string} /></svg>
          </span>
        </label>
      </div>
    </div>
    <button type="submit">Schedule your call <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={`0 0 ${calendarPlus[0]} ${calendarPlus[1]}`} fill="currentColor"><path d={calendarPlus[4] as string} /></svg></button>
  </form>
</IntakeFormAllentown>
