    --kiw--section-text-xl-size: var(--kiw--intake-form-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--intake-form-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--intake-form-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--intake-form-allentown-actions-gap, var(--space-s));
    --kiw--section-actions-margin: var(--kiw--intake-form-allentown-actions-margin, var(--space-xl));
    --kiw--section-button-height: var(--kiw--intake-form-allentown-button-height, var(--input-height));
