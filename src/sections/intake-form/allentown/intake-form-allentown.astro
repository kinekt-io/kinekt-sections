---
import '../../../styles/wireframe-tokens.css'
import FormEmbed from '../../../components/form-embed/allentown/form-embed-allentown.astro'
import IntakeStep, { type IntakeStepContent } from '../../../components/intake-step/allentown/intake-step-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaIntakeFormAllentownContent } from './intake-form-allentown.types.js'

// The generated contract type is still `Record<string, unknown>`; these are the manifest fields the renderer reads.
interface Props extends BetaIntakeFormAllentownContent {
  id?: string
  theme?: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }
  stepsHeading: string
  steps: IntakeStepContent[]
  formHeading?: string | null
  /** HubSpot embed code (manifest kind formEmbed). Executed by the integration inside FormEmbed. */
  form?: string | null
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { id, theme = 'light', intro, stepsHeading, steps = [], formHeading, form, headingLevel = 'h2' } = Astro.props as Props

const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const validSteps = steps.filter((step) => typeof step?.text === 'string' && step.text !== '')
const ChildHeading = headingLevel === 'h1' ? 'h2' : headingLevel === 'h2' ? 'h3' : 'h4'
// Catalogue previews pass non-submitting placeholder fields in the `form` slot; production renders the embed only.
const hasFormPlaceholder = Astro.slots.has('form')
---
<section class="intake-form-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="intake-form-allentown__container">
    <div class="intake-form-allentown__lead">
      <header class="intake-form-allentown__intro">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      </header>

      {validSteps.length > 0 && (
        <div class="intake-form-allentown__steps">
          {stepsHeading && <ChildHeading class="intake-form-allentown__steps-heading">{stepsHeading}</ChildHeading>}
          <ol class="intake-form-allentown__step-list">
            {validSteps.map((step, index) => (
              <li class="intake-form-allentown__step">
                <IntakeStep step={step} number={index + 1} />
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>

    <div class="intake-form-allentown__form">
      {formHeading && <ChildHeading class="intake-form-allentown__form-heading">{formHeading}</ChildHeading>}
      {hasFormPlaceholder ? (
        <FormEmbed class="intake-form-allentown__form-embed" form={form}><slot name="form" /></FormEmbed>
      ) : (
        <FormEmbed class="intake-form-allentown__form-embed" form={form} />
      )}
    </div>
  </div>
</section>
