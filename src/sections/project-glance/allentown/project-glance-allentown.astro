---
import '../../../styles/wireframe-tokens.css'
import type { RichText } from '../../../shared/content.js'
import KeyFact from '../../../components/key-fact/allentown/key-fact-allentown.astro'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type Fact = { label?: string; description?: string | RichText | { html?: string } }
interface Props { id?: string; theme?: Theme; headingLevel?: 'h2' | 'h3'; heading: string; facts?: Fact[] }

const { id, theme = 'semi-dark', headingLevel = 'h2', heading, facts = [] } = Astro.props as Props
const Heading = headingLevel
const validFacts = facts.filter((fact): fact is Required<Pick<Fact, 'label'>> & Fact => typeof fact?.label === 'string' && fact.label.trim().length > 0)
---
<section class="project-glance-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="project-glance-allentown__container">
    <Heading class="project-glance-allentown__heading">{heading}</Heading>
    {validFacts.length > 0 && <ul class="project-glance-allentown__facts">
      {validFacts.map((fact) => <KeyFact fact={fact} as="li" class="project-glance-allentown__fact" />)}
    </ul>}
  </div>
</section>

<style is:global>
  /*
   * Figma "The project at a glance" (Case Template, "Partners section" 5639:525223, semi-dark):
   * 1440 content column, centred; h2 (line-height 1) → section-xl → facts. Facts wrap and centre in rows of three:
   * width-s (288) each, gap section-l. Figma's padding is section-xxl (125); the section keeps its section-l (80).
   */
  :where(.project-glance-allentown) {
    --kiw--project-glance-allentown-inline-space: var(--section-gutter);
    --kiw--project-glance-allentown-block-space: var(--section-space-l);
    --kiw--project-glance-allentown-gap: var(--section-space-xl);
    --kiw--project-glance-allentown-heading-size: var(--h2);
    --kiw--project-glance-allentown-heading-line-height: 1;
    --kiw--project-glance-allentown-facts-gap: var(--section-space-l);
    /* The fixed desktop step (288): the fluid --width-s drops to ~155 at tablet widths, too narrow for text-xxl copy; facts share the row up to it. */
    --kiw--project-glance-allentown-fact-width: var(--desktop-width-s);
    --kiw--project-glance-allentown-columns: 3;
  }

  .project-glance-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-dark));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
    --kinekt-component-line: var(--kinekt-section-line, var(--primary));
    /* Off-role: Figma sets the fact descriptions in neutral-ultra-light on this dark frame; light themes fall back to ink (inferred). */
    --kiw--project-glance-allentown-description-color: var(--neutral-ultra-light);
    padding-block: var(--kiw--project-glance-allentown-block-space);
    color: var(--kinekt-component-ink);
    font-family: var(--text-font-family);
    background: var(--kinekt-component-canvas);

    &[data-kinekt-theme='light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light)); --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark)); --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark)); --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark)); --kinekt-component-line: var(--kinekt-section-line, var(--primary-ultra-light)); --kiw--project-glance-allentown-description-color: var(--kinekt-component-ink); }
    &[data-kinekt-theme='semi-light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light)); --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark)); --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark)); --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark)); --kinekt-component-line: var(--kinekt-section-line, var(--primary-ultra-light)); --kiw--project-glance-allentown-description-color: var(--kinekt-component-ink); }
    &[data-kinekt-theme='dark'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark)); }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .project-glance-allentown__container { display: grid; justify-items: center; width: 100%; max-width: min(var(--website-width), calc(var(--content-width) + (var(--kiw--project-glance-allentown-inline-space) * 2))); gap: var(--kiw--project-glance-allentown-gap); margin-inline: auto; padding-inline: var(--kiw--project-glance-allentown-inline-space); }
    & .project-glance-allentown__heading { width: 100%; margin: 0; font-family: var(--heading-font-family); font-size: var(--kiw--project-glance-allentown-heading-size); font-weight: var(--heading-font-weight); line-height: var(--kiw--project-glance-allentown-heading-line-height); letter-spacing: var(--heading-letter-spacing); text-align: center; text-wrap: balance; }
    & .project-glance-allentown__facts { --kiw--key-fact-allentown-description-color: var(--kiw--project-glance-allentown-description-color); display: grid; width: 100%; gap: var(--kiw--project-glance-allentown-facts-gap); margin: 0; padding: 0; list-style: none; }

    @media (min-width: 50rem) {
      & .project-glance-allentown__facts { display: flex; flex-wrap: wrap; justify-content: center; max-width: calc(var(--kiw--project-glance-allentown-columns) * var(--kiw--project-glance-allentown-fact-width) + (var(--kiw--project-glance-allentown-columns) - 1) * var(--kiw--project-glance-allentown-facts-gap)); }
      & .project-glance-allentown__fact { flex: 0 1 calc((100% - (var(--kiw--project-glance-allentown-columns) - 1) * var(--kiw--project-glance-allentown-facts-gap)) / var(--kiw--project-glance-allentown-columns)); max-width: var(--kiw--project-glance-allentown-fact-width); }
    }
  }
</style>
