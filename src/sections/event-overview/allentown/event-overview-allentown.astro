    --kiw--section-text-xs-size: var(--kiw--event-overview-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--event-overview-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--event-overview-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--event-overview-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--event-overview-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--event-overview-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--event-overview-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--event-overview-allentown-actions-gap, var(--space-s));
    --kiw--section-actions-margin: var(--kiw--event-overview-allentown-actions-margin, var(--space-xl));
    --kiw--section-button-height: var(--kiw--event-overview-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--event-overview-allentown-button-padding-block, var(--space-s));
