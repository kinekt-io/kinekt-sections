---
import '../../../styles/wireframe-tokens.css'
import EventCard from '../../../components/event-card/allentown/event-card-allentown.astro'
import type { EventCardContent, EventType } from '../../../components/event-card/allentown/event-card-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths } from '../../../shared/cta-icons.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type HeadingLevel = 'h1' | 'h2' | 'h3'

interface Props {
  id?: string
  theme?: Theme
  headingLevel?: HeadingLevel
  intro: SectionIntroContent
  /** runtimeProps.eventSelection: future published Events for the active region and locale (selected by the platform). */
  events?: EventCardContent[]
  /** Localised flight-path labels per event type, passed to each card. */
  eventTypeLabels?: Partial<Record<EventType, string>>
  /** Label of the load-more control (runtimeProps.pagination = sixPerPageLoadMore). */
  loadMoreLabel?: string
  /** IANA time zone used for the card dates. */
  timeZone?: string
}

const { id, theme = 'light', headingLevel = 'h2', intro, events = [], eventTypeLabels, loadMoreLabel = 'Load more future events', timeZone } = Astro.props as Props

// runtimeProps.pagination: six cards per page, revealed by the load-more control (every card renders without JavaScript).
const pageSize = 6
// runtimeProps.sort = startDateTimeAscending; events without a valid start date go last, ties keep their order.
const startTime = (event: EventCardContent): number => {
  const time = Date.parse(event.startDateTime)
  return Number.isNaN(time) ? Number.POSITIVE_INFINITY : time
}
const valid = events.filter((event) => event && typeof event.title === 'string' && event.title !== '' && typeof event.location === 'string' && typeof event.startDateTime === 'string')
const sorted = valid.map((event, index) => ({ event, index })).sort((a, b) => startTime(a.event) - startTime(b.event) || a.index - b.index).map(({ event }) => event)
const CardHeading = headingLevel === 'h1' ? 'h2' : headingLevel === 'h2' ? 'h3' : 'h4'
const loadMoreIcon = ctaIconPaths.plus
---
<section class="event-overview-allentown" id={id} data-kinekt-section data-kinekt-theme={theme} data-event-overview data-event-overview-page-size={pageSize}>
  <div class="event-overview-allentown__container">
    <header class="event-overview-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>
    {sorted.length > 0 && <ul class="event-overview-allentown__events" data-event-overview-list>
      {sorted.map((event) => <li class="event-overview-allentown__event"><EventCard event={event} headingLevel={CardHeading} eventTypeLabels={eventTypeLabels} timeZone={timeZone} /></li>)}
    </ul>}
    {sorted.length > pageSize && <button class="button button--clear event-overview-allentown__load-more" type="button" data-event-overview-load-more hidden>{loadMoreLabel}<svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={loadMoreIcon.viewBox} fill="none"><path d={loadMoreIcon.path} stroke="currentColor" stroke-width="2" /></svg></button>}
  </div>
</section>
<script>
  // Progressive enhancement: without JavaScript every event stays visible and the control stays hidden.
  for (const section of document.querySelectorAll<HTMLElement>('[data-event-overview]')) {
    const button = section.querySelector<HTMLButtonElement>('[data-event-overview-load-more]')
    const items = [...section.querySelectorAll<HTMLElement>('[data-event-overview-list] > li')]
    const pageSize = Number(section.dataset.eventOverviewPageSize) || 6
    if (!button || button.dataset.eventOverviewReady || items.length <= pageSize) continue
    button.dataset.eventOverviewReady = 'true'
    items.slice(pageSize).forEach((item) => { item.hidden = true })
    button.hidden = false
    button.addEventListener('click', () => {
      const next = items.filter((item) => item.hidden).slice(0, pageSize)
      next.forEach((item) => { item.hidden = false })
      if (!items.some((item) => item.hidden)) button.hidden = true
      const first = next[0]
      if (first) { first.tabIndex = -1; first.focus() }
    })
  }
</script>
