    --kiw--section-input-height: var(--kiw--event-overview-allentown-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--event-overview-allentown-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--event-overview-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--event-overview-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--event-overview-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--event-overview-allentown-canvas);
    --kiw--section-surface: var(--kiw--event-overview-allentown-surface);
    --kiw--section-ink: var(--kiw--event-overview-allentown-ink);
