---
import '../../../styles/wireframe.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import type { ReadMoreContent } from './read-more-allentown.types.js'
interface Props extends ReadMoreContent { headingLevel?: 'h1' | 'h2' | 'h3'; mediaLoading?: 'eager' | 'lazy' }
const { theme, intro, ctas, media, headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
---
<section class="read-more read-more--allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="read-more__container">
    <header class="read-more__content">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
      {(ctas.primary || ctas.secondary) && <div class="read-more__actions">
        {ctas.primary && <Button class="read-more__action read-more__action--primary" href={ctas.primary.href} label={ctas.primary.label} />}
        {ctas.secondary && <Button class="read-more__action read-more__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="secondary" />}
      </div>}
    </header>
    <picture class="read-more__media">
      {media.sources?.length && <source type="image/avif" srcset={media.sources.map((source) => `${source.url} ${source.width}w`).join(', ')} sizes={media.sizes} />}
      <img class="read-more__image" src={media.url} alt={media.alt} width={media.width} height={media.height} data-fallback-url={media.fallbackUrl} loading={mediaLoading} decoding="async" />
    </picture>
  </div>
</section>
