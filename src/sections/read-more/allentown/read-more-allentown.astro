---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type CtaGroup, type Media, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
interface Props {
  theme?: Theme
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro: SectionIntroContent
  label?: { text: string; icon?: string }
  ctas: CtaGroup
  media: Media
  mediaLoading?: 'eager' | 'lazy'
}

const { theme = 'light', intro, label, ctas, media, headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props as Props
const actions = ctaGroupActions(ctas)
---
<section class="read-more-allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="read-more-allentown__container">
    <header class="read-more-allentown__content">
      <SectionIntro intro={intro} headingLevel={headingLevel}>
        {label?.text && <Label slot="after-heading" class="read-more-allentown__label" text={label.text} icon={label.icon} />}
      </SectionIntro>
      {actions.length > 0 && <div class="read-more-allentown__actions">
        {actions.map((action, index) => {
          const icon = isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
          return <Button class="read-more-allentown__action" href={action.href} label={action.label} style={action.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
        })}
      </div>}
    </header>
    <picture class="read-more-allentown__media">
      {media.sources?.length && <source type="image/avif" srcset={media.sources.map((source) => `${source.url} ${source.width}w`).join(', ')} sizes={media.sizes} />}
      <img class="read-more-allentown__image" src={media.url} alt={media.alt} width={media.width} height={media.height} data-fallback-url={media.fallbackUrl} loading={mediaLoading} decoding="async" />
    </picture>
  </div>
</section>
