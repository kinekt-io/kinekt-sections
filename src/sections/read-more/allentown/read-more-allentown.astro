  :where(.read-more-allentown) > [class$='__container'] { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); } :where(.read-more-allentown) :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; } :where(.read-more-allentown) h2 { font-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); }
  :where(.read-more-allentown) h1 { font-size: var(--kinekt-section-heading-1-size, var(--kiw--section-heading-1-size, var(--h1))); } :where(.read-more-allentown) h3 { font-size: var(--kinekt-section-heading-3-size, var(--kiw--section-heading-3-size, var(--h3))); } :where(.read-more-allentown) h4 { font-size: var(--kinekt-section-heading-4-size, var(--kiw--section-heading-4-size, var(--h4))); } :where(.read-more-allentown) h5 { font-size: var(--kinekt-section-heading-5-size, var(--kiw--section-heading-5-size, var(--h5))); } :where(.read-more-allentown) h6 { font-size: var(--kinekt-section-heading-6-size, var(--kiw--section-heading-6-size, var(--h6))); }
  :where(.read-more-allentown) :is(p, li, dd, td, th, label, input, textarea, button) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.read-more-allentown) :is(p, ul, ol, dl, table, form) { margin-block: 0; } :where(.read-more-allentown) :is([class$='__accent'], [class*='__label']):not(.label-allentown) { color: var(--kinekt-component-muted); font-family: var(--kinekt-component-mono); font-size: var(--kinekt-component-text-xs-size); font-weight: var(--kiw--section-heading-font-weight); letter-spacing: var(--kiw--section-text-letter-spacing); text-transform: uppercase; }
  :where(.read-more-allentown) :is([class$='__actions'], [class*='__cta-group']) { display: flex; flex-wrap: wrap; gap: var(--kiw--section-actions-gap); margin-top: var(--kiw--section-actions-margin); }
  :where(.read-more-allentown) :is([class$='__media'], [class*='__media-'], [class*='__image']), :where(.read-more-allentown) picture { display: block; max-width: 100%; } :where(.read-more-allentown) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
</style>
