{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/homepage-problem-solution/allentown",
  "slug": "homepage-problem-solution-allentown",
  "title": "Homepage Problem Solution Allentown",
  "description": "A reusable, hand-animated scroll section pairing problem and solution content.",
  "category": "sections",
  "tags": ["conversion", "content", "beta"],
  "role": "homepage-problem-solution",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411370&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411370"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "problemIntro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true,
      "fields": {
        "accentHeading": { "kind": "text", "required": false, "localized": true },
        "heading": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": false, "localized": true }
      }
    },
    "problemItems": {
      "kind": "componentList",
      "componentId": "components/homepage-problem-item/allentown",
      "minItems": 1,
      "required": true,
      "localized": true,
      "fields": {
        "icon": { "kind": "text", "required": true, "localized": true, "description": "Font Awesome 7 Sharp Solid icon name, for example bolt or shield-halved." },
        "title": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": true, "localized": true }
      }
    },
    "solutionIntro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true,
      "fields": {
        "accentHeading": { "kind": "text", "required": false, "localized": true },
        "heading": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": false, "localized": true }
      }
    },
    "solutionSteps": {
      "kind": "componentList",
      "componentId": "components/homepage-solution-step/allentown",
      "minItems": 1,
      "required": true,
      "localized": true,
      "fields": {
        "icon": { "kind": "text", "required": true, "localized": true, "description": "Font Awesome 7 Sharp Solid icon name, for example bolt or shield-halved." },
        "title": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": true, "localized": true }
      }
    },
    "solutionCtaGroup": {
      "kind": "ctaGroup",
      "required": false,
      "localized": true
    },
    "problemRangeLabel": {
      "kind": "text",
      "required": false,
      "localized": true,
      "description": "Text beside the initial range circle. Leave empty to hide this text."
    },
    "solutionRangeLabel": {
      "kind": "text",
      "required": false,
      "localized": true,
      "description": "Title beside the expanded range circle. Leave empty to hide this text."
    },
    "solutionRangeValue": {
      "kind": "text",
      "required": false,
      "localized": true,
      "description": "Label below the expanded range title. Leave empty to hide this label."
    }
  },
  "runtimeProps": {
    "scrollAnimation": { "kind": "handImplementedProblemSolutionScrollAnimation", "source": "renderer" },
    "problemMedia": { "kind": "fixedImplementationAsset", "source": "renderer" },
    "solutionMedia": { "kind": "fixedImplementationAsset", "source": "renderer" }
  }
}
