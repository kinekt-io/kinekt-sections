---
import HomepageProblemSolution from './homepage-problem-solution-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

// Copy from Figma "Section - The problem + The Solution" (5240:411370). The two infographics are fixed implementation
// assets the renderer will ship (runtime props problemMedia / solutionMedia); the preview uses local placeholders.
const content = {
  theme: 'dark' as const,
  problemIntro: {
    accentHeading: '/ The low-density problem',
    heading: 'Low-density batteries force compromises',
    description: 'Every gram and every millimeter matters. When battery systems take up too much space or add unnecessary weight, platform designers are forced to compromise on payload, range, endurance or overall system design.',
  },
  problemItems: [
    { icon: 'xmark', title: 'Less payload', description: 'More battery weight leaves less capacity for mission equipment.' },
    { icon: 'xmark', title: 'Shorter endurance', description: 'Limited energy density reduces time in operation.' },
    { icon: 'xmark', title: 'Restricted range', description: 'Less usable energy limits how far the platform can operate.' },
    { icon: 'xmark', title: 'More redesign', description: 'Extra capacity often requires a larger or heavier battery system.' },
  ],
  solutionIntro: {
    accentHeading: '/ The high-density solution',
    heading: 'More performance from the same battery space',
    description: 'High-density cells and a pack engineered around them deliver more usable energy in the same envelope, so platforms gain range, endurance and payload instead of trading one for another.',
  },
  solutionSteps: [
    { icon: 'microchip', title: 'High-density cell technology', description: 'Selected high-energy cells store more energy per gram and per litre than conventional packs.' },
    { icon: 'gears', title: 'High-density engineering', description: 'Pack structure, thermal design and electronics are optimised to keep that density at system level.' },
    { icon: 'shield-halved', title: 'Battle tested & developed', description: 'Validated in demanding field conditions before a design moves into series production.' },
  ],
  solutionCtaGroup: {
    primaryButton: { label: 'Read more about high-density tech', href: '/technology/high-density', icon: 'arrow-right' as const },
  },
  problemMedia: {
    url: placeholder('placeholder-1000x1000.svg'),
    alt: 'Infographic: flight range of a low-density battery',
    width: 1000,
    height: 1000,
  },
  solutionMedia: {
    url: placeholder('placeholder-1000x1000.svg'),
    alt: 'Infographic: the larger flight range of a high-density battery',
    width: 1000,
    height: 1000,
  },
}
---
<HomepageProblemSolution {...content} />
