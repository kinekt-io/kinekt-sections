---
import '../../../styles/wireframe-tokens.css'
import HomepageProblemItem, { type HomepageProblemItemContent } from '../../../components/homepage-problem-item/allentown/homepage-problem-item-allentown.astro'
import HomepageSolutionStep, { type HomepageSolutionStepContent } from '../../../components/homepage-solution-step/allentown/homepage-solution-step-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import { isSafeWebUrl } from '../../../urls.js'
import type { BetaHomepageProblemSolutionAllentownContent } from './homepage-problem-solution-allentown.types.js'

type IntroInput = Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaHomepageProblemSolutionAllentownContent {
  theme?: BetaTheme
  problemIntro: IntroInput
  problemItems: HomepageProblemItemContent[]
  solutionIntro: IntroInput
  solutionSteps: HomepageSolutionStepContent[]
  solutionCtaGroup?: { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  /** Runtime prop (manifest `fixedImplementationAsset`): the low-density infographic the renderer ships. */
  problemMedia?: Media | null
  /** Runtime prop (manifest `fixedImplementationAsset`): the high-density infographic the renderer ships. */
  solutionMedia?: Media | null
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const {
  id,
  theme = 'dark',
  problemIntro,
  problemItems = [],
  solutionIntro,
  solutionSteps = [],
  solutionCtaGroup,
  problemMedia,
  solutionMedia,
  headingLevel = 'h2',
  mediaLoading = 'lazy',
} = Astro.props
const itemHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const toIntro = (intro: IntroInput, field: string): SectionIntroContent => {
  const description = intro.description == null || typeof intro.description === 'string'
    ? intro.description ?? undefined
    : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, field) }
  return { ...intro, description }
}
const problemIntroContent = toIntro(problemIntro, 'problemIntro.description')
const solutionIntroContent = toIntro(solutionIntro, 'solutionIntro.description')
const hasTitle = (item: { title?: unknown } | null | undefined) => typeof item?.title === 'string' && item.title !== ''
const visibleProblemItems = problemItems.filter(hasTitle)
const visibleSolutionSteps = solutionSteps.filter(hasTitle)
const isMedia = (value: Media | null | undefined): value is Media => Boolean(value && typeof value === 'object' && typeof value.url === 'string')
const isCta = (value: Cta | null | undefined): value is Cta => typeof value?.label === 'string' && value.label !== '' && typeof value.href === 'string'
const primary = isCta(solutionCtaGroup?.primaryButton) ? solutionCtaGroup.primaryButton : undefined
const secondary = isCta(solutionCtaGroup?.secondaryButton) ? solutionCtaGroup.secondaryButton : undefined
for (const cta of [primary, secondary]) if (cta && !isSafeWebUrl(cta.href)) throw new Error('solutionCtaGroup buttons must use an HTTP(S) or root-relative URL.')
const actions = [
  primary && { cta: primary, style: 'primary' as const },
  secondary && { cta: secondary, style: 'clear' as const },
].filter((action): action is { cta: Cta; style: 'primary' | 'clear' } => Boolean(action))
---
<section class="homepage-problem-solution-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="homepage-problem-solution-allentown__container">
    <div class:list={['homepage-problem-solution-allentown__group', 'homepage-problem-solution-allentown__group--problem', { 'homepage-problem-solution-allentown__group--media': isMedia(problemMedia) }]}>
      {isMedia(problemMedia) && <KinektMedia media={problemMedia} class="homepage-problem-solution-allentown__media homepage-problem-solution-allentown__media--problem" imageClass="homepage-problem-solution-allentown__image" loading={mediaLoading} />}
      <div class="homepage-problem-solution-allentown__text">
        <header class="homepage-problem-solution-allentown__intro">
          <SectionIntro intro={problemIntroContent} headingLevel={headingLevel} accentStyle="heading" />
        </header>
        {visibleProblemItems.length > 0 && (
          <ul class="homepage-problem-solution-allentown__problems">
            {visibleProblemItems.map((item) => (
              <li class="homepage-problem-solution-allentown__problem">
                <HomepageProblemItem item={item} headingLevel={itemHeadingLevel} />
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class:list={['homepage-problem-solution-allentown__group', 'homepage-problem-solution-allentown__group--solution', { 'homepage-problem-solution-allentown__group--media': isMedia(solutionMedia) }]}>
      {isMedia(solutionMedia) && <KinektMedia media={solutionMedia} class="homepage-problem-solution-allentown__media homepage-problem-solution-allentown__media--solution" imageClass="homepage-problem-solution-allentown__image" loading={mediaLoading} />}
      <div class="homepage-problem-solution-allentown__text">
        <header class="homepage-problem-solution-allentown__intro">
          <SectionIntro intro={solutionIntroContent} headingLevel={headingLevel} accentStyle="heading" />
        </header>
        {visibleSolutionSteps.length > 0 && (
          <ol class="homepage-problem-solution-allentown__steps">
            {visibleSolutionSteps.map((step) => (
              <li class="homepage-problem-solution-allentown__step">
                <HomepageSolutionStep item={step} headingLevel={itemHeadingLevel} />
              </li>
            ))}
          </ol>
        )}
        {actions.length > 0 && (
          <div class="homepage-problem-solution-allentown__actions">
            {actions.map(({ cta, style }) => {
              const icon = isCtaIcon(cta.icon) ? ctaIconPaths[cta.icon] : undefined
              return <Button href={cta.href} label={cta.label} style={style}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="none"><path d={icon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
