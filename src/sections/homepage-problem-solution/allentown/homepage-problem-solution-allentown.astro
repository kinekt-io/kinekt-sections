---
import '../../../styles/wireframe-tokens.css'
import HomepageProblemItem, { type HomepageProblemItemContent } from '../../../components/homepage-problem-item/allentown/homepage-problem-item-allentown.astro'
import HomepageSolutionStep, { type HomepageSolutionStepContent } from '../../../components/homepage-solution-step/allentown/homepage-solution-step-allentown.astro'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type RichText, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import { isSafeWebUrl } from '../../../urls.js'
import type { BetaHomepageProblemSolutionAllentownContent } from './homepage-problem-solution-allentown.types.js'
// Fixed implementation assets (manifest runtimeProps problemMedia / solutionMedia): a dark night map of Paris, 1086 × 1086.
import mapLarge from './assets/paris-night-map-1086.webp?url'
import mapSmall from './assets/paris-night-map-720.webp?url'

type IntroInput = Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaHomepageProblemSolutionAllentownContent {
  theme?: BetaTheme
  problemIntro: IntroInput
  problemItems: HomepageProblemItemContent[]
  solutionIntro: IntroInput
  solutionSteps: HomepageSolutionStepContent[]
  solutionCtaGroup?: CtaGroup | Cta[] | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  /** Renderer-only: accessible name of the infographic in its problem state (not in the contract yet). */
  problemInfographicLabel?: string
  /** Renderer-only: accessible name of the infographic in its solution state (not in the contract yet). */
  solutionInfographicLabel?: string
  /** Optional editor-owned callout beside the initial range circle. */
  problemRangeLabel?: string
  /** Optional editor-owned title beside the expanded range circle. */
  solutionRangeLabel?: string
  /** Optional editor-owned label below the expanded range title. */
  solutionRangeValue?: string
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const {
  id,
  theme = 'dark',
  problemIntro,
  problemItems = [],
  solutionIntro,
  solutionSteps = [],
  solutionCtaGroup,
  problemInfographicLabel = 'Infographic: flight range of a standard battery',
  solutionInfographicLabel = 'Infographic: the larger flight range of a high-density battery',
  problemRangeLabel,
  solutionRangeLabel,
  solutionRangeValue,
  headingLevel = 'h2',
  mediaLoading = 'lazy',
} = Astro.props
const itemHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const toIntro = (intro: IntroInput, field: string): SectionIntroContent => {
  const description = intro.description == null || typeof intro.description === 'string'
    ? intro.description ?? undefined
    : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, field) }
  return { ...intro, description }
}
const problemIntroContent = toIntro(problemIntro, 'problemIntro.description')
const solutionIntroContent = toIntro(solutionIntro, 'solutionIntro.description')
const hasTitle = (item: { title?: unknown } | null | undefined) => typeof item?.title === 'string' && item.title !== ''
const visibleProblemItems = problemItems.filter(hasTitle)
const visibleSolutionSteps = solutionSteps.filter(hasTitle)
const actions = ctaGroupActions(solutionCtaGroup)
for (const cta of actions) if (!isSafeWebUrl(cta.href)) throw new Error('solutionCtaGroup buttons must use an HTTP(S) or root-relative URL.')
// One infographic in two static states. From 50rem (with motion allowed) the script hides the solution copy and
// scrubs the problem copy from state 0 to 1 while it sticks beside both text groups (runtimeProps.scrollAnimation).
const groups = [
  { state: 'problem' as const, intro: problemIntroContent, label: problemInfographicLabel },
  { state: 'solution' as const, intro: solutionIntroContent, label: solutionInfographicLabel },
]
// Green callout line (overlay units): from the dot a 45° diagonal out past the ring, then a short run to the arrow. One
// SVG path, so it draws with a dash offset in one go; the gradient needs an id per rendered infographic.
// The path starts `gap` units along the diagonal, just inside the semi-transparent dot's edge (a slight overlap rather
// than a gap; the dot is a fixed 4 px, the units scale with the stage).
const donutCallout = { diagonal: 68, elbow: 16, gap: 1.5 }
const donutCalloutRun = Math.round(donutCallout.diagonal * Math.SQRT1_2 * 100) / 100
const donutCalloutStart = Math.round(donutCallout.gap * Math.SQRT1_2 * 100) / 100
const donutCalloutPath = `M${donutCalloutStart} ${donutCalloutStart}L${donutCalloutRun} ${donutCalloutRun}H${donutCalloutRun + donutCallout.elbow}`
const donutCalloutStyle = `--kiw--homepage-problem-solution-donut-callout-run: ${donutCalloutRun}; --kiw--homepage-problem-solution-donut-callout-elbow: ${donutCallout.elbow}; --kiw--homepage-problem-solution-donut-callout-length: ${donutCallout.diagonal - donutCallout.gap + donutCallout.elbow};`
const gradientId = `homepage-problem-solution-${Math.random().toString(36).slice(2, 10)}`
---
<section class="homepage-problem-solution-allentown" id={id} data-kinekt-section data-kinekt-content-width={Astro.props.contentWidth ?? 'standard'} data-kinekt-theme={theme} data-homepage-problem-solution>
  <div class="homepage-problem-solution-allentown__container" data-homepage-problem-solution-grid>
    {groups.map(({ state, intro, label }) => (
    <div class:list={['homepage-problem-solution-allentown__group', `homepage-problem-solution-allentown__group--${state}`]}>
      <div class:list={['homepage-problem-solution-allentown__stage', `homepage-problem-solution-allentown__stage--${state}`]} role="img" aria-label={label} data-homepage-problem-solution-stage={state} data-homepage-problem-solution-problem-label={problemInfographicLabel} data-homepage-problem-solution-solution-label={solutionInfographicLabel}>
        <div class="homepage-problem-solution-allentown__scene">
          <img class="homepage-problem-solution-allentown__map" src={mapLarge} srcset={`${mapSmall} 720w, ${mapLarge} 1086w`} sizes="(min-width: 50rem) 714px, 124vw" width="1086" height="1086" alt="" loading={mediaLoading} decoding="async" />
          <span class="homepage-problem-solution-allentown__donut-glow"></span>
          <svg class="homepage-problem-solution-allentown__overlay" viewBox="0 0 576 576" aria-hidden="true" focusable="false">
            <g class="homepage-problem-solution-allentown__donut">
              <circle class="homepage-problem-solution-allentown__donut-fill" cx="288" cy="288" />
              <circle class="homepage-problem-solution-allentown__donut-line" cx="288" cy="288" pathLength="1000" />
            </g>
            <circle class="homepage-problem-solution-allentown__range" cx="288" cy="288" />
            <g class="homepage-problem-solution-allentown__plane">
              <svg x="276" y="276" width="24" height="24" viewBox="0 0 640 640">
                <!--!Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc.-->
                <path d="M552 264C582.9 264 608 289.1 608 320C608 350.9 582.9 376 552 376L424.7 376L256 560L176 560L237.3 376L137.6 376L80 448L32 448L64 320L32 192L80 192L137.6 264L237.3 264L176 80L256 80L424.7 264L552 264z" />
              </svg>
            </g>
          </svg>
          {problemRangeLabel && (
            <div class="homepage-problem-solution-allentown__callout homepage-problem-solution-allentown__callout--range">
              <span class="homepage-problem-solution-allentown__callout-dot"></span>
              <span class="homepage-problem-solution-allentown__callout-line"><span class="homepage-problem-solution-allentown__callout-arrow"></span></span>
              <span class="homepage-problem-solution-allentown__callout-label">{problemRangeLabel}</span>
            </div>
          )}
          {(solutionRangeLabel || solutionRangeValue) && (
            <div class="homepage-problem-solution-allentown__callout homepage-problem-solution-allentown__callout--donut" style={donutCalloutStyle}>
              <span class="homepage-problem-solution-allentown__callout-dot"></span>
              <svg class="homepage-problem-solution-allentown__callout-path" viewBox={`0 0 ${donutCalloutRun + donutCallout.elbow} ${donutCalloutRun}`} aria-hidden="true" focusable="false">
                <defs>
                  <linearGradient id={`${gradientId}-${state}`} gradientUnits="userSpaceOnUse" x1={donutCalloutStart} y1={donutCalloutStart} x2={donutCalloutRun} y2={donutCalloutRun}>
                    <stop class="homepage-problem-solution-allentown__callout-path-fade" offset="0" />
                    <stop class="homepage-problem-solution-allentown__callout-path-full" offset="1" />
                  </linearGradient>
                </defs>
                <path d={donutCalloutPath} pathLength="1" stroke={`url(#${gradientId}-${state})`} />
              </svg>
              <span class="homepage-problem-solution-allentown__callout-arrow"></span>
              <span class="homepage-problem-solution-allentown__callout-label">
                {solutionRangeLabel && <span class="homepage-problem-solution-allentown__callout-text">{solutionRangeLabel}</span>}
                {solutionRangeValue && <Label text={solutionRangeValue} size="s" class="homepage-problem-solution-allentown__callout-value" />}
              </span>
            </div>
          )}
        </div>
      </div>
      <div class="homepage-problem-solution-allentown__text" data-homepage-problem-solution-sticky-end={state === 'solution' ? '' : undefined}>
        <header class="homepage-problem-solution-allentown__intro">
          <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
        </header>
        {state === 'problem' && visibleProblemItems.length > 0 && (
          <ul class="homepage-problem-solution-allentown__problems">
            {visibleProblemItems.map((item) => (
              <li class="homepage-problem-solution-allentown__problem">
                <HomepageProblemItem item={item} headingLevel={itemHeadingLevel} />
              </li>
            ))}
          </ul>
        )}
        {state === 'solution' && visibleSolutionSteps.length > 0 && (
          <ol class="homepage-problem-solution-allentown__steps">
            {visibleSolutionSteps.map((step) => (
              <li class="homepage-problem-solution-allentown__step">
                <HomepageSolutionStep item={step} headingLevel={itemHeadingLevel} />
              </li>
            ))}
          </ol>
        )}
        {state === 'solution' && actions.length > 0 && (
          <div class="homepage-problem-solution-allentown__actions">
            {actions.map((cta, index) => {
              const icon = isCtaIcon(cta.icon) ? ctaIconPaths(cta.icon) : undefined
              return <Button href={cta.href} label={cta.label} style={cta.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
            })}
          </div>
        )}
      </div>
    </div>
    ))}
  </div>
</section>
<script>
  // runtimeProps.scrollAnimation (progressive): from 50rem with motion allowed, one sticky infographic scrubs from the
  // problem state (0) to the solution state (1). Otherwise (phones, reduced motion, no JS) both static states stay.
  const motion = window.matchMedia('(min-width: 50rem) and (prefers-reduced-motion: no-preference)')
  const progressProperty = '--kiw--homepage-problem-solution-progress'

  for (const section of document.querySelectorAll<HTMLElement>('[data-homepage-problem-solution]')) {
    if (section.hasAttribute('data-homepage-problem-solution-initialized')) continue
    section.setAttribute('data-homepage-problem-solution-initialized', '')
    const grid = section.querySelector<HTMLElement>('[data-homepage-problem-solution-grid]')
    const stage = section.querySelector<HTMLElement>('[data-homepage-problem-solution-stage="problem"]')
    if (!grid || !stage) continue
    const labels = { problem: stage.dataset.homepageProblemSolutionProblemLabel ?? '', solution: stage.dataset.homepageProblemSolutionSolutionLabel ?? '' }
    const stickyEnd = section.querySelector<HTMLElement>('[data-homepage-problem-solution-sticky-end]')
    let stickyTop = 0
    let endOffset = 0
    // Progress points at which each callout plays (CSS variables, read on measure).
    const callouts = [
      { attribute: 'data-homepage-problem-solution-range-callout', property: '--kiw--homepage-problem-solution-range-callout-at', at: 0.55 },
      { attribute: 'data-homepage-problem-solution-donut-callout', property: '--kiw--homepage-problem-solution-donut-callout-at', at: 0.85 },
    ]
    let progress = ''
    let frame = 0

    const update = () => {
      frame = 0
      if (!section.hasAttribute('data-homepage-problem-solution-animated')) return
      // The stage travels from the top of the grid to the end of the solution steps (the bottom margin keeps it clear
      // of the CTA); progress is how far along that travel it is.
      const gridBox = grid.getBoundingClientRect()
      const travel = gridBox.height - stage.offsetHeight - endOffset
      const value = travel > 0 ? Math.min(Math.max((stickyTop - gridBox.top) / travel, 0), 1) : 0
      const next = value.toFixed(4)
      if (next === progress) return
      progress = next
      stage.style.setProperty(progressProperty, next)
      stage.setAttribute('aria-label', value >= 0.5 ? labels.solution : labels.problem)
      // Callouts aren't scrubbed: past their point they play (and reverse) as CSS transitions.
      for (const callout of callouts) stage.toggleAttribute(callout.attribute, value >= callout.at)
    }
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update) }
    const measure = () => {
      const style = getComputedStyle(stage)
      stickyTop = Number.parseFloat(style.top) || 0
      for (const callout of callouts) callout.at = Number.parseFloat(style.getPropertyValue(callout.property)) || callout.at
      // Sticky stops at the end of its grid area; a bottom margin makes it stop earlier, with its top level with the top
      // of the solution text (the eyebrow).
      stage.style.removeProperty('margin-block-end')
      endOffset = section.hasAttribute('data-homepage-problem-solution-animated') && stickyEnd
        ? Math.max(0, grid.getBoundingClientRect().bottom - (stickyEnd.getBoundingClientRect().top + stage.offsetHeight))
        : 0
      if (endOffset) stage.style.setProperty('margin-block-end', `${endOffset}px`)
      progress = ''
      schedule()
    }
    const apply = () => {
      section.toggleAttribute('data-homepage-problem-solution-animated', motion.matches)
      if (!motion.matches) {
        stage.style.removeProperty(progressProperty)
        stage.setAttribute('aria-label', labels.problem)
        for (const callout of callouts) stage.removeAttribute(callout.attribute)
      }
      measure()
    }

    motion.addEventListener('change', apply)
    window.addEventListener('scroll', schedule, { passive: true })
    window.addEventListener('resize', measure, { passive: true })
    new ResizeObserver(measure).observe(grid)
    apply()
  }
</script>
<style is:global>
  .homepage-problem-solution-allentown {
    --kiw--section-site-width: var(--kiw--homepage-problem-solution-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--homepage-problem-solution-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--homepage-problem-solution-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--homepage-problem-solution-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--homepage-problem-solution-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--homepage-problem-solution-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--homepage-problem-solution-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--homepage-problem-solution-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--homepage-problem-solution-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--homepage-problem-solution-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--homepage-problem-solution-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--homepage-problem-solution-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--homepage-problem-solution-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--homepage-problem-solution-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--homepage-problem-solution-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--homepage-problem-solution-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--homepage-problem-solution-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--homepage-problem-solution-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--homepage-problem-solution-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--homepage-problem-solution-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--homepage-problem-solution-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--homepage-problem-solution-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--homepage-problem-solution-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--homepage-problem-solution-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--homepage-problem-solution-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--homepage-problem-solution-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--homepage-problem-solution-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--homepage-problem-solution-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--homepage-problem-solution-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--homepage-problem-solution-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--homepage-problem-solution-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--homepage-problem-solution-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--homepage-problem-solution-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--homepage-problem-solution-allentown-actions-gap, var(--space-l));
    --kiw--section-actions-margin: var(--kiw--homepage-problem-solution-allentown-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--homepage-problem-solution-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--homepage-problem-solution-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--homepage-problem-solution-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--homepage-problem-solution-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--homepage-problem-solution-allentown-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--homepage-problem-solution-allentown-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--homepage-problem-solution-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--homepage-problem-solution-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--homepage-problem-solution-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--homepage-problem-solution-allentown-canvas);
    --kiw--section-surface: var(--kiw--homepage-problem-solution-allentown-surface);
    --kiw--section-ink: var(--kiw--homepage-problem-solution-allentown-ink);
    --kiw--section-muted: var(--kiw--homepage-problem-solution-allentown-muted);
    --kiw--section-line: var(--kiw--homepage-problem-solution-allentown-line);
    --kiw--section-action: var(--kiw--homepage-problem-solution-allentown-action);
    --kiw--section-action-text: var(--kiw--homepage-problem-solution-allentown-action-text);
    --kiw--section-accent: var(--kiw--homepage-problem-solution-allentown-accent);
    --kiw--section-action-icon: var(--kiw--homepage-problem-solution-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--homepage-problem-solution-allentown-subtle);
  }
</style>
<style is:global>
  .homepage-problem-solution-allentown[data-kinekt-section] > .homepage-problem-solution-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .homepage-problem-solution-allentown :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; }
  .homepage-problem-solution-allentown :is(p, ul, ol) { margin-block: 0; }
</style>
<style is:global>
  /* Figma "Section - The problem + The Solution" (5240:411370), dark: 1296 container; two groups (problem, solution), each a 576 square infographic + 80 + 640 text column. */
  :where(.homepage-problem-solution-allentown) {
    --kiw--homepage-problem-solution-container-width: var(--width-xxl);
    --kiw--homepage-problem-solution-group-gap: var(--section-space-xxl);
    --kiw--homepage-problem-solution-column-gap: var(--section-space-l);
    --kiw--homepage-problem-solution-stack-gap: var(--section-space-s);
    --kiw--homepage-problem-solution-media-width: var(--width-m);
    --kiw--homepage-problem-solution-text-gap: var(--section-space-m);
    --kiw--homepage-problem-solution-intro-gap: var(--space-m);
    --kiw--homepage-problem-solution-heading-stack-gap: var(--space-xxs);
    --kiw--homepage-problem-solution-heading-size: var(--h2);
    --kiw--homepage-problem-solution-description-font-size: var(--text-l);
    --kiw--homepage-problem-solution-description-line-height: 1.5;
    --kiw--homepage-problem-solution-problem-accent-color: var(--error, var(--kinekt-component-accent));
    --kiw--homepage-problem-solution-problems-column-gap: var(--section-space-m);
    --kiw--homepage-problem-solution-problems-row-gap: var(--section-space-s);
    --kiw--homepage-problem-solution-step-gap: var(--space-xxl);
    --kiw--homepage-problem-solution-divider-color: var(--kinekt-component-line);
    --kiw--homepage-problem-solution-actions-gap: var(--space-s);
    /* Infographic (always dark: the map is a fixed asset, so it uses palette colours rather than theme roles). Units are
       the 576 × 576 overlay; the start frame matches the Tulip reference (range r 78, plane 24). */
    --kiw--homepage-problem-solution-infographic-canvas: var(--primary-ultra-dark);
    --kiw--homepage-problem-solution-plane-color: var(--white);
