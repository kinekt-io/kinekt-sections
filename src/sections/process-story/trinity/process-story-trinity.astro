---
import '../../../styles/wireframe-tokens.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import { fas } from '@fortawesome/free-solid-svg-icons'
import type { RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'

interface Cta { label: string; href: string }

interface ProcessItem {
  title: string
  description?: string | RichText
  markerType?: 'number' | 'icon'
  icon?: string
  ctaGroup?: { primaryButton?: Cta; secondaryButton?: Cta }
}

interface Props {
  id?: string
  theme?: 'light' | 'semi-light' | 'semi-dark' | 'dark'
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro: SectionIntroContent
  items: ProcessItem[]
}

const { id, theme = 'light', headingLevel = 'h2', intro, items = [] } = Astro.props as Props
const description = (value: ProcessItem['description']) => typeof value === 'string' ? value : value?.html
const fontAwesomeIcon = (name?: string) => {
  if (!name || !/^[a-z0-9-]+$/.test(name)) return undefined
  const key = `fa${name.split('-').map((part) => part[0].toUpperCase() + part.slice(1)).join('')}`
  return fas[key]
}
---
<section class="process-story-trinity" id={id} data-kinekt-section data-kinekt-theme={theme} data-process-story-trinity>
  <div class="process-story-trinity__container">
    <div class="process-story-trinity__intro"><SectionIntro intro={intro} headingLevel={headingLevel} /></div>
    <ol class="process-story-trinity__steps" aria-label="Process steps">
      {items.map((item, index) => {
        const icon = fontAwesomeIcon(item.icon)
        return <li class="process-story-trinity__step" data-process-story-step data-process-story-item-marker={item.markerType ?? 'number'}>
          <details class="process-story-trinity__disclosure" open={index === 0} data-process-story-disclosure>
            <summary class="process-story-trinity__trigger" data-process-story-trigger>
              <span class="process-story-trinity__number" aria-hidden="true">
                <span class="process-story-trinity__marker-number">{String(index + 1).padStart(2, '0')}</span>
                {icon && <svg class="process-story-trinity__marker-icon" viewBox={`0 0 ${icon.icon[0]} ${icon.icon[1]}`} focusable="false"><path d={icon.icon[4] as string} /></svg>}
              </span>
              <span class="process-story-trinity__title">{item.title}</span>
              <span class="process-story-trinity__timer" aria-hidden="true"><span></span></span>
            </summary>
            <div class="process-story-trinity__panel">
              {description(item.description) && <div class="process-story-trinity__description" set:html={description(item.description)} />}
              {item.ctaGroup && <div class="process-story-trinity__cta-group">
                {item.ctaGroup.primaryButton && <Button {...item.ctaGroup.primaryButton} />}
                {item.ctaGroup.secondaryButton && <Button {...item.ctaGroup.secondaryButton} style="secondary" />}
              </div>}
            </div>
          </details>
        </li>
      })}
    </ol>
  </div>
</section>

<script>
  const duration = 6000

  function initialise(root: HTMLElement) {
    if (root.dataset.processStoryInitialised) return
    root.dataset.processStoryInitialised = 'true'

    const steps = [...root.querySelectorAll<HTMLElement>('[data-process-story-step]')]
    if (steps.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const disclosures = steps.map((step) => step.querySelector<HTMLDetailsElement>('[data-process-story-disclosure]')!)
    const triggers = steps.map((step) => step.querySelector<HTMLElement>('[data-process-story-trigger]')!)
    let activeIndex = 0
    let timer: number | undefined
    let pausedByPointer = false
    let outsideViewport = true
    let stoppedByClick = false

    const setTimerState = (state: 'running' | 'paused') => {
      root.dataset.processStoryTimerState = state
    }

    const clearTimer = () => {
      if (timer !== undefined) window.clearTimeout(timer)
      timer = undefined
    }

    const show = (index: number) => {
      activeIndex = index
      steps.forEach((step, stepIndex) => {
        const active = stepIndex === index
        step.toggleAttribute('data-process-story-active', active)
        disclosures[stepIndex].open = active
      })
    }

    const schedule = () => {
      clearTimer()
      if (stoppedByClick || pausedByPointer || outsideViewport) {
        setTimerState('paused')
        return
      }
      setTimerState('running')
      timer = window.setTimeout(() => {
        show((activeIndex + 1) % steps.length)
        schedule()
      }, duration)
    }

    show(0)
    root.addEventListener('pointerenter', () => {
      pausedByPointer = true
      schedule()
    })
    root.addEventListener('pointerleave', () => {
      pausedByPointer = false
      schedule()
    })
    triggers.forEach((trigger, index) => trigger.addEventListener('click', (event) => {
      event.preventDefault()
      stoppedByClick = true
      root.dataset.processStoryStopped = 'true'
      show(index)
      schedule()
    }))

    const observer = new IntersectionObserver(([entry]) => {
      outsideViewport = !entry.isIntersecting
      schedule()
    }, { threshold: 0.2 })
    observer.observe(root)
  }

  document.querySelectorAll<HTMLElement>('[data-process-story-trinity]').forEach(initialise)
</script>

