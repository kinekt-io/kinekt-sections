{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.2-beta.15",
  "id": "sections/process-story/trinity",
  "slug": "process-story-trinity",
  "title": "Process Story Trinity",
  "description": "A timed, single-open process accordion with localized introductory content and process steps.",
  "category": "sections",
  "tags": ["content", "process", "accordion", "prerelease"],
  "role": "process-story",
  "variation": "trinity",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411425&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411425"
  },
  "fields": {
    "theme": {
      "kind": "select",
      "required": true,
      "localized": false,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "items": {
      "kind": "componentList",
      "componentId": "components/process-item/trinity",
      "required": true,
      "localized": true,
      "minItems": 1,
      "description": "Ordered process steps. The renderer owns the active state, timing bar, and pause behaviour."
    }
  },
  "runtimeProps": {
    "accordion": {
      "kind": "timedSingleOpen",
      "source": "renderer",
      "pauseOnHover": true,
      "pauseOutsideViewport": true,
      "stopOnClick": true
    }
  }
}
