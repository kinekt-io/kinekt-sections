    --kiw--section-actions-margin: var(--kiw--process-story-allentown-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--process-story-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--process-story-allentown-button-padding-block, var(--space-s));
