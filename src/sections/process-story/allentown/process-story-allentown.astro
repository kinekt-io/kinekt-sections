---
import '../../../styles/wireframe-tokens.css'
import ProcessItem, { type ProcessItemContent } from '../../../components/process-item/allentown/process-item-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaProcessStoryAllentownContent } from './process-story-allentown.types.js'

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaProcessStoryAllentownContent {
  theme?: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }
  image?: Media | null
  items: ProcessItemContent[]
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', intro, image, items = [], headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const itemHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const hasMedia = Boolean(image && typeof image === 'object' && typeof image.url === 'string')
const visibleItems = items.filter((item) => (typeof item?.label === 'string' && item.label !== '') || (typeof item?.title === 'string' && item.title !== ''))
const classes = ['process-story-allentown', hasMedia && 'process-story-allentown--with-media'].filter(Boolean).join(' ')
---
<section class={classes} id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="process-story-allentown__container">
    <header class="process-story-allentown__intro">
      <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
    </header>

    <div class="process-story-allentown__content">
      {hasMedia && image && <KinektMedia media={image} class="process-story-allentown__media" imageClass="process-story-allentown__image" loading={mediaLoading} />}
      {visibleItems.length > 0 && (
        <ul class="process-story-allentown__items">
          {visibleItems.map((item) => (
            <li class="process-story-allentown__item">
              <ProcessItem item={item} headingLevel={itemHeadingLevel} />
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
