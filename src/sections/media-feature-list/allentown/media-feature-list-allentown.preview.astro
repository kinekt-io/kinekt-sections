---
import MediaFeatureList from './media-feature-list-allentown.astro'
import type { MediaFeatureListContent } from './media-feature-list-allentown.types.js'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content: MediaFeatureListContent = {
  theme: 'dark',
  direction: 'mediaLeft',
  intro: {
    accentHeading: 'Engineered energy systems',
    heading: 'Energy systems built around real operating conditions',
    description: {
      html: '<p>Clear technical information helps teams assess operating conditions, integration constraints and the next engineering decision.</p>',
    },
  },
  label: {
    text: 'Validated for demanding deployments',
    icon: '↗',
  },
  media: {
    url: placeholder('placeholder-1376x812.svg'),
    alt: 'Battery module and electrical interface',
    width: 1376,
    height: 812,
  },
  features: [
    {
      title: 'Designed for the constraints that shape delivery',
      description: {
        html: '<p>The system is configured around the duty cycle, environmental demands and evidence needed for a reliable release.</p>',
      },
    },
    {
      title: 'Performance data teams can use with confidence',
      description: {
        html: '<p>Structured content keeps performance requirements, technical context and implementation choices easy to compare.</p>',
      },
    },
    {
      title: 'Support from specification to integration',
      description: {
        html: '<p>Expert input connects technical decisions with the evidence and documentation each project needs.</p>',
      },
    },
  ],
}
---
<MediaFeatureList {...content} />
