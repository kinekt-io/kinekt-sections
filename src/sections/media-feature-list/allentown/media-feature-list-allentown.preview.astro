---
import MediaFeatureList from './media-feature-list-allentown.astro'
import type { MediaFeatureListContent } from './media-feature-list-allentown.types.js'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content: MediaFeatureListContent = {
  theme: 'semi-dark',
  direction: 'mediaLeft',
  intro: {
    accentHeading: '/ EU headquarters',
    heading: 'European roots. Global ambitions.',
    description: {
      html: '<p>From our headquarters in the Netherlands, our engineering, commercial and program teams work closely with customers across Europe and beyond. Direct access to our specialists keeps communication short, decisions fast and development moving.</p>',
    },
  },
  label: {
    text: 'The Netherlands',
    icon: 'location-dot',
  },
  media: {
    url: placeholder('placeholder-688x406.svg'),
    alt: 'Engineering team at the European headquarters',
    width: 688,
    height: 406,
  },
  features: [
    {
      title: 'Direct access to expertise',
      description: {
        html: '<p>Work closely with the specialists behind our battery technology.</p>',
      },
    },
    {
      title: 'Short communication lines',
      description: {
        html: '<p>Direct collaboration keeps projects moving and decisions fast.</p>',
      },
    },
    {
      title: 'Strategically located in Europe',
      description: {
        html: '<p>A strong European base for programs operating across global markets.</p>',
      },
    },
  ],
}
---
<MediaFeatureList {...content} />
