---
import ComparisonOverviewAllentown from './comparison-overview-allentown.astro'

const intro = {
  accentHeading: 'Programme assurance',
  heading: 'Choose the evidence package that fits your rollout',
  description: 'Each delivery path includes a clear set of test evidence, production controls and programme documentation.',
}
const comparison = {
  columns: ['Core package', 'Adapt package', 'Connected package'],
  rows: [
    { feature: 'Transport test record', cells: [{ type: 'text', text: 'Included' }, { type: 'text', text: 'Included' }, { type: 'text', text: 'Included' }] },
    { feature: 'Market-entry review', cells: [{ type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }] },
    { feature: 'System integration dossier', cells: [{ type: 'text', text: 'Standard scope' }, { type: 'text', text: 'Programme scope' }, { type: 'text', text: 'Programme scope' }] },
    { feature: 'Independent lab report', cells: [{ type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }] },
    { feature: 'Serial traceability pack', cells: [{ type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }, { type: 'status', status: 'positive' }] },
    { feature: 'Supplier audit summary', cells: [{ type: 'status', status: 'positive' }, { type: 'status', status: 'negative' }, { type: 'status', status: 'negative' }] },
  ],
}
const callout = {
  intro: {
    accentHeading: 'Talk to a programme lead',
    heading: 'Map the evidence needed for your release',
    description: 'Review the tests, records and handover material required before production begins.',
  },
  cta: { label: 'Arrange a call', href: '#' },
}
---
<ComparisonOverviewAllentown
  theme="semi-light"
  intro={intro}
  introCta={{ cta: { label: 'Review package options', href: '#' } }}
  comparison={comparison as any}
  callout={callout}
/>
