  :where(.comparison-overview-allentown) > [class$='__container'] { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); } :where(.comparison-overview-allentown) :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; } :where(.comparison-overview-allentown) h2 { font-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); }
  :where(.comparison-overview-allentown) :is(p, li, dd, td, th, label, input, textarea, button) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.comparison-overview-allentown) :is(p, ul, ol, dl, table, form) { margin-block: 0; } :where(.comparison-overview-allentown) .section-intro__accent { margin-block: 0 var(--kinekt-component-intro-accent-gap); color: var(--kinekt-component-accent); font-family: var(--kinekt-component-mono); font-size: var(--kinekt-component-text-xs-size); font-weight: var(--kiw--section-heading-font-weight); letter-spacing: var(--kiw--section-text-letter-spacing); text-transform: uppercase; } :where(.comparison-overview-allentown) .section-intro__heading { margin: 0; } :where(.comparison-overview-allentown) .section-intro__description { max-width: var(--kinekt-component-reading-width); margin-block: var(--kinekt-component-intro-description-gap) 0; color: var(--kinekt-component-muted); font-size: var(--kinekt-component-text-l-size); }
  :where(.comparison-overview-allentown) table { width: 100%; border-collapse: collapse; overflow: hidden; border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); } :where(.comparison-overview-allentown) :is(th, td) { padding: var(--space-s); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); text-align: left; vertical-align: top; } :where(.comparison-overview-allentown) th { font-weight: var(--heading-font-weight); background: var(--kinekt-component-surface); }
 
</style>
