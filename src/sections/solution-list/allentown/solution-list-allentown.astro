---
import { sectionTokenBridgeStyle } from '../../../shared/section-token-bridge.js'
import '../../../styles/wireframe.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import Callout from '../../../components/callout/allentown/callout-allentown.astro'

const { id, theme = 'semi-light', intro, items = [], callout, headingLevel = 'h2' } = Astro.props as any
const sectionId = id ?? 'solution-list'
const toc = items.map((item: any, index: number) => ({ id: `${sectionId}-item-${index + 1}`, label: item.heading }))
const description = (value: unknown) => typeof value === 'string' ? value : (value as { html?: string })?.html
const action = (value: any) => value?.cta ?? value
---
<section class="beta-solution-list-allentown" id={id} data-kinekt-section data-kinekt-theme={theme} style={sectionTokenBridgeStyle('solution-list-allentown')}>
  <div class="beta-solution-list-allentown__container">
    <header class="beta-solution-list-allentown__intro"><SectionIntro intro={intro} headingLevel={headingLevel} /></header>
    <nav class="beta-solution-list-allentown__toc" aria-label="Solutions in this section"><ul>{toc.map((item: any) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul></nav>
    <ul class="beta-solution-list-allentown__items">
      {items.map((item: any, index: number) => (
        <li id={toc[index].id}><article>
          <KinektMedia class="beta-solution-list-allentown__media" imageClass="beta-solution-list-allentown__image" media={item.image} />
          <div class="beta-solution-list-allentown__content">
            <div class="beta-solution-list-allentown__body">
              <div class="beta-solution-list-allentown__heading-group">
                {item.accentHeading && <p class="beta-solution-list-allentown__accent">{item.accentHeading}</p>}
                <h3>{item.heading}</h3>
              </div>
              {item.label?.text && <Label class="beta-solution-list-allentown__label" text={item.label.text} icon={item.label.icon} />}
              {item.label && typeof item.label === 'string' && <Label class="beta-solution-list-allentown__label" text={item.label} />}
              {description(item.description) && <div class="beta-solution-list-allentown__description" set:html={description(item.description)} />}
            </div>
            {action(item.cta)?.label && <div class="beta-solution-list-allentown__actions"><Button href={action(item.cta).href} label={action(item.cta).label} style="clear" /></div>}
          </div>
        </article></li>
      ))}
    </ul>
  </div>
  {callout && <div class="beta-solution-list-allentown__callout-container"><Callout class="beta-solution-list-allentown__callout" callout={callout} /></div>}
</section>
<style>
  :global(:where(.beta-solution-list-allentown)) {
    --kiw--solution-list-allentown-accent-gap: var(--space-xs);
    --kiw--solution-list-allentown-heading-gap: var(--space-m);
    --kiw--solution-list-allentown-label-space: var(--space-l);
    --kiw--solution-list-allentown-container-gap: var(--space-xl);
    --kiw--solution-list-allentown-content-width: var(--content-width);
    --kiw--solution-list-allentown-content-gap: var(--content-gap);
    --kiw--solution-list-allentown-inline-space: var(--section-gutter);
    --kiw--solution-list-allentown-toc-gap: var(--space-xs);
    --kiw--solution-list-allentown-toc-block-space: var(--space-xs);
    --kiw--solution-list-allentown-toc-inline-space: var(--space-s);
    --kiw--solution-list-allentown-border-width: var(--border-width);
    --kiw--solution-list-allentown-line-color: var(--kinekt-component-line);
    --kiw--solution-list-allentown-ink-color: var(--kinekt-component-ink);
    --kiw--solution-list-allentown-surface-color: var(--kinekt-component-surface);
    --kiw--solution-list-allentown-item-gap: var(--space-s);
    --kiw--solution-list-allentown-media-filter: var(--media-filter);
    --kiw--solution-list-allentown-column-gap: var(--section-space-s);
  }

  .beta-solution-list-allentown {
    --kinekt-section-card-media-ratio: 1 / 1;
    --solution-list-accent-to-heading: var(--kiw--solution-list-allentown-accent-gap);
    --solution-list-heading-group-to-label: var(--kiw--solution-list-allentown-heading-gap);
    --solution-list-label-to-description: var(--kiw--solution-list-allentown-label-space);
    --solution-list-body-to-action: var(--kiw--solution-list-allentown-label-space);

    & > .beta-solution-list-allentown__container {
      gap: var(--kiw--solution-list-allentown-container-gap);
    }

    & > .beta-solution-list-allentown__callout-container {
      display: grid;
      width: 100%;
      max-width: var(--kiw--solution-list-allentown-content-width);
      margin-block-start: var(--kiw--solution-list-allentown-content-gap);
      margin-inline: auto;
      padding-inline: var(--kiw--solution-list-allentown-inline-space);
    }

    & .beta-solution-list-allentown__content,
    & .beta-solution-list-allentown__body,
    & .beta-solution-list-allentown__heading-group {
      display: grid;
    }

    & .beta-solution-list-allentown__content {
      row-gap: var(--solution-list-body-to-action);
    }

    & .beta-solution-list-allentown__body {
      row-gap: var(--solution-list-heading-group-to-label);
    }

    & .beta-solution-list-allentown__heading-group {
      row-gap: var(--solution-list-accent-to-heading);
    }

    & .beta-solution-list-allentown__accent,
    & h3,
    & .beta-solution-list-allentown__description {
      margin: 0;
    }

    & .beta-solution-list-allentown__label {
      margin: 0 0 calc(var(--solution-list-label-to-description) - var(--solution-list-heading-group-to-label));
    }

    & .beta-solution-list-allentown__actions {
      display: flex;
      margin-block-start: 0;
    }

    & .beta-solution-list-allentown__toc {
      inline-size: 100vw;
      margin-inline: calc(50% - 50vw);
      overflow-x: auto;
      ul {
        display: flex;
        gap: var(--kiw--solution-list-allentown-toc-gap);
        width: max-content;
        min-width: 100%;
        margin: 0;
        padding-inline: var(--kiw--solution-list-allentown-inline-space);
        list-style: none;
      }

      a {
        display: block;
        padding: var(--kiw--solution-list-allentown-toc-block-space) var(--kiw--solution-list-allentown-toc-inline-space);
        border: var(--kiw--solution-list-allentown-border-width) solid var(--kiw--solution-list-allentown-line-color);
        color: var(--kiw--solution-list-allentown-line-color);
        text-decoration: none;
        white-space: nowrap;

        &:focus-visible,
        &:hover {
          box-shadow: inset 0 0 0 calc(var(--kiw--solution-list-allentown-border-width) * 2) var(--kiw--solution-list-allentown-ink-color);
          background: var(--kiw--solution-list-allentown-surface-color);
        }
      }
    }

    & .beta-solution-list-allentown__items {
      margin: 0;
      padding: 0;
      border-top: 0;
      list-style: none;

      > li:last-child > article {
        border-bottom: 0;
      }
      article {
        display: grid;
        row-gap: var(--kiw--solution-list-allentown-item-gap);
        column-gap: 0;
      }
    }

    & .beta-solution-list-allentown__media,
    & .beta-solution-list-allentown__image {
      display: block;
      width: 100%;
    }

    & .beta-solution-list-allentown__image {
      aspect-ratio: 1 / 1;
      object-fit: cover;
      filter: var(--kiw--solution-list-allentown-media-filter);
    }

    @media (min-width: 50rem) {
      & .beta-solution-list-allentown__toc {
        display: none;
      }

      & .beta-solution-list-allentown__items article {
        grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.55fr);
        column-gap: var(--kiw--solution-list-allentown-column-gap);
      }
    }
  }
</style>
