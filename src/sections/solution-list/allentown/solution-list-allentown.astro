---
import '../../../styles/wireframe-tokens.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import Callout from '../../../components/callout/allentown/callout-allentown.astro'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { RichText } from '../../../shared/content.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

const { id, theme = 'semi-light', intro, items = [], callout, headingLevel = 'h2' } = Astro.props as any
const sectionId = id ?? 'solution-list'
const toc = items.map((item: any, index: number) => ({ id: `${sectionId}-item-${index + 1}`, label: item.heading }))
const descriptionHtml = (value: string | RichText | null | undefined) => value == null || value === ''
  ? undefined
  : typeof value === 'string'
    ? richTextToHtml(value, 'solution item description')
    : value.html
const action = (value: any) => value?.cta ?? value
---
<section class="beta-solution-list-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-solution-list-allentown__container">
    <header class="beta-solution-list-allentown__intro"><SectionIntro intro={intro} headingLevel={headingLevel} /></header>
    <nav class="beta-solution-list-allentown__toc" aria-label="Solutions in this section"><ul>{toc.map((item: any) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul></nav>
    <ul class="beta-solution-list-allentown__items">
      {items.map((item: any, index: number) => (
        <li id={toc[index].id}><article>
          <KinektMedia class="beta-solution-list-allentown__media" imageClass="beta-solution-list-allentown__image" media={item.image} />
          <div class="beta-solution-list-allentown__content">
            <div class="beta-solution-list-allentown__body">
              <div class="beta-solution-list-allentown__heading-group">
                {item.accentHeading && <p class="beta-solution-list-allentown__accent">{item.accentHeading}</p>}
                <h3>{item.heading}</h3>
              </div>
              {item.label?.text && <Label class="beta-solution-list-allentown__label" text={item.label.text} icon={item.label.icon} />}
              {item.label && typeof item.label === 'string' && <Label class="beta-solution-list-allentown__label" text={item.label} />}
              {descriptionHtml(item.description) && <div class="beta-solution-list-allentown__description" set:html={descriptionHtml(item.description)} />}
            </div>
            {action(item.cta)?.label && (() => {
              const itemAction = action(item.cta)
              const icon = isCtaIcon(itemAction.icon) ? ctaIconPaths(itemAction.icon) : undefined
              return <div class="beta-solution-list-allentown__actions"><Button href={itemAction.href} label={itemAction.label} style="clear" size="l">{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button></div>
            })()}
          </div>
        </article></li>
      ))}
    </ul>
  </div>
  {callout && <div class="beta-solution-list-allentown__callout-container"><Callout class="beta-solution-list-allentown__callout" callout={callout} size="medium" /></div>}
</section>
<style is:global>
  :where(.beta-solution-list-allentown) { box-sizing: border-box; padding-block: var(--kinekt-component-block-space); color: var(--kinekt-component-ink); background: var(--kinekt-component-canvas); font-family: var(--kinekt-component-font); font-size: var(--kiw--section-text-m-size); font-weight: var(--kiw--section-text-font-weight); line-height: var(--kiw--section-text-line-height); letter-spacing: var(--kiw--section-text-letter-spacing); } :where(.beta-solution-list-allentown) *, :where(.beta-solution-list-allentown) *::before, :where(.beta-solution-list-allentown) *::after { box-sizing: border-box; }
