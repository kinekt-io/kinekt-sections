  :where(.beta-solution-list-allentown) > [class$='__container'] { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); } :where(.beta-solution-list-allentown) :is([class$='__header'], [class$='__intro']) { max-width: var(--kinekt-component-reading-width); }
  :where(.beta-solution-list-allentown) :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; } :where(.beta-solution-list-allentown) h1 { font-size: var(--kinekt-section-heading-1-size, var(--kiw--section-heading-1-size)); } :where(.beta-solution-list-allentown) h2 { font-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); } :where(.beta-solution-list-allentown) h3 { font-size: var(--kinekt-section-heading-3-size, var(--kiw--section-heading-3-size)); }
  :where(.beta-solution-list-allentown) :is(p, li, dd, td, th, label, input, textarea, button) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.beta-solution-list-allentown) :is(p, ul, ol, dl, table, form) { margin-block: 0; } :where(.beta-solution-list-allentown) .section-intro__accent { margin-block: 0 var(--kinekt-component-intro-accent-gap); color: var(--kinekt-component-accent); font-family: var(--kinekt-component-mono); font-size: var(--kinekt-component-text-xs-size); font-weight: var(--kiw--section-heading-font-weight); letter-spacing: var(--kiw--section-text-letter-spacing); text-transform: uppercase; } :where(.beta-solution-list-allentown) .section-intro__heading { margin: 0; } :where(.beta-solution-list-allentown) .section-intro__description { max-width: var(--kinekt-component-reading-width); margin-block: var(--kinekt-component-intro-description-gap) 0; color: var(--kinekt-component-muted); font-size: var(--kinekt-component-text-l-size); }
  :where(.beta-solution-list-allentown) :is([class$='__actions'], [class*='__cta-group']) { display: flex; flex-wrap: wrap; gap: var(--kiw--section-actions-gap); margin-top: var(--kiw--section-actions-margin); }
  :where(.beta-solution-list-allentown) :is([class$='__media'], [class*='__media-'], [class*='__image']), :where(.beta-solution-list-allentown) picture { display: block; max-width: 100%; } :where(.beta-solution-list-allentown) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); } :where(.beta-solution-list-allentown) :is(ul, ol)[class*='__'] { display: grid; padding: 0; list-style: none; } :where(.beta-solution-list-allentown) :is(ul, ol)[class*='__'] > li { min-width: 0; } :where(.beta-solution-list-allentown) li > article { display: grid; gap: var(--space-s); padding: var(--kinekt-component-gap); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); background: var(--kinekt-component-surface); }
