---
import SolutionListAllentown from './solution-list-allentown.astro'
const image = (text: string) => ({ url: `https://placehold.co/1600x900/png?text=${encodeURIComponent(text)}`, alt: `${text} preview`, width: 1600, height: 900 })
---
<SolutionListAllentown
  intro={{
    accentHeading: 'Service formats',
    heading: 'Choose the support model that fits your next rollout',
  }}
  items={[
    {
      image: image('Planning workshop'),
      accentHeading: 'Start with clarity',
      heading: 'Planning workshop',
      label: { text: 'Best for teams aligning a complex brief' },
      description: 'Turn an early idea into priorities, milestones, and a practical delivery plan.',
      cta: { cta: { label: 'Explore workshops', href: '#' } },
    },
    {
      image: image('Delivery partnership'),
      accentHeading: 'Build with momentum',
      heading: 'Delivery partnership',
      label: { text: 'Best for programmes that need an embedded team' },
      description: 'Combine specialist delivery capacity with a clear cadence for decisions and progress.',
      cta: { cta: { label: 'Explore delivery', href: '#' } },
    },
    {
      image: image('Capability review'),
      accentHeading: 'Improve what exists',
      heading: 'Capability review',
      label: { text: 'Best for teams preparing their next operating model' },
      description: 'Identify the constraints holding work back and define the changes worth making first.',
      cta: { cta: { label: 'Explore reviews', href: '#' } },
    },
  ]}
  callout={{
    intro: {
      accentHeading: 'Planning a new initiative?',
      heading: 'Bring the right people together before delivery starts.',
      description: 'Share the context, constraints, and intended outcome. We will help frame a useful next step.',
    },
    ctaGroup: { primary: { label: 'Start a conversation', href: '#' } },
  }}
/>
