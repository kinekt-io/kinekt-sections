---
import OutputCardGrid from './output-card-grid-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = (name: string, alt: string) => ({
  url: `${catalogueBase}placeholders/${name}`,
  alt,
  width: 144,
  height: 144,
})

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: 'System overview',
    heading: 'Explore the capabilities that support your project.',
    description: 'Use this section to introduce a focused set of services, features, or technical considerations.',
  },
  ctas: {
    primary: { label: 'Start a conversation', href: '#' },
  },
  label: 'Explore capabilities',
  cards: [
    { image: placeholder('case-study-observatory.webp', 'Abstract technical placeholder'), title: 'Capability one', description: { html: '<p>A concise summary of the first capability or outcome.</p>' } },
    { image: placeholder('case-study-towers.webp', 'Abstract technical placeholder'), title: 'Capability two', description: { html: '<p>A concise summary of the second capability or outcome.</p>' } },
    { image: placeholder('case-study-buses.webp', 'Abstract technical placeholder'), title: 'Capability three', description: { html: '<p>A concise summary of the third capability or outcome.</p>' } },
    { image: placeholder('case-study-motorcycle.webp', 'Abstract technical placeholder'), title: 'Capability four', description: { html: '<p>A concise summary of the fourth capability or outcome.</p>' } },
    { image: placeholder('hero-trinity-street.webp', 'Abstract technical placeholder'), title: 'Capability five', description: { html: '<p>A concise summary of the fifth capability or outcome.</p>' } },
    { image: placeholder('pexels-industrial-building.webp', 'Abstract technical placeholder'), title: 'Capability six', description: { html: '<p>A concise summary of the sixth capability or outcome.</p>' } },
  ],
}
---
<OutputCardGrid {...content} />
