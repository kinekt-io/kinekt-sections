---
import OutputCardGrid from './output-card-grid-allentown.astro'
import type { OutputCardGridContent } from './output-card-grid-allentown.types.js'

const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name
const square = (alt: string) => ({ url: placeholder('placeholder-200x200.svg'), alt, width: 200, height: 200 })

const content: OutputCardGridContent = {
  theme: 'semi-light',
  intro: {
    accentHeading: '/ Customized batteries',
    heading: 'Need a different fit?',
    description: {
      html: '<p>If a standard pack doesn’t match your platform, Tulip can customize the battery around your required dimensions, voltage, capacity and power needs.</p>',
    },
  },
  ctas: {
    primary: { label: 'Contact us', href: '#', icon: 'arrow-right' },
  },
  label: 'What we can tailor',
  cards: [
    { image: square('Power output icon'), title: 'Power output', description: { html: '<p>Continuous and peak discharge matched to your motors, payload and flight profile.</p>' } },
    { image: square('Form factor icon'), title: 'Form factor', description: { html: '<p>Pack dimensions, connectors and mounting points shaped around your airframe.</p>' } },
    { image: square('Cycle life icon'), title: 'Cycle life', description: { html: '<p>Cell chemistry and charge limits tuned for the service life your fleet needs.</p>' } },
    { image: square('Materials icon'), title: 'Materials', description: { html: '<p>Enclosures, insulation and cell sourcing chosen for your operating environment.</p>' } },
    { image: square('Energy density icon'), title: 'Energy density', description: { html: '<p>More capacity per kilogram, so your platform flies longer on the same weight.</p>' } },
    { image: square('Weight icon'), title: 'Weight', description: { html: '<p>Every gram counted, from cell selection to the busbars and housing.</p>' } },
  ],
}
---
<OutputCardGrid {...content} />
