    --kiw--section-card-padding: var(--kiw--output-card-grid-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--output-card-grid-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--output-card-grid-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--output-card-grid-allentown-canvas);
    --kiw--section-surface: var(--kiw--output-card-grid-allentown-surface);
