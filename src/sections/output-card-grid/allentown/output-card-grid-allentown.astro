  :where(.output-card-grid--allentown) :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; } :where(.output-card-grid--allentown) h2 { font-size: var(--kiw--section-heading-2-size); } :where(.output-card-grid--allentown) h3 { font-size: var(--kiw--section-heading-3-size); } :where(.output-card-grid--allentown) :is(p, li) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.output-card-grid--allentown) :is(p, ul, ol) { margin-block: 0; } :where(.output-card-grid--allentown) .section-intro__accent { margin-block: 0 var(--kinekt-component-intro-accent-gap); } :where(.output-card-grid--allentown) .section-intro__heading { margin: 0; } :where(.output-card-grid--allentown) .section-intro__description { max-width: var(--kinekt-component-reading-width); margin-block: var(--kinekt-component-intro-description-gap) 0; color: var(--kinekt-component-muted); font-size: var(--kiw--section-text-l-size); } :where(.output-card-grid--allentown) .button { display: inline-flex; align-items: center; justify-content: center; gap: .8ch; min-height: var(--kiw--section-button-height); padding: var(--kiw--section-button-padding-block) var(--kiw--section-button-padding-inline); border: var(--kinekt-component-border-width) solid var(--kinekt-component-action); border-radius: calc(var(--buttons-has-radius) * var(--kiw--section-button-radius)); color: var(--kinekt-component-action-text); background: var(--kinekt-component-action); font-size: var(--kiw--section-text-s-size); font-weight: var(--kiw--section-heading-font-weight); text-decoration: none; cursor: pointer; } :where(.output-card-grid--allentown) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  :where(.output-card-grid--allentown) h1 { font-size: var(--kiw--section-heading-1-size); } :where(.output-card-grid--allentown) h2 { font-size: var(--kiw--section-heading-2-size); } :where(.output-card-grid--allentown) h3 { font-size: var(--kiw--section-heading-3-size); } :where(.output-card-grid--allentown) h4 { font-size: var(--kiw--section-heading-4-size); } :where(.output-card-grid--allentown) h5 { font-size: var(--kiw--section-heading-5-size); } :where(.output-card-grid--allentown) h6 { font-size: var(--kiw--section-heading-6-size); }
