---
import '../../../styles/wireframe.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { OutputCardGridContent } from './output-card-grid-allentown.types.js'

interface Props extends OutputCardGridContent {
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { theme, intro, ctas, label, cards, headingLevel = 'h2' } = Astro.props as Props
---
<section class="output-card-grid output-card-grid--allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="output-card-grid__container">
    <header class="output-card-grid__header">
      <div class="output-card-grid__header-content">
        <SectionIntro intro={intro} headingLevel={headingLevel} />
      </div>
      {(ctas?.primary || ctas?.secondary) && (
        <nav class="output-card-grid__actions" aria-label="Section actions">
          {ctas.primary && <Button class="output-card-grid__action output-card-grid__action--primary" href={ctas.primary.href} label={ctas.primary.label} />}
          {ctas.secondary && <Button class="output-card-grid__action output-card-grid__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="secondary" />}
        </nav>
      )}
    </header>

    <div class="output-card-grid__content">
      {label && <p class="output-card-grid__label">{label}</p>}
      <div class="output-card-grid__cards">
        {cards.map((card) => (
          <article class="output-card-grid__card">
            <KinektMedia class="output-card-grid__media" imageClass="output-card-grid__image" media={card.image} />
            <div class="output-card-grid__card-content">
              <h3 class="output-card-grid__title">{card.title}</h3>
              <div class="output-card-grid__description" set:html={card.description.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
