    --kiw--section-heading-6-size: var(--kiw--output-card-grid-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--output-card-grid-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--output-card-grid-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--output-card-grid-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--output-card-grid-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--output-card-grid-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--output-card-grid-allentown-text-font-weight, var(--text-font-weight));
