    --kiw--section-text-xs-size: var(--kiw--output-card-grid-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--output-card-grid-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--output-card-grid-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--output-card-grid-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--output-card-grid-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--output-card-grid-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--output-card-grid-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--output-card-grid-allentown-actions-gap, var(--space-s));
    --kiw--section-actions-margin: var(--kiw--output-card-grid-allentown-actions-margin, var(--space-xl));
    --kiw--section-button-height: var(--kiw--output-card-grid-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--output-card-grid-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--output-card-grid-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--output-card-grid-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--output-card-grid-allentown-input-height, var(--input-height));
