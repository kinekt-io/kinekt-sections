---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import OutputCard from '../../../components/output-card/allentown/output-card-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import { ctaIconPaths } from '../../../shared/cta-icons.js'
import type { OutputCardGridContent } from './output-card-grid-allentown.types.js'

interface Props extends OutputCardGridContent {
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { theme, intro, ctas, label, cards, headingLevel = 'h2' } = Astro.props as Props
const primaryIcon = ctas?.primary?.icon ? ctaIconPaths[ctas.primary.icon] : undefined
const secondaryIcon = ctas?.secondary?.icon ? ctaIconPaths[ctas.secondary.icon] : undefined
const cardHeadingLevel = ('h' + Math.min(Number(headingLevel.slice(1)) + 1, 6)) as 'h2' | 'h3' | 'h4'
---
<section class="output-card-grid output-card-grid--allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="output-card-grid__container">
    <header class="output-card-grid__header">
      <div class="output-card-grid__header-content">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      </div>
      {(ctas?.primary || ctas?.secondary) && (
        <nav class="output-card-grid__actions" aria-label="Section actions">
          {ctas.primary && <Button class="output-card-grid__action output-card-grid__action--primary" href={ctas.primary.href} label={ctas.primary.label}>{primaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={primaryIcon.viewBox} fill="none"><path d={primaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
          {ctas.secondary && <Button class="output-card-grid__action output-card-grid__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="clear">{secondaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={secondaryIcon.viewBox} fill="none"><path d={secondaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
        </nav>
      )}
    </header>

    <div class="output-card-grid__content">
      {label && <SubtitleFlightPath class="output-card-grid__label" text={label} />}
      <div class="output-card-grid__cards">
        {cards.map((card) => <OutputCard class="output-card-grid__card" card={card} headingLevel={cardHeadingLevel} />)}
      </div>
    </div>
  </div>
</section>
<style is:global>
  .output-card-grid.output-card-grid--allentown {
    --kiw--section-site-width: var(--kiw--output-card-grid-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--output-card-grid-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--output-card-grid-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--output-card-grid-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--output-card-grid-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--output-card-grid-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--output-card-grid-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--output-card-grid-allentown-border-width, var(--border-width));
