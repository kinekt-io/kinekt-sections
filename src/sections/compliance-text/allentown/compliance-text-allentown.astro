    --kiw--section-text-xs-size: var(--kiw--compliance-text-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--compliance-text-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--compliance-text-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--compliance-text-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--compliance-text-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--compliance-text-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-canvas: var(--kiw--compliance-text-allentown-canvas);
    --kiw--section-surface: var(--kiw--compliance-text-allentown-surface);
    --kiw--section-ink: var(--kiw--compliance-text-allentown-ink);
    --kiw--section-muted: var(--kiw--compliance-text-allentown-muted);
    --kiw--section-line: var(--kiw--compliance-text-allentown-line);
    --kiw--section-action: var(--kiw--compliance-text-allentown-action);
    --kiw--section-action-text: var(--kiw--compliance-text-allentown-action-text);
    --kiw--section-accent: var(--kiw--compliance-text-allentown-accent);
    --kiw--section-action-icon: var(--kiw--compliance-text-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--compliance-text-allentown-subtle);
  }
</style>
<style is:global>
  :where(.compliance-text-allentown[data-kinekt-section]) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-ultra-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary))); --kinekt-component-font: var(--kinekt-section-font, var(--kiw--section-text-font-family)); --kinekt-component-mono: var(--kinekt-section-mono, var(--kiw--section-mono-font-family)); --kinekt-component-site-width: var(--kinekt-section-site-width, var(--kiw--section-site-width)); --kinekt-component-content-width: var(--kinekt-section-content-width, var(--kiw--section-content-width)); --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--kiw--section-reading-width)); --kinekt-component-inline-space: var(--kinekt-section-inline-space, var(--kiw--section-inline-space)); --kinekt-component-block-space: var(--kinekt-section-block-space, var(--kiw--section-block-space)); --kinekt-component-gap: var(--kinekt-section-gap, var(--kiw--section-gap)); --kinekt-component-radius: var(--kinekt-section-radius, var(--kiw--section-radius)); --kinekt-component-border-width: var(--kinekt-section-border-width, var(--kiw--section-border-width)); --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--kiw--section-media-filter)); --kinekt-component-intro-accent-gap: var(--kinekt-section-intro-accent-gap, var(--kiw--section-intro-accent-gap)); --kinekt-component-intro-description-gap: var(--kinekt-section-intro-description-gap, var(--kiw--section-intro-description-gap)); --kinekt-component-heading-2-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); --kinekt-component-heading-line-height: var(--kinekt-section-heading-line-height, var(--kiw--section-heading-line-height)); --kinekt-component-text-l-size: var(--kinekt-section-text-l-size, var(--kiw--section-text-l-size)); --kinekt-component-text-line-height: var(--kinekt-section-text-line-height, var(--kiw--section-text-line-height)); }
  :where(.compliance-text-allentown[data-kinekt-section][data-kinekt-theme='semi-light']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary-semi-dark))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary))); color-scheme: light; }
  :where(.compliance-text-allentown[data-kinekt-section][data-kinekt-theme='dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--primary-ultra-dark))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--primary-semi-dark))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--white))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-ultra-light))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary-ultra-light))); color-scheme: dark; }
  :where(.compliance-text-allentown[data-kinekt-section][data-kinekt-theme='semi-dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--primary-dark))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--primary-semi-dark))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--white))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-light))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary-light))); color-scheme: dark; }
  :where(.compliance-text-allentown[data-kinekt-section]), :where(.compliance-text-allentown[data-kinekt-section][data-kinekt-theme='light']) { color-scheme: light; }
</style>
<style is:global>
  :where(.compliance-text-allentown) {
    --kiw--compliance-text-allentown-content-max-width: var(--width-l);
    --kiw--compliance-text-allentown-column-gap: var(--section-space-l);
    --kiw--compliance-text-allentown-body-gap: var(--space-xl);
    --kiw--compliance-text-allentown-intro-gap: var(--space-l);
    --kiw--compliance-text-allentown-heading-stack-gap: var(--kinekt-component-intro-accent-gap);
    --kiw--compliance-text-allentown-copy-color: var(--kinekt-component-muted);
    --kiw--compliance-text-allentown-copy-font-size: var(--kiw--section-text-l-size);
    --kiw--compliance-text-allentown-checklist-gap: var(--space-s);
    --kiw--compliance-text-allentown-media-size: var(--desktop-width-xs);
    --kiw--compliance-text-allentown-media-ratio: 1 / 1;
    --kiw--compliance-text-allentown-media-fit: contain;
    box-sizing: border-box;
    padding-block: var(--kinekt-component-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--kinekt-component-font);
    font-size: var(--kiw--section-text-m-size);
    font-weight: var(--kiw--section-text-font-weight);
    line-height: var(--kiw--section-text-line-height);
    letter-spacing: var(--kiw--section-text-letter-spacing);
  }
  :where(.compliance-text-allentown) *, :where(.compliance-text-allentown) *::before, :where(.compliance-text-allentown) *::after { box-sizing: border-box; }
  :where(.compliance-text-allentown) [hidden] { display: none !important; }
  :where(.compliance-text-allentown) :is(p, ul) { margin-block: 0; }

  .compliance-text-allentown > .compliance-text-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .compliance-text-allentown .compliance-text-allentown__content { display: grid; gap: var(--kiw--compliance-text-allentown-body-gap); min-width: 0; }
  .compliance-text-allentown .section-intro { display: grid; justify-items: start; gap: var(--kiw--compliance-text-allentown-intro-gap); }
  .compliance-text-allentown .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .compliance-text-allentown .section-intro__heading-group { display: grid; gap: var(--kiw--compliance-text-allentown-heading-stack-gap); }
  .compliance-text-allentown .section-intro__heading { max-width: none; }
  .compliance-text-allentown :is(.section-intro__description, .compliance-text-allentown__closing) { max-width: none; color: var(--kiw--compliance-text-allentown-copy-color); font-size: var(--kiw--compliance-text-allentown-copy-font-size); line-height: var(--kinekt-component-text-line-height); }
  .compliance-text-allentown .compliance-text-allentown__closing > * { margin-block: 0; }
  .compliance-text-allentown .compliance-text-allentown__closing > * + * { margin-block-start: var(--space-s); }
  /* Rows are the shared checklist-item renderer; the section sets the list gap and passes its copy colour and size through the renderer's hooks. */
  .compliance-text-allentown .compliance-text-allentown__checklist { --kiw--checklist-item-allentown-text-color: var(--kiw--compliance-text-allentown-copy-color); --kiw--checklist-item-allentown-font-size: var(--kiw--compliance-text-allentown-copy-font-size); display: grid; gap: var(--kiw--compliance-text-allentown-checklist-gap); margin: 0; padding: 0; list-style: none; }
  .compliance-text-allentown .compliance-text-allentown__media { display: block; inline-size: var(--kiw--compliance-text-allentown-media-size); max-inline-size: 100%; }
  .compliance-text-allentown .compliance-text-allentown__image { display: block; inline-size: 100%; block-size: auto; aspect-ratio: var(--kiw--compliance-text-allentown-media-ratio); object-fit: var(--kiw--compliance-text-allentown-media-fit); border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  @media (min-width: 50rem) {
    .compliance-text-allentown { --kiw--section-content-width: var(--kiw--compliance-text-allentown-content-width, var(--width-xxl)); }
    .compliance-text-allentown > .compliance-text-allentown__container { grid-template-columns: minmax(0, var(--kiw--compliance-text-allentown-content-max-width)) auto; justify-content: space-between; align-items: start; column-gap: var(--kiw--compliance-text-allentown-column-gap); }
  }
</style>
<style is:global>
  .compliance-text-allentown[data-kinekt-section] {
    --kinekt-section-content-width: var(--desktop-content-width);
    --kinekt-component-content-width: var(--kinekt-section-content-width);
    &[data-kinekt-content-width='80'] { --kinekt-section-content-width: calc(var(--desktop-content-width) * .8); }
    &[data-kinekt-content-width='70'] { --kinekt-section-content-width: calc(var(--desktop-content-width) * .7); }
  }
</style>
