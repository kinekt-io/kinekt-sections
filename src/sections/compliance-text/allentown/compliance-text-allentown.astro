---
import { normalizeSectionContentWidth } from '../../../shared/section-width'
import '../../../styles/wireframe-tokens.css'
import ChecklistItem from '../../../components/checklist-item/allentown/checklist-item-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
interface ComplianceTextChecklistItem { text: string }
interface Props {
  contentWidth?: import('../../../shared/section-width.js').SectionContentWidth
  theme?: Theme
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro: SectionIntroContent
  checklistItems: ComplianceTextChecklistItem[]
  closingText: string | RichText
  certImage?: Media | null
  mediaLoading?: 'eager' | 'lazy'
}

const { theme = 'light', id, headingLevel = 'h2', intro, checklistItems = [], closingText, certImage, mediaLoading = 'lazy' } = Astro.props as Props
const items = checklistItems.filter((item) => item?.text)
---
<section class="compliance-text-allentown" id={id} data-kinekt-section data-kinekt-content-width={normalizeSectionContentWidth(Astro.props.contentWidth)} data-kinekt-theme={theme}>
  <div class="compliance-text-allentown__container">
    <div class="compliance-text-allentown__content">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      {items.length > 0 && (
        <ul class="compliance-text-allentown__checklist">
          {items.map((item) => <ChecklistItem item={item} class="compliance-text-allentown__checklist-item" />)}
        </ul>
      )}
      {typeof closingText === 'string' && closingText && <p class="compliance-text-allentown__closing">{closingText}</p>}
      {typeof closingText === 'object' && closingText?.html && <div class="compliance-text-allentown__closing" set:html={closingText.html} />}
    </div>
    {certImage?.url && <KinektMedia media={certImage} class="compliance-text-allentown__media" imageClass="compliance-text-allentown__image" loading={mediaLoading} />}
  </div>
</section>
<style is:global>
  .compliance-text-allentown {
    --kiw--section-site-width: var(--kiw--compliance-text-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--compliance-text-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--compliance-text-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--compliance-text-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--compliance-text-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--compliance-text-allentown-gap, var(--section-space-l));
    --kiw--section-radius: var(--kiw--compliance-text-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--compliance-text-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--compliance-text-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--compliance-text-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--compliance-text-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--compliance-text-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--compliance-text-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--compliance-text-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--compliance-text-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--compliance-text-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--compliance-text-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--compliance-text-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--compliance-text-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--compliance-text-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--compliance-text-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--compliance-text-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--compliance-text-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--compliance-text-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--compliance-text-allentown-text-letter-spacing, var(--text-letter-spacing));
