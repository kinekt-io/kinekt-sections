---
import ComplianceTextAllentown from './compliance-text-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ REACH compliance',
    heading: 'Battery packs that meet EU REACH requirements',
    description: 'Every pack we build is assessed against the REACH regulation. We track substances of very high concern across our supply chain, so your product documentation stays complete and ready for audit.',
  },
  checklistItems: [
    { text: 'Supplier declarations collected for every cell and component' },
    { text: 'Substances of very high concern screened against the latest candidate list' },
    { text: 'Compliance documentation delivered with each production batch' },
  ],
  closingText: 'Regulations change, and the candidate list grows every year. Our compliance team monitors each update and reviews affected products, so you hear about any impact on your programme before it reaches your customers.',
  certImage: {
    url: placeholder('placeholder-200x200.svg'),
    alt: 'REACH compliance certification mark',
    width: 200,
    height: 200,
  },
}
---
<ComplianceTextAllentown {...content} />
