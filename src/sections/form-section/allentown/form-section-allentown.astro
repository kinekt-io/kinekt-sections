---
import '../../../styles/wireframe-tokens.css'
import ContactIcon from '../../../primitives/contact-icon/contact-icon.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type ImagePosition = 'left' | 'right'
interface ContactMethod {
  icon?: 'whatsapp' | 'phone' | 'email'
  label: string
  href: string
}
interface Props {
  id?: string
  theme?: Theme
  intro: SectionIntroContent
  image?: Media
  imagePosition?: ImagePosition
  form: string
  contactHeading?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  contactMethods?: ContactMethod[]
}

const { id, theme = 'semi-dark', intro, image, imagePosition = 'left', contactHeading, contactMethods = [], headingLevel = 'h2' } = Astro.props as Props
const methods = contactMethods.filter((method) => method.label && method.href)
---
<section class="form-section-allentown" id={id} data-kinekt-section data-kinekt-theme={theme} data-image-position={imagePosition} data-form-variation="compact">
  <div class="form-section-allentown__container">
    <div class="form-section-allentown__content">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
      <div class="form-section-allentown__form-embed" data-kinekt-hubspot-form-placeholder aria-label="Formulier wordt geladen">
        <div class="form-section-allentown__form-compact">
          <label class="form-section-allentown__email-label" for={`${id ?? 'form-section'}-email`}>Your email address</label>
          <div class="form-section-allentown__email-row">
            <input id={`${id ?? 'form-section'}-email`} name="email" type="email" autocomplete="email" inputmode="email" placeholder="Email address" />
            <button type="button">Book a call <span aria-hidden="true">›</span></button>
          </div>
        </div>
        <div class="form-section-allentown__form-expanded">
          <div class="form-section-allentown__form-row">
            <label>First name <input name="given-name" autocomplete="given-name" placeholder="Morgan" /></label>
            <label>Last name <input name="family-name" autocomplete="family-name" placeholder="Reed" /></label>
          </div>
          <label>Email address <input name="email" type="email" autocomplete="email" placeholder="morgan.reed@example.com" /></label>
          <label>Phone number <input name="tel" type="tel" autocomplete="tel" placeholder="+1 212 555 0147" /></label>
          <div class="form-section-allentown__form-row">
            <label>Company name <input name="organization" autocomplete="organization" placeholder="Company X" /></label>
            <label>Country <select name="country"><option>Select country</option></select></label>
          </div>
          <button type="button">Schedule your call <span aria-hidden="true">›</span></button>
        </div>
      </div>
      {methods.length > 0 && <address class="form-section-allentown__contacts">
        {contactHeading && <p class="form-section-allentown__contacts-heading">{contactHeading}</p>}
        <ul>
          {methods.map((method) => <li><a href={method.href}>{method.icon && <ContactIcon name={method.icon} />}<span>{method.label}</span></a></li>)}
        </ul>
      </address>}
    </div>
    {image && <picture class="form-section-allentown__media">
      {image.sources?.length && <source type="image/avif" srcset={image.sources.map((source) => `${source.url} ${source.width}w`).join(', ')} sizes={image.sizes} />}
      <img src={image.url} alt={image.alt} width={image.width} height={image.height} data-fallback-url={image.fallbackUrl} loading="lazy" decoding="async" />
    </picture>}
  </div>
</section>
<style is:global>
