  :where(.form-section-allentown) :is(p, li, dd, td, th, label, input, textarea, button) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.form-section-allentown) :is(p, ul, ol, dl, table, form) { margin-block: 0; } :where(.form-section-allentown) .section-intro__accent { margin-block: 0 var(--kinekt-component-intro-accent-gap); color: var(--kinekt-component-accent); font-family: var(--kinekt-component-mono); font-size: var(--kinekt-component-text-xs-size); font-weight: var(--kiw--section-heading-font-weight); letter-spacing: var(--kiw--section-text-letter-spacing); text-transform: uppercase; } :where(.form-section-allentown) .section-intro__heading { margin: 0; } :where(.form-section-allentown) .section-intro__description { max-width: var(--kinekt-component-reading-width); margin-block: var(--kinekt-component-intro-description-gap) 0; color: var(--kinekt-component-muted); font-size: var(--kinekt-component-text-l-size); }
  :where(.form-section-allentown) form[class*='__'] { display: grid; gap: var(--kinekt-component-gap); } :where(.form-section-allentown) form label { display: grid; gap: var(--space-xxs); font-weight: var(--heading-font-weight); } :where(.form-section-allentown) :is(input, textarea) { width: 100%; padding: var(--space-s); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); color: var(--kinekt-component-ink); background: var(--kinekt-component-canvas); } :where(.form-section-allentown) textarea { min-height: var(--section-space-s); resize: vertical; } :where(.form-section-allentown) button { display: inline-flex; align-items: center; justify-content: center; gap: .8ch; width: fit-content; min-height: var(--kiw--section-button-height); padding: var(--kiw--section-button-padding-block) var(--kiw--section-button-padding-inline); border: var(--kinekt-component-border-width) solid var(--kinekt-component-action); border-radius: calc(var(--buttons-has-radius) * var(--kiw--section-button-radius)); color: var(--kinekt-component-action-text); background: var(--kinekt-component-action); font-weight: var(--kiw--section-heading-font-weight); cursor: pointer; }
  :where(.form-section-allentown) :is([class$='__media'], [class*='__media-'], [class*='__image']), :where(.form-section-allentown) picture { display: block; max-width: 100%; } :where(.form-section-allentown) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
</style>
