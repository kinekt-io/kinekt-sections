{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.2-beta.25",
  "id": "sections/form-section/allentown",
  "slug": "form-section-allentown",
  "title": "Form Section Allentown",
  "description": "A reusable split conversion section with optional media, a HubSpot embed code and direct contact methods.",
  "category": "sections",
  "tags": ["conversion", "form", "prerelease"],
  "role": "form-section",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411427&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411427"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "theme": { "kind": "select", "required": true, "localized": true, "options": ["light", "semi-light", "semi-dark", "dark"], "description": "CMS-selected presentation setting passed to the renderer." },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "image": { "kind": "media", "required": false, "localized": true },
    "imagePosition": { "kind": "select", "required": true, "localized": true, "options": ["left", "right"], "description": "Desktop media position. Mobile always presents content before media." },
    "form": { "kind": "formEmbed", "required": true, "localized": true, "description": "Paste the complete HubSpot embed code. The frontend renders it in place." },
    "contactHeading": { "kind": "text", "required": false, "localized": true },
    "contactMethods": { "kind": "componentList", "componentId": "components/contact-method/allentown", "required": false, "localized": true, "minItems": 1 }
  },
  "runtimeProps": {
    "decoration": { "kind": "tulipRegionPatternSharp", "source": "renderer" },
    "formEmbed": { "kind": "hubSpot", "source": "integration" }
  }
}
