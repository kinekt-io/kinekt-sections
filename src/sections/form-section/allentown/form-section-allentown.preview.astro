---
import FormSectionAllentown from './form-section-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const intro = {
  accentHeading: 'Work with our experts',
  heading: 'Not sure yet? Discuss with one of our experts.',
  description: 'Every operation has its own constraints. We help map the technical priorities and define a practical next step together.',
}
const image = {
  url: `${catalogueBase}placeholders/pexels-industrial-building.webp`,
  alt: 'A team member in an industrial workspace',
  width: 1200,
  height: 1200,
}
---
<FormSectionAllentown
  theme="semi-dark"
  intro={intro}
  image={image}
  imagePosition="left"
  form={{ name: 'Book a call' }}
  contactHeading="Or get in touch with us directly:"
  contactMethods={[
    { icon: 'email', label: 'advice@example.com', href: 'mailto:advice@example.com' },
    { icon: 'phone', label: '+1 212 555 0147', href: 'tel:+12125550147' },
  ]}
/>
