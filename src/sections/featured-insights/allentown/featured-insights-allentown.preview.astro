---
import FeaturedInsightsAllentown from './featured-insights-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const intro = { accentHeading: 'Research updates', heading: 'Notes from the engineering floor' }
const insightSources = [
  {
    title: 'How modular packs shorten integration cycles',
    excerpt: 'A practical view of the mechanical, electrical and service decisions that keep deployment moving.',
    href: '#',
    publishedAt: '2026-10-15',
    kind: 'Article' as const,
    featured: true,
    image: { url: `${catalogueBase}placeholders/hero-trinity-street.webp`, alt: 'A city street at dusk', width: 1200, height: 900 },
  },
  { title: 'Planning the verification route', excerpt: 'How teams turn open technical questions into a clear evidence plan.', href: '#', publishedAt: '2026-10-14', kind: 'Article' as const },
  { title: 'Designing for service access', excerpt: 'Small packaging choices that reduce maintenance time in the field.', href: '#', publishedAt: '2026-10-13', kind: 'Article' as const },
  { title: 'A programme built around delivery evidence', excerpt: 'What a controlled handover looks like from prototype to production.', href: '#', publishedAt: '2026-10-12', kind: 'Case' as const },
]
---
<FeaturedInsightsAllentown
  theme="light"
  intro={intro}
  insightSources={insightSources}
  cta={{ cta: { label: 'Browse field notes', href: '#' } }}
/>
