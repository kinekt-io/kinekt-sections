---
import '../../../styles/wireframe.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
interface Cta { label: string; href: string }
interface Insight {
  title: string
  excerpt?: string
  href: string
  kind?: string
  featured?: boolean
  image?: Media
}
interface Props {
  id?: string
  theme?: Theme
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro: SectionIntroContent
  insightSources: Insight[]
  cta?: { cta: Cta } | Cta
}

const { id, theme = 'light', headingLevel = 'h2', intro, insightSources = [], cta } = Astro.props as Props
const action = cta && ('cta' in cta ? cta.cta : cta)
const featured = insightSources.find((insight) => insight.featured) ?? insightSources[0]
const recent = insightSources.filter((insight) => insight !== featured).slice(0, 3)
const kindLabel = (kind?: string): string | undefined => kind?.replace(/[-_]/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase())
---
<section class="featured-insights-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="featured-insights-allentown__container">
    <header class="featured-insights-allentown__intro">
      <div class="featured-insights-allentown__intro-content"><SectionIntro intro={intro} headingLevel={headingLevel} /></div>
      {action && <div class="featured-insights-allentown__cta"><Button {...action} /></div>}
    </header>
    <div class="featured-insights-allentown__content">
      {featured && <article class="featured-insights-allentown__featured">
        {featured.image && <picture class="featured-insights-allentown__media">
          {featured.image.sources?.length && <source type="image/avif" srcset={featured.image.sources.map((source) => `${source.url} ${source.width}w`).join(', ')} sizes={featured.image.sizes} />}
          <img src={featured.image.url} alt={featured.image.alt} width={featured.image.width} height={featured.image.height} data-fallback-url={featured.image.fallbackUrl} loading="lazy" decoding="async" />
        </picture>}
        <header class="featured-insights-allentown__featured-header"><p class="featured-insights-allentown__eyebrow">Featured</p><span aria-hidden="true"></span></header>
        {kindLabel(featured.kind) && <p class="featured-insights-allentown__kind">{kindLabel(featured.kind)}</p>}
        <h3>{featured.title}</h3>
        {featured.excerpt && <p>{featured.excerpt}</p>}
        <Button class="featured-insights-allentown__link" href={featured.href} label="Read more" style="clear"><span aria-hidden="true">›</span></Button>
      </article>}
      <div class="featured-insights-allentown__recent">
        <header class="featured-insights-allentown__recent-header"><p>Most recent</p><span aria-hidden="true"></span></header>
        <ol>{recent.map((insight) => <li><article>
          {kindLabel(insight.kind) && <p class="featured-insights-allentown__kind">{kindLabel(insight.kind)}</p>}
          <h3>{insight.title}</h3>
          {insight.excerpt && <p>{insight.excerpt}</p>}
          <Button class="featured-insights-allentown__link" href={insight.href} label="Read more" style="clear"><span aria-hidden="true">›</span></Button>
        </article></li>)}</ol>
      </div>
    </div>
  </div>
</section>
<style>
  .featured-insights-allentown {
    --kinekt-section-content-width: 96rem;
    & > .featured-insights-allentown__container { display: grid; gap: var(--kinekt-wireframe-section-space-l); }
    & .featured-insights-allentown__intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--kinekt-wireframe-space-m); width: 100%; max-width: none; }
    & .featured-insights-allentown__intro :global(.section-intro__description) { max-width: 42rem; }
    & .featured-insights-allentown__content { display: grid; width: 100%; max-width: none; gap: var(--kinekt-wireframe-section-space-l); }
    & :is(.featured-insights-allentown__featured, .featured-insights-allentown__recent article) { display: grid; align-content: start; gap: var(--kinekt-wireframe-space-s); }
    & :is(.featured-insights-allentown__featured, .featured-insights-allentown__recent article) :is(h3, p) { margin: 0; }
    & .featured-insights-allentown__media img { aspect-ratio: 4 / 3; object-fit: cover; }
    & .featured-insights-allentown__eyebrow, & .featured-insights-allentown__recent-header p { color: var(--kinekt-component-action); font: 700 .75rem/1.2 var(--kinekt-component-mono); letter-spacing: .08em; text-transform: uppercase; }
    & .featured-insights-allentown__kind { color: var(--kinekt-component-action); font-size: .75rem; font-weight: 700; }
    & :is(.featured-insights-allentown__featured, .featured-insights-allentown__recent) > :is(p, h3), & .featured-insights-allentown__recent article > :is(p, h3) { max-width: 34rem; }
    & .featured-insights-allentown__link { display: inline-flex; align-items: center; gap: .5rem; width: max-content; color: var(--kinekt-component-ink); font-size: .875rem; font-weight: 700; text-decoration: none; }
    & .featured-insights-allentown__link:hover { color: var(--kinekt-component-action); }
    & .featured-insights-allentown__recent { display: none; }
    & .featured-insights-allentown__featured-header, & .featured-insights-allentown__recent-header { display: flex; align-items: center; gap: .75rem; }
    & .featured-insights-allentown__featured-header p, & .featured-insights-allentown__recent-header p { flex: 0 0 auto; margin: 0; }
    & .featured-insights-allentown__featured-header span, & .featured-insights-allentown__recent-header span { flex: 1; height: var(--kinekt-component-border-width); background: var(--kinekt-component-line); }
    & .featured-insights-allentown__recent ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
    & .featured-insights-allentown__recent li > article { min-height: 0; padding: 0; border: 0; background: transparent; box-shadow: none; }
    & .featured-insights-allentown__recent li > article h3 { font-size: 1.125rem; line-height: 1.2; }
    & .featured-insights-allentown__recent li > article > p:not(.featured-insights-allentown__kind) { color: var(--kinekt-component-muted); font-size: .875rem; }
    & .featured-insights-allentown__recent li { padding-block: var(--kinekt-wireframe-space-l); border-bottom: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
    & .featured-insights-allentown__recent li:first-child { padding-top: 0; }
    & .featured-insights-allentown__recent li:last-child { border-bottom: 0; }

    @media (min-width: 50rem) {
      & .featured-insights-allentown__intro { flex-direction: row; align-items: end; justify-content: space-between; column-gap: var(--kinekt-wireframe-section-space-xl); }
      & .featured-insights-allentown__content { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); column-gap: var(--kinekt-wireframe-section-space-l); }
      & .featured-insights-allentown__recent { display: grid; align-content: start; gap: var(--kinekt-wireframe-space-l); }
    }
  }
</style>
