{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/featured-insights/allentown",
  "slug": "featured-insights-allentown",
  "title": "Featured Insights Allentown",
  "description": "A hybrid insights section: one newest featured item and three newest recent items from selected platform-admin Insight Sources.",
  "category": "sections",
  "tags": ["insights", "featured", "prerelease"],
  "role": "featured-insights",
  "variation": "allentown",
  "status": "prerelease",
  "figma": { "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411490&m=dev", "nodeId": "5240:411490" },
  "fields": {
    "theme": { "kind": "select", "required": true, "localized": true, "options": ["light", "semi-light", "semi-dark", "dark"], "description": "CMS-selected presentation setting passed to the renderer." },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "insightSources": { "kind": "contentReferenceList", "required": true, "localized": true, "minItems": 1, "description": "Select published content. Its title, route, optional description and optional Article type are rendered automatically." },
    "cta": { "kind": "component", "componentId": "controls/button/allentown", "required": false, "localized": true }
  },
  "runtimeProps": {
    "featuredSelection": { "kind": "selectedFeaturedThenListOrder", "source": "renderer" },
    "recentSelection": { "kind": "selectedListOrder", "source": "renderer" },
    "featuredMedia": { "kind": "required", "source": "renderer" },
    "recentMedia": { "kind": "hidden", "source": "renderer" },
    "kindIcon": { "kind": "articleTypeIcon", "source": "renderer", "description": "Optional FA7 Sharp Solid icon name resolved centrally from the referenced article type." }
  }
}
