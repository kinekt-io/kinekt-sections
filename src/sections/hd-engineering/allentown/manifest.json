{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.1",
  "id": "sections/hd-engineering/allentown",
  "slug": "hd-engineering-allentown",
  "title": "HD Engineering Allentown",
  "description": "A reusable interactive high-density engineering section.",
  "category": "sections",
  "tags": ["engineering", "product", "beta"],
  "role": "hd-engineering",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-412556&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:412556"
  },
  "fields": {
    "contentWidth": {
      "kind": "select",
      "required": false,
      "localized": true,
      "defaultValue": "standard",
      "options": ["standard", "80", "70", "50"],
      "description": "Maximum content width: Standard (100%), 80%, 70%, or 50%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "engineeringTopics": {
      "kind": "componentList",
      "componentId": "components/hd-engineering-topic/allentown",
      "minItems": 1,
      "required": true,
      "localized": true
    },
    "moreInformationLabel": {
      "kind": "text",
      "required": false,
      "localized": true,
      "defaultValue": "More information",
      "description": "Text for the control that reveals an engineering topic’s details."
    }
  },
  "runtimeProps": {
    "activeEngineeringTopic": {
      "kind": "firstListItem",
      "source": "renderer"
    },
    "engineeringInteraction": {
      "kind": "handImplementedTopicHotspotsAndTransitions",
      "source": "renderer"
    }
  }
}
