---
import ProductOptionsAllentown from './product-options-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = (name: string, alt: string) => ({
  url: `${catalogueBase}placeholders/${name}`,
  alt,
  width: 144,
  height: 144,
})

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: 'Product options',
    heading: 'Choose the configuration that fits your application.',
    description: 'Compare the core options, then share your operating context to start a focused technical conversation.',
  },
  ctas: {
    primary: { label: 'Discuss a project', href: '#' },
    secondary: { label: 'View specifications', href: '#' },
  },
  options: [
    { image: placeholder('case-study-observatory.webp', 'Abstract technical placeholder'), title: 'Energy capacity', description: 'Select a capacity range that supports the required operating window.', benefits: ['Defined usable energy', 'Clear duty-cycle fit', 'Documented assumptions'] },
    { image: placeholder('case-study-towers.webp', 'Abstract technical placeholder'), title: 'Power delivery', description: 'Match peak and continuous output to the equipment and load profile.', benefits: ['Validated power range', 'Thermal considerations', 'Integration-ready data'] },
    { image: placeholder('case-study-buses.webp', 'Abstract technical placeholder'), title: 'Mechanical format', description: 'Choose a proven enclosure approach for the available installation space.', benefits: ['Practical packaging', 'Serviceable layout', 'Environmental protection'] },
    { image: placeholder('case-study-motorcycle.webp', 'Abstract technical placeholder'), title: 'Control interface', description: 'Connect the system to the controls and monitoring already in use.', benefits: ['Documented signals', 'Clear system status', 'Supported integration'] },
    { image: placeholder('hero-trinity-street.webp', 'Abstract technical placeholder'), title: 'Operating environment', description: 'Adapt the specification for temperature, vibration, and duty conditions.', benefits: ['Defined limits', 'Relevant validation', 'Traceable evidence'] },
    { image: placeholder('pexels-industrial-building.webp', 'Abstract technical placeholder'), title: 'Project support', description: 'Plan the reviews and documentation needed to make the next decision.', benefits: ['Focused technical review', 'Clear deliverables', 'Named next steps'] },
  ],
  form: { name: 'Project enquiry' },
}
---
<ProductOptionsAllentown {...content}>
  <form slot="form" class="product-options-allentown__form" action="#" method="post">
    <fieldset>
      <legend>Project details</legend>
      <label>
        Name
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        Work email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Project summary
        <textarea name="summary" rows="4"></textarea>
      </label>
    </fieldset>
    <button type="submit">Send enquiry</button>
  </form>
</ProductOptionsAllentown>
