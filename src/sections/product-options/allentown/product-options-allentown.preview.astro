---
import { ctaIconPaths } from '../../../shared/cta-icons.js'
import ProductOptionsAllentown from './product-options-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = (alt: string) => ({
  url: catalogueBase + 'placeholders/placeholder-200x200.svg',
  alt,
  width: 200,
  height: 200,
})
const plusIcon = ctaIconPaths.plus
const sendIcon = ctaIconPaths['paper-plane']

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ Configuration options',
    heading: 'Choose the right foundation for your custom battery pack',
    description: 'Every custom battery starts with the right combination of cell technology, pack architecture and system requirements. Tulip helps determine the configuration that best balances energy density, power, weight, dimensions and mission performance.',
  },
  ctas: {
    primary: { label: 'Get in touch to order', href: '#', icon: 'arrow-right' as const },
    secondary: { label: 'Download specs', href: '#', icon: 'download' as const },
  },
  options: [
    { image: placeholder('Power output placeholder'), title: 'Power output', description: 'Match peak and continuous discharge to the motors, payload and flight profile, with thermal headroom for demanding missions.', benefits: ['High continuous discharge rates', 'Validated peak power bursts', 'Thermal behaviour documented'] },
    { image: placeholder('Form factor placeholder'), title: 'Form factor', description: 'Shape the pack around the available airframe space, mounting points and centre of gravity instead of the other way round.', benefits: ['Custom dimensions and layouts', 'Integrated mounting options', 'Serviceable construction'] },
    { image: placeholder('Cycle life placeholder'), title: 'Cycle life', description: 'Choose cell chemistry and operating windows that keep capacity stable across the number of missions you plan to fly.', benefits: ['Chemistry matched to duty cycle', 'Defined end-of-life criteria', 'Lifetime data per configuration'] },
    { image: placeholder('Materials placeholder'), title: 'Materials', description: 'Select enclosure, insulation and interconnect materials for the environment, from salt spray to extreme temperatures.', benefits: ['Lightweight enclosure options', 'Environmental sealing', 'Traceable material sourcing'] },
    { image: placeholder('Energy density placeholder'), title: 'Energy density', description: 'Balance gravimetric and volumetric energy to extend endurance without compromising safety margins or power delivery.', benefits: ['High-density cell options', 'Optimised pack architecture', 'Safety margins built in'] },
    { image: placeholder('Weight placeholder'), title: 'Weight', description: 'Reduce mass across cells, structure and electronics so every gram goes to payload, range or flight time.', benefits: ['Weight-optimised structures', 'Integrated electronics', 'Mass budget per component'] },
  ],
  form: '<script src="https://js.hsforms.net/forms/embed/v2.js"></script>',
}
---
<ProductOptionsAllentown {...content}>
  <form slot="form" action="#" method="post">
    <div class="form-embed-allentown__fields">
      <fieldset>
        <legend>Choose your primary performance priority</legend>
        <div class="form-embed-allentown__options">
          <label><input type="radio" name="priority" value="endurance" checked /> Endurance</label>
          <label><input type="radio" name="priority" value="power" /> Power</label>
          <label><input type="radio" name="priority" value="weight" /> Weight</label>
          <label><input type="radio" name="priority" value="lifetime" /> Lifetime</label>
        </div>
      </fieldset>
      <div class="form-embed-allentown__group">
        <div class="form-embed-allentown__row">
          <label>Your name <input name="name" autocomplete="name" placeholder="Name" required /></label>
          <label>Your email address <input name="email" type="email" autocomplete="email" placeholder="Email address" required /></label>
        </div>
        <details>
          <summary>Add phone number <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={plusIcon.viewBox} fill="none"><path d={plusIcon.path} stroke="currentColor" stroke-width="2" /></svg></summary>
          <label>Your phone number <input name="phone" type="tel" autocomplete="tel" placeholder="Phone number" /></label>
        </details>
      </div>
      <fieldset>
        <legend>How would you like to continue?</legend>
        <div class="form-embed-allentown__options">
          <label><input type="radio" name="follow-up" value="expert" /> I want to get in touch with an expert</label>
          <label><input type="radio" name="follow-up" value="specs" checked /> I want personalised specs</label>
        </div>
      </fieldset>
    </div>
    <button type="submit">Send request <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={sendIcon.viewBox} fill="none"><path d={sendIcon.path} stroke="currentColor" stroke-width="2" /></svg></button>
  </form>
</ProductOptionsAllentown>
