{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/product-options/allentown",
  "slug": "product-options-allentown",
  "title": "Product Options Allentown",
  "description": "A reusable product-options grid with an optional region-filtered configurator form.",
  "category": "sections",
  "tags": ["product", "catalogue", "beta"],
  "role": "product-options",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411550&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411550"
  },
  "fields": {
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true,
      "fields": {
        "accentHeading": { "kind": "text", "required": false, "localized": true },
        "heading": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": false, "localized": true }
      }
    },
    "ctas": {
      "kind": "ctaGroup",
      "required": false,
      "localized": true,
      "description": "Optional primary and secondary actions below the introduction."
    },
    "options": {
      "kind": "componentList",
      "componentId": "components/option-card/allentown",
      "required": true,
      "localized": true,
      "minItems": 1,
      "fields": {
        "image": { "kind": "media", "required": true, "localized": true },
        "title": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": true, "localized": true },
        "benefits": { "kind": "featureItems", "required": false, "localized": true }
      }
    },
    "form": {
      "kind": "formEmbed",
      "required": false,
      "localized": true,
      "description": "HubSpot embed code. The catalogue renders a safe placeholder through components/form-embed/allentown; the integration owns execution of the embed."
    }
  }
}
