<style is:global>
/*
 * Product Options Allentown: Figma "Section - Product and cell options"
 * (5240:411550, light). Intro + CTAs, divider, option cards (Figma "Battery
 * Output Card", rendered by the shared components/output-card/allentown), divider, and the
 * form block: copy column + the HubSpot form embed, rendered by the shared
 * components/form-embed/allentown (which owns all field styling).
 */
  :where(.product-options-allentown) {
    --kiw--product-options-block-space: var(--section-space-xl);
    --kiw--product-options-container-width: var(--content-width);
    --kiw--product-options-major-gap: var(--section-space-l);
    --kiw--product-options-intro-width: var(--content-width);
    --kiw--product-options-intro-gap: var(--section-space-xs);
    --kiw--product-options-intro-group-gap: var(--space-m);
    --kiw--product-options-heading-stack-gap: var(--space-xxs);
    --kiw--product-options-actions-gap: var(--space-l);
    --kiw--product-options-options-columns: 1;
    --kiw--product-options-options-gap: var(--section-space-m);
    --kiw--product-options-form-gap: var(--space-xl);
    --kiw--product-options-form-intro-width: var(--width-m);
    --kiw--product-options-form-intro-gap: var(--space-xs);
    --kiw--product-options-form-heading-size: var(--h3);
    /* Off-role Figma colour (light frame). */
    --kiw--product-options-secondary-text: var(--kinekt-component-subtle);
    --kinekt-section-block-space: var(--kiw--product-options-block-space);
    --kinekt-section-content-width: var(--kiw--product-options-container-width);
    --kinekt-section-gap: var(--kiw--product-options-major-gap);
  }

  .product-options-allentown .product-options-allentown__container { gap: var(--kiw--product-options-major-gap); }

  .product-options-allentown .product-options-allentown__intro { display: grid; justify-items: start; gap: var(--kiw--product-options-intro-gap); max-width: var(--kiw--product-options-intro-width); }
  .product-options-allentown .section-intro { display: grid; justify-items: start; gap: var(--kiw--product-options-intro-group-gap); }
  .product-options-allentown .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { max-width: none; margin: 0; }
  .product-options-allentown .section-intro__heading-group { display: grid; gap: var(--kiw--product-options-heading-stack-gap); }
  .product-options-allentown .product-options-allentown__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--kiw--product-options-actions-gap); margin: 0; }

  .product-options-allentown .product-options-allentown__divider { width: 100%; height: 0; margin: 0; border: 0; border-block-start: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }

