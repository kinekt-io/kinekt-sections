---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import FormEmbed from '../../../components/form-embed/allentown/form-embed-allentown.astro'
import OutputCard from '../../../components/output-card/allentown/output-card-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { ProductOptionsAllentownContent } from './product-options-allentown.types.js'

interface Props extends ProductOptionsAllentownContent {
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { theme, intro, ctas, options, form, headingLevel = 'h2' } = Astro.props as Props

const actions = ctaGroupActions(ctas)

type ChildHeading = 'h2' | 'h3' | 'h4'
const ChildHeading = `h${Number(headingLevel.slice(1)) + 1}` as ChildHeading
---
<section class="product-options-allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="product-options-allentown__container">
    <header class="product-options-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      {actions.length > 0 && (
        <nav class="product-options-allentown__actions" aria-label="Section actions">
          {actions.map((action, index) => {
            const icon = isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
            return <Button class="product-options-allentown__action" href={action.href} label={action.label} style={action.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
          })}
        </nav>
      )}
    </header>

    <hr class="product-options-allentown__divider" />

    <ul class="product-options-allentown__options" aria-label="Product options">
      {options.map((option) => (
        <li class="product-options-allentown__option">
          <OutputCard card={option} headingLevel={ChildHeading} />
        </li>
      ))}
    </ul>

    {form && (
      <>
        <hr class="product-options-allentown__divider" />
        <section class="product-options-allentown__form-section" aria-labelledby="product-options-form-heading">
          <div class="product-options-allentown__form-intro">
            <ChildHeading class="product-options-allentown__form-heading" id="product-options-form-heading">Discuss your requirements</ChildHeading>
            <p class="product-options-allentown__form-description">Share the operating context and priorities for your project. The selected form manages the questions, validation, and submission.</p>
          </div>
          <FormEmbed class="product-options-allentown__form-embed" form={form}>
            <slot name="form" />
          </FormEmbed>
        </section>
      </>
    )}
  </div>
</section>
<style is:global>
  .product-options-allentown {
    --kiw--section-site-width: var(--kiw--product-options-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--product-options-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--product-options-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--product-options-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--product-options-allentown-block-space, var(--section-space-l));
