    --kiw--section-header-to-content-gap: var(--kiw--product-options-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--product-options-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--product-options-allentown-canvas);
