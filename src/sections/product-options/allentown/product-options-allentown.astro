---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { ProductOptionsAllentownContent } from './product-options-allentown.types.js'

interface Props extends ProductOptionsAllentownContent {
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { theme, intro, ctas, options, form, headingLevel = 'h2' } = Astro.props as Props
---
<section class="product-options-allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="product-options-allentown__container">
    <header class="product-options-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
      {(ctas?.primary || ctas?.secondary) && (
        <nav class="product-options-allentown__actions" aria-label="Section actions">
          {ctas.primary && <Button class="product-options-allentown__action product-options-allentown__action--primary" href={ctas.primary.href} label={ctas.primary.label} />}
          {ctas.secondary && <Button class="product-options-allentown__action product-options-allentown__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="secondary" />}
        </nav>
      )}
    </header>

    <hr class="product-options-allentown__divider" />

    <ul class="product-options-allentown__options" aria-label="Product options">
      {options.map((option) => (
        <li class="product-options-allentown__option">
          <article>
            <KinektMedia class="product-options-allentown__media" imageClass="product-options-allentown__image" media={option.image} />
            <div class="product-options-allentown__option-content">
              <h3 class="product-options-allentown__title">{option.title}</h3>
              <p class="product-options-allentown__description">{option.description}</p>
              {option.benefits?.length ? (
                <ul class="product-options-allentown__benefits">
                  {option.benefits.map((benefit) => <li>{benefit}</li>)}
                </ul>
              ) : null}
            </div>
          </article>
        </li>
      ))}
    </ul>

    {form && (
      <>
        <hr class="product-options-allentown__divider" />
        <section class="product-options-allentown__form-section" aria-labelledby="product-options-form-heading">
          <div class="product-options-allentown__form-intro">
            <h2 id="product-options-form-heading">Discuss your requirements</h2>
            <p>Share the operating context and priorities for your project. The selected form manages the questions, validation, and submission.</p>
          </div>
          <div class="product-options-allentown__form-embed" data-kinekt-form-reference>
            <slot name="form" />
          </div>
        </section>
      </>
    )}
  </div>
</section>
