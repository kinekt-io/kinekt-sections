  .product-options-allentown .product-options-allentown__option { min-width: 0; }

  .product-options-allentown .product-options-allentown__form-section { display: grid; gap: var(--kiw--product-options-form-gap); }
  .product-options-allentown .product-options-allentown__form-intro { display: grid; align-content: start; gap: var(--kiw--product-options-form-intro-gap); }
  .product-options-allentown .product-options-allentown__form-heading { max-width: none; font-size: var(--kiw--product-options-form-heading-size); line-height: 1; }
  .product-options-allentown .product-options-allentown__form-description { color: var(--kiw--product-options-secondary-text); font-size: var(--text-l); }

  @media (min-width: 50rem) {
    .product-options-allentown {
