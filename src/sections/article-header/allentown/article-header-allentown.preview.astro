---
import ArticleHeaderAllentown from './article-header-allentown.astro'

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = `${base}placeholders/placeholder-1600x900.svg`
---
<ArticleHeaderAllentown
  theme="light"
  intro={{ accentHeading: 'Engineering notes', heading: 'How to specify a battery system for sustained flight', description: 'The operating decisions that turn an early battery brief into a credible integration plan.' }}
  readingTime="6 min read"
  heroMedia={{ sourceType: 'image', image: { url: placeholder, alt: 'Battery module on an engineering bench', width: 1600, height: 900 } }}
  mediaLoading="eager"
/>
