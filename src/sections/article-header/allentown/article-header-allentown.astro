---
import '../../../styles/wireframe-tokens.css'
import { faChevronRight } from '@fortawesome/sharp-solid-svg-icons'
import ContentHeroMedia, { type ContentHeroMediaContent } from '../../../components/content-hero-media/allentown/content-hero-media-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { isSafeWebUrl } from '../../../urls.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
/** Route-derived trail (runtimeProps.breadcrumb, source renderer); the last item is the current page. */
type BreadcrumbItem = { label: string; href?: string }
interface Props {
  id?: string
  theme?: Theme
  headingLevel?: 'h1' | 'h2'
  intro: SectionIntroContent
  heroMedia: ContentHeroMediaContent
  readingTime?: string
  mediaLoading?: 'eager' | 'lazy'
  breadcrumb?: BreadcrumbItem[]
  /** Accessible name of the breadcrumb navigation. */
  breadcrumbLabel?: string
  /** Accessible name of the play button on uploaded video. */
  playLabel?: string
}

const { id, theme = 'light', headingLevel = 'h1', intro, heroMedia, readingTime, mediaLoading = 'eager', breadcrumb = [], breadcrumbLabel = 'Breadcrumb', playLabel } = Astro.props as Props
const trail = Array.isArray(breadcrumb) ? breadcrumb.filter((item) => typeof item?.label === 'string' && item.label.length > 0) : []
const [chevronWidth, chevronHeight, , , chevronPath] = faChevronRight.icon
---
<section class="article-header-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="article-header-allentown__container">
    {trail.length > 0 && (
      <nav class="article-header-allentown__breadcrumb" aria-label={breadcrumbLabel}>
        <ol class="article-header-allentown__breadcrumb-list">
          {trail.map((item, index) => {
            const current = index === trail.length - 1
            return (
              <li class="article-header-allentown__breadcrumb-item">
                {index > 0 && <svg class="article-header-allentown__breadcrumb-separator" aria-hidden="true" focusable="false" viewBox={`0 0 ${chevronWidth} ${chevronHeight}`} fill="currentColor"><path d={chevronPath as string} /></svg>}
                {current
                  ? <span class="article-header-allentown__breadcrumb-current" aria-current="page">{item.label}</span>
                  : isSafeWebUrl(item.href) ? <a class="article-header-allentown__breadcrumb-link" href={item.href}>{item.label}</a> : <span class="article-header-allentown__breadcrumb-link">{item.label}</span>}
              </li>
            )
          })}
        </ol>
      </nav>
    )}
    <div class="article-header-allentown__body">
      <header class="article-header-allentown__header">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading">
          {readingTime && <p slot="after-heading" class="article-header-allentown__reading-time">{readingTime}</p>}
        </SectionIntro>
      </header>
      <figure class="article-header-allentown__media">
        <ContentHeroMedia media={heroMedia} title={intro.heading} playLabel={playLabel} loading={mediaLoading} />
      </figure>
    </div>
  </div>
</section>

<style is:global>
  /*
   * Figma "Hero Section - Article" 5639:526185 (Article Template, semi-light + a faint accent gradient, not reproduced):
   * 1440 container; breadcrumb → body 64 (section-m); body 680 + 80 (section-l) + 680, centred: intro
   * (accent text-m, XXS to an H2-sized h1; space-m to the reading time; 41 → section-xs to a text-xl description in the
   * subtle role, paragraphs space-xs apart) beside 5:4 hero media.
   */
  :where(.article-header-allentown) {
    --kiw--article-header-allentown-inline-space: var(--section-gutter);
    --kiw--article-header-allentown-block-space: var(--section-space-l);
    --kiw--article-header-allentown-gap: var(--section-space-m);
    --kiw--article-header-allentown-column-gap: var(--section-space-l);
    --kiw--article-header-allentown-heading-size: var(--h2);
    --kiw--article-header-allentown-reading-time-gap: var(--space-m);
    --kiw--article-header-allentown-description-gap: var(--section-space-xs);
    --kiw--article-header-allentown-description-size: var(--text-xl);
    --kiw--article-header-allentown-media-ratio: 5 / 4;
  }

  .article-header-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark));
    /* Off-role Figma colour for the breadcrumb trail and reading time: primary-semi-light on light frames (the reading time
       uses a stray "color/neutral/semi-dark" #656667 from another library, mapped to the same tone); dark tones inferred. */
    --kiw--article-header-allentown-meta-color: var(--primary-semi-light);
    --kinekt-component-radius: var(--kinekt-section-radius, var(--radius-none));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--media-filter));
    --kinekt-component-reading-width: var(--kinekt-section-reading-width, none);
    --kinekt-component-intro-description-gap: var(--kiw--article-header-allentown-description-gap);
    --kinekt-component-heading-1-size: var(--kiw--article-header-allentown-heading-size);
    --kinekt-component-heading-2-size: var(--kiw--article-header-allentown-heading-size);
    --kiw--content-hero-media-allentown-ratio: var(--kiw--article-header-allentown-media-ratio);
    box-sizing: border-box;
    padding-block: var(--kiw--article-header-allentown-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--text-font-family);
    font-size: var(--text-m);
    line-height: var(--text-line-height);

    &[data-kinekt-theme='semi-light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light)); }
    &[data-kinekt-theme='semi-dark'] {
      --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-dark));
      --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
      --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-light));
      --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary-light));
      --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
      --kiw--article-header-allentown-meta-color: var(--primary-light);
      color-scheme: dark;
    }
    &[data-kinekt-theme='dark'] {
      --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark));
      --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
      --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light));
      --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary-ultra-light));
      --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
      --kiw--article-header-allentown-meta-color: var(--primary-ultra-light);
      color-scheme: dark;
    }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .article-header-allentown__container { display: grid; width: 100%; max-width: min(var(--website-width), calc(var(--content-width) + (var(--kiw--article-header-allentown-inline-space) * 2))); gap: var(--kiw--article-header-allentown-gap); margin-inline: auto; padding-inline: var(--kiw--article-header-allentown-inline-space); }

    & .article-header-allentown__breadcrumb-list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xxs); margin: 0; padding: 0; list-style: none; color: var(--kiw--article-header-allentown-meta-color); font-size: var(--text-m); line-height: 1; }
    & .article-header-allentown__breadcrumb-item { display: inline-flex; align-items: center; gap: var(--space-xxs); min-width: 0; }
    & .article-header-allentown__breadcrumb-separator { flex: none; inline-size: auto; block-size: var(--text-xs); fill: currentColor; }
    & .article-header-allentown__breadcrumb-link { color: inherit; text-decoration: none; }
    & a.article-header-allentown__breadcrumb-link:hover { text-decoration: underline; }
    & .article-header-allentown__breadcrumb-current { color: var(--kinekt-component-accent); }

    & .article-header-allentown__body { display: grid; gap: var(--kiw--article-header-allentown-gap); min-width: 0; }
    & .article-header-allentown__header { min-width: 0; }
    & .section-intro__heading { max-width: none; }
    /* Figma "4 min reading time": text-m, Medium, 2% tracking, line-height 1. */
    & .article-header-allentown__reading-time { margin: var(--kiw--article-header-allentown-reading-time-gap) 0 0; color: var(--kiw--article-header-allentown-meta-color); font-size: var(--text-m); font-weight: var(--heading-font-weight); line-height: 1; letter-spacing: 0.02em; }
    & .section-intro__description { max-width: none; color: var(--kinekt-component-subtle); font-size: var(--kiw--article-header-allentown-description-size); line-height: var(--text-line-height); }
    & .section-intro__description > * { margin-block: 0; }
    & .section-intro__description > * + * { margin-block-start: var(--space-xs); }
    & .article-header-allentown__media { min-width: 0; margin: 0; }

    @media (min-width: 50rem) {
      & .article-header-allentown__body { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; column-gap: var(--kiw--article-header-allentown-column-gap); }
    }
  }
</style>
