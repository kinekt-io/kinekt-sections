{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/article-header/allentown",
  "slug": "article-header-allentown",
  "title": "Article Header Allentown",
  "description": "An editorial article header with intro, derived reading time and reusable image or video hero media.",
  "category": "sections",
  "tags": ["article", "header", "content"],
  "role": "article-header",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5639-526185",
    "nodeId": "5639:526185"
  },
  "fields": {
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "heroMedia": {
      "kind": "component",
      "componentId": "components/content-hero-media/allentown",
      "required": true,
      "localized": true
    }
  },
  "runtimeProps": {
    "breadcrumb": {
      "kind": "contentContext",
      "source": "renderer"
    },
    "readingTime": {
      "kind": "derivedReadingTime",
      "source": "renderer"
    }
  }
}
