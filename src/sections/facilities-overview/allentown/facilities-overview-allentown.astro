---
import '../../../styles/wireframe-tokens.css'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import FacilityFact from '../../../components/facility-fact/allentown/facility-fact-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

// The generated .types.ts is still generic (Record<string, unknown>), so the renderer types its props from the manifest here.
interface FacilityFactContent { title: string; description: string | RichText | Record<string, unknown> }
interface Props {
  theme: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }
  label?: { text: string; icon?: string | null } | null
  facts: FacilityFactContent[]
  media?: Media | null
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { theme, intro, label, facts = [], media, headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const factHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const hasMedia = Boolean(media && typeof media === 'object' && typeof media.url === 'string')
---
<section class="facilities-overview-allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="facilities-overview-allentown__container">
    <header class="facilities-overview-allentown__header">
      <div class="facilities-overview-allentown__intro">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      </div>
      {label?.text && <Label class="facilities-overview-allentown__label" size="l" text={label.text} icon={label.icon ?? undefined} />}
    </header>

    <div class:list={['facilities-overview-allentown__body', { 'facilities-overview-allentown__body--media': hasMedia }]}>
      <ul class="facilities-overview-allentown__facts">
        {facts.map((fact) => (
          <li class="facilities-overview-allentown__fact">
            <FacilityFact title={fact.title} description={fact.description} headingLevel={factHeadingLevel} />
          </li>
        ))}
      </ul>
      {hasMedia && media && <KinektMedia media={media} class="facilities-overview-allentown__media" imageClass="facilities-overview-allentown__image" loading={mediaLoading} />}
    </div>
  </div>
</section>
<style is:global>
