---
import FacilitiesOverview from './facilities-overview-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-dark' as const,
  intro: {
    accentHeading: '/ Production base',
    heading: 'Bringing high-density battery production closer to US programs',
    description: {
      html: '<p>Tulip is expanding its production footprint in the United States to support customers that need high-performance battery systems with shorter supply chains, local manufacturing and greater sourcing control.</p>',
    },
  },
  label: {
    text: 'Austin, Texas',
    icon: 'location-dot',
  },
  facts: [
    {
      title: 'Engineering',
      description: { html: '<p>Proven high-density battery designs developed around the platform and mission.</p>' },
    },
    {
      title: 'US sourcing',
      description: { html: '<p>Components selected around performance, availability and applicable procurement requirements.</p>' },
    },
    {
      title: 'US manufacturing',
      description: { html: '<p>Battery packs produced through US-based manufacturing for American customer programs.</p>' },
    },
    {
      title: 'Scale',
      description: { html: '<p>Move proven battery designs from initial builds into reliable and repeatable volume production.</p>' },
    },
  ],
  media: {
    url: placeholder('placeholder-688x406.svg'),
    alt: 'Battery production facility in Austin, Texas',
    width: 688,
    height: 406,
  },
}
---
<FacilitiesOverview {...content} />
