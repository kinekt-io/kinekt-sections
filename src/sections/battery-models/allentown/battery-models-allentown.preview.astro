---
import BatteryModelsAllentown from './battery-models-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name
const cardImage = (alt: string) => ({ url: placeholder('placeholder-1600x900.svg'), alt, width: 1600, height: 900 })
const itemImage = (alt: string) => ({ url: placeholder('placeholder-200x200.svg'), alt, width: 200, height: 200 })
---

<BatteryModelsAllentown
  theme="light"
  intro={{
    accentHeading: '/ The options',
    heading: 'Our battery pack models',
  }}
  ctas={{
    primary: { label: 'Get in touch to order', href: '/', icon: 'arrow-right' },
    secondary: { label: 'Download specs', href: '/', icon: 'download' },
  }}
  models={[
    {
      image: cardImage('16Ah 4S1P battery pack'),
      title: '16Ah 4S1P',
      description: 'A compact, lightweight pack for short missions and tightly packaged airframes.',
      specs: [
        { label: 'Weight', value: '573g' },
        { label: 'Dimensions', value: '145 x 50 x 40 mm' },
        { label: 'Configuration', value: '424 Wh/kg' },
        { label: 'Discharge', value: '3C Peak, 1C Continuous' },
      ],
    },
    {
      image: cardImage('78Ah 6S2P battery pack'),
      title: '78Ah 6S2P',
      description: 'Our highest-capacity standard pack for long-endurance and heavy-lift platforms.',
      specs: [
        { label: 'Weight', value: '2,760g' },
        { label: 'Dimensions', value: '210 x 95 x 80 mm' },
        { label: 'Configuration', value: '424 Wh/kg' },
        { label: 'Discharge', value: '3C Peak, 1C Continuous' },
      ],
    },
    {
      image: cardImage('30Ah 6S1P battery pack'),
      title: '30Ah 6S1P',
      description: 'A balanced pack for mid-size drones that need reliable range at a moderate weight.',
      specs: [
        { label: 'Weight', value: '1,060g' },
        { label: 'Dimensions', value: '165 x 70 x 55 mm' },
        { label: 'Configuration', value: '424 Wh/kg' },
        { label: 'Discharge', value: '3C Peak, 1C Continuous' },
      ],
    },
    {
      image: cardImage('40Ah 6S1P battery pack'),
      title: '40Ah 6S1P',
      description: 'Extra capacity in the same 6S format, for longer flights without a new integration.',
      specs: [
        { label: 'Weight', value: '1,420g' },
        { label: 'Dimensions', value: '180 x 75 x 60 mm' },
        { label: 'Configuration', value: '424 Wh/kg' },
        { label: 'Discharge', value: '3C Peak, 1C Continuous' },
      ],
    },
  ]}
  crossSell={{
    intro: {
      accentHeading: 'Customize your battery needs',
      heading: 'Need something different?',
      description: 'If a standard pack does not fit your platform, our engineers can configure the cells, format and electronics around your mission profile, or add the smart features your fleet needs.',
    },
    items: [
      {
        image: itemImage('Custom battery pack'),
        title: 'Our Custom Packs',
        cta: { cta: { label: 'View details', href: '/', icon: 'arrow-right' } },
      },
      {
        image: itemImage('Smart battery pack'),
        title: 'Our Smart Packs',
        cta: { cta: { label: 'View details', href: '/', icon: 'arrow-right' } },
      },
    ],
  }}
/>
