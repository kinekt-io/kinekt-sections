---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import Callout from '../../../components/callout/allentown/callout-allentown.astro'
import SpecPair from '../../../components/spec-pair/allentown/spec-pair-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaIconPaths } from '../../../shared/cta-icons.js'
import { ctaGroupActions, type Cta, type CtaGroup, type Media, type RichText, type SectionIntro as SectionIntroContent, type SectionTheme } from '../../../shared/content.js'

interface BatteryModel {
  image: Media
  title: string
  description: string | RichText
  specs: Array<{ label: string; value: string }>
}

interface CrossSellItem {
  image: Media
  title: string
  cta: { cta: Cta }
}

interface Props {
  id?: string
  theme?: SectionTheme
  intro: SectionIntroContent
  ctas?: CtaGroup | Cta[]
  models: BatteryModel[]
  crossSell?: { label?: string; intro: SectionIntroContent; items: CrossSellItem[] } | null
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const {
  id,
  theme = 'light',
  intro,
  ctas,
  models,
  crossSell,
  headingLevel = 'h2',
} = Astro.props as Props

const actions = ctaGroupActions(ctas)
const iconFor = (cta?: Cta | null) => (cta?.icon ? ctaIconPaths(cta.icon) : undefined)
type ChildHeading = 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
const level = Number(headingLevel.slice(1))
const ModelHeading = `h${Math.min(level + 1, 6)}` as ChildHeading
const crossSellHeadingLevel = `h${Math.min(level + 1, 3)}` as 'h2' | 'h3'
const ItemHeading = `h${Math.min(level + 2, 6)}` as ChildHeading
// The manifest's cross-sell is an Intro component, so the shared Callout renders its header from intro.accentHeading; the older `label` prop still wins when set.
const crossSellIntro = crossSell ? { ...crossSell.intro, accentHeading: crossSell.label ?? crossSell.intro.accentHeading } : undefined
---

<section class="beta-battery-models-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-battery-models-allentown__container">
    <div class="beta-battery-models-allentown__catalogue">
      <header class="beta-battery-models-allentown__intro">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
        {actions.length > 0 && (
          <nav class="beta-battery-models-allentown__actions" aria-label="Section actions">
            {actions.map((action, index) => {
              const icon = action.icon ? ctaIconPaths(action.icon) : undefined
              return <Button class="beta-battery-models-allentown__action" href={action.href} label={action.label} style={action.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
            })}
          </nav>
        )}
      </header>

      <ul class="beta-battery-models-allentown__models">
        {models.map((model) => (
          <li class="beta-battery-models-allentown__model">
            <article class="beta-battery-models-allentown__model-card">
              <KinektMedia class="beta-battery-models-allentown__model-media" imageClass="beta-battery-models-allentown__model-image" media={model.image} />
              <div class="beta-battery-models-allentown__model-text">
                <div class="beta-battery-models-allentown__model-content">
                  <ModelHeading class="beta-battery-models-allentown__model-title">{model.title}</ModelHeading>
                  {typeof model.description === 'string'
                    ? <p class="beta-battery-models-allentown__model-description">{model.description}</p>
                    : <div class="beta-battery-models-allentown__model-description" set:html={model.description.html} />}
                </div>
                {model.specs.length > 0 && (
                  <dl class="beta-battery-models-allentown__specifications">
                    {model.specs.map((specification) => <SpecPair class="beta-battery-models-allentown__specification" label={specification.label} value={specification.value} />)}
                  </dl>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>

    {crossSell && crossSellIntro && crossSell.items.length > 0 && (
      <Callout class="beta-battery-models-allentown__cross-sell" callout={{ intro: crossSellIntro }} size="medium" headingLevel={crossSellHeadingLevel}>
        <Fragment slot="actions">
          <ul class="beta-battery-models-allentown__cross-sell-items">
            {crossSell.items.map((item) => {
              const itemIcon = iconFor(item.cta.cta)
              return (
                <li class="beta-battery-models-allentown__cross-sell-item">
                  <KinektMedia class="beta-battery-models-allentown__cross-sell-media" imageClass="beta-battery-models-allentown__cross-sell-image" media={item.image} />
                  <div class="beta-battery-models-allentown__cross-sell-content">
                    <ItemHeading class="beta-battery-models-allentown__cross-sell-title">{item.title}</ItemHeading>
                    <Button class="beta-battery-models-allentown__cross-sell-action" size="s" href={item.cta.cta.href} label={item.cta.cta.label} style="clear">{itemIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={itemIcon.viewBox} fill="currentColor"><path d={itemIcon.path} /></svg>}</Button>
                  </div>
                </li>
              )
            })}
          </ul>
        </Fragment>
      </Callout>
    )}
  </div>
</section>
