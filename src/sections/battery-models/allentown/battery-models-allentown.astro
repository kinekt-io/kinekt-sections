---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, CtaGroup, Media, RichText, SectionIntro as SectionIntroContent, SectionTheme } from '../../../shared/content.js'

interface BatteryModel {
  image: Media
  title: string
  description: string | RichText
  specs: Array<{ label: string; value: string }>
}

interface CrossSellItem {
  image: Media
  title: string
  cta: { cta: Cta }
}

interface Props {
  id?: string
  theme?: SectionTheme
  intro: SectionIntroContent
  ctas?: CtaGroup
  models: BatteryModel[]
  crossSell?: { label?: string; intro: SectionIntroContent; items: CrossSellItem[] } | null
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const {
  id,
  theme = 'light',
  intro,
  ctas,
  models,
  crossSell,
  headingLevel = 'h2',
} = Astro.props as Props
---

<section class="beta-battery-models-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-battery-models-allentown__container">
    <header class="beta-battery-models-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
      {(ctas?.primary || ctas?.secondary) && (
        <nav class="beta-battery-models-allentown__actions" aria-label="Section actions">
          {ctas.primary && <Button class="beta-battery-models-allentown__action beta-battery-models-allentown__action--primary" href={ctas.primary.href} label={ctas.primary.label} />}
          {ctas.secondary && <Button class="beta-battery-models-allentown__action beta-battery-models-allentown__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="secondary" />}
        </nav>
      )}
    </header>

    <ul class="beta-battery-models-allentown__models">
      {models.map((model) => (
        <li class="beta-battery-models-allentown__model">
          <article>
            <KinektMedia class="beta-battery-models-allentown__model-media" imageClass="beta-battery-models-allentown__model-image" media={model.image} />
            <div class="beta-battery-models-allentown__model-content">
              <h4 class="beta-battery-models-allentown__model-title">{model.title}</h4>
              {typeof model.description === 'string'
                ? <p class="beta-battery-models-allentown__model-description">{model.description}</p>
                : <div class="beta-battery-models-allentown__model-description" set:html={model.description.html} />}
            </div>
            {model.specs.length > 0 && (
              <dl class="beta-battery-models-allentown__specifications">
                {model.specs.map((specification) => (
                  <div>
                    <dt>{specification.label}</dt>
                    <dd>{specification.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        </li>
      ))}
    </ul>

    {crossSell && crossSell.items.length > 0 && (
      <section class="beta-battery-models-allentown__cross-sell">
        {crossSell.label && <p class="beta-battery-models-allentown__cross-sell-label">{crossSell.label}</p>}
        <div class="beta-battery-models-allentown__cross-sell-content-row">
          <div class="beta-battery-models-allentown__cross-sell-intro">
            <SectionIntro intro={crossSell.intro} headingLevel="h2" />
          </div>
          <ul class="beta-battery-models-allentown__cross-sell-items">
            {crossSell.items.map((item) => (
              <li>
                <article class="beta-battery-models-allentown__cross-sell-item">
                  <KinektMedia class="beta-battery-models-allentown__cross-sell-media" imageClass="beta-battery-models-allentown__cross-sell-image" media={item.image} />
                  <div class="beta-battery-models-allentown__cross-sell-content">
                    <h3 class="beta-battery-models-allentown__cross-sell-title">{item.title}</h3>
                    <Button class="beta-battery-models-allentown__cross-sell-action" href={item.cta.cta.href} label={item.cta.cta.label} style="clear" />
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </div>
</section>
