---
import '../../../styles/wireframe-tokens.css'
import FormEmbed from '../../../components/form-embed/allentown/form-embed-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'

// The generated types (product-finder-form-allentown.types.ts) are still a generic record; these are the fields the manifest declares.
interface Props {
  contentWidth?: import('../../../shared/section-width.js').SectionContentWidth
  id?: string
  theme?: BetaTheme
  intro: SectionIntroContent
  /** HubSpot embed code (manifest kind formEmbed). Executed by the integration inside FormEmbed. */
  form?: string | null
  /** Figma "Subtile + Flight Path" above the form. Not in the manifest yet (contract gap); rendered only when set. */
  formLabel?: string
  /** runtimeProps.layout: the only layout this renderer has. */
  layout?: 'centeredCompactForm'
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { id, theme = 'light', intro, form, formLabel, headingLevel = 'h2' } = Astro.props as Props
const hasPlaceholder = Astro.slots.has('form')
---
<section class="product-finder-form-allentown" id={id} data-kinekt-section data-kinekt-content-width={Astro.props.contentWidth ?? 'standard'} data-kinekt-theme={theme}>
  <div class="product-finder-form-allentown__container">
    <header class="product-finder-form-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>
    <div class="product-finder-form-allentown__finder">
      {formLabel && <SubtitleFlightPath class="product-finder-form-allentown__label" text={formLabel} size="small" />}
      {hasPlaceholder
        ? <FormEmbed class="product-finder-form-allentown__form-embed" form={form}><slot name="form" /></FormEmbed>
        : <FormEmbed class="product-finder-form-allentown__form-embed" form={form} />}
    </div>
  </div>
</section>
<style is:global>
  .product-finder-form-allentown {
    --kiw--section-site-width: var(--kiw--product-finder-form-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--product-finder-form-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--product-finder-form-allentown-reading-width, var(--width-m));
