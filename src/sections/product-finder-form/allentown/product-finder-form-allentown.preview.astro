---
import { ctaIconPaths } from '../../../shared/cta-icons.js'
import ProductFinderFormAllentown from './product-finder-form-allentown.astro'

const submitIcon = ctaIconPaths['arrow-right']

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ Find the perfect fit',
    heading: 'Find the right battery for your system',
  },
  formLabel: 'Battery finder',
  form: '<script src="https://js.hsforms.net/forms/embed/v2.js"></script>',
}
---
<ProductFinderFormAllentown {...content}>
  <form slot="form" action="#" method="post">
    <div class="form-embed-allentown__fields">
      <fieldset>
        <legend>What is your main priority for this battery?</legend>
        <div class="form-embed-allentown__options">
          <label><input type="radio" name="priority" value="endurance" required /> Endurance</label>
          <label><input type="radio" name="priority" value="low-weight" /> Low weight</label>
          <label><input type="radio" name="priority" value="high-power" /> High power</label>
        </div>
      </fieldset>
    </div>
    <button type="submit">Find my battery <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={submitIcon.viewBox} fill="none"><path d={submitIcon.path} stroke="currentColor" stroke-width="2" /></svg></button>
  </form>
</ProductFinderFormAllentown>
