---
import ThankYouHero from './thank-you-hero-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ It’s received in good order',
    heading: 'Thank you for your request!',
    description: 'Our team will review your battery requirements and get back to you within two working days with the next steps for your project.',
  },
  media: {
    url: placeholder('placeholder-1600x900.svg'),
    alt: 'Battery engineering team reviewing a project request',
    width: 1600,
    height: 900,
  },
  nextStepsHeading: 'These are your next steps:',
  nextSteps: [
    {
      title: 'We will contact you',
      description: 'A battery specialist reviews your request and contacts you to confirm the application, quantities and timeline.',
    },
    {
      title: 'Call with an expert',
      description: 'In a short call we go through your operating conditions, integration constraints and certification needs.',
    },
    {
      title: 'Follow up things',
      description: 'You receive a tailored proposal with a recommended configuration and the technical documents to review.',
      ctaGroup: {
        primaryButton: { label: 'Read the integration guide', href: '#', icon: 'arrow-down' as const },
      },
    },
  ],
}
---
<ThankYouHero {...content} />
