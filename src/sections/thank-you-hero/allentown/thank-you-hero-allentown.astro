---
import '../../../styles/wireframe-tokens.css'
import NextStep, { type NextStepContent } from '../../../components/next-step/allentown/next-step-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import type { BetaThankYouHeroAllentownContent } from './thank-you-hero-allentown.types.js'

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaThankYouHeroAllentownContent {
  theme?: BetaTheme
  intro: SectionIntroContent
  media?: Media | null
  nextStepsHeading: string
  nextSteps: NextStepContent[]
  id?: string
  headingLevel?: 'h1' | 'h2'
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', intro, media, nextStepsHeading, nextSteps = [], headingLevel = 'h1', mediaLoading = 'eager' } = Astro.props
const nextStepsHeadingLevel = headingLevel === 'h1' ? 'h2' : 'h3'
const stepHeadingLevel = headingLevel === 'h1' ? 'h3' : 'h4'
---
<section class="thank-you-hero thank-you-hero--allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="thank-you-hero__container">
    <div class="thank-you-hero__lead">
      <header class="thank-you-hero__header">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      {media?.url && <KinektMedia media={media} class="thank-you-hero__media" imageClass="thank-you-hero__image" loading={mediaLoading} />}
    </div>

    {nextSteps.length > 0 && (
      <div class="thank-you-hero__next-steps">
        <SubtitleFlightPath text={nextStepsHeading} size="medium" as={nextStepsHeadingLevel} class="thank-you-hero__next-steps-heading" />
        <ol class="thank-you-hero__steps">
          {nextSteps.map((step, index) => (
            <li class="thank-you-hero__step">
              <NextStep step={step} number={index + 1} headingLevel={stepHeadingLevel} />
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</section>
<style is:global>
