---
import '../../../styles/wireframe-tokens.css'
import EventCard from '../../../components/event-card/allentown/event-card-allentown.astro'
import type { EventCardContent, EventType } from '../../../components/event-card/allentown/event-card-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type HeadingLevel = 'h1' | 'h2' | 'h3'

/*
 * runtimeProps.eventMapping = eventRecord (title, media, location, startDateTime, endDateTime, description, button).
 * `featured` and `publishedAt` drive runtimeProps.eventSelection; `eventType` is optional because the
 * featured presentation doesn't show it.
 */
export interface FeaturedEventSource extends Omit<EventCardContent, 'eventType'> {
  eventType?: EventType
  featured?: boolean
  publishedAt?: string | null
}

interface Props {
  id?: string
  theme?: Theme
  headingLevel?: HeadingLevel
  intro: SectionIntroContent
  /** Published Events for the active region and locale (runtimeProps.eventSelection.source = activeRegionAndLocale). */
  events?: FeaturedEventSource[]
  /** Localised flight-path label above the card (runtimeProps.eventStage = flightPath). */
  eventStageLabel?: string
  /** IANA time zone used for the card dates. */
  timeZone?: string
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', headingLevel = 'h2', intro, events = [], eventStageLabel = 'Featured event', timeZone, mediaLoading = 'lazy' } = Astro.props as Props

// runtimeProps.eventSelection = newestFeaturedThenNewestPublished: the newest featured Event, else the newest
// published one. Events without a valid publishedAt rank last; ties keep the input order.
const publishedTime = (event: FeaturedEventSource): number => {
  const time = event.publishedAt ? Date.parse(event.publishedAt) : Number.NaN
  return Number.isNaN(time) ? Number.NEGATIVE_INFINITY : time
}
const newest = (list: FeaturedEventSource[]): FeaturedEventSource | undefined => list.reduce<FeaturedEventSource | undefined>((best, event) => (!best || publishedTime(event) > publishedTime(best) ? event : best), undefined)
const valid = events.filter((event) => event && typeof event.title === 'string' && event.title !== '' && typeof event.location === 'string' && typeof event.startDateTime === 'string')
const selected = newest(valid.filter((event) => event.featured === true)) ?? newest(valid)
const event: EventCardContent | undefined = selected ? { ...selected, eventType: selected.eventType ?? 'tulip' } : undefined
const CardHeading = headingLevel === 'h1' ? 'h2' : headingLevel === 'h2' ? 'h3' : 'h4'
---
<section class="featured-event-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="featured-event-allentown__container">
    <header class="featured-event-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>
    {event && <div class="featured-event-allentown__featured">
      <SubtitleFlightPath class="featured-event-allentown__stage" text={eventStageLabel} size="small" />
      <EventCard class="featured-event-allentown__card" event={event} presentation="featured" headingLevel={CardHeading} timeZone={timeZone} mediaLoading={mediaLoading} />
    </div>}
  </div>
</section>
