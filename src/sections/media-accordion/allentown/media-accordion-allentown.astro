---
import '../../../styles/wireframe-tokens.css'
import AccordionItem, { type AccordionItemContent } from '../../../components/accordion-item/allentown/accordion-item-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type Media, type RichText, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaMediaAccordionAllentownContent } from './media-accordion-allentown.types.js'

// The generated .types.ts is still generic (Record<string, unknown>), so the renderer types its props from the manifest here.
interface Props extends BetaMediaAccordionAllentownContent {
  theme?: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }
  ctas?: CtaGroup | Cta[] | null
  media?: Media | null
  items: AccordionItemContent[]
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', intro, ctas, media, items = [], headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const actions = ctaGroupActions(ctas)
const hasMedia = Boolean(media && typeof media === 'object' && typeof media.url === 'string')
---
<section class="media-accordion-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="media-accordion-allentown__container">
    <header class="media-accordion-allentown__header">
      <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      {actions.length > 0 && (
        <div class="media-accordion-allentown__actions">
          {actions.map((cta) => {
            const icon = isCtaIcon(cta.icon) ? ctaIconPaths[cta.icon] : undefined
            return <Button href={cta.href} label={cta.label} style={cta.style ?? 'clear'}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="none"><path d={icon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>
          })}
        </div>
      )}
    </header>

    <div class:list={['media-accordion-allentown__body', { 'media-accordion-allentown__body--media': hasMedia }]}>
      {hasMedia && media && <KinektMedia media={media} class="media-accordion-allentown__media" imageClass="media-accordion-allentown__image" loading={mediaLoading} />}
      <ul class="media-accordion-allentown__items" data-kinekt-disclosure-group>
        {items.map((item, index) => (
          <li class="media-accordion-allentown__item">
            <AccordionItem item={item} number={index + 1} open={index === 0} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<script>
  import { initializeKinektInteractions } from '../../../shared/interactions'
  initializeKinektInteractions()
</script>
<style is:global>
  .media-accordion-allentown {
    --kiw--section-site-width: var(--kiw--media-accordion-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--media-accordion-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--media-accordion-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--media-accordion-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--media-accordion-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--media-accordion-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--media-accordion-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--media-accordion-allentown-border-width, var(--border-width));
