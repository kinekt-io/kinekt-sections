  .media-accordion-allentown .media-accordion-allentown__item + .media-accordion-allentown__item { padding-block-start: var(--kiw--media-accordion-items-gap); border-block-start: var(--kinekt-component-border-width) solid var(--kiw--media-accordion-divider-color); }

