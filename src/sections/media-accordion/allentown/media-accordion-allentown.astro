    --kiw--section-text-letter-spacing: var(--kiw--media-accordion-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--media-accordion-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--media-accordion-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--media-accordion-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--media-accordion-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--media-accordion-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--media-accordion-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--media-accordion-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--media-accordion-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--media-accordion-allentown-actions-gap, var(--space-l));
    --kiw--section-actions-margin: var(--kiw--media-accordion-allentown-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--media-accordion-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--media-accordion-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--media-accordion-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--media-accordion-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--media-accordion-allentown-input-height, var(--input-height));
