---
import MediaAccordion from './media-accordion-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ Material sourcing',
    heading: 'Secure sourcing for long-term battery programs',
    description: 'Critical cells, electronics and enclosure materials come from qualified suppliers with documented origin, so programs can plan production volumes with confidence.',
  },
  ctas: {
    primary: { label: 'View certifications and compliances', href: '#', icon: 'arrow-right' as const },
  },
  media: {
    url: placeholder('placeholder-1000x800.svg'),
    alt: 'Battery cells and components prepared for incoming inspection',
    width: 1000,
    height: 800,
  },
  items: [
    {
      markerType: 'icon' as const,
      icon: 'shield-halved',
      title: 'Supply chain security',
      subtitle: 'Reduce dependency and supply risk',
      description: 'Critical components and materials are sourced with continuity in mind, helping reduce exposure to shortages and supporting predictable production as programs scale.',
    },
    {
      markerType: 'icon' as const,
      icon: 'route',
      title: 'Material traceability',
      subtitle: 'Know what goes into every pack',
      description: 'Every cell batch and critical component is recorded against the pack serial number, so origin, test results and revisions can be traced at any point in the product life.',
    },
    {
      markerType: 'icon' as const,
      icon: 'calendar-check',
      title: 'Long-term availability',
      subtitle: 'Build for more than the first production run',
      description: 'Component choices are checked for long-term availability and second sources, so the same pack can be built and serviced for the full life of the platform.',
    },
  ],
}
---
<MediaAccordion {...content} />
