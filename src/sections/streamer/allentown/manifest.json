{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/streamer/allentown",
  "slug": "streamer-allentown",
  "title": "Streamer Allentown",
  "description": "A compact themed section streamer that pairs the standard intro with an optional CTA group.",
  "category": "sections",
  "tags": ["intro", "cta", "prerelease"],
  "role": "streamer",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5255-537167&t=DdGjpoAvVqSIinWT-11",
    "nodeId": "5255:537167"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "theme": { "kind": "select", "required": true, "localized": true, "options": ["light", "semi-light", "semi-dark", "dark"], "description": "CMS-selected presentation setting passed to the renderer." },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "ctas": { "kind": "ctaGroup", "required": false, "localized": true, "minItems": 0, "maxItems": 2, "description": "Add zero, one or two actions. Set the style of each action to Primary, Secondary or Clear." }
  }
}
