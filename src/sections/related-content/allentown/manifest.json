{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/related-content/allentown",
  "slug": "related-content-allentown",
  "title": "Related Content Allentown",
  "description": "A related-posts section with an intro, automatic article selection by default, an optional manual override, and an optional overview action.",
  "category": "sections",
  "tags": ["article", "case-study", "related-content"],
  "role": "related-content",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5639-526230&t=OtYEVTRRdAJJYQ0v-11",
    "nodeId": "5639:526230"
  },
  "fields": {
    "cardReadMoreIcon": {
      "kind": "text",
      "required": false,
      "localized": true,
      "description": "Optional installed CTA icon for every related-content card Read More link. Empty uses chevron-right."
    },
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70", "50"],
        "description": "Maximum content width: Standard (100%), 80%, 70%, or 50%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "selectionMode": {
      "kind": "select",
      "required": false,
      "localized": true,
      "options": [
        "automatic",
        "manual"
      ],
      "description": "Automatic when left empty: show related published Articles selected by the CMS request path. Choose Manual to select published content in display order."
    },
    "contentSources": {
      "kind": "contentReferenceList",
      "required": false,
      "localized": true,
      "minItems": 0,
      "description": "Manual selection only. Select one or more published content items in display order. In Automatic mode, leave this empty; the CMS request path supplies matching related Articles."
    },
    "cta": {
      "kind": "component",
      "componentId": "controls/button/allentown",
      "required": false,
      "localized": true,
      "description": "Optional Content-or-URL overview action."
    }
  },
  "runtimeProps": {
    "cardLayout": {
      "kind": "responsiveRelatedCardGrid",
      "source": "renderer"
    }
  }
}
