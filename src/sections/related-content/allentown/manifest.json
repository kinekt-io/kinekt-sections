{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/related-content/allentown",
  "slug": "related-content-allentown",
  "title": "Related Content Allentown",
  "description": "A related-posts section with an intro, explicitly selected published content and an optional overview action.",
  "category": "sections",
  "tags": ["article", "case-study", "related-content"],
  "role": "related-content",
  "variation": "allentown",
  "status": "planned",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5639-526183&t=OtYEVTRRdAJJYQ0v-11",
    "nodeId": "5639:526183"
  },
  "fields": {
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "contentSources": {
      "kind": "contentReferenceList",
      "required": true,
      "localized": true,
      "minItems": 1,
      "description": "Explicitly select published related content. Each card derives its content type, title, card excerpt, hero image or video poster, and route from the selected document."
    },
    "cta": {
      "kind": "component",
      "componentId": "controls/button/allentown",
      "required": false,
      "localized": true,
      "description": "Optional Content-or-URL overview action."
    }
  },
  "runtimeProps": {
    "cardLayout": {
      "kind": "responsiveRelatedCardGrid",
      "source": "renderer"
    }
  }
}
