---
import RelatedContentAllentown from './related-content-allentown.astro'

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = `${base}placeholders/placeholder-1600x900.svg`
---
<RelatedContentAllentown
  theme="semi-light"
  intro={{ accentHeading: '/ Stay up-to-date', heading: 'Tulip’s insights' }}
  cta={{ label: 'See all insights', href: '/insights/', icon: 'arrow-right' }}
  contentSources={[
    { kind: 'Article', title: 'Tulip extends flight time up to 8 hours', excerpt: 'How high-density cells and a lighter pack structure turn into longer missions for long-range drones.', href: '/insights/tulip-extends-flight-time/', image: { url: placeholder, alt: 'Drone flying through the clouds at sunset', width: 1600, height: 900 } },
    { kind: 'Case', title: 'A programme built around delivery evidence', excerpt: 'What a controlled handover looks like from the first prototype to series production.', href: '/cases/delivery-evidence/', image: { url: placeholder, alt: 'Engineering team at work', width: 1600, height: 900 } },
    { kind: 'Article', title: 'Designing battery packs for service access', excerpt: 'Small packaging choices that reduce maintenance time in the field and keep fleets flying.', href: '/insights/designing-for-service-access/', image: { url: placeholder, alt: 'Service access detail of a battery pack', width: 1600, height: 900 } },
  ]}
/>
