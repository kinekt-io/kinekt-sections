---
import RelatedContentAllentown from './related-content-allentown.astro'

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = `${base}placeholders/placeholder-1600x900.svg`
---
<RelatedContentAllentown
  theme="semi-light"
  intro={{ accentHeading: 'Continue reading', heading: 'Related engineering work', description: 'Further notes, project evidence and technical context from across the programme.' }}
  cta={{ label: 'Browse all insights', href: '/insights/' }}
  contentSources={[
    { kind: 'Article', title: 'Planning the verification route', excerpt: 'How teams turn early technical questions into a clear evidence plan.', href: '/insights/planning-the-verification-route/', image: { url: placeholder, alt: 'Technical workshop', width: 1600, height: 900 } },
    { kind: 'Case', title: 'A programme built around delivery evidence', excerpt: 'What a controlled handover looks like from prototype to production.', href: '/cases/delivery-evidence/', image: { url: placeholder, alt: 'Engineering team at work', width: 1600, height: 900 } },
    { kind: 'Article', title: 'Designing for service access', excerpt: 'Small packaging choices that reduce maintenance time in the field.', href: '/insights/designing-for-service-access/', image: { url: placeholder, alt: 'Service access detail', width: 1600, height: 900 } },
  ]}
/>
