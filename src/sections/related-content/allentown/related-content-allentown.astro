---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { isSafeWebUrl } from '../../../urls.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type RelatedItem = { title?: string; excerpt?: string; href?: string; kind?: string; image?: unknown; media?: unknown; poster?: unknown }
interface Props { id?: string; theme?: Theme; headingLevel?: 'h2' | 'h3'; intro: SectionIntroContent; contentSources?: RelatedItem[]; cta?: { cta?: Cta } | Cta | null; mediaLoading?: 'eager' | 'lazy' }

const { id, theme = 'semi-light', headingLevel = 'h2', intro, contentSources = [], cta, mediaLoading = 'lazy' } = Astro.props as Props
const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string' && isSafeWebUrl((value as Media).url)
const relatedItems = contentSources.filter((item): item is Required<Pick<RelatedItem, 'title' | 'href'>> & RelatedItem => typeof item?.title === 'string' && item.title.trim().length > 0 && typeof item.href === 'string' && isSafeWebUrl(item.href))
const rawAction: unknown = cta && typeof cta === 'object' && 'cta' in cta ? cta.cta : cta
const isCta = (value: unknown): value is Cta & Required<Pick<Cta, 'label' | 'href'>> => typeof value === 'object' && value !== null && typeof (value as Record<string, unknown>).label === 'string' && typeof (value as Record<string, unknown>).href === 'string' && isSafeWebUrl((value as Record<string, string>).href)
const action = isCta(rawAction) ? rawAction : undefined
const itemMedia = (item: RelatedItem) => [item.image, item.media, item.poster].find(isMedia)
---
<section class="related-content-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="related-content-allentown__container">
    <header class="related-content-allentown__header">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      {action && <Button class="related-content-allentown__action" href={action.href} label={action.label} />}
    </header>
    {relatedItems.length > 0 && <ul class="related-content-allentown__cards">
      {relatedItems.map((item) => {
        const media = itemMedia(item)
        return <li class="related-content-allentown__item"><article class="related-content-allentown__card">
          {media && <a class="related-content-allentown__media-link" href={item.href} aria-label={`Read ${item.title}`}><KinektMedia media={media} class="related-content-allentown__media" imageClass="related-content-allentown__image" loading={mediaLoading} /></a>}
          <div class="related-content-allentown__body">
            {item.kind && <p class="related-content-allentown__kind">{item.kind}</p>}
            <h3 class="related-content-allentown__title"><a href={item.href}>{item.title}</a></h3>
            {item.excerpt && <p class="related-content-allentown__excerpt">{item.excerpt}</p>}
            <a class="related-content-allentown__link" href={item.href}>Read more <span aria-hidden="true">→</span></a>
          </div>
        </article></li>
      })}
    </ul>}
  </div>
</section>

<style is:global>
  :where(.related-content-allentown) { --kiw--related-content-allentown-inline-space: var(--section-gutter); --kiw--related-content-allentown-block-space: var(--section-space-xl); --kiw--related-content-allentown-gap: var(--section-space-l); --kiw--related-content-allentown-card-gap: var(--space-m); --kiw--related-content-allentown-media-ratio: 16 / 9; }

  .related-content-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark));
    --kinekt-component-line: var(--kinekt-section-line, var(--primary-ultra-light));
    --kinekt-component-radius: var(--kinekt-section-radius, var(--radius-none));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--media-filter));
    --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--width-l));
    padding-block: var(--kiw--related-content-allentown-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);

    &[data-kinekt-theme='light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light)); }
    &:is([data-kinekt-theme='dark'], [data-kinekt-theme='semi-dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark)); --kinekt-component-ink: var(--kinekt-section-ink, var(--white)); --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light)); --kinekt-component-accent: var(--kinekt-section-accent, var(--accent)); --kinekt-component-line: var(--kinekt-section-line, var(--primary)); }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .related-content-allentown__container { display: grid; width: 100%; max-width: min(var(--website-width), calc(var(--content-width) + (var(--kiw--related-content-allentown-inline-space) * 2))); gap: var(--kiw--related-content-allentown-gap); margin-inline: auto; padding-inline: var(--kiw--related-content-allentown-inline-space); }
    & .related-content-allentown__header { display: grid; align-items: end; gap: var(--space-l); }
    & .related-content-allentown__action { width: max-content; }
    & .related-content-allentown__cards { display: grid; gap: var(--kiw--related-content-allentown-card-gap); margin: 0; padding: 0; list-style: none; }
    & .related-content-allentown__card { display: grid; height: 100%; gap: var(--kiw--related-content-allentown-card-gap); }
    & .related-content-allentown__media-link { display: block; }
    & .related-content-allentown__image { display: block; inline-size: 100%; aspect-ratio: var(--kiw--related-content-allentown-media-ratio); object-fit: cover; }
    & .related-content-allentown__body { display: grid; align-content: start; gap: var(--space-s); }
    & :is(.related-content-allentown__kind, .related-content-allentown__excerpt, .related-content-allentown__title) { margin: 0; }
    & .related-content-allentown__kind { color: var(--kinekt-component-accent); font-family: var(--mono-font-family); font-size: var(--text-s); text-transform: uppercase; }
    & .related-content-allentown__title { font-size: var(--h4); line-height: var(--heading-line-height); }
    & .related-content-allentown__title a { color: inherit; text-decoration: none; }
    & .related-content-allentown__excerpt { color: var(--kinekt-component-muted); }
    & .related-content-allentown__link { width: max-content; color: inherit; font-weight: var(--heading-font-weight); text-decoration: none; }
    & .related-content-allentown__link span { color: var(--kinekt-component-accent); }

    @media (min-width: 50rem) { & .related-content-allentown__header { grid-template-columns: minmax(0, var(--kinekt-component-reading-width)) auto; justify-content: space-between; } & .related-content-allentown__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  }
</style>
