---
import '../../../styles/wireframe-tokens.css'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import { isSafeWebUrl } from '../../../urls.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type RelatedItem = { title?: string; excerpt?: string; href?: string; kind?: string; image?: unknown; media?: unknown; poster?: unknown }
interface Props {
  id?: string
  theme?: Theme
  headingLevel?: 'h2' | 'h3'
  intro: SectionIntroContent
  contentSources?: RelatedItem[]
  cta?: { cta?: Cta } | Cta | null
  /** Visible label of each card's link; the card title is added for screen readers. */
  readMoreLabel?: string
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'semi-light', headingLevel = 'h2', intro, contentSources = [], cta, readMoreLabel = 'Read more', mediaLoading = 'lazy' } = Astro.props as Props
const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string' && isSafeWebUrl((value as Media).url)
const relatedItems = contentSources.filter((item): item is Required<Pick<RelatedItem, 'title' | 'href'>> & RelatedItem => typeof item?.title === 'string' && item.title.trim().length > 0 && typeof item.href === 'string' && isSafeWebUrl(item.href))
const rawAction: unknown = cta && typeof cta === 'object' && 'cta' in cta ? cta.cta : cta
const isCta = (value: unknown): value is Cta & Required<Pick<Cta, 'label' | 'href'>> => typeof value === 'object' && value !== null && typeof (value as Record<string, unknown>).label === 'string' && typeof (value as Record<string, unknown>).href === 'string' && isSafeWebUrl((value as Record<string, string>).href)
const action = isCta(rawAction) ? rawAction : undefined
const actionIcon = action && isCtaIcon(action.icon) ? ctaIconPaths[action.icon] : undefined
const itemMedia = (item: RelatedItem) => [item.image, item.media, item.poster].find(isMedia)
const CardHeading = headingLevel === 'h2' ? 'h3' : 'h4'
const linkIcon = ctaIconPaths['arrow-right']
// Figma "Label Icon" (4650:28087) icon per content type, as Font Awesome free solid names for the Label atom (same map as Insight Index).
const kindIcons: Record<string, string> = { article: 'newspaper', case: 'suitcase', 'case study': 'suitcase', 'white paper': 'file-lines', video: 'circle-play', blog: 'pen-nib', interview: 'microphone', news: 'bullhorn' }
const kindIcon = (kind?: string) => (kind ? kindIcons[kind.trim().toLowerCase()] : undefined)
---
<section class="related-content-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="related-content-allentown__container">
    <header class="related-content-allentown__header">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
    </header>
    {relatedItems.length > 0 && <ul class="related-content-allentown__cards">
      {relatedItems.map((item) => {
        const media = itemMedia(item)
        return <li class="related-content-allentown__item"><article class="related-content-allentown__card">
          {media && <a class="related-content-allentown__media-link" href={item.href} aria-label={`Read ${item.title}`}><KinektMedia media={media} class="related-content-allentown__media" imageClass="related-content-allentown__image" loading={mediaLoading} /></a>}
          <div class="related-content-allentown__body">
            <div class="related-content-allentown__copy">
              <div class="related-content-allentown__heading-group">
                {item.kind && <Label class="related-content-allentown__kind" text={item.kind} icon={kindIcon(item.kind)} size="s" />}
                <CardHeading class="related-content-allentown__title"><a href={item.href}>{item.title}</a></CardHeading>
              </div>
              {item.excerpt && <p class="related-content-allentown__excerpt">{item.excerpt}</p>}
            </div>
            <Button class="related-content-allentown__link" href={item.href} label={readMoreLabel} style="clear"><span class="related-content-allentown__visually-hidden">: {item.title}</span><svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={linkIcon.viewBox} fill="none"><path d={linkIcon.path} stroke="currentColor" stroke-width="2" /></svg></Button>
          </div>
        </article></li>
      })}
    </ul>}
    {action && <div class="related-content-allentown__actions"><Button class="related-content-allentown__action" href={action.href} label={action.label}>{actionIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={actionIcon.viewBox} fill="none"><path d={actionIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button></div>}
  </div>
</section>
<style is:global>
  .related-content-allentown {
    --kiw--section-site-width: var(--kiw--related-content-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--related-content-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--related-content-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--related-content-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--related-content-allentown-block-space, var(--section-space-xl));
    --kiw--section-gap: var(--kiw--related-content-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--related-content-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--related-content-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--related-content-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--related-content-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--related-content-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--related-content-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--related-content-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--related-content-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--related-content-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--related-content-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--related-content-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--related-content-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--related-content-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--related-content-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--related-content-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--related-content-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--related-content-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--related-content-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--related-content-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--related-content-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--related-content-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--related-content-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--related-content-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--related-content-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--related-content-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--related-content-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--related-content-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--related-content-allentown-actions-gap, var(--space-l));
    --kiw--section-actions-margin: var(--kiw--related-content-allentown-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--related-content-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--related-content-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--related-content-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--related-content-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--related-content-allentown-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--related-content-allentown-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--related-content-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--related-content-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--related-content-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--related-content-allentown-canvas);
    --kiw--section-surface: var(--kiw--related-content-allentown-surface);
    --kiw--section-ink: var(--kiw--related-content-allentown-ink);
    --kiw--section-muted: var(--kiw--related-content-allentown-muted);
    --kiw--section-line: var(--kiw--related-content-allentown-line);
    --kiw--section-action: var(--kiw--related-content-allentown-action);
    --kiw--section-action-text: var(--kiw--related-content-allentown-action-text);
    --kiw--section-accent: var(--kiw--related-content-allentown-accent);
    --kiw--section-action-icon: var(--kiw--related-content-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--related-content-allentown-subtle);
  }
</style>
<style is:global>
  /* Figma "Section - Featured insights" (Article Template 5639:526230; same block in the Case Template 5639:525272), semi-light:
     a 1440 container; intro Column 864 (accent + h2) → 64 → three equal cards (gap 80) → 64 → primary-alt Button, bottom-left.
     Card: 16:9 image → 32 → "Label Icon" (4650:28087) → XXS → h4 lh 1.25 → XS → text-m 1.5 excerpt (--primary = subtle) → L → clear
     "Read more" + chevron. Cards are built here (the same pattern as Insight Index's cards; shared insight-card proposed). */
  :where(.related-content-allentown) {
    --kiw--related-content-allentown-container-width: var(--content-width);
    --kiw--related-content-allentown-header-width: var(--width-l);
    --kiw--related-content-allentown-gap: var(--section-space-m);
    --kiw--related-content-allentown-cards-column-gap: var(--section-space-l);
    --kiw--related-content-allentown-cards-tablet-column-gap: var(--section-space-xs);
    --kiw--related-content-allentown-cards-row-gap: var(--section-space-s);
    --kiw--related-content-allentown-card-gap: var(--space-xl);
    --kiw--related-content-allentown-media-ratio: 16 / 9;
    --kiw--related-content-allentown-body-gap: var(--space-l);
    --kiw--related-content-allentown-copy-gap: var(--space-xs);
    --kiw--related-content-allentown-heading-gap: var(--space-xxs);
    --kiw--related-content-allentown-title-size: var(--kiw--section-heading-4-size);
    --kiw--related-content-allentown-title-line-height: 1.25;
    --kiw--related-content-allentown-excerpt-size: var(--text-m);
    --kiw--related-content-allentown-excerpt-color: var(--kinekt-component-subtle);
  }

  .related-content-allentown > .related-content-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kiw--related-content-allentown-container-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kiw--related-content-allentown-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .related-content-allentown :is(h2, h3, h4, p, ul) { margin: 0; }
  .related-content-allentown .related-content-allentown__visually-hidden { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Intro Column: accent → XXS → h2 (SectionIntro accent heading), optional description. */
  .related-content-allentown .section-intro { display: grid; justify-items: start; gap: var(--kinekt-component-intro-description-gap); }
  .related-content-allentown .section-intro :is(.section-intro__heading, .section-intro__description) { max-width: none; margin: 0; }
  .related-content-allentown .section-intro__heading:is(h2) { font-size: var(--kiw--section-heading-2-size); }
  .related-content-allentown .section-intro__heading:is(h3) { font-size: var(--kiw--section-heading-3-size); }
  .related-content-allentown .section-intro__description { font-size: var(--kiw--section-text-l-size); line-height: var(--kinekt-component-text-line-height); }
  .related-content-allentown .section-intro__description > * { margin-block: 0; }

  /* Cards. */
  .related-content-allentown .related-content-allentown__cards { display: grid; column-gap: var(--kiw--related-content-allentown-cards-column-gap); row-gap: var(--kiw--related-content-allentown-cards-row-gap); padding: 0; list-style: none; }
  .related-content-allentown .related-content-allentown__item { min-width: 0; }
  .related-content-allentown .related-content-allentown__card { display: grid; align-content: start; gap: var(--kiw--related-content-allentown-card-gap); height: 100%; min-width: 0; }
  .related-content-allentown .related-content-allentown__media-link { display: block; }
  .related-content-allentown .related-content-allentown__image { display: block; inline-size: 100%; max-inline-size: 100%; height: auto; aspect-ratio: var(--kinekt-section-media-ratio, var(--kiw--related-content-allentown-media-ratio)); object-fit: cover; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  .related-content-allentown .related-content-allentown__body { display: grid; justify-items: start; align-content: start; gap: var(--kiw--related-content-allentown-body-gap); min-width: 0; }
  .related-content-allentown .related-content-allentown__copy { display: grid; gap: var(--kiw--related-content-allentown-copy-gap); min-width: 0; }
  .related-content-allentown .related-content-allentown__heading-group { display: grid; justify-items: start; gap: var(--kiw--related-content-allentown-heading-gap); min-width: 0; }
  /* Figma "Label Icon" (Light=no): the shared Label atom without its chip (no padding, border or tint), text-s in the heading font. */
  .related-content-allentown .related-content-allentown__kind {
    --kiw--label-allentown-gap: var(--space-xxs);
    --kiw--label-allentown-padding-block: 0;
    --kiw--label-allentown-padding-inline: 0;
    --kiw--label-allentown-border-width: 0;
    --kiw--label-allentown-background: transparent;
    --kiw--label-allentown-font-family: var(--kiw--section-heading-font-family);
    --kiw--label-allentown-font-size: var(--text-s);
    --kiw--label-allentown-icon-size: var(--text-xs);
    --kiw--label-allentown-text-transform: none;
  }
  .related-content-allentown .related-content-allentown__title { max-width: none; color: var(--kinekt-component-ink); font-family: var(--kiw--section-heading-font-family); font-size: var(--kiw--related-content-allentown-title-size); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kiw--related-content-allentown-title-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: pretty; }
  .related-content-allentown .related-content-allentown__title a { color: inherit; text-decoration: none; }
  .related-content-allentown .related-content-allentown__title a:hover { text-decoration: underline; text-decoration-thickness: var(--kinekt-component-border-width); text-underline-offset: 0.15em; }
  .related-content-allentown .related-content-allentown__excerpt { color: var(--kiw--related-content-allentown-excerpt-color); font-size: var(--kiw--related-content-allentown-excerpt-size); line-height: var(--kinekt-component-text-line-height); }
  .related-content-allentown .related-content-allentown__link { position: relative; }
  .related-content-allentown .related-content-allentown__actions { display: flex; flex-wrap: wrap; gap: var(--kiw--section-actions-gap); }

  @media (min-width: 50rem) {
    .related-content-allentown .related-content-allentown__header { max-inline-size: var(--kiw--related-content-allentown-header-width); }
    .related-content-allentown .related-content-allentown__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--kiw--related-content-allentown-cards-tablet-column-gap); }
  }
  @media (min-width: 75rem) {
    .related-content-allentown .related-content-allentown__cards { column-gap: var(--kiw--related-content-allentown-cards-column-gap); }
  }
  @media (max-width: 49.999rem) {
    .related-content-allentown .related-content-allentown__title { line-height: 1.2; }
  }
</style>
<style is:global>
