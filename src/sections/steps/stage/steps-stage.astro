    --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--kiw--section-reading-width));
    --kinekt-component-inline-space: var(--kinekt-section-inline-space, var(--kiw--section-inline-space));
    --kinekt-component-block-space: var(--kinekt-section-block-space, var(--kiw--section-block-space));
    --kinekt-component-gap: var(--kinekt-section-gap, var(--kiw--section-gap));
    --kinekt-component-radius: var(--kinekt-section-radius, var(--kiw--section-radius));
    --kinekt-component-border-width: var(--kinekt-section-border-width, var(--kiw--section-border-width));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--kiw--section-media-filter));
