---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import StepStage, { type StepStageContent } from '../../../components/step/stage/step-stage.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type CtaGroup, type Media, type RichText, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaStepsStageContent } from './steps-stage.types.js'

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaStepsStageContent {
  theme?: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | null }
  introCtaGroup?: CtaGroup | null
  listCtaGroup?: CtaGroup | null
  media?: Media | null
  steps: StepStageContent[]
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', intro, introCtaGroup, media, steps = [], listCtaGroup, headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const stepHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const hasMedia = Boolean(media && typeof media === 'object' && typeof media.url === 'string' && media.url !== '')
const visibleSteps = steps.filter((step) => typeof step?.title === 'string' && step.title !== '')
const introActions = ctaGroupActions(introCtaGroup)
const listActions = ctaGroupActions(listCtaGroup)
---
<section class="steps-stage" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="steps-stage__container">
    <div class="steps-stage__lead">
      <header class="steps-stage__intro">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
        {introActions.length > 0 && (
          <nav class="steps-stage__actions steps-stage__intro-actions" aria-label="Introduction actions">
            {introActions.map((action) => {
              const icon = isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
              return <Button href={action.href} label={action.label} style={action.style ?? 'primary'}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
            })}
          </nav>
        )}
      </header>
      {hasMedia && media && <KinektMedia media={media} class="steps-stage__media" imageClass="steps-stage__image" loading={mediaLoading} />}
    </div>

    {(visibleSteps.length > 0 || listActions.length > 0) && (
      <div class="steps-stage__list-column">
        {visibleSteps.length > 0 && (
          <ol class="steps-stage__steps">
            {visibleSteps.map((step, index) => (
              <li class="steps-stage__step">
                <StepStage step={step} number={index + 1} headingLevel={stepHeadingLevel} />
              </li>
            ))}
          </ol>
        )}
        {listActions.length > 0 && (
          <nav class="steps-stage__actions steps-stage__list-actions" aria-label="Steps actions">
            {listActions.map((action) => {
              const icon = isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
              return <Button href={action.href} label={action.label} style={action.style ?? 'primary'}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
            })}
          </nav>
        )}
      </div>
    )}
  </div>
</section>
<style is:global>
  .steps-stage {
    --kiw--section-site-width: var(--kiw--steps-stage-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--steps-stage-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--steps-stage-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--steps-stage-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--steps-stage-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--steps-stage-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--steps-stage-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--steps-stage-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--steps-stage-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--steps-stage-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--steps-stage-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--steps-stage-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--steps-stage-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--steps-stage-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--steps-stage-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--steps-stage-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--steps-stage-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--steps-stage-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--steps-stage-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--steps-stage-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--steps-stage-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--steps-stage-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--steps-stage-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--steps-stage-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--steps-stage-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--steps-stage-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--steps-stage-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--steps-stage-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--steps-stage-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--steps-stage-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--steps-stage-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--steps-stage-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--steps-stage-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--steps-stage-actions-gap, var(--space-l));
    --kiw--section-actions-margin: var(--kiw--steps-stage-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--steps-stage-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--steps-stage-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--steps-stage-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--steps-stage-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--steps-stage-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--steps-stage-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--steps-stage-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--steps-stage-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--steps-stage-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--steps-stage-canvas);
    --kiw--section-surface: var(--kiw--steps-stage-surface);
    --kiw--section-ink: var(--kiw--steps-stage-ink);
    --kiw--section-muted: var(--kiw--steps-stage-muted);
    --kiw--section-line: var(--kiw--steps-stage-line);
    --kiw--section-action: var(--kiw--steps-stage-action);
    --kiw--section-action-text: var(--kiw--steps-stage-action-text);
    --kiw--section-accent: var(--kiw--steps-stage-accent);
    --kiw--section-action-icon: var(--kiw--steps-stage-action-icon);
    --kiw--section-subtle: var(--kiw--steps-stage-subtle);
  }
</style>
<style is:global>
  .steps-stage[data-kinekt-section] > .steps-stage__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .steps-stage :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; }
  .steps-stage :is(p, ul, ol) { margin-block: 0; }
</style>
<style is:global>
  /* Figma "Section - 01 Light Battery Packs" (5240:414399), light: 1440 container, 680 + 80 + 680.
     Lead: intro "Column" → section-s → 16:9 media. Steps: "Text Container"s stacked at section-s. */
  :where(.steps-stage) {
    --kiw--steps-stage-container-width: var(--content-width);
    --kiw--steps-stage-column-gap: var(--section-space-l);
    --kiw--steps-stage-stack-gap: var(--section-space-l);
    --kiw--steps-stage-lead-gap: var(--section-space-s);
    --kiw--steps-stage-intro-gap: var(--space-m);
    --kiw--steps-stage-heading-stack-gap: var(--space-xxs);
    --kiw--steps-stage-heading-size: var(--h2);
    --kiw--steps-stage-description-font-size: var(--text-l);
    --kiw--steps-stage-media-ratio: 16 / 9;
    --kiw--steps-stage-step-gap: var(--section-space-s);
    --kinekt-section-content-width: var(--kiw--steps-stage-container-width);
    --kinekt-section-gap: var(--kiw--steps-stage-stack-gap);
  }

  .steps-stage .steps-stage__lead { display: grid; gap: var(--kiw--steps-stage-lead-gap); min-width: 0; align-content: start; }
  .steps-stage .steps-stage__intro { display: grid; gap: var(--kiw--steps-stage-intro-gap); min-width: 0; }
  .steps-stage .section-intro { display: grid; justify-items: start; gap: var(--kiw--steps-stage-intro-gap); }
  .steps-stage .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .steps-stage .section-intro__heading-group { display: grid; gap: var(--kiw--steps-stage-heading-stack-gap); }
  .steps-stage .section-intro__heading { max-width: none; font-size: var(--kiw--steps-stage-heading-size); }
  .steps-stage .section-intro__description { max-width: none; color: var(--kinekt-component-muted); font-size: var(--kiw--steps-stage-description-font-size); line-height: var(--kinekt-component-text-line-height); }
  .steps-stage .section-intro__description > * { margin-block: 0; }
  .steps-stage .steps-stage__media { display: block; min-width: 0; }
  .steps-stage .steps-stage__image { display: block; inline-size: 100%; max-inline-size: 100%; block-size: auto; aspect-ratio: var(--kinekt-section-media-ratio, var(--kiw--steps-stage-media-ratio)); object-fit: cover; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }

  .steps-stage {
    & .steps-stage__list-column {
      display: grid;
      gap: var(--kiw--steps-stage-step-gap);
      min-width: 0;
    }

    & .steps-stage__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--kiw--section-actions-gap);
    }

    & .steps-stage__steps {
      display: grid;
      gap: 0;
      min-width: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    & .steps-stage__step {
      min-width: 0;

      & + .steps-stage__step {
        margin-block-start: calc(var(--kiw--steps-stage-step-gap) / 2);
        padding-block-start: calc(var(--kiw--steps-stage-step-gap) / 2);
        border-block-start: var(--kinekt-component-border-width) solid var(--kinekt-component-line);
      }
    }
  }

  @media (min-width: 50rem) {
    .steps-stage[data-kinekt-section] > .steps-stage__container { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; column-gap: var(--kiw--steps-stage-column-gap); }
  }
  @media (max-width: 49.999rem) {
    .steps-stage :is(h1, h2, h3, h4, h5, h6) { max-width: 100vw; }
  }
</style>
<style is:global>
