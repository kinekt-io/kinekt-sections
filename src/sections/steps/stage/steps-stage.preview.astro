---
import StepsStage from './steps-stage.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: 'Working together',
    heading: 'From first brief to dependable delivery',
    description: { html: '<p>Align the requirements, test the practical details, and prepare a clear handover before work moves into production.</p>' },
  },
  introCtaGroup: {
    buttons: [{ label: 'Discuss your project', href: '/contact/', style: 'primary' as const, icon: 'arrow-right' as const }],
  },
  media: {
    url: placeholder('placeholder-1600x900.svg'),
    alt: 'A prototype prepared for a design review',
    width: 1600,
    height: 900,
  },
  steps: [
    {
      title: 'Agree on the requirements',
      description: 'Turn the initial brief into a practical scope with clear priorities and acceptance criteria.',
      ctaGroup: { buttons: [{ label: 'Explore the planning workshop', href: '/services/', style: 'clear' as const, icon: 'arrow-right' as const }] },
    },
    {
      title: 'Validate the design early',
      description: 'Review a working prototype and resolve the critical details before committing to the full delivery.',
    },
    {
      title: 'Confirm operational readiness',
      description: 'Check the design against real operating conditions and document the evidence needed for handover.',
    },
    {
      title: 'Prepare a repeatable delivery',
      description: 'Agree on the production schedule, quality checks, and support arrangements for the next rollout.',
    },
  ],
  listCtaGroup: {
    buttons: [{ label: 'Review our delivery approach', href: '/approach/', style: 'clear-base' as const, icon: 'arrow-right' as const }],
  },
}
---
<StepsStage {...content} />
