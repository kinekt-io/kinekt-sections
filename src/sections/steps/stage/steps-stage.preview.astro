const fields = {
  "theme": {
    "kind": "select"
  },
  "intro": {
    "kind": "component",
    "id": "components/intro/allentown",
    "role": "intro",
    "fields": {
      "accentHeading": {
        "kind": "text"
      },
      "heading": {
        "kind": "text"
      },
      "description": {
