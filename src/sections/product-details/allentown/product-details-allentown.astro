---
import '../../../styles/wireframe-tokens.css'
import ProductDetailItem, { type ProductDetailItemContent } from '../../../components/product-detail-item/allentown/product-detail-item-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import type { Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaProductDetailsAllentownContent } from './product-details-allentown.types.js'

// The generated contract type is still `Record<string, unknown>`; these are the fields the renderer reads.
interface Props extends BetaProductDetailsAllentownContent {
  theme?: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | null }
  image?: Media | null
  detailLabel: string
  items: ProductDetailItemContent[]
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', intro, image, detailLabel, items = [], headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const detailLabelLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const itemHeadingLevel = ({ h1: 'h3', h2: 'h4', h3: 'h5' } as const)[headingLevel] ?? 'h4'
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const hasMedia = Boolean(image && typeof image === 'object' && typeof image.url === 'string')
const visibleItems = items.filter((item) => typeof item?.title === 'string' && item.title !== '')
---
<section class="product-details-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="product-details-allentown__container">
    <div class="product-details-allentown__lead">
      <header class="product-details-allentown__intro">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      {hasMedia && image && <KinektMedia media={image} class="product-details-allentown__media" imageClass="product-details-allentown__image" loading={mediaLoading} />}
    </div>

    <div class="product-details-allentown__details">
      {detailLabel && <SubtitleFlightPath text={detailLabel} as={detailLabelLevel} class="product-details-allentown__detail-label" />}
      {visibleItems.length > 0 && (
        <ul class="product-details-allentown__items" data-kinekt-disclosure-group>
          {visibleItems.map((item, index) => (
            <li class="product-details-allentown__item">
              <ProductDetailItem item={item} open={index === 0} headingLevel={itemHeadingLevel} />
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
<script>
  import { initializeKinektInteractions } from '../../../shared/interactions'
  initializeKinektInteractions()
</script>
