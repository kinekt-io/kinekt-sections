---
import ProductDetails from './product-details-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ Use cases',
    heading: 'When is a smart battery pack the right fit?',
    description: {
      html: '<p>Some platforms need more than energy alone. Tulip smart battery packs combine high-density performance with monitoring, communication and battery intelligence to give operators and engineering teams more visibility and control.</p>',
    },
  },
  image: {
    url: placeholder('placeholder-1600x900.svg'),
    alt: 'Smart battery pack on an integration bench',
    width: 1600,
    height: 900,
  },
  detailLabel: 'Technical building',
  items: [
    {
      title: 'Electrical performance',
      subtitle: 'Built around the power profile of your platform',
      description: 'Review the electrical characteristics that determine how the battery performs in your application, including voltage, capacity, energy content and continuous or peak discharge capability.',
      detailHeading: 'Electrical characteristics:',
      details: [
        { text: 'Nominal voltage' },
        { text: 'Capacity' },
        { text: 'Energy' },
        { text: 'Continuous discharge' },
        { text: 'Peak discharge' },
        { text: 'Operating voltage range' },
      ],
    },
    {
      title: 'Battery management',
      subtitle: 'Integrated monitoring and protection',
      description: 'The battery management system monitors every cell group and protects the pack against over-current, over-voltage and temperature limits during operation and charging.',
      detailHeading: 'Monitoring and protection:',
      details: [
        { text: 'Cell balancing' },
        { text: 'Over-current protection' },
        { text: 'Temperature monitoring' },
        { text: 'State of charge' },
      ],
    },
    {
      title: 'Communication',
      subtitle: 'Battery data available to the platform',
      description: 'Live battery data is shared with the platform over standard interfaces, so flight controllers and ground stations can act on accurate state information.',
      detailHeading: 'Interfaces:',
      details: [
        { text: 'CAN bus' },
        { text: 'SMBus' },
        { text: 'UART' },
      ],
    },
    {
      title: 'Mechanical integration',
      subtitle: 'Designed to fit the complete system',
      description: 'Enclosure, connectors and mounting points are designed around the available space, weight targets and service access of the platform.',
      detailHeading: 'Mechanical characteristics:',
      details: [
        { text: 'Dimensions' },
        { text: 'Weight' },
        { text: 'Connectors' },
        { text: 'Mounting' },
      ],
    },
    {
      title: 'Diagnostics & lifecycle',
      subtitle: 'Visibility beyond a single mission',
      description: 'Logged usage, cycle counts and fault history help teams plan maintenance and retire packs at the right moment.',
      detailHeading: 'Lifecycle data:',
      details: [
        { text: 'Cycle count' },
        { text: 'State of health' },
        { text: 'Fault log' },
      ],
    },
  ],
}
---
<ProductDetails {...content} />
