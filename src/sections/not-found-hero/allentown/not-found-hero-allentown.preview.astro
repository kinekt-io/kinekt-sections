---
import NotFoundHero from './not-found-hero-allentown.astro'

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ 404',
    heading: 'Page not found',
    description: 'Looks like this page took a wrong turn somewhere along the way. The link might be outdated, mistyped, or simply no longer exists.',
  },
  ctaGroup: {
    primaryButton: { label: 'Go back to the homepage', href: '/', icon: 'arrow-up-left' as const },
    secondaryButton: { label: 'Or contact us', href: '/contact', icon: 'arrow-right' as const },
  },
}
---
<NotFoundHero {...content} />
