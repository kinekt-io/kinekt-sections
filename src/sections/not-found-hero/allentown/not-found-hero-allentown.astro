---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { isSafeWebUrl } from '../../../urls.js'

// The generated types (not-found-hero-allentown.types.ts) are still a generic record; these are the fields the manifest declares.
interface Props {
  id?: string
  theme?: BetaTheme
  intro: SectionIntroContent
  ctaGroup?: CtaGroup | Cta[] | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  headingLevel?: 'h1' | 'h2'
}

const { id, theme = 'semi-light', intro, ctaGroup, headingLevel = 'h1' } = Astro.props
const actions = ctaGroupActions(ctaGroup)
for (const cta of actions) if (!isSafeWebUrl(cta.href)) throw new Error('ctaGroup buttons must use an HTTP(S) or root-relative URL.')
---
<section class="not-found-hero not-found-hero--allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="not-found-hero__container">
    <header class="not-found-hero__header">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>
    {actions.length > 0 && <div class="not-found-hero__actions">
      {actions.map((action, index) => {
        const icon = isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
        return <Button class="not-found-hero__action" size={index === 0 ? 'l' : undefined} href={action.href} label={action.label} style={action.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
      })}
    </div>}
  </div>
</section>
<style is:global>
  .not-found-hero.not-found-hero--allentown {
    --kiw--section-site-width: var(--kiw--not-found-hero-allentown-site-width, var(--website-width));
