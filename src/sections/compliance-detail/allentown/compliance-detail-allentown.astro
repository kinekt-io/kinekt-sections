  .compliance-detail-allentown .compliance-detail-allentown__cert-image { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 1 / 1; object-fit: var(--kiw--compliance-detail-allentown-cert-fit); border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
