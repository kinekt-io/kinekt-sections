  .compliance-detail-allentown .compliance-detail-allentown__detail-body { display: grid; gap: var(--kiw--compliance-detail-allentown-detail-body-gap); }
  .compliance-detail-allentown .compliance-detail-allentown__detail-description { color: var(--kiw--compliance-detail-allentown-detail-copy-color); font-size: var(--kiw--compliance-detail-allentown-detail-copy-size); line-height: var(--kinekt-component-text-line-height); }
  /* Rows are the shared checklist-item renderer (size m); Figma sets them in --primary like the copy above (subtle role). */
  .compliance-detail-allentown .compliance-detail-allentown__checklist { --kiw--checklist-item-allentown-text-color: var(--kiw--compliance-detail-allentown-detail-copy-color); display: grid; gap: var(--kiw--compliance-detail-allentown-checklist-gap); margin: 0; padding: 0; list-style: none; }
  .compliance-detail-allentown .compliance-detail-allentown__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--kiw--compliance-detail-allentown-actions-gap); }
  @media (max-width: 49.999rem) {
    .compliance-detail-allentown .compliance-detail-allentown__detail-heading { line-height: 1.2; }
  }
