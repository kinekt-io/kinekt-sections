  .compliance-detail-allentown .compliance-detail-allentown__image { display: block; inline-size: 100%; block-size: auto; aspect-ratio: var(--kiw--compliance-detail-allentown-media-ratio); object-fit: cover; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
