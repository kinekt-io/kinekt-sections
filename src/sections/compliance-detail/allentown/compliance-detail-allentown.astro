    --kiw--section-text-font-family: var(--kiw--compliance-detail-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--compliance-detail-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--compliance-detail-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--compliance-detail-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--compliance-detail-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--compliance-detail-allentown-text-xs-size, var(--text-xs));
