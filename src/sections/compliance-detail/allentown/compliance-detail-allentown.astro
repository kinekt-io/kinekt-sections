---
import '../../../styles/wireframe-tokens.css'
import ChecklistItem, { type ChecklistItemContent } from '../../../components/checklist-item/allentown/checklist-item-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type Media, type RichText, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import { isSafeWebUrl } from '../../../urls.js'

// The generated types (compliance-detail-allentown.types.ts) are still a generic record; these are the fields the manifest declares,
// plus two optional renderer props for the detail column's title and copy, which Figma shows but the contract has no fields for (contract gap).
/** Rich text as it arrives: a plain string, pre-rendered `{ html }`, or raw Lexical JSON from the identity Payload adapter. */
type RichTextInput = string | RichText | Record<string, unknown>
interface Props {
  /** Stable section anchor (runtime `sectionAnchor`); Compliance Overview's collage links to it. */
  id?: string
  theme?: BetaTheme
  headingLevel?: 'h2' | 'h3'
  intro: Omit<SectionIntroContent, 'description'> & { description?: RichTextInput | null }
  checklistItems: ChecklistItemContent[]
  ctaGroup?: CtaGroup | Cta[] | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  certImage?: Media | null
  media?: Media | null
  /** Renderer-only (no contract field yet): the h4-sized title above the detail copy. */
  detailHeading?: string
  /** Renderer-only (no contract field yet): the copy between the detail title and the checklist. */
  detailDescription?: RichTextInput | null
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'semi-light', headingLevel = 'h2', intro, checklistItems = [], ctaGroup, certImage, media, detailHeading, detailDescription, mediaLoading = 'lazy' } = Astro.props
const toHtml = (value: RichTextInput | null | undefined, field: string): string => {
  if (value == null || value === '') return ''
  if (typeof value === 'string') return value.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean).map((part) => richTextToHtml(part, field)).join('')
  if (typeof value.html === 'string') return value.html
  return richTextToHtml(value, field)
}
const introContent: SectionIntroContent = { ...intro, description: intro.description == null || typeof intro.description === 'string' ? intro.description ?? undefined : { html: toHtml(intro.description, 'intro.description') } }
const detailHtml = toHtml(detailDescription, 'detailDescription')
const DetailHeading = headingLevel === 'h2' ? 'h3' : 'h4'
const items = checklistItems.filter((item) => item?.text)
const ctas = ctaGroupActions(ctaGroup)
for (const cta of ctas) if (!isSafeWebUrl(cta.href)) throw new Error('ctaGroup buttons must use an HTTP(S) or root-relative URL.')
const iconOf = (cta: Cta) => (isCtaIcon(cta.icon) ? ctaIconPaths(cta.icon) : undefined)
const hasDetail = Boolean(detailHeading || detailHtml || items.length > 0 || ctas.length > 0)
---
<section class="compliance-detail-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="compliance-detail-allentown__container">
    <div class="compliance-detail-allentown__header">
      <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      {certImage?.url && <KinektMedia media={certImage} class="compliance-detail-allentown__cert" imageClass="compliance-detail-allentown__cert-image" loading={mediaLoading} />}
    </div>
    {(media?.url || hasDetail) && (
      <div class="compliance-detail-allentown__body">
        {media?.url && <KinektMedia media={media} class="compliance-detail-allentown__media" imageClass="compliance-detail-allentown__image" loading={mediaLoading} />}
        {hasDetail && (
          <div class="compliance-detail-allentown__detail">
            {(detailHeading || detailHtml || items.length > 0) && (
              <div class="compliance-detail-allentown__copy">
                {detailHeading && <DetailHeading class="compliance-detail-allentown__detail-heading">{detailHeading}</DetailHeading>}
                {(detailHtml || items.length > 0) && (
                  <div class="compliance-detail-allentown__detail-body">
                    {detailHtml && <div class="compliance-detail-allentown__detail-description" set:html={detailHtml} />}
                    {items.length > 0 && (
                      <ul class="compliance-detail-allentown__checklist">
                        {items.map((item) => <ChecklistItem item={item} size="m" />)}
                      </ul>
                    )}
                  </div>
                )}
              </div>
            )}
            {ctas.length > 0 && (
              <div class="compliance-detail-allentown__actions">
                {ctas.map((cta) => {
                  const icon = iconOf(cta)
                  return <Button class="compliance-detail-allentown__action" size="s" href={cta.href} label={cta.label} style={cta.style ?? 'clear'}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}</Button>
                })}
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</section>
<style is:global>
  .compliance-detail-allentown {
    --kiw--section-site-width: var(--kiw--compliance-detail-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--compliance-detail-allentown-content-width, var(--content-width));
