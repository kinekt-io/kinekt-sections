    --kiw--section-text-m-size: var(--kiw--compliance-detail-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--compliance-detail-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--compliance-detail-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--compliance-detail-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-canvas: var(--kiw--compliance-detail-allentown-canvas);
    --kiw--section-surface: var(--kiw--compliance-detail-allentown-surface);
    --kiw--section-ink: var(--kiw--compliance-detail-allentown-ink);
    --kiw--section-muted: var(--kiw--compliance-detail-allentown-muted);
    --kiw--section-line: var(--kiw--compliance-detail-allentown-line);
    --kiw--section-action: var(--kiw--compliance-detail-allentown-action);
    --kiw--section-action-text: var(--kiw--compliance-detail-allentown-action-text);
    --kiw--section-accent: var(--kiw--compliance-detail-allentown-accent);
    --kiw--section-action-icon: var(--kiw--compliance-detail-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--compliance-detail-allentown-subtle);
  }
</style>
