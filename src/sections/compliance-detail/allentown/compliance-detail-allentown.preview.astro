---
import ComplianceDetailAllentown from './compliance-detail-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-light' as const,
  id: 'un-38-3',
  intro: {
    accentHeading: '/ Transport safety',
    heading: 'UN 38.3 certified for safe transport',
    description: 'Every battery design passes the UN 38.3 test series before it ships. The tests cover altitude, temperature, vibration, shock, short circuit and overcharge, so your packs can travel by air, sea and road without extra paperwork.',
  },
  detailHeading: 'From supplier to finished battery',
  detailDescription: 'We test the cells we buy and the packs we build. Test summaries are available for every design, and we update them whenever a design change affects the results.',
  checklistItems: [
    { text: 'Cell-level test reports from qualified suppliers' },
    { text: 'Pack-level testing for every new design' },
    { text: 'Test summaries ready for your carrier' },
  ],
  ctaGroup: {
    primaryButton: { label: 'Read more on the government site', href: 'https://unece.org/transport/dangerous-goods', icon: 'arrow-right' as const },
  },
  certImage: {
    url: placeholder('placeholder-200x200.svg'),
    alt: 'UN 38.3 certification mark',
    width: 200,
    height: 200,
  },
  media: {
    url: placeholder('placeholder-688x406.svg'),
    alt: 'Battery pack on a vibration test bench',
    width: 688,
    height: 406,
  },
}
---
<ComplianceDetailAllentown {...content} />
