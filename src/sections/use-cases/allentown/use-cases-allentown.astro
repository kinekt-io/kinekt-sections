    </header>

    <div class="beta-use-cases-allentown__content">
      {sectionLabel && <SubtitleFlightPath class="beta-use-cases-allentown__label" text={sectionLabel} size="small" />}

      <div class="beta-use-cases-allentown__grid">
        {items.map((item) => (
          <UseCaseItem class="beta-use-cases-allentown__item" item={item} headingLevel={itemHeadingLevel} />
