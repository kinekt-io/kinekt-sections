---
import '../../../styles/wireframe.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { SectionIntro as SectionIntroContent, SectionTheme } from '../../../shared/content.js'

interface Cta {
  label: string
  href: string
}

interface UseCase {
  title: string
  description?: string | { html: string }
  ctaGroup?: {
    primaryButton?: Cta
  }
}

interface Props {
  id?: string
  theme?: SectionTheme
  intro: SectionIntroContent
  advantageHeading?: string
  gridHeading?: string
  items: UseCase[]
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const {
  id,
  theme = 'semi-light',
  intro,
  advantageHeading,
  gridHeading,
  items,
  headingLevel = 'h2',
} = Astro.props as Props
const sectionLabel = advantageHeading || gridHeading
---

<section class="beta-use-cases-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-use-cases-allentown__container">
    <header class="beta-use-cases-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
    </header>

    <div class="beta-use-cases-allentown__content">
      {sectionLabel && (
        <div class="beta-use-cases-allentown__label">
          <p>{sectionLabel}</p>
          <span aria-hidden="true"></span>
        </div>
      )}

      <div class="beta-use-cases-allentown__grid">
        {items.map((item) => (
          <article class="beta-use-cases-allentown__item">
            <h3>{item.title}</h3>
            {typeof item.description === 'string' && <p>{item.description}</p>}
            {item.description && typeof item.description === 'object' && <div class="beta-use-cases-allentown__description" set:html={item.description.html} />}
            {item.ctaGroup?.primaryButton?.label && item.ctaGroup.primaryButton.href && (
              <a class="beta-use-cases-allentown__cta" href={item.ctaGroup.primaryButton.href}>
                {item.ctaGroup.primaryButton.label}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
