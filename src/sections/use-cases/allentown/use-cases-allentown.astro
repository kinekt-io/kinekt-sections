type UseCase = UseCaseItemContent

interface Props {
  id?: string
  theme?: SectionTheme
  intro: SectionIntroContent
  advantageHeading?: string
  items: UseCase[]
  headingLevel?: 'h1' | 'h2' | 'h3'
