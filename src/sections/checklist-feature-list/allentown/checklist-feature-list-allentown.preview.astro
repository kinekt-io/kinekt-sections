const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ Supply chain',
    heading: 'Trusted and robust supply chain',
    description: {
      html: '<p>Reliable battery production depends on more than strong engineering. Tulip builds long-term supplier relationships, qualifies critical components and maintains traceability across the supply chain.</p><ul><li>Long-term relationships with qualified cell suppliers</li><li>Traceability from incoming components to finished packs</li><li>Second sources for critical parts where it matters</li></ul>',
    },
  },
  features: [
