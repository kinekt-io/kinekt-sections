---
import ChecklistFeatureListAllentown from './checklist-feature-list-allentown.astro'

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ Supply chain',
    heading: 'Trusted and robust supply chain',
    description: 'Reliable battery production depends on more than strong engineering. Tulip builds long-term supplier relationships, qualifies critical components and maintains traceability across the supply chain to support consistent quality and dependable production.',
  },
  checklist: [
    { text: 'Long-term relationships with qualified cell suppliers' },
    { text: 'Traceability from incoming components to finished packs' },
    { text: 'Second sources for critical parts where it matters' },
  ],
  features: [
    { title: 'Supplier network', description: 'Selected suppliers provide reliable access to critical components while supporting quality, availability and long-term continuity.' },
    { title: 'Component validation', description: 'Critical components are validated before production to reduce risk and ensure they meet required specifications.' },
    { title: 'Tulip production', description: 'Controlled production processes deliver consistent battery builds while supporting growth from smaller to larger volumes.' },
  ],
}
---
<ChecklistFeatureListAllentown {...content} />
