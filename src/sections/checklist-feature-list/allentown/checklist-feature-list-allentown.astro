---
import '../../../styles/wireframe-tokens.css'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

// The generated types (checklist-feature-list-allentown.types.ts) are still a generic record; these are the fields the manifest declares.
// Feature items are built here (Figma "Step Description" in "The 5 steps"); components/feature-item/allentown is also referenced by media-feature-list, so its extraction is a proposal.
/** Rich text as it arrives: a plain string, pre-rendered `{ html }`, or raw Lexical JSON from the identity Payload adapter. */
type RichTextInput = string | RichText | Record<string, unknown>
interface FeatureItem { title: string; description?: RichTextInput | null }
interface Props {
  id?: string
  theme?: BetaTheme
  headingLevel?: 'h2' | 'h3'
  intro: Omit<SectionIntroContent, 'description'> & { description?: RichTextInput | null }
  features: FeatureItem[]
  /** Runtime `featureDividers` (renderer presentation): dividers between feature items, as in Figma. */
  featureDividers?: boolean
}

const { id, theme = 'semi-light', headingLevel = 'h2', intro, features = [], featureDividers = true } = Astro.props
const FeatureHeading = headingLevel === 'h2' ? 'h3' : 'h4'
const featureItems = features.filter((feature) => feature?.title)
const toHtml = (value: RichTextInput | null | undefined, field: string): string => {
  if (value == null || value === '') return ''
  if (typeof value === 'string') return value.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean).map((part) => richTextToHtml(part, field)).join('')
  if (typeof value.html === 'string') return value.html
  return richTextToHtml(value, field)
}
const introContent: SectionIntroContent = { ...intro, description: intro.description == null || typeof intro.description === 'string' ? intro.description ?? undefined : { html: toHtml(intro.description, 'intro.description') } }
---
<section class:list={['checklist-feature-list-allentown', featureDividers && 'checklist-feature-list-allentown--dividers']} id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="checklist-feature-list-allentown__container">
    <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
    {featureItems.length > 0 && (
      <ul class="checklist-feature-list-allentown__features">
        {featureItems.map((feature) => (
          <li class="checklist-feature-list-allentown__feature">
            <FeatureHeading class="checklist-feature-list-allentown__feature-title">{feature.title}</FeatureHeading>
            {feature.description && <div class="checklist-feature-list-allentown__feature-description" set:html={toHtml(feature.description, 'features.description')} />}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
