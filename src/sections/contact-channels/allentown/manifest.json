{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/contact-channels/allentown",
  "slug": "contact-channels-allentown",
  "title": "Contact Channels Allentown",
  "description": "A compact two-column contact section with availability details, a privacy note and one or two direct contact actions.",
  "category": "sections",
  "tags": ["conversion", "contact", "beta"],
  "role": "contact-channels",
  "variation": "allentown",
  "status": "beta",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-773926&m=dev",
    "nodeId": "5744:773926"
  },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "dark", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "contactHeading": { "kind": "text", "required": true, "localized": true },
    "availability": { "kind": "richText", "required": true, "localized": true, "description": "Availability or response-time details shown below the contact heading." },
    "privacyNote": { "kind": "text", "required": false, "localized": true, "description": "Optional short privacy or handling reassurance shown with a renderer-owned shield icon." },
    "actions": { "kind": "ctaGroup", "required": true, "localized": true, "minItems": 1, "maxItems": 2, "description": "Add one or two direct contact actions. Set each action’s style, label and Content, URL or Form target." }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" },
    "privacyIcon": { "kind": "shield", "source": "renderer" }
  }
}
