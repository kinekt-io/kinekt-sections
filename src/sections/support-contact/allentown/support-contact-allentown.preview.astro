---
import SupportContactAllentown from './support-contact-allentown.astro'

const intro = {
  accentHeading: 'Technical support',
  heading: 'Get support from our team',
  description: 'Need help with a battery, integration question or technical issue? Share the details with our team and we will connect you with the right person.',
}
---

<SupportContactAllentown
  theme="dark"
  intro={intro}
  contactHeading="Get in touch with us directly"
  contactMethods={[
    { icon: 'email', label: 'support@tulip.tech', href: 'mailto:support@tulip.tech' },
    { icon: 'phone', label: '+31 6 123 456 78', href: 'tel:+31612345678' },
  ]}
  formHeading="Or send a support request"
/>
