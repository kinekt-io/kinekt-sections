---
// @generated structural section preview.
import StructuralSection from '../../../shared/structural-section.astro'

const content = {
  "theme": "light",
  "intro": {
    "accentHeading": "Engineering energy storage for demanding applications",
    "heading": "Engineering energy storage for demanding applications",
    "description": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
  },
  "contactHeading": "Engineering energy storage for demanding applications",
  "contactMethods": [
    {
      "icon": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content.",
      "label": "Battery systems",
      "href": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
    },
    {
      "icon": "Use this space to explain the decision, the technical context and the next step without reducing the layout to placeholder labels.",
      "label": "Built for the field",
      "href": "Use this space to explain the decision, the technical context and the next step without reducing the layout to placeholder labels."
    },
    {
      "icon": "Every example uses realistic-length content so hierarchy, reading rhythm and responsive behaviour are visible before site-specific styling is applied.",
      "label": "From cell to system",
      "href": "Every example uses realistic-length content so hierarchy, reading rhythm and responsive behaviour are visible before site-specific styling is applied."
    }
  ],
  "formHeading": "Engineering energy storage for demanding applications",
  "form": {
    "name": "Project enquiry",
    "description": "A governed form reference for product, engineering and partnership enquiries."
  }
}
const fields = {
  "theme": {
    "kind": "select"
  },
  "intro": {
    "kind": "component",
    "id": "components/intro/allentown",
    "role": "intro",
    "fields": {
      "accentHeading": {
        "kind": "text"
      },
      "heading": {
        "kind": "text"
      },
      "description": {
        "kind": "richText"
      }
    }
  },
  "contactHeading": {
    "kind": "text"
  },
  "contactMethods": {
    "kind": "componentList",
    "id": "components/contact-method/allentown",
    "role": "contact-method",
    "fields": {
      "icon": {
        "kind": "text"
      },
      "label": {
        "kind": "text"
      },
      "href": {
        "kind": "text"
      }
    }
  },
  "formHeading": {
    "kind": "text"
  },
  "form": {
    "kind": "formReference"
  }
}
const intro = {
  "accentHeading": "Engineering energy storage for demanding applications",
  "heading": "Engineering energy storage for demanding applications",
  "description": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
}
const ctas = undefined
const media = undefined
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`

function resolveCatalogueAssets(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(resolveCatalogueAssets)
  if (!value || typeof value !== 'object') return value
  const record = Object.fromEntries(Object.entries(value).map(([key, item]) => [key, resolveCatalogueAssets(item)]))
  if (typeof record.url === 'string' && record.url.startsWith('catalogue-placeholder:')) {
    record.url = `${catalogueBase}placeholders/${record.url.slice('catalogue-placeholder:'.length)}`
  }
  return record
}

const resolvedContent = resolveCatalogueAssets(content) as Record<string, unknown>
---
<StructuralSection block="beta-support-contact-allentown" intro={intro} ctas={ctas} media={media} content={resolvedContent} fields={fields} />
