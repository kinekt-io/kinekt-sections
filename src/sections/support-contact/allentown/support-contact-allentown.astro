---
import '../../../styles/wireframe-tokens.css'
import { fas } from '@fortawesome/free-solid-svg-icons'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import FormEmbed from '../../../components/form-embed/allentown/form-embed-allentown.astro'
import ContactIcon from '../../../primitives/contact-icon/contact-icon.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaIconPaths } from '../../../shared/cta-icons.js'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'

interface ContactMethod {
  icon?: 'whatsapp' | 'phone' | 'email'
  label: string
  href: string
}

interface Props {
  id?: string
  theme?: 'light' | 'semi-light' | 'semi-dark' | 'dark'
  intro: SectionIntroContent
  contactHeading?: string
  contactMethods?: ContactMethod[]
  formHeading?: string
  /** HubSpot embed code (manifest kind formEmbed). */
  form?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const {
  id,
  theme = 'semi-dark',
  intro,
  contactHeading,
  contactMethods = [],
  formHeading = 'Send a support request',
  form,
  headingLevel = 'h2',
} = Astro.props as Props

const methods = contactMethods.filter((method) => method.label && method.href)
const chevronDown = fas.faChevronDown.icon
const submitIcon = ctaIconPaths['paper-plane']
---

<section class="beta-support-contact-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-support-contact-allentown__container">
    <header class="beta-support-contact-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>

    <div class="beta-support-contact-allentown__support">
      {methods.length > 0 && (
        <section class="beta-support-contact-allentown__direct">
          {contactHeading && <h3 class="beta-support-contact-allentown__direct-heading">{contactHeading}</h3>}
          <ul class="beta-support-contact-allentown__contact-methods">
            {methods.map((method) => (
              <li class="beta-support-contact-allentown__contact-method">
                <Button href={method.href} label={method.label} class="beta-support-contact-allentown__contact-link">
                  {method.icon && <ContactIcon name={method.icon} />}
                </Button>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="beta-support-contact-allentown__request">
        <h3 class="beta-support-contact-allentown__request-heading">{formHeading}</h3>
        <FormEmbed form={form}>
          <form action="#" method="post">
            <div class="form-embed-allentown__fields">
              <div class="form-embed-allentown__row">
                <label>First name <input name="given-name" autocomplete="given-name" placeholder="Morgan" required /></label>
                <label>Last name <input name="family-name" autocomplete="family-name" placeholder="Reed" required /></label>
              </div>
              <div class="form-embed-allentown__row">
                <label>Company name <input name="organization" autocomplete="organization" placeholder="Company X" /></label>
                <label>Email address <input name="email" type="email" autocomplete="email" placeholder="morgan.reed@example.com" required /></label>
              </div>
              <label>Subject <input name="subject" placeholder="What is it about?" required /></label>
              <div class="form-embed-allentown__row">
                <label>Type of battery
                  <span class="form-embed-allentown__select">
                    <select name="battery-type"><option value="">Select type of battery</option></select>
                    <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={`0 0 ${chevronDown[0]} ${chevronDown[1]}`} fill="currentColor"><path d={chevronDown[4] as string} /></svg>
                  </span>
                </label>
                <label>Support category
                  <span class="form-embed-allentown__select">
                    <select name="support-category"><option value="">Choose a category</option></select>
                    <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={`0 0 ${chevronDown[0]} ${chevronDown[1]}`} fill="currentColor"><path d={chevronDown[4] as string} /></svg>
                  </span>
                </label>
              </div>
              <label>How can we help? <textarea name="message" placeholder="Type here..." required></textarea></label>
            </div>
            <button type="submit">Send request <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={submitIcon.viewBox} fill="none"><path d={submitIcon.path} stroke="currentColor" stroke-width="2" /></svg></button>
          </form>
        </FormEmbed>
      </section>
    </div>
  </div>
</section>
<style is:global>
  .beta-support-contact-allentown {
    --kiw--section-site-width: var(--kiw--support-contact-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--support-contact-allentown-content-width, var(--content-width));
