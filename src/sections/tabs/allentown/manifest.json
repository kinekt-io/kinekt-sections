{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/tabs/allentown",
  "slug": "tabs-allentown",
  "title": "Tabs Allentown",
  "description": "Accessible contact tabs with optional introductions, action groups and form embeds.",
  "category": "sections",
  "tags": ["content", "navigation", "forms", "beta"],
  "role": "tabs",
  "variation": "allentown",
  "status": "beta",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-773783",
    "nodeId": "5744:773783"
  },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "light", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "tabsHeading": { "kind": "text", "required": false, "localized": true, "description": "Optional prompt above the tab navigation." },
    "tabs": { "kind": "componentList", "componentId": "components/tab-item/allentown", "required": true, "localized": true, "minItems": 1, "admin": { "initCollapsed": true } }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" },
    "initialActiveTab": { "kind": "firstItem", "source": "renderer" },
    "tabSemantics": { "kind": "accessibleTabs", "source": "renderer" }
  }
}
