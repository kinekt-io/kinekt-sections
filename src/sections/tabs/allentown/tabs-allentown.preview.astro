---
import TabsAllentown from './tabs-allentown.astro'
import { ctaIconPaths } from '../../../shared/cta-icons.js'
const send = ctaIconPaths('paper-plane')!
const form = `<form class="form-embed-allentown__form">
  <div class="form-embed-allentown__fields">
    <label>Your name<input name="name" autocomplete="name" placeholder="Morgan Reed" /></label>
    <div class="form-embed-allentown__row">
      <label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="+1 202-555-0147" /></label>
      <label>Country<select name="country" autocomplete="country-name"><option value="">Select country</option><option>United States</option><option>Netherlands</option></select></label>
    </div>
    <div class="form-embed-allentown__row">
      <label>Email address (optional)<input name="email" type="email" autocomplete="email" placeholder="morgan@example.com" /></label>
      <label>Company name (optional)<input name="company" autocomplete="organization" placeholder="Northfield Studio" /></label>
    </div>
  </div>
  <button type="button">Send request <svg aria-hidden="true" width="1em" height="1em" viewBox="${send.viewBox}" fill="currentColor"><path d="${send.path}" /></svg></button>
</form>`
const tabs = [
  { label: 'Message our team', intro: { description: 'Connect with an adviser to discuss your next project. Our team responds during weekday office hours.' }, ctaGroup: { buttons: [
    { label: 'Start a conversation', href: '/contact/', style: 'primary' as const, icon: 'comments' },
    { label: 'Schedule a call', href: '/appointments/', style: 'secondary' as const, icon: 'calendar' },
  ] } },
  { label: 'Contact details', intro: { accentHeading: 'Local support', heading: 'Speak with our service team', description: 'Monday to Friday, 9:00–17:00. We can help with project planning, service questions and delivery arrangements.' }, ctaGroup: { buttons: [
    { label: '+1 202-555-0147', href: 'tel:+12025550147', style: 'primary' as const, icon: 'phone' },
    { label: 'hello@example.com', href: 'mailto:hello@example.com', style: 'secondary' as const, icon: 'envelope' },
  ] } },
  { label: 'Send a request', form },
]
---
<TabsAllentown contentWidth="80" theme="light" intro={{ accentHeading: 'Get in touch', heading: 'Talk with our local support team' }} tabsHeading="How would you like to get in touch?" tabs={tabs} />
