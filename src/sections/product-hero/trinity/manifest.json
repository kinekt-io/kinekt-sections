{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/product-hero/trinity",
  "slug": "product-hero-trinity",
  "title": "Product Hero Trinity",
  "description": "A product-list hero with an intro, optional featured flightpath, reusable battery comparison cards and optional actions below the list.",
  "category": "sections",
  "tags": ["product", "hero", "catalogue", "prerelease"],
  "role": "product-hero",
  "variation": "trinity",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-772818&m=dev",
    "nodeId": "5744:772818"
  },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "dark", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "catalogueCta": { "kind": "cta", "required": false, "localized": true, "description": "Optional heading action, preserving the Battery Models Trinity contract." },
    "featuredLabel": { "kind": "text", "required": false, "localized": true, "description": "Featured label between the intro and model list. Leave blank to omit both the label and flightpath." },
    "models": { "kind": "componentList", "componentId": "components/battery-card/trinity", "required": true, "localized": true, "minItems": 1 },
    "ctaGroup": { "kind": "component", "componentId": "components/cta-group/allentown", "required": false, "localized": true, "description": "Zero to two styled actions below the model list, without a callout." }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" }
  }
}
