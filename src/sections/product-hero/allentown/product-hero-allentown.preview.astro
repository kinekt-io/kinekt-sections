---
import ProductHero from './product-hero-allentown.astro'

const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'dark' as const,
  intro: {
    accentHeading: '/ Battery info',
    heading: 'Battery packs built for the field',
    description: 'High-density lithium-ion packs for drones and unmanned systems, engineered around your duty cycle, form factor and certification needs.',
  },
  featureListTitle: 'Key specs at a glance:',
  featurePairs: [
    { label: 'High energy density', value: 'Up to 300 Wh/kg' },
    { label: 'Custom form factor', value: 'Built to your airframe' },
    { label: 'Certified for transport', value: 'UN 38.3 tested' },
  ],
  ctaGroup: {
    primaryButton: { label: 'Buy now in the webshop', href: '/webshop', icon: 'arrow-right' as const },
    secondaryButton: { label: 'Download specs', href: '/downloads/battery-specs.pdf', icon: 'download' as const },
  },
  media: { url: placeholder('placeholder-864x615.svg'), alt: 'Three battery packs with connector leads', width: 864, height: 615 },
}
---
<ProductHero {...content} />
