---
import '../../../styles/wireframe-tokens.css'
import { faCheck } from '@fortawesome/free-solid-svg-icons'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Cta, Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { isSafeWebUrl } from '../../../urls.js'

// The generated types (product-hero-allentown.types.ts) are still a generic record; these are the fields the manifest declares.
interface FeaturePair {
  label: string
  value: string
}

interface Props {
  id?: string
  theme?: BetaTheme
  headingLevel?: 'h1' | 'h2'
  intro: SectionIntroContent
  featureListTitle?: string
  featurePairs?: FeaturePair[]
  ctaGroup?: { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  media: unknown
  mobileMedia?: unknown
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'dark', headingLevel = 'h1', intro, featureListTitle, featurePairs = [], ctaGroup, media, mobileMedia, mediaLoading = 'eager' } = Astro.props as Props

const primary = ctaGroup?.primaryButton ?? undefined
const secondary = ctaGroup?.secondaryButton ?? undefined
for (const cta of [primary, secondary]) if (cta && !isSafeWebUrl(cta.href)) throw new Error('ctaGroup buttons must use an HTTP(S) or root-relative URL.')
const primaryIcon = primary && isCtaIcon(primary.icon) ? ctaIconPaths[primary.icon] : undefined
const secondaryIcon = secondary && isCtaIcon(secondary.icon) ? ctaIconPaths[secondary.icon] : undefined

// The Payload adapter passes media through unchanged, so it may arrive as an ID; render only resolved, safe media objects.
const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string' && isSafeWebUrl((value as Media).url)
const heroMedia = isMedia(media) ? { ...media, alt: typeof media.alt === 'string' ? media.alt : '' } : undefined
const heroMobileMedia = isMedia(mobileMedia) ? { ...mobileMedia, alt: typeof mobileMedia.alt === 'string' ? mobileMedia.alt : '' } : undefined

const pairs = featurePairs.filter((pair) => pair && typeof pair.label === 'string' && pair.label.trim())
const [checkWidth, checkHeight, , , checkPath] = faCheck.icon
---
<section class="product-hero-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="product-hero-allentown__container">
    <div class="product-hero-allentown__content">
      <header class="product-hero-allentown__header">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      {(featureListTitle || pairs.length > 0) && <div class="product-hero-allentown__features">
        {featureListTitle && <p class="product-hero-allentown__features-title">{featureListTitle}</p>}
        {pairs.length > 0 && <dl class="product-hero-allentown__feature-list">
          {pairs.map((pair) => (
            <div class="product-hero-allentown__feature">
              <dt class="product-hero-allentown__feature-label"><svg class="product-hero-allentown__check" aria-hidden="true" focusable="false" viewBox={`0 0 ${checkWidth} ${checkHeight}`}><path d={checkPath as string} /></svg>{pair.label}</dt>
              {pair.value && <dd class="product-hero-allentown__feature-value">{pair.value}</dd>}
            </div>
          ))}
        </dl>}
      </div>}
      {(primary || secondary) && <hr class="product-hero-allentown__divider" />}
      {(primary || secondary) && <div class="product-hero-allentown__actions">
        {primary && <Button class="product-hero-allentown__action product-hero-allentown__action--primary" href={primary.href} label={primary.label}>{primaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={primaryIcon.viewBox} fill="none"><path d={primaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
        {secondary && <Button class="product-hero-allentown__action product-hero-allentown__action--secondary" href={secondary.href} label={secondary.label} style="clear">{secondaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={secondaryIcon.viewBox} fill="none"><path d={secondaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
      </div>}
    </div>
    {heroMedia && <KinektMedia media={heroMedia} mobileMedia={heroMobileMedia} class="product-hero-allentown__media" imageClass="product-hero-allentown__image" loading={mediaLoading} fetchpriority={mediaLoading === 'eager' ? 'high' : undefined} />}
  </div>
</section>
<style is:global>
  .product-hero-allentown {
    --kiw--section-site-width: var(--kiw--product-hero-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--product-hero-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--product-hero-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--product-hero-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--product-hero-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--product-hero-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--product-hero-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--product-hero-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--product-hero-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--product-hero-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--product-hero-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--product-hero-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--product-hero-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--product-hero-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--product-hero-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--product-hero-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--product-hero-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--product-hero-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--product-hero-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--product-hero-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--product-hero-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--product-hero-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--product-hero-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--product-hero-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--product-hero-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--product-hero-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--product-hero-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--product-hero-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--product-hero-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--product-hero-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--product-hero-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--product-hero-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--product-hero-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--product-hero-allentown-actions-gap, var(--space-s));
    --kiw--section-actions-margin: var(--kiw--product-hero-allentown-actions-margin, var(--space-xl));
    --kiw--section-button-height: var(--kiw--product-hero-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--product-hero-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--product-hero-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--product-hero-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--product-hero-allentown-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--product-hero-allentown-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--product-hero-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--product-hero-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--product-hero-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--product-hero-allentown-canvas);
    --kiw--section-surface: var(--kiw--product-hero-allentown-surface);
    --kiw--section-ink: var(--kiw--product-hero-allentown-ink);
    --kiw--section-muted: var(--kiw--product-hero-allentown-muted);
    --kiw--section-line: var(--kiw--product-hero-allentown-line);
    --kiw--section-action: var(--kiw--product-hero-allentown-action);
    --kiw--section-action-text: var(--kiw--product-hero-allentown-action-text);
    --kiw--section-accent: var(--kiw--product-hero-allentown-accent);
    --kiw--section-action-icon: var(--kiw--product-hero-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--product-hero-allentown-subtle);
  }
</style>
<style is:global>
  :where(.product-hero-allentown) {
    --kiw--product-hero-container-width: var(--content-width);
    --kiw--product-hero-content-width: var(--width-m);
    --kiw--product-hero-column-gap: 0px;
    --kiw--product-hero-row-gap: var(--section-space-m);
    --kiw--product-hero-content-gap: var(--space-xxl);
    --kiw--product-hero-intro-gap: var(--space-m);
    --kiw--product-hero-heading-stack-gap: var(--space-xxs);
    --kiw--product-hero-heading-size: var(--kiw--section-heading-1-size);
    --kiw--product-hero-heading-line-height: 1.05;
    --kiw--product-hero-description-size: var(--text-l);
    --kiw--product-hero-description-color: var(--kinekt-component-muted);
    --kiw--product-hero-features-gap: var(--space-l);
    --kiw--product-hero-features-title-size: var(--text-xl);
    /* Figma "Aeonik Pro SemiBold"; there is no semibold weight token. */
    --kiw--product-hero-features-title-font-weight: 600;
    --kiw--product-hero-feature-list-gap: var(--space-m);
    --kiw--product-hero-feature-gap: var(--space-xs);
    --kiw--product-hero-feature-size: var(--text-l);
    --kiw--product-hero-feature-line-height: 1;
    --kiw--product-hero-feature-label-color: var(--kinekt-component-ink);
    --kiw--product-hero-feature-value-color: var(--kinekt-component-muted);
    --kiw--product-hero-check-size: var(--text-m);
    /* Figma colours the checks accent-semi-dark on this dark frame (the dark accent role is --accent); on light themes it equals the accent role. */
    --kiw--product-hero-check-color: var(--accent-semi-dark);
    --kiw--product-hero-divider-color: var(--kinekt-component-line);
    --kiw--product-hero-actions-gap: var(--space-l);
    --kiw--product-hero-media-ratio: 864 / 615;
    --kinekt-section-content-width: var(--kiw--product-hero-container-width);
  }
  .product-hero-allentown > .product-hero-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kiw--product-hero-row-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .product-hero-allentown :is(h1, h2, h3, h4, h5, h6, p, dl, dt, dd) { margin: 0; }
  .product-hero-allentown .product-hero-allentown__content { display: grid; justify-items: start; gap: var(--kiw--product-hero-content-gap); min-width: 0; }
  .product-hero-allentown .product-hero-allentown__header { width: 100%; min-width: 0; }
  .product-hero-allentown .section-intro { display: grid; justify-items: start; gap: var(--kiw--product-hero-intro-gap); }
  .product-hero-allentown .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .product-hero-allentown .section-intro__heading-group { display: grid; gap: var(--kiw--product-hero-heading-stack-gap); width: 100%; }
  .product-hero-allentown .section-intro__heading { max-width: none; font-size: var(--kiw--product-hero-heading-size); line-height: var(--kiw--product-hero-heading-line-height); }
  .product-hero-allentown .section-intro__description { max-width: none; color: var(--kiw--product-hero-description-color); font-size: var(--kiw--product-hero-description-size); line-height: var(--kinekt-component-text-line-height); }
  .product-hero-allentown .section-intro__description > * { margin-block: 0; }
  .product-hero-allentown .product-hero-allentown__features { display: grid; gap: var(--kiw--product-hero-features-gap); width: 100%; min-width: 0; }
  .product-hero-allentown .product-hero-allentown__features-title { color: var(--kinekt-component-ink); font-size: var(--kiw--product-hero-features-title-size); font-weight: var(--kiw--product-hero-features-title-font-weight); line-height: 1; }
  .product-hero-allentown .product-hero-allentown__feature-list { display: grid; gap: var(--kiw--product-hero-feature-list-gap); }
  .product-hero-allentown .product-hero-allentown__feature { position: relative; display: flex; flex-wrap: wrap; column-gap: var(--kiw--product-hero-feature-gap); row-gap: var(--space-xxs); padding-inline-start: calc(var(--kiw--product-hero-check-size) + var(--kiw--product-hero-feature-gap)); font-size: var(--kiw--product-hero-feature-size); line-height: var(--kiw--product-hero-feature-line-height); }
  .product-hero-allentown .product-hero-allentown__feature-label { color: var(--kiw--product-hero-feature-label-color); }
  .product-hero-allentown .product-hero-allentown__feature-value { color: var(--kiw--product-hero-feature-value-color); }
  .product-hero-allentown .product-hero-allentown__check { position: absolute; inset-block-start: calc((1lh - var(--kiw--product-hero-check-size)) / 2); inset-inline-start: 0; inline-size: var(--kiw--product-hero-check-size); block-size: var(--kiw--product-hero-check-size); fill: var(--kiw--product-hero-check-color); }
  .product-hero-allentown .product-hero-allentown__divider { width: 100%; height: 0; margin: 0; border: 0; border-block-start: var(--kinekt-component-border-width) solid var(--kiw--product-hero-divider-color); }
  .product-hero-allentown .product-hero-allentown__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--kiw--product-hero-actions-gap); }
  .product-hero-allentown .product-hero-allentown__media { display: block; min-width: 0; }
  .product-hero-allentown .product-hero-allentown__image { display: block; inline-size: 100%; max-inline-size: 100%; height: auto; aspect-ratio: var(--kinekt-section-media-ratio, var(--kiw--product-hero-media-ratio)); object-fit: cover; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  @media (max-width: 49.999rem) {
    /* Figma's line-height 1 assumes single-line rows; give wrapped rows room on narrow screens. */
    .product-hero-allentown { --kiw--product-hero-feature-line-height: 1.3; }
  }
  @media (min-width: 50rem) {
    .product-hero-allentown > .product-hero-allentown__container { grid-template-columns: minmax(0, var(--kiw--product-hero-content-width)) minmax(0, 1fr); align-items: center; column-gap: var(--kiw--product-hero-column-gap); }
  }
</style>
<style is:global>
