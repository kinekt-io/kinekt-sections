{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/product-hero/allentown",
  "slug": "product-hero-allentown",
  "title": "Product Hero Allentown",
  "description": "A reusable product hero with introductory content, product feature items, actions and responsive media.",
  "category": "sections",
  "tags": ["product", "hero", "beta"],
  "role": "product-hero",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5255-538028&t=OtYEVTRRdAJJYQ0v-11",
    "nodeId": "5255:538028"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "featureListTitle": {
      "kind": "text",
      "required": true,
      "localized": true
    },
    "features": {
      "kind": "featureItems",
      "required": true,
      "localized": true,
      "minItems": 1,
      "description": "Short product features. The renderer supplies the check marker."
    },
    "ctaGroup": {
      "kind": "component",
      "componentId": "components/cta-group/allentown",
      "required": true,
      "localized": true
    },
    "media": {
      "kind": "media",
      "required": true,
      "localized": true,
      "description": "Desktop hero media."
    },
    "mobileMedia": {
      "kind": "media",
      "required": false,
      "localized": true,
      "description": "Optional mobile-specific hero media."
    }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" },
    "mediaFit": { "kind": "coverMedia", "source": "renderer" }
  }
}
