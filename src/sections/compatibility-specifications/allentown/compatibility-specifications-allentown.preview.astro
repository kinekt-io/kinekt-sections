---
import CompatibilitySpecifications from './compatibility-specifications-allentown.astro'

const content = {
  theme: 'light' as const,
  intro: {
    accentHeading: '/ Drone compatibility',
    heading: 'Is this battery compatible with your drone?',
    description: 'Check the key requirements below to see whether this battery is a good fit for your platform. Compatibility depends on voltage, dimensions, weight, connector and power demand.',
  },
  specifications: [
    { label: 'Voltage', value: 'XX V / XXS' },
    { label: 'Dimensions', value: 'XXX × XX × XX mm' },
    { label: 'Weight', value: 'X.X kg' },
    { label: 'Connector', value: 'XT90 / AS150 / Custom' },
    { label: 'Power output', value: 'XX A continuous / XX A peak' },
  ],
  compatiblePlatforms: {
    heading: 'Compatible drones',
    items: ['Drone 1', 'Drone 2', 'Drone 3'],
  },
}
---
<CompatibilitySpecifications {...content} />
