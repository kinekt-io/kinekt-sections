    },
    {
      "label": "From cell to system",
      "value": "Every example uses realistic-length content so hierarchy, reading rhythm and responsive behaviour are visible before site-specific styling is applied."
    }
  ],
  "compatiblePlatforms": {
    "heading": "Engineering energy storage for demanding applications",
    "items": [
      {
        "name": "Engineering energy storage for demanding applications"
      },
      {
        "name": "Designed around the constraints that matter"
      },
      {
        "name": "Performance you can specify with confidence"
      }
    ]
  }
}
const fields = {
  "theme": {
    "kind": "select"
  },
  "intro": {
    "kind": "component",
    "id": "components/intro/allentown",
    "role": "intro",
    "fields": {
      "accentHeading": {
        "kind": "text"
      },
      "heading": {
        "kind": "text"
      },
      "description": {
        "kind": "richText"
      }
    }
  },
  "specifications": {
    "kind": "componentList",
    "id": "components/compatibility-specification-item/allentown",
    "role": "compatibility-specification-item",
    "fields": {
      "label": {
        "kind": "text"
      },
      "value": {
        "kind": "text"
      }
    }
  },
  "compatiblePlatforms": {
    "kind": "component",
    "id": "components/compatible-platform-list/allentown",
    "role": "compatible-platform-list",
    "fields": {
      "heading": {
        "kind": "text"
      },
      "items": {
        "kind": "componentList",
        "id": "components/compatible-platform-item/allentown",
        "role": "compatible-platform-item",
        "fields": {
          "name": {
            "kind": "text"
          }
        }
      }
    }
  }
}
const intro = {
  "accentHeading": "Engineering energy storage for demanding applications",
  "heading": "Engineering energy storage for demanding applications",
  "description": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
}
const ctas = undefined
const media = undefined
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`

function resolveCatalogueAssets(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(resolveCatalogueAssets)
  if (!value || typeof value !== 'object') return value
  const record = Object.fromEntries(Object.entries(value).map(([key, item]) => [key, resolveCatalogueAssets(item)]))
  if (typeof record.url === 'string' && record.url.startsWith('catalogue-placeholder:')) {
    record.url = `${catalogueBase}placeholders/${record.url.slice('catalogue-placeholder:'.length)}`
  }
  return record
}

const resolvedContent = resolveCatalogueAssets(content) as Record<string, unknown>
---
<StructuralSection block="beta-compatibility-specifications-allentown" intro={intro} ctas={ctas} media={media} content={resolvedContent} fields={fields} />
