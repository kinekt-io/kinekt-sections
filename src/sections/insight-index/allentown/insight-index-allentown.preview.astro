---
import InsightIndexAllentown from './insight-index-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name
const image = (alt: string) => ({ url: placeholder('placeholder-1600x900.svg'), alt, width: 1600, height: 900 })

const content = {
  theme: 'light' as const,
  subjects: [
    { id: 'high-density', label: 'High-density' },
    { id: 'battery-packs', label: 'Battery packs' },
    { id: 'custom-packs', label: 'Custom packs' },
    { id: 'smart-packs', label: 'Smart packs' },
    { id: 'tulip', label: 'Tulip' },
    { id: 'endurance', label: 'Endurance' },
  ],
  insightSources: [
    {
      title: 'How system constraints shape battery design',
      excerpt: 'Duty cycle, enclosure and thermal limits decide most of a pack before the first cell is chosen. A practical look at the trade-offs.',
      href: '#how-system-constraints-shape-battery-design',
      publishedAt: '2026-10-20',
      kind: 'Article',
      subjects: ['high-density', 'battery-packs'],
      image: image('Neutral wireframe placeholder for an engineering team reviewing test data'),
    },
    {
      title: 'Making validation data useful for integration teams',
      excerpt: 'The system is configured around the duty cycle, environmental demands and evidence needed for a reliable release.',
      href: '#making-validation-data-useful',
      publishedAt: '2026-10-14',
      kind: 'Article',
      subjects: ['smart-packs'],
      image: image('Neutral wireframe placeholder for a battery system integration'),
    },
    {
      title: 'Electrifying a regional bus fleet',
      excerpt: 'A custom high-density pack gave a regional operator the range for a full shift without changing the chassis.',
      href: '#electrifying-a-regional-bus-fleet',
      publishedAt: '2026-10-09',
      kind: 'Case',
      subjects: ['high-density', 'custom-packs'],
      image: image('Neutral wireframe placeholder for an electric bus at a depot'),
    },
    {
      title: 'Endurance testing for long-range drones',
      excerpt: 'How a survey-drone maker doubled flight time by matching cell chemistry to its mission profile.',
      href: '#endurance-testing-for-long-range-drones',
      publishedAt: '2026-10-02',
      kind: 'Case',
      subjects: ['endurance', 'high-density'],
      image: image('Neutral wireframe placeholder for a drone over farmland'),
    },
    {
      title: 'A practical guide to energy-storage specifications',
      excerpt: 'Structured content keeps performance requirements, technical context and implementation choices easy to compare.',
      href: '#a-practical-guide-to-energy-storage-specifications',
      publishedAt: '2026-09-25',
      kind: 'Article',
      subjects: ['battery-packs'],
      image: image('Neutral wireframe placeholder for technical documentation'),
    },
    {
      title: 'Why smart battery management pays off',
      excerpt: 'Cell-level monitoring and a clear communication protocol shorten integration and extend service life.',
      href: '#why-smart-battery-management-pays-off',
      publishedAt: '2026-09-18',
      kind: 'Article',
      subjects: ['smart-packs', 'tulip'],
      image: image('Neutral wireframe placeholder for a battery management board'),
    },
    {
      title: 'Powering an observatory off the grid',
      excerpt: 'A remote research site replaced its diesel generator with a modular pack sized for winter demand.',
      href: '#powering-an-observatory-off-the-grid',
      publishedAt: '2026-09-11',
      kind: 'Case',
      subjects: ['custom-packs', 'endurance'],
      image: image('Neutral wireframe placeholder for an observatory at dusk'),
    },
    {
      title: 'Inside the Tulip pack assembly line',
      excerpt: 'From cell sorting to end-of-line testing: how each pack is built and traced in our Dutch facility.',
      href: '#inside-the-tulip-pack-assembly-line',
