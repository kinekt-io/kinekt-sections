{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/insight-index/allentown",
  "slug": "insight-index-allentown",
  "title": "Insight Index Allentown",
  "description": "A reusable searchable and facet-filtered insight card index backed by selected platform-managed Insight Sources.",
  "category": "sections","tags":["insights","listing"],
  "role": "insight-index",
  "variation": "allentown",
  "status": "planned",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411675&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411675"
  },
  "fields": {
    "theme": {"kind":"select","required":true,"localized":false,"options":["light","semi-light","dark","semi-dark"],"description":"CMS-selected presentation setting passed to the renderer."},
    "insightSources": {
      "kind": "insightSourceList",
      "required": true,
      "localized": true,
      "minItems": 1,
      "description": "One or more active platform-managed Insight Sources to index."
    }
  },
  "runtimeProps": {
    "searchEngine": {
      "kind": "pagefind",
      "source": "renderer"
    },
    "searchFields": {
      "kind": "titleExcerptBody",
      "source": "renderer"
    },
    "facets": {
      "kind": "mediaTypeAndInsightSubject",
      "source": "renderer"
    },
    "facetMatching": {
      "kind": "orWithinFacetAndAcrossFacets",
      "source": "renderer"
    },
    "sorting": {
      "kind": "publishedDateAndTitle",
      "source": "renderer"
    },
    "pageSize": {
      "kind": "four",
      "source": "renderer"
    },
    "contentScope": {
      "kind": "activeRegionAndLocale",
      "source": "renderer"
    }
  }
}
