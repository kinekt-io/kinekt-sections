---
import '../../../styles/wireframe.css'
import Label from '../../../atoms/label/allentown/label-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media as KinektMediaValue } from '../../../shared/content'

interface Media {
  url?: string
  alt?: string
  width?: number
  height?: number
}

interface Cta {
  label?: string
  href?: string
  icon?: 'arrow-right' | 'arrow-down'
}

interface Result {
  label?: string
  value?: { text?: string; icon?: string }
}

interface CaseStudy {
  logo?: Media
  title?: string
  description?: string | { html?: string }
  image?: Media
  results?: Result[]
  quote?: {
    quote?: string
    authorName?: string
    authorRole?: string
    avatar?: Media
  }
  cta?: { cta?: Cta } | Cta
}

function isCta(value: unknown): value is Cta {
  return typeof value === 'object' && value !== null
    && typeof (value as Cta).label === 'string'
    && typeof (value as Cta).href === 'string'
}

function descriptionHtml(value: CaseStudy['description']): string | undefined {
  if (typeof value === 'string') return value
  return value?.html
}

const props = Astro.props as Record<string, unknown>
const content = (props.content && typeof props.content === 'object' ? props.content : props) as Record<string, unknown>
const theme = ['light', 'semi-light', 'semi-dark', 'dark'].includes(String(content.theme)) ? String(content.theme) : 'light'
const intro = content.intro as { accentHeading?: string; heading: string; description?: string | { html: string } } | undefined
const carousel = content.carousel as { items?: CaseStudy[] } | undefined
const cases = Array.isArray(carousel?.items) ? carousel.items : []
const sectionCta = isCta(content.cta) ? content.cta : isCta((content.cta as { cta?: unknown } | undefined)?.cta) ? (content.cta as { cta: Cta }).cta : undefined
const ctaIconPaths = {
  'arrow-right': { viewBox: '0 0 11 18', path: 'm2 2 7 7-7 7' },
  'arrow-down': { viewBox: '0 0 18 18', path: 'm2 9 7 7 7-7M9 2v14' },
} as const
const sectionCtaIcon = sectionCta?.icon ? ctaIconPaths[sectionCta.icon] : undefined
const controls = props.carouselControls === 'next' ? 'next' : 'previous-next'
---
<section class="case-studies-allentown" id={typeof props.id === 'string' ? props.id : undefined} data-kinekt-section data-kinekt-theme={theme}>
  <div class="case-studies-allentown__container">
    {(intro || sectionCta) && (
      <header class="case-studies-allentown__header">
        {intro && <div class="case-studies-allentown__header-content"><SectionIntro intro={intro} headingLevel={(props.headingLevel as 'h1' | 'h2' | 'h3' | undefined) ?? 'h2'} /></div>}
        {sectionCta && <div class="case-studies-allentown__cta"><Button class="case-studies-allentown__cta" href={sectionCta.href!} label={sectionCta.label!}>{sectionCtaIcon && <svg aria-hidden="true" width="1em" height="1em" viewBox={sectionCtaIcon.viewBox} fill="none"><path d={sectionCtaIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button></div>}
      </header>
    )}

    {cases.length > 0 && (
      <div class="case-studies-allentown__carousel" data-kinekt-carousel data-kinekt-carousel-controls={controls} data-kinekt-carousel-control-style={props.carouselControlStyle === 'text' ? 'text' : 'icon'} data-kinekt-carousel-loop={props.carouselLoop === true ? 'true' : 'false'} role="region" aria-label="Case studies carousel">
        {typeof content.sectionLabel === 'string' && <div class="case-studies-allentown__carousel-heading" data-kinekt-carousel-label><p>{content.sectionLabel}</p><span aria-hidden="true"></span></div>}
        <div class="case-studies-allentown__carousel-viewport" data-kinekt-carousel-viewport>
          <ul class="case-studies-allentown__carousel-slides" data-kinekt-carousel-container>
            {cases.map((item) => {
              const cta = isCta(item.cta) ? item.cta : isCta(item.cta?.cta) ? item.cta.cta : undefined
              const ctaIcon = cta?.icon ? ctaIconPaths[cta.icon] : undefined
              const quote = item.quote
              return <li class="case-studies-allentown__carousel-slide" data-kinekt-carousel-slide>
                <article>
                  <div class="case-studies-allentown__carousel-slide-intro">
                    {item.logo?.url && <KinektMedia class="case-studies-allentown__logo" imageClass="case-studies-allentown__logo-image" media={item.logo as KinektMediaValue} />}
                    {item.title && <h3 class="case-studies-allentown__title">{item.title}</h3>}
                    {descriptionHtml(item.description) && <div class="case-studies-allentown__description" set:html={descriptionHtml(item.description)} />}
                  </div>
                  <div class="case-studies-allentown__carousel-slide-content">
                    {item.image?.url && <KinektMedia class="case-studies-allentown__image" imageClass="case-studies-allentown__image-element" media={item.image as KinektMediaValue} loading="lazy" />}
                    <div class="case-studies-allentown__carousel-slide-details">
                      {item.results?.length && <ul class="case-studies-allentown__results">{item.results.map((result) => <li><article><p>{result.label}</p><div class="case-studies-allentown__value">{result.value?.icon && <Label class="case-studies-allentown__value-icon" text={result.value.icon} />}{result.value?.text && <Label class="case-studies-allentown__value-text" text={result.value.text} />}</div></article></li>)}</ul>}
                      {quote && <figure class="case-studies-allentown__quote"><blockquote>{quote.quote && <p class="case-studies-allentown__quote-text">{quote.quote}</p>}</blockquote>{(quote.avatar?.url || quote.authorName || quote.authorRole) && <figcaption class="case-studies-allentown__quote-attribution">{quote.avatar?.url && <KinektMedia class="case-studies-allentown__quote-avatar" imageClass="case-studies-allentown__quote-avatar-image" media={quote.avatar as KinektMediaValue} loading="lazy" />}<div class="case-studies-allentown__quote-author">{quote.authorName && <p class="case-studies-allentown__quote-author-name">{quote.authorName}</p>}{quote.authorRole && <p class="case-studies-allentown__quote-author-role">{quote.authorRole}</p>}</div></figcaption>}</figure>}
                      {cta && <div class="case-studies-allentown__cta"><Button href={cta.href!} label={cta.label!} style="clear">{ctaIcon && <svg aria-hidden="true" width="1em" height="1em" viewBox={ctaIcon.viewBox} fill="none"><path d={ctaIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button></div>}
                    </div>
                  </div>
                </article>
              </li>
            })}
          </ul>
        </div>
        {cases.length > 1 && <nav class="case-studies-allentown__carousel-pagination" data-kinekt-carousel-pagination aria-label="Case study pagination">
          {controls === 'previous-next' && <button class="button button--clear" type="button" data-kinekt-carousel-previous aria-label="Previous case study"><span data-kinekt-carousel-control-icon aria-hidden="true">←</span><span data-kinekt-carousel-control-text>Previous</span></button>}
          <p class="case-studies-allentown__carousel-counter" data-kinekt-carousel-counter aria-live="polite" aria-atomic="true"><span data-kinekt-carousel-current aria-hidden="true">1</span><span data-kinekt-carousel-separator aria-hidden="true"> / </span><span data-kinekt-carousel-total aria-hidden="true">{cases.length}</span><span class="case-studies-allentown__carousel-status" data-kinekt-carousel-status>Slide 1 of {cases.length}</span></p>
          <button class="button button--clear" type="button" data-kinekt-carousel-next aria-label="Next case study"><span data-kinekt-carousel-control-icon aria-hidden="true">→</span><span data-kinekt-carousel-control-text>Next</span></button>
          <div class="case-studies-allentown__carousel-indicators" data-kinekt-carousel-indicators role="group" aria-label="Case study pagination">{cases.map((_, index) => <button class="button button--clear" type="button" data-kinekt-carousel-dot data-kinekt-carousel-index={index} aria-label={`Go to case study ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} />)}</div>
        </nav>}
      </div>
    )}
  </div>
</section>

<script>
  import { initializeKinektInteractions } from '../../../shared/interactions'

  initializeKinektInteractions()
</script>
<style is:global>
/*
 * Case Studies Allentown follows the Figma section’s editorial sequence:
 * section introduction, a single full-width featured case, then pagination.
 * Site tokens remain responsible for all colour and type choices.
 */
:where(.case-studies-allentown[data-kinekt-section]) {
  --kinekt-section-content-width: var(--kinekt-wireframe-layout-content-width);
  --case-studies-carousel-to-slide: clamp(var(--kinekt-wireframe-section-space-s), 4vw, var(--kinekt-wireframe-section-space-m));
  --case-studies-carousel-heading-gap: var(--kinekt-wireframe-space-s);
  --case-studies-carousel-heading-line-size: var(--kinekt-component-border-width);
  --case-studies-header-content-width: var(--kinekt-wireframe-layout-width-l);
  --case-studies-header-gap: var(--kinekt-wireframe-space-m);
  --case-studies-header-column-gap: var(--kinekt-wireframe-space-xl);
  --case-studies-header-justify-content: space-between;
  --case-studies-logo-to-title: var(--kinekt-wireframe-space-m);
  --case-studies-title-to-summary: var(--kinekt-wireframe-space-m);
  --case-studies-summary-to-content: var(--kinekt-wireframe-section-space-xs);
  --case-studies-media-to-details: clamp(var(--kinekt-wireframe-section-space-s), 5.5vw, var(--kinekt-wireframe-section-space-l));
  --case-studies-details-gap: clamp(var(--kinekt-wireframe-space-xl), 3vw, var(--kinekt-wireframe-section-space-xs));
  --case-studies-results-gap: var(--kinekt-wireframe-space-l);
}

:where(.case-studies-allentown) > .case-studies-allentown__container {
  gap: 0;
}

:where(.case-studies-allentown) .case-studies-allentown__header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: none;
  gap: var(--case-studies-header-gap);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel {
  display: grid;
  gap: var(--case-studies-carousel-to-slide);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-heading {
  display: flex;
  align-items: center;
  gap: var(--case-studies-carousel-heading-gap);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-heading p {
  margin: 0;
  color: var(--kinekt-component-action);
  font-family: var(--kinekt-component-mono);
  font-size: var(--kinekt-component-text-xs-size);
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: var(--kinekt-component-text-xs-line-height);
  text-transform: uppercase;
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-heading span {
  flex: 1;
  height: var(--case-studies-carousel-heading-line-size);
  background: var(--kinekt-component-action);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide {
  flex-basis: 100%;
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide > article {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide-content,
:where(.case-studies-allentown) .case-studies-allentown__carousel-slide-details {
  display: flex;
  flex-direction: column;
}

:where(.case-studies-allentown) .case-studies-allentown__logo {
  width: min(100%, 5.625rem);
  margin-bottom: var(--case-studies-logo-to-title);
}

:where(.case-studies-allentown) .case-studies-allentown__logo img {
  height: 1.5rem;
  object-fit: contain;
  object-position: left center;
}

:where(.case-studies-allentown) .case-studies-allentown__title {
  max-width: 54rem;
  margin-bottom: var(--case-studies-title-to-summary);
  font-size: clamp(1.5rem, 3vw, 2rem);
  line-height: 1.1;
}

:where(.case-studies-allentown) .case-studies-allentown__description {
  max-width: 54rem;
  margin: 0;
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide-content {
  gap: var(--case-studies-summary-to-content);
  margin-top: var(--case-studies-summary-to-content);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide-details {
  gap: var(--case-studies-details-gap);
}

:where(.case-studies-allentown) .case-studies-allentown__image img {
  aspect-ratio: 1.25;
  object-fit: cover;
}

:where(.case-studies-allentown) .case-studies-allentown__results {
  display: flex;
  flex-wrap: wrap;
  gap: var(--case-studies-results-gap);
  align-content: start;
  margin: 0;
}

:where(.case-studies-allentown) .case-studies-allentown__results > li > article {
  gap: 0.75rem;
  padding: 0;
  border: 0;
  background: transparent;
}

:where(.case-studies-allentown) .case-studies-allentown__value {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}


:where(.case-studies-allentown) .case-studies-allentown__quote {
  margin: 0;
}

:where(.case-studies-allentown) .case-studies-allentown__quote blockquote {
  margin: 0 0 1.25rem;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-text {
  margin: 0;
  color: var(--kinekt-component-action);
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  line-height: 1.2;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-attribution {
  display: flex;
  align-items: center;
  gap: 1rem;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-avatar {
  flex: 0 0 3rem;
  width: 3rem;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-avatar img {
  aspect-ratio: 1;
  border-radius: 50%;
  object-fit: cover;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-author {
  display: grid;
  gap: 0.375rem;
}

:where(.case-studies-allentown) :is(.case-studies-allentown__quote-author-name, .case-studies-allentown__quote-author-role) {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.2;
}

:where(.case-studies-allentown) .case-studies-allentown__quote-author-role {
  color: var(--kinekt-component-muted);
}

:where(.case-studies-allentown) .case-studies-allentown__carousel-slide .case-studies-allentown__cta > a {
  min-height: 0;
  padding: 0;
  border: 0;
  color: var(--kinekt-component-ink);
  background: transparent;
}

:where(.case-studies-allentown) [data-kinekt-carousel-pagination] {
  gap: var(--case-studies-pagination-gap, 1.25rem);
}

:where(.case-studies-allentown) :is([data-kinekt-carousel-previous], [data-kinekt-carousel-next]) {
  min-height: 0;
  padding: 0;
  border: 0;
  color: light-dark(black, white);
  background: transparent;
  font-size: var(--case-studies-pagination-icon-size, 1.375rem);
}

:where(.case-studies-allentown) [data-kinekt-carousel-indicators] {
  gap: var(--case-studies-pagination-indicator-gap, 0.5rem);
}

@media (min-width: 50rem) {
  :where(.case-studies-allentown) .case-studies-allentown__header {
    display: grid;
    grid-template-columns: minmax(0, var(--case-studies-header-content-width)) auto;
    align-items: end;
    column-gap: var(--case-studies-header-column-gap);
    justify-content: var(--case-studies-header-justify-content);
  }

  :where(.case-studies-allentown) .case-studies-allentown__header-content {
    grid-column: 1;
  }

  :where(.case-studies-allentown) .case-studies-allentown__header > .case-studies-allentown__cta {
    grid-column: 2;
    align-self: end;
  }

  :where(.case-studies-allentown) .case-studies-allentown__carousel-slide-content {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--case-studies-media-to-details);
  }

  :where(.case-studies-allentown) .case-studies-allentown__image {
    flex: 1.2 1 0;
  }

  :where(.case-studies-allentown) .case-studies-allentown__carousel-slide-details {
    flex: 1 1 0;
  }
}
/*
 * Result metrics in the Case Studies layout are labels with a single value
 * field. The list item is structural, not a card; its outer box must remain
 * visually absent.
 */
:where(.case-studies-allentown) .case-studies-allentown__results > li > article {
  gap: 0.75rem;
  padding: 0;
  border: 0;
  background: transparent;
}
/* The carousel owns the header-to-content rhythm for Case Studies. */
:where(.case-studies-allentown) .case-studies-allentown__header {
  margin-bottom: 0;
}
</style>
