  :where(.case-studies-allentown) :is([class$='__actions'], [class*='__cta-group']) { display: flex; flex-wrap: wrap; gap: var(--kiw--section-actions-gap); margin-top: var(--kiw--section-actions-margin); }
  :where(.case-studies-allentown) :is([class$='__media'], [class*='__media-'], [class*='__image']), :where(.case-studies-allentown) picture { display: block; max-width: 100%; } :where(.case-studies-allentown) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); } :where(.case-studies-allentown) :is(ul, ol)[class*='__'] { display: grid; padding: 0; list-style: none; } :where(.case-studies-allentown) :is(ul, ol)[class*='__'] > li { min-width: 0; }
  :where(.case-studies-allentown) [data-kinekt-carousel-viewport] { overflow: hidden; } :where(.case-studies-allentown) [data-kinekt-carousel] { --kinekt-carousel-gap: var(--kinekt-section-carousel-gap, var(--kiw--section-carousel-gap)); } :where(.case-studies-allentown) ul[data-kinekt-carousel-container] { display: flex; gap: var(--kinekt-carousel-gap); } :where(.case-studies-allentown) [data-kinekt-carousel-slide] { flex: 0 0 var(--kinekt-carousel-slide-basis, 100%); } :where(.case-studies-allentown) [data-kinekt-carousel-loop='true'] ul[data-kinekt-carousel-container] { gap: 0; } :where(.case-studies-allentown) [data-kinekt-carousel-loop='true'] [data-kinekt-carousel-slide] { margin-inline-start: var(--kinekt-carousel-gap); } :where(.case-studies-allentown) [data-kinekt-carousel-pagination] { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'counter next' 'indicators indicators'; align-items: center; gap: var(--space-l); } :where(.case-studies-allentown) [data-kinekt-carousel-controls='previous-next'] [data-kinekt-carousel-pagination] { grid-template-columns: minmax(0, 1fr) auto auto; grid-template-areas: 'counter previous next' 'indicators indicators indicators'; } :where(.case-studies-allentown) [data-kinekt-carousel-counter] { grid-area: counter; margin: 0; color: var(--kinekt-component-action); font: var(--heading-font-weight) var(--text-xl)/var(--heading-line-height) var(--kinekt-carousel-counter-font, var(--kinekt-component-font)); letter-spacing: var(--kinekt-carousel-counter-tracking, var(--heading-letter-spacing)); } :where(.case-studies-allentown) [data-kinekt-carousel-previous] { grid-area: previous; } :where(.case-studies-allentown) [data-kinekt-carousel-next] { grid-area: next; } :where(.case-studies-allentown) [data-kinekt-carousel-indicators] { grid-area: indicators; display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--width-xs), 1fr)); gap: var(--space-xs); } :where(.case-studies-allentown) [data-kinekt-carousel-dot] { position: relative; width: auto; min-height: var(--kinekt-carousel-indicator-hit-area, var(--input-height)); padding: 0; border: 0; border-radius: 0; color: transparent; background: transparent; touch-action: manipulation; } :where(.case-studies-allentown) [data-kinekt-carousel-dot]::after { position: absolute; top: 50%; right: 0; left: 0; height: var(--kinekt-carousel-indicator-size, var(--border-width)); transform: translateY(-50%); background: var(--kinekt-component-line); content: ''; } :where(.case-studies-allentown) [data-kinekt-carousel-dot][aria-current='true']::after { background: var(--kinekt-component-action); }
</style>
