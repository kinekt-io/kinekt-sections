---
import { sectionTokenBridgeStyle } from "../../../shared/section-token-bridge.js";
import "../../../styles/wireframe.css";
import SectionIntro from "../../../primitives/section-intro/section-intro.astro";
import Button from "../../../controls/button/allentown/button-allentown.astro";
import Label from "../../../atoms/label/allentown/label-allentown.astro";

const {
  id,
  theme = "light",
  intro,
  sectionLabel,
  carousel = {},
  cta,
  headingLevel = "h2",
  carouselControlStyle = "icon",
  carouselControls = "previous-next",
  carouselLoop = false,
} = Astro.props as any;
const items = Array.isArray(carousel.items) ? carousel.items : [];
const action = cta?.cta ?? cta;
const hasCarousel = items.length > 1;
const slideAction = (item: any) => item.cta?.cta ?? item.cta;
---

<section
  style={sectionTokenBridgeStyle('case-studies-allentown')}
  class="case-studies-allentown"
  id={id}
  data-kinekt-section
  data-kinekt-theme={theme}
>
  <div class="case-studies-allentown__container">
    <header class="case-studies-allentown__header">
      {
        intro && (
          <div class="case-studies-allentown__header-content">
            <SectionIntro intro={intro} headingLevel={headingLevel} />
          </div>
        )
      }
      {
        action?.label && (
          <div class="case-studies-allentown__cta">
            <Button
              class="case-studies-allentown__cta"
              href={action.href}
              label={action.label}
            />
          </div>
        )
      }
    </header>
    <div
      class="case-studies-allentown__carousel"
      data-kinekt-carousel={hasCarousel ? true : undefined}
      data-kinekt-carousel-controls={hasCarousel ? carouselControls : undefined}
      data-kinekt-carousel-control-style={hasCarousel ? carouselControlStyle : undefined}
      data-kinekt-carousel-loop={hasCarousel ? (carouselLoop ? "true" : "false") : undefined}
      role={hasCarousel ? "region" : undefined}
      aria-label={hasCarousel ? "Case studies carousel" : undefined}
    >
      {
        sectionLabel && (
          <div
            class="case-studies-allentown__carousel-label"
            data-kinekt-carousel-label={hasCarousel ? true : undefined}
          >
            <>
              <p>{sectionLabel}</p>
              <span aria-hidden="true" />
            </>
          </div>
        )
      }
      <div
        class="case-studies-allentown__carousel-viewport"
        data-kinekt-carousel-viewport={hasCarousel ? true : undefined}
      >
        <ul
          class="case-studies-allentown__carousel-slides"
          data-kinekt-carousel-container={hasCarousel ? true : undefined}
        >
          {
            items.map((item: any) => {
              const itemAction = slideAction(item);
              return (
                <li
                  class="case-studies-allentown__carousel-slide"
                  data-kinekt-carousel-slide={hasCarousel ? true : undefined}
                >
                  <article>
                    {item.logo?.url && (
                      <picture class="case-studies-allentown__logo">
                        <img
                          src={item.logo.url}
                          alt={item.logo.alt ?? ""}
                          width={item.logo.width}
                          height={item.logo.height}
                        />
                      </picture>
                    )}
                    {item.title && (
                      <h3 class="case-studies-allentown__title">
                        {item.title}
                      </h3>
                    )}
                    {item.description && (
                      <p class="case-studies-allentown__description">
                        {item.description}
                      </p>
                    )}
                    <div class="case-studies-allentown__carousel-slide-content">
                      {item.image?.url && (
                        <picture class="case-studies-allentown__image">
                          <img
                            src={item.image.url}
                            alt={item.image.alt ?? ""}
                            width={item.image.width}
                            height={item.image.height}
                          />
                        </picture>
                      )}
                      <div class="case-studies-allentown__carousel-slide-details">
                        {item.results?.length > 0 && (
                          <ul class="case-studies-allentown__results">
                            {item.results.map((result: any) => (
                              <li class="case-studies-allentown__results-item">
                                <article>
                                  <p class="case-studies-allentown__label">
                                    {result.label}
                                  </p>
                                  <Label
                                    class="case-studies-allentown__value"
                                    text={result.value?.text ?? ""}
                                    icon={result.value?.icon}
                                  />
                                </article>
                              </li>
                            ))}
                          </ul>
                        )}
                        {item.quote?.quote && (
                          <figure class="case-studies-allentown__quote">
                            <blockquote>
                              <p class="case-studies-allentown__quote-text">
                                {item.quote.quote}
                              </p>
                            </blockquote>
                            <figcaption class="case-studies-allentown__quote-attribution">
                              {item.quote.avatar?.url && (
                                <picture class="case-studies-allentown__quote-avatar">
                                  <img
                                    src={item.quote.avatar.url}
                                    alt={item.quote.avatar.alt ?? ""}
                                    width={item.quote.avatar.width}
                                    height={item.quote.avatar.height}
                                  />
                                </picture>
                              )}
                              <div class="case-studies-allentown__quote-author">
                                {item.quote.authorName && (
                                  <p class="case-studies-allentown__quote-author-name">
                                    {item.quote.authorName}
                                  </p>
                                )}
                                {item.quote.authorRole && (
                                  <p class="case-studies-allentown__quote-author-role">
                                    {item.quote.authorRole}
                                  </p>
                                )}
                              </div>
                            </figcaption>
                          </figure>
                        )}
                        {itemAction?.label && (
                          <div class="case-studies-allentown__cta">
                            <Button
                              class="case-studies-allentown__cta"
                              href={itemAction.href}
                              label={itemAction.label}
                              style="clear"
                            />
                          </div>
                        )}
                      </div>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </div>
      {
        hasCarousel && (
          <div
            class="case-studies-allentown__carousel-pagination"
            data-kinekt-carousel-pagination
          >
            {carouselControls === "previous-next" && (
              <button
                class="button button--clear"
                type="button"
                data-kinekt-carousel-previous
                aria-label="Previous case study"
              >
                <span data-kinekt-carousel-control-icon aria-hidden="true">
                  ←
                </span>
                <span data-kinekt-carousel-control-text>Previous</span>
              </button>
            )}
            <p
              class="case-studies-allentown__carousel-counter"
              data-kinekt-carousel-counter
              aria-live="polite"
              aria-atomic="true"
            >
              <span data-kinekt-carousel-current aria-hidden="true">1</span>
              <span data-kinekt-carousel-separator aria-hidden="true">/</span>
              <span data-kinekt-carousel-total aria-hidden="true">{items.length}</span>
              <span
                class="case-studies-allentown__carousel-status"
                data-kinekt-carousel-status
              >
                Slide 1 of {items.length}
              </span>
            </p>
            <button
              class="button button--clear"
              type="button"
              data-kinekt-carousel-next
              aria-label="Next case study"
            >
              <span data-kinekt-carousel-control-icon aria-hidden="true">→</span>
              <span data-kinekt-carousel-control-text>Next</span>
            </button>
            <div
              class="case-studies-allentown__carousel-indicators"
              data-kinekt-carousel-indicators
              role="group"
              aria-label="Case study pagination"
            >
              {items.map((_: any, index: number) => (
                <button
                  class="button button--clear"
                  type="button"
                  data-kinekt-carousel-dot
                  data-kinekt-carousel-index={index}
                  aria-label={`Go to case study ${index + 1}`}
                  aria-current={index === 0 ? "true" : undefined}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
<script>
  import { initializeKinektInteractions } from "../../../shared/interactions";
  initializeKinektInteractions();
</script>
<style>
  :global(:where(.case-studies-allentown)) {
    --kiw--case-studies-allentown-content-width: var(--content-width);
    --kiw--case-studies-allentown-carousel-gap: var(--section-space-m);
    --kiw--case-studies-allentown-label-gap: var(--space-s);
    --kiw--case-studies-allentown-header-gap: var(--space-m);
    --kiw--case-studies-allentown-header-width: var(--width-l);
    --kiw--case-studies-allentown-header-column-gap: var(--space-xl);
    --kiw--case-studies-allentown-summary-space: var(--section-space-xs);
    --kiw--case-studies-allentown-media-gap: var(--section-space-l);
    --kiw--case-studies-allentown-results-gap: var(--space-l);
    --kiw--case-studies-allentown-logo-size: var(--section-space-xxl);
    --kiw--case-studies-allentown-logo-height: var(--text-l);
    --kiw--case-studies-allentown-title-size: var(--h3);
    --kiw--case-studies-allentown-heading-line-height: var(--heading-line-height);
    --kiw--case-studies-allentown-result-gap: var(--space-s);
    --kiw--case-studies-allentown-quote-space: var(--space-l);
    --kiw--case-studies-allentown-action-color: var(--kinekt-component-action);
    --kiw--case-studies-allentown-quote-size: var(--text-xl);
    --kiw--case-studies-allentown-text-line-height: var(--text-line-height);
    --kiw--case-studies-allentown-attribution-gap: var(--space-m);
    --kiw--case-studies-allentown-avatar-size: var(--section-space-s);
    --kiw--case-studies-allentown-author-gap: var(--space-xs);
    --kiw--case-studies-allentown-author-size: var(--text-s);
    --kiw--case-studies-allentown-muted-color: var(--kinekt-component-muted);
    --kiw--case-studies-allentown-ink-color: var(--kinekt-component-ink);
  }

  .case-studies-allentown {
    --kinekt-section-content-width: var(--kiw--case-studies-allentown-content-width);
    --case-studies-carousel-to-slide: var(--kiw--case-studies-allentown-carousel-gap);
    --case-studies-label-gap: var(--kiw--case-studies-allentown-label-gap);
    --case-studies-header-gap: var(--kiw--case-studies-allentown-header-gap);
    --case-studies-header-content-width: var(--kiw--case-studies-allentown-header-width);
    --case-studies-header-column-gap: var(--kiw--case-studies-allentown-header-column-gap);
    --case-studies-logo-to-title: var(--kiw--case-studies-allentown-header-gap);
    --case-studies-title-to-summary: var(--kiw--case-studies-allentown-header-gap);
    --case-studies-summary-to-content: var(--kiw--case-studies-allentown-summary-space);
    --case-studies-media-to-details: var(--kiw--case-studies-allentown-media-gap);
    --case-studies-details-gap: var(--kiw--case-studies-allentown-summary-space);
    --case-studies-results-gap: var(--kiw--case-studies-allentown-results-gap);

    & > .case-studies-allentown__container {
      gap: var(--case-studies-carousel-to-slide);
    }
    & .case-studies-allentown__header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: none;
      gap: var(--case-studies-header-gap);
      margin-bottom: 0;
    }
    & .case-studies-allentown__carousel {
      display: grid;
      gap: var(--case-studies-carousel-to-slide);
    }
    & .case-studies-allentown__carousel-label {
      display: flex;
      align-items: center;
      gap: var(--case-studies-label-gap);
    }
    & .case-studies-allentown__carousel-label p {
      margin: 0;
    }
    & .case-studies-allentown__carousel-label span {
      flex: 1;
      height: var(--kinekt-component-border-width);
      background: var(--kiw--case-studies-allentown-action-color);
    }
    & .case-studies-allentown__carousel-slide {
      flex-basis: 100%;
    }
    & .case-studies-allentown__carousel-slide > article {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
      border: 0;
      background: transparent;
    }
    &
      :is(
        .case-studies-allentown__carousel-slide-content,
        .case-studies-allentown__carousel-slide-details
      ) {
      display: flex;
      flex-direction: column;
    }
    & .case-studies-allentown__logo {
      width: min(100%, var(--kiw--case-studies-allentown-logo-size));
      margin-bottom: var(--case-studies-logo-to-title);
    }
    & .case-studies-allentown__logo img {
      height: var(--kiw--case-studies-allentown-logo-height);
      object-fit: contain;
      object-position: left center;
    }
    & .case-studies-allentown__title {
      max-width: var(--kiw--case-studies-allentown-header-width);
      margin-bottom: var(--case-studies-title-to-summary);
      font-size: var(--kiw--case-studies-allentown-title-size);
      line-height: var(--kiw--case-studies-allentown-heading-line-height);
    }
    & .case-studies-allentown__description {
      max-width: var(--kiw--case-studies-allentown-header-width);
      margin: 0;
    }
    & .case-studies-allentown__carousel-slide-content {
      gap: var(--case-studies-summary-to-content);
      margin-top: var(--case-studies-summary-to-content);
    }
    & .case-studies-allentown__carousel-slide-details {
      gap: var(--case-studies-details-gap);
    }
    & .case-studies-allentown__image img {
      aspect-ratio: 1.25;
      object-fit: cover;
    }
    & .case-studies-allentown__results {
      display: flex;
      flex-wrap: wrap;
      gap: var(--case-studies-results-gap);
      align-content: start;
      margin: 0;
    }
    & .case-studies-allentown__results > li > article {
      gap: var(--kiw--case-studies-allentown-result-gap);
      padding: 0;
      border: 0;
      background: transparent;
    }
    & .case-studies-allentown__quote {
      margin: 0;
    }
    & .case-studies-allentown__quote blockquote {
      margin: 0 0 var(--kiw--case-studies-allentown-quote-space);
    }
    & .case-studies-allentown__quote-text {
      margin: 0;
      color: var(--kiw--case-studies-allentown-action-color);
      font-size: var(--kiw--case-studies-allentown-quote-size);
      line-height: var(--kiw--case-studies-allentown-text-line-height);
    }
    & .case-studies-allentown__quote-attribution {
      display: flex;
      align-items: center;
      gap: var(--kiw--case-studies-allentown-attribution-gap);
    }
    & .case-studies-allentown__quote-avatar {
      flex: 0 0 var(--kiw--case-studies-allentown-avatar-size);
      width: var(--kiw--case-studies-allentown-avatar-size);
    }
    & .case-studies-allentown__quote-avatar img {
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
    }
    & .case-studies-allentown__quote-author {
      display: grid;
      gap: var(--kiw--case-studies-allentown-author-gap);
    }
    &
      :is(
        .case-studies-allentown__quote-author-name,
        .case-studies-allentown__quote-author-role
      ) {
      margin: 0;
      font-size: var(--kiw--case-studies-allentown-author-size);
      line-height: var(--kiw--case-studies-allentown-text-line-height);
    }
    & .case-studies-allentown__quote-author-role {
      color: var(--kiw--case-studies-allentown-muted-color);
    }
    & .case-studies-allentown__carousel-slide .case-studies-allentown__cta > a {
      min-height: 0;
      padding: 0;
      border: 0;
      color: var(--kiw--case-studies-allentown-ink-color);
      background: transparent;
    }
    & [data-kinekt-carousel-pagination] {
      gap: var(--case-studies-pagination-gap, var(--kiw--case-studies-allentown-results-gap));
    }
    & :is([data-kinekt-carousel-previous], [data-kinekt-carousel-next]) {
      min-height: 0;
      padding: 0;
      border: 0;
      color: var(--kiw--case-studies-allentown-ink-color);
      background: transparent;
      font-size: var(--case-studies-pagination-icon-size, var(--kiw--case-studies-allentown-quote-size));
    }
    & [data-kinekt-carousel-indicators] {
      gap: var(--case-studies-pagination-indicator-gap, var(--kiw--case-studies-allentown-author-gap));
    }

    @media (min-width: 50rem) {
      & .case-studies-allentown__header {
        display: grid;
        grid-template-columns: minmax(
            0,
            var(--case-studies-header-content-width)
          ) auto;
        align-items: end;
        column-gap: var(--case-studies-header-column-gap);
        justify-content: space-between;
      }
      & .case-studies-allentown__header-content {
        grid-column: 1;
      }
      & .case-studies-allentown__header > .case-studies-allentown__cta {
        grid-column: 2;
        align-self: end;
      }
      & .case-studies-allentown__carousel-slide-content {
        flex-direction: row;
        align-items: flex-start;
        gap: var(--case-studies-media-to-details);
      }
      & .case-studies-allentown__image {
        flex: 1.2 1 0;
      }
      & .case-studies-allentown__carousel-slide-details {
        flex: 1 1 0;
      }
    }
  }
</style>
