{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/proof-metrics/trinity",
  "slug": "proof-metrics-trinity",
  "title": "Proof Metrics Trinity",
  "description": "A two-column grid of service proof points with optional titled results and an optional action callout.",
  "category": "sections",
  "tags": ["metrics", "proof", "prerelease"],
  "role": "proof-metrics",
  "variation": "trinity",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-771911",
    "nodeId": "5744:771911"
  },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "light", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "items": {
      "kind": "componentList",
      "required": true,
      "localized": true,
      "minItems": 1,
      "maxItems": 6,
      "admin": { "initCollapsed": true },
      "fields": {
        "title": { "kind": "text", "required": true, "localized": true },
        "description": { "kind": "richText", "required": true, "localized": true },
        "label": { "kind": "component", "componentId": "components/result-item/allentown", "required": false, "localized": true }
      }
    },
    "callout": { "kind": "component", "componentId": "components/callout/allentown", "required": false, "localized": true, "admin": { "initCollapsed": true } }
  },
  "runtimeProps": {
    "headingLevel": { "kind": "headingLevel", "source": "renderer" }
  }
}
