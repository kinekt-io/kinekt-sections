---
import '../../../styles/wireframe-tokens.css'
import Callout from '../../../components/callout/allentown/callout-allentown.astro'
import ResultItem from '../../../components/result-item/allentown/result-item-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type Media, type SectionIntro as SectionIntroContent, type SectionTheme } from '../../../shared/content.js'

type CalloutCta = Partial<Cta> | null | undefined
interface Props {
  id?: string
  theme?: SectionTheme
  intro: SectionIntroContent
  metrics: Array<{ label: string; value: { text: string; icon?: string } }>
  media?: Media | null
  callout?: {
    /** Legacy preview shape; the Payload contract puts this in `intro.accentHeading`. */
    label?: string
    intro: SectionIntroContent
    /** Payload contract (`components/cta-group/allentown`). */
    ctaGroup?: CtaGroup | Cta[] | { primary?: CalloutCta; secondary?: CalloutCta; primaryButton?: CalloutCta; secondaryButton?: CalloutCta } | null
    /** Legacy preview shape. */
    cta?: { cta?: CalloutCta } | null
  } | null
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { id, theme = 'light', intro, metrics = [], media, callout, headingLevel = 'h2' } = Astro.props as Props
const calloutGroup: CtaGroup = {
  buttons: ctaGroupActions(callout?.ctaGroup ?? { primary: callout?.cta?.cta }),
}
const calloutContent = callout?.intro
  ? { intro: { ...callout.intro, accentHeading: callout.intro.accentHeading ?? callout.label }, ctaGroup: calloutGroup }
  : undefined
---
<section class="proof-metrics-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="proof-metrics-allentown__container">
    <div class="proof-metrics-allentown__intro-and-metrics">
      <header class="proof-metrics-allentown__intro">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      </header>

      <ul class="proof-metrics-allentown__metrics" aria-label="Proof points">
        {metrics.map((metric) => (
          <li class="proof-metrics-allentown__metric">
            <ResultItem class="proof-metrics-allentown__result" size="xl" labelAs="p" label={metric.label} value={metric.value ?? { text: '' }} />
          </li>
        ))}
      </ul>
    </div>

    {media && <KinektMedia class="proof-metrics-allentown__media" imageClass="proof-metrics-allentown__image" media={media} />}

    {calloutContent && <Callout class="proof-metrics-allentown__callout" callout={calloutContent} />}
  </div>
</section>
<style is:global>
