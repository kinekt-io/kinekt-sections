    --kiw--section-table-offset: var(--kiw--proof-metrics-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--proof-metrics-allentown-canvas);
    --kiw--section-surface: var(--kiw--proof-metrics-allentown-surface);
