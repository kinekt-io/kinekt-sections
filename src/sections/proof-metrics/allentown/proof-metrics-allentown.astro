<style is:global>
/*
 * Proof Metrics follows the source composition: editorial introduction,
 * four unboxed proof values, a wide proof image, then one clear action.
 * The aliases let a site retune this composition without replacing markup.
 */
.proof-metrics-allentown[data-kinekt-section] {
  --kiw--proof-metrics-inline-space: var(--section-gutter);
  --kiw--proof-metrics-section-space: var(--section-gutter);
  --kiw--proof-metrics-content-width: var(--width-xxl);
  --kiw--proof-metrics-major-gap: var(--section-space-xl);
  --kiw--proof-metrics-metric-gap: var(--section-space-xxl);
  --kiw--proof-metrics-callout-gap: var(--section-space-xxl);
  --kiw--proof-metrics-value-gap: var(--space-s);
  --kiw--proof-metrics-media-ratio: 1296 / 406;
  padding-block: var(--kiw--proof-metrics-section-space);
}

.proof-metrics-allentown .proof-metrics-allentown__container {
  display: grid;
  max-width: var(--kiw--proof-metrics-content-width);
  gap: var(--kiw--proof-metrics-major-gap);
  padding-inline: var(--kiw--proof-metrics-inline-space);
}

.proof-metrics-allentown .proof-metrics-allentown__intro-and-metrics {
  display: grid;
  gap: var(--section-space-l);
  max-width: var(--width-l);
}

.proof-metrics-allentown .proof-metrics-allentown__intro {
  display: grid;
  gap: var(--kinekt-component-intro-description-gap);
}

.proof-metrics-allentown .proof-metrics-allentown__metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--section-space-xs) var(--kiw--proof-metrics-metric-gap);
  margin: 0;
  padding: 0;
  list-style: none;
}

.proof-metrics-allentown .proof-metrics-allentown__metric {
  display: grid;
  align-content: start;
  gap: var(--kiw--proof-metrics-value-gap);
}

.proof-metrics-allentown .proof-metrics-allentown__metric-label,
.proof-metrics-allentown .proof-metrics-allentown__metric-value {
  margin: 0;
}

.proof-metrics-allentown .proof-metrics-allentown__metric-label {
  font-size: var(--text-xl);
  font-weight: var(--text-font-weight);
  line-height: var(--heading-line-height);
  letter-spacing: var(--heading-letter-spacing);
}

.proof-metrics-allentown .proof-metrics-allentown__metric-value {
  color: var(--kinekt-component-muted);
  font-size: var(--text-s);
  line-height: var(--text-line-height);
}

.proof-metrics-allentown .proof-metrics-allentown__media {
  display: block;
  width: 100%;
}

.proof-metrics-allentown .proof-metrics-allentown__image {
  display: block;
  width: 100%;
  aspect-ratio: var(--kiw--proof-metrics-media-ratio);
  object-fit: cover;
}

.proof-metrics-allentown .proof-metrics-allentown__callout {
  display: grid;
  gap: var(--section-space-xs);
}

.proof-metrics-allentown .proof-metrics-allentown__callout-label {
  display: flex;
  align-items: center;
  gap: var(--space-m);
  color: var(--kinekt-component-muted);
  font-family: var(--kinekt-component-mono);
  font-size: var(--text-xs);
  font-weight: var(--heading-font-weight);
  letter-spacing: var(--text-letter-spacing);
  text-transform: uppercase;
}

.proof-metrics-allentown .proof-metrics-allentown__callout-label::after {
  width: 100%;
  height: var(--kinekt-component-border-width);
  background: var(--kinekt-component-line);
  content: '';
}

.proof-metrics-allentown .proof-metrics-allentown__callout-label span {
  flex: none;
}

.proof-metrics-allentown .proof-metrics-allentown__callout-body {
  display: grid;
  gap: var(--section-space-xs);
  align-items: end;
}

.proof-metrics-allentown .proof-metrics-allentown__callout-content {
  max-width: var(--kiw--proof-metrics-allentown-callout-width, var(--kinekt-component-reading-width));
}

.proof-metrics-allentown .proof-metrics-allentown__callout-content h3 {
  font-size: var(--h3);
}

.proof-metrics-allentown .proof-metrics-allentown__callout-content .section-intro__description {
  margin-top: var(--space-m);
  font-size: var(--text-l);
}

.proof-metrics-allentown .proof-metrics-allentown__callout-action {
  justify-self: start;
}

