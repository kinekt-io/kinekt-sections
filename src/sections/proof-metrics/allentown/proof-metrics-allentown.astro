</style>
<style is:global>
/*
 * Proof Metrics follows its Figma frame (5240:412607): an intro column, four
 * proof values (shared result-item, Figma Label "Title=yes", Extra Large), a wide proof image, then
 * the shared Call to Action Block (callout-allentown, large). The aliases let
 * a site retune this composition without replacing markup.
 */
.proof-metrics-allentown[data-kinekt-section] {
  --kiw--proof-metrics-inline-space: var(--section-gutter);
  --kiw--proof-metrics-section-space: var(--section-gutter);
  --kiw--proof-metrics-content-width: var(--width-xxl);
  --kiw--proof-metrics-major-gap: var(--section-space-l);
  --kiw--proof-metrics-intro-gap: var(--section-space-m);
  --kiw--proof-metrics-intro-width: var(--width-l);
  --kiw--proof-metrics-intro-group-gap: var(--space-m);
  --kiw--proof-metrics-heading-stack-gap: var(--space-xxs);
  --kiw--proof-metrics-metric-gap: var(--section-space-xxl);
  --kiw--proof-metrics-metric-row-gap: var(--section-space-s);
  --kiw--proof-metrics-media-ratio: 1296 / 406;
  padding-block: var(--kiw--proof-metrics-section-space);
}

.proof-metrics-allentown[data-kinekt-section] > .proof-metrics-allentown__container {
  display: grid;
  width: 100%;
  max-width: none;
  gap: var(--kiw--proof-metrics-major-gap);
  margin-inline: auto;
  padding-inline: var(--kiw--proof-metrics-inline-space);
}

.proof-metrics-allentown .proof-metrics-allentown__intro-and-metrics {
  display: grid;
  gap: var(--kiw--proof-metrics-intro-gap);
  min-width: 0;
}

.proof-metrics-allentown .proof-metrics-allentown__intro {
  max-width: none;
}

.proof-metrics-allentown .proof-metrics-allentown__intro .section-intro {
  display: grid;
  justify-items: start;
  gap: var(--kiw--proof-metrics-intro-group-gap);
}

.proof-metrics-allentown .proof-metrics-allentown__intro .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) {
  max-width: none;
  margin: 0;
}

.proof-metrics-allentown .proof-metrics-allentown__intro .section-intro__heading-group {
  display: grid;
  gap: var(--kiw--proof-metrics-heading-stack-gap);
}

.proof-metrics-allentown .proof-metrics-allentown__intro .section-intro__description {
  color: var(--kinekt-component-muted);
  font-size: var(--kinekt-component-text-l-size);
  line-height: var(--kinekt-component-text-line-height);
}

.proof-metrics-allentown .proof-metrics-allentown__intro .section-intro__description > * {
  margin-block: 0;
}

.proof-metrics-allentown .proof-metrics-allentown__metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--kiw--proof-metrics-metric-row-gap);
