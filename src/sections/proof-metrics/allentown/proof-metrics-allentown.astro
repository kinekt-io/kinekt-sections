  :where(.proof-metrics-allentown[data-kinekt-section]) > .proof-metrics-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  :where(.proof-metrics-allentown) :is(.proof-metrics-allentown__intro, .proof-metrics-allentown__header) { max-width: var(--kinekt-component-reading-width); }
