---
import ProofMetricsAllentown from './proof-metrics-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  "theme": "semi-light" as const,
  "intro": {
    "accentHeading": "/ Battle tested battery packs",
    "heading": "Proven under real-world conditions",
    "description": "High-density performance only matters when it remains reliable in demanding conditions. Tulip validates its battery packs through extensive laboratory testing, platform validation and real-world operation to prove performance beyond the specification sheet."
  },
  "metrics": [
    {
      "label": "Operating hours",
      "value": {
        "text": "XX,000+"
      }
    },
    {
      "label": "Packs tested",
      "value": {
        "text": "XX,000+"
      }
    },
    {
      "label": "Field failure rate",
      "value": {
        "text": "< XX%"
      }
    },
    {
      "label": "Platforms powered",
      "value": {
        "text": "XXX+"
      }
    }
  ],
  "media": {
    "url": placeholder('placeholder-1296x406.svg'),
    "alt": "Abstract grayscale placeholder for proof media",
    "width": 1296,
    "height": 406
  },
  "callout": {
    "intro": {
      "accentHeading": "Validation & testing",
      "heading": "The things we test in the field",
      "description": "Temperature, vibration and environmental conditions are evaluated to understand how battery performance holds up beyond controlled laboratory environments."
    },
    "ctaGroup": {
      "primaryButton": {
        "label": "Download test report",
        "href": "#",
        "icon": "download" as const
      }
    }
  }
}
---
<ProofMetricsAllentown {...content} />
