{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/proof-metrics/allentown",
  "slug": "proof-metrics-allentown",
  "title": "Proof Metrics Allentown",
  "description": "A reusable evidence section with an introduction, one to four proof values, optional wide proof media, and an optional labelled callout.",
  "category": "sections",
  "tags": ["metrics", "social-proof", "beta"],
  "role": "proof-metrics",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-412607&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:412607"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "metrics": {
      "kind": "componentList",
      "componentId": "components/result-item/allentown",
      "required": true,
      "localized": true,
      "minItems": 1,
      "maxItems": 4,
      "description": "One to four named proof values; each metric has a required title and a localized Label value."
    },
    "media": {
      "kind": "media",
      "required": false,
      "localized": true,
      "description": "Optional editor-selected proof media, localized per locale."
    },
    "callout": {
      "kind": "component",
      "componentId": "components/callout/allentown",
      "required": false,
      "localized": true,
      "description": "Optional localized action callout with zero, one or two actions. Leave its heading empty to omit the callout."
    }
  },
  "runtimeProps": {
    "metricLayout": {
      "kind": "responsiveGrid",
      "source": "renderer"
    },
    "calloutFlightPath": {
      "kind": "flightPath",
      "source": "renderer"
    }
  }
}
