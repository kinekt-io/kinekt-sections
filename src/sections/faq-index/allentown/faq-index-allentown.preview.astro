---
import FaqIndex from './faq-index-allentown.astro'

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ FAQ',
    heading: 'Find your answer',
  },
  subjects: [
    { id: 'selection', label: 'Selection' },
    { id: 'integration', label: 'Integration' },
    { id: 'certification', label: 'Certification' },
    { id: 'ordering', label: 'Ordering' },
  ],
  faqs: [
    {
      question: 'How do I know which battery pack is right for my platform?',
      answer: 'The right pack depends on your platform architecture, voltage, energy requirements, available space, weight budget and mission profile. Tulip can help compare available standard packs and determine whether a standard or custom solution is the better fit.',
      subjects: ['selection'],
    },
    {
      question: 'Can I use a Tulip battery pack in an existing platform?',
      answer: 'Yes. Standard packs are available in common voltages and connector options, and our engineers check mechanical fit, power draw and communication protocols against your existing platform before you order.',
      subjects: ['integration', 'selection'],
    },
    {
      question: 'What is the difference between a standard and custom battery pack?',
      answer: 'Standard packs are qualified, in stock and ready to integrate. Custom packs are engineered around your platform when space, energy or environmental requirements fall outside the standard range.',
      subjects: ['selection'],
    },
    {
      question: 'Are Tulip battery packs certified for use in Europe?',
      answer: 'Our packs are designed and tested to meet UN 38.3 transport requirements and the relevant IEC safety standards. Certificates and test reports are available on request for every pack in the standard range.',
      subjects: ['certification'],
    },
    {
      question: 'What information do you need to recommend a battery pack?',
      answer: 'Share your platform type, operating voltage, expected power draw, flight or mission time, available space and weight budget. Environmental conditions and expected order volumes help us refine the recommendation.',
      subjects: ['ordering', 'selection'],
    },
  ],
  callout: {
    intro: {
      accentHeading: 'Did you not find your answer?',
      heading: 'Talk to a battery engineer',
      description: 'Send us your question and an engineer will get back to you within one working day.',
    },
    ctaGroup: {
      primaryButton: { label: 'Ask an expert', href: '/contact', icon: 'arrow-right' as const },
    },
  },
}
---
<FaqIndex {...content} />
