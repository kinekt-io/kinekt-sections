---
import '../../../styles/wireframe-tokens.css'
import type { RichText } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
interface Props { id?: string; theme?: Theme; content: string | RichText | { html?: string } }

const { id, theme = 'light', content } = Astro.props as Props
const html = typeof content === 'object' && content !== null && 'html' in content && typeof content.html === 'string' ? content.html : undefined
---
<section class="editorial-content-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="editorial-content-allentown__container">
    {typeof content === 'string' && content && <p class="editorial-content-allentown__copy">{content}</p>}
    {html && <div class="editorial-content-allentown__copy" set:html={html} />}
  </div>
</section>

<style is:global>
  :where(.editorial-content-allentown) { --kiw--editorial-content-allentown-inline-space: var(--section-gutter); --kiw--editorial-content-allentown-block-space: var(--section-space-xl); --kiw--editorial-content-allentown-reading-width: var(--width-l); --kiw--editorial-content-allentown-copy-gap: var(--space-l); }

  .editorial-content-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark));
    --kinekt-component-line: var(--kinekt-section-line, var(--primary-ultra-light));
    --kinekt-component-radius: var(--kinekt-section-radius, var(--radius-none));
    padding-block: var(--kiw--editorial-content-allentown-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);

    &[data-kinekt-theme='semi-light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light)); }
    &:is([data-kinekt-theme='dark'], [data-kinekt-theme='semi-dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark)); --kinekt-component-ink: var(--kinekt-section-ink, var(--white)); --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light)); --kinekt-component-line: var(--kinekt-section-line, var(--primary)); }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .editorial-content-allentown__container { width: 100%; max-width: min(var(--website-width), calc(var(--kiw--editorial-content-allentown-reading-width) + (var(--kiw--editorial-content-allentown-inline-space) * 2))); margin-inline: auto; padding-inline: var(--kiw--editorial-content-allentown-inline-space); }
    & .editorial-content-allentown__copy { color: var(--kinekt-component-muted); font-size: var(--text-l); line-height: var(--text-line-height); }
    & .editorial-content-allentown__copy > :first-child { margin-top: 0; }
    & .editorial-content-allentown__copy > :last-child { margin-bottom: 0; }
    & .editorial-content-allentown__copy > * + * { margin-block-start: var(--kiw--editorial-content-allentown-copy-gap); }
    & .editorial-content-allentown__copy :is(h2, h3, h4, h5, h6) { color: var(--kinekt-component-ink); font-family: var(--heading-font-family); font-weight: var(--heading-font-weight); line-height: var(--heading-line-height); }
    & .editorial-content-allentown__copy blockquote { margin-inline: 0; padding-inline-start: var(--space-l); border-inline-start: var(--border-width) solid var(--kinekt-component-line); color: var(--kinekt-component-ink); }
    & .editorial-content-allentown__copy :is(ul, ol) { padding-inline-start: var(--space-l); }
    & .editorial-content-allentown__copy a { color: inherit; font-weight: var(--heading-font-weight); text-underline-offset: var(--space-xxs); }
  }
</style>
