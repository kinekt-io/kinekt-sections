---
import ComplianceOverviewAllentown from './compliance-overview-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name
const cert = (alt: string) => ({ url: placeholder('placeholder-mark-144x144.svg'), alt, width: 144, height: 144 })

const content = {
  theme: 'dark' as const,
  intro: {
    accentHeading: '/ Certified and documented',
    heading: 'Safety & Compliance',
    description: 'Every Tulip battery is built to meet the regulations of the markets you sell in. Below you find each certification we hold, what it covers and the documentation you can request.',
  },
  checklistTitle: 'What we cover for every pack:',
  checklistItems: [
    { text: 'Transport certification' },
    { text: 'Chemical compliance' },
    { text: 'Safety and quality standards' },
  ],
  ctaGroup: {
    primaryButton: { label: 'See first subject', href: '/compliance/#un-38-3', icon: 'arrow-down' as const },
    secondaryButton: { label: 'Download documentation', href: '/downloads/compliance/', icon: 'download' as const },
  },
  // Runtime collageNavigation: one tile per compliance section with a cert image, in page order.
  collage: [
    { anchor: 'un-38-3', certImage: cert('UN 38.3 certification mark'), label: 'UN 38.3 transport safety' },
    { anchor: 'reach', certImage: cert('REACH compliance mark'), label: 'REACH compliance' },
    { anchor: 'rohs', certImage: cert('RoHS compliance mark'), label: 'RoHS compliance' },
    { anchor: 'iec-62133', certImage: cert('IEC 62133 certification mark'), label: 'IEC 62133 safety' },
    { anchor: 'ce', certImage: cert('CE marking'), label: 'CE marking' },
    { anchor: 'iso-9001', certImage: cert('ISO 9001 certification mark'), label: 'ISO 9001 quality management' },
  ],
}
---
<ComplianceOverviewAllentown {...content} />
