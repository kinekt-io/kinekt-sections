---
// @generated structural section preview.
import StructuralSection from '../../../shared/structural-section.astro'

const content = {
  "theme": "light",
  "intro": {
    "accentHeading": "Engineering energy storage for demanding applications",
    "heading": "Engineering energy storage for demanding applications",
    "description": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
  },
  "checklistTitle": "Engineering energy storage for demanding applications",
  "checklistItems": [
    {
      "text": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
    },
    {
      "text": "Use this space to explain the decision, the technical context and the next step without reducing the layout to placeholder labels."
    },
    {
      "text": "Every example uses realistic-length content so hierarchy, reading rhythm and responsive behaviour are visible before site-specific styling is applied."
    }
  ],
  "ctaGroup": {
    "primaryButton": {
      "label": "Explore the specification",
      "href": "#"
    },
    "secondaryButton": {
      "label": "Explore the specification",
      "href": "#"
    }
  }
}
const fields = {
  "theme": {
    "kind": "select"
  },
  "intro": {
    "kind": "component",
    "id": "components/intro/allentown",
    "role": "intro",
    "fields": {
      "accentHeading": {
        "kind": "text"
      },
      "heading": {
        "kind": "text"
      },
      "description": {
        "kind": "richText"
      }
    }
  },
  "checklistTitle": {
    "kind": "text"
  },
  "checklistItems": {
    "kind": "componentList",
    "id": "components/checklist-item/allentown",
    "role": "checklist-item",
    "fields": {
      "text": {
        "kind": "text"
      }
    }
  },
  "ctaGroup": {
    "kind": "component",
    "id": "components/cta-group/allentown",
    "role": "cta-group",
    "fields": {
      "primaryButton": {
        "kind": "cta"
      },
      "secondaryButton": {
        "kind": "cta"
      }
    }
  }
}
const intro = {
  "accentHeading": "Engineering energy storage for demanding applications",
  "heading": "Engineering energy storage for demanding applications",
  "description": "A representative introduction that shows how longer copy, links and lists will behave once a component is connected to real content."
}
const ctas = {
  "primaryButton": {
    "label": "Explore the specification",
    "href": "#"
  },
  "secondaryButton": {
    "label": "Explore the specification",
    "href": "#"
  }
}
const media = undefined
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`

function resolveCatalogueAssets(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(resolveCatalogueAssets)
  if (!value || typeof value !== 'object') return value
  const record = Object.fromEntries(Object.entries(value).map(([key, item]) => [key, resolveCatalogueAssets(item)]))
  if (typeof record.url === 'string' && record.url.startsWith('catalogue-placeholder:')) {
    record.url = `${catalogueBase}placeholders/${record.url.slice('catalogue-placeholder:'.length)}`
  }
  return record
}

const resolvedContent = resolveCatalogueAssets(content) as Record<string, unknown>
---
<StructuralSection block="beta-compliance-overview-allentown" intro={intro} ctas={ctas} media={media} content={resolvedContent} fields={fields} />
