    --kiw--section-text-letter-spacing: var(--kiw--compliance-overview-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--compliance-overview-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--compliance-overview-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--compliance-overview-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--compliance-overview-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--compliance-overview-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--compliance-overview-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--compliance-overview-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-canvas: var(--kiw--compliance-overview-allentown-canvas);
    --kiw--section-surface: var(--kiw--compliance-overview-allentown-surface);
    --kiw--section-ink: var(--kiw--compliance-overview-allentown-ink);
    --kiw--section-muted: var(--kiw--compliance-overview-allentown-muted);
    --kiw--section-line: var(--kiw--compliance-overview-allentown-line);
    --kiw--section-action: var(--kiw--compliance-overview-allentown-action);
    --kiw--section-action-text: var(--kiw--compliance-overview-allentown-action-text);
    --kiw--section-accent: var(--kiw--compliance-overview-allentown-accent);
    --kiw--section-action-icon: var(--kiw--compliance-overview-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--compliance-overview-allentown-subtle);
  }
</style>
<style is:global>
  :where(.compliance-overview-allentown[data-kinekt-section]) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-ultra-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary))); --kinekt-component-font: var(--kinekt-section-font, var(--kiw--section-text-font-family)); --kinekt-component-mono: var(--kinekt-section-mono, var(--kiw--section-mono-font-family)); --kinekt-component-site-width: var(--kinekt-section-site-width, var(--kiw--section-site-width)); --kinekt-component-content-width: var(--kinekt-section-content-width, var(--kiw--section-content-width)); --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--kiw--section-reading-width)); --kinekt-component-inline-space: var(--kinekt-section-inline-space, var(--kiw--section-inline-space)); --kinekt-component-block-space: var(--kinekt-section-block-space, var(--kiw--section-block-space)); --kinekt-component-gap: var(--kinekt-section-gap, var(--kiw--section-gap)); --kinekt-component-radius: var(--kinekt-section-radius, var(--kiw--section-radius)); --kinekt-component-border-width: var(--kinekt-section-border-width, var(--kiw--section-border-width)); --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--kiw--section-media-filter)); --kinekt-component-intro-accent-gap: var(--kinekt-section-intro-accent-gap, var(--kiw--section-intro-accent-gap)); --kinekt-component-intro-description-gap: var(--kinekt-section-intro-description-gap, var(--kiw--section-intro-description-gap)); --kinekt-component-heading-2-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); --kinekt-component-heading-line-height: var(--kinekt-section-heading-line-height, var(--kiw--section-heading-line-height)); --kinekt-component-text-l-size: var(--kinekt-section-text-l-size, var(--kiw--section-text-l-size)); --kinekt-component-text-line-height: var(--kinekt-section-text-line-height, var(--kiw--section-text-line-height)); }
  :where(.compliance-overview-allentown[data-kinekt-section][data-kinekt-theme='semi-light']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-light))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary-semi-dark))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary))); color-scheme: light; }
  :where(.compliance-overview-allentown[data-kinekt-section][data-kinekt-theme='dark']) { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--primary-ultra-dark))); --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--primary-semi-dark))); --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--white))); --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-ultra-light))); --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary))); --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary))); --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white))); --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent))); --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent))); --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary-ultra-light))); color-scheme: dark; }
