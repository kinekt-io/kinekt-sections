---
import '../../../styles/wireframe-tokens.css'
import ChecklistItem, { type ChecklistItemContent } from '../../../components/checklist-item/allentown/checklist-item-allentown.astro'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type Media, type RichText, type SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import { isSafeWebUrl } from '../../../urls.js'

// The generated types (compliance-overview-allentown.types.ts) are still a generic record; these are the fields the manifest declares.
/** Rich text as it arrives: a plain string, pre-rendered `{ html }`, or raw Lexical JSON from the identity Payload adapter. */
type RichTextInput = string | RichText | Record<string, unknown>
/** One tile of the runtime `collageNavigation` (eligibleComplianceSectionsCertImageInPageOrder): a compliance section on the page with a cert image, linked by its stable anchor. */
export interface ComplianceCollageTile {
  /** The section's anchor id (runtime `sectionAnchor` of Compliance Detail / Text), without `#`. */
  anchor: string
  certImage: Media
  /** Accessible name of the link, e.g. the section heading. Defaults to the image alt text. */
  label?: string
}
interface Props {
  id?: string
  theme?: BetaTheme
  /** Figma sets this as the page's main section (h1-size title), so it defaults to h1. */
  headingLevel?: 'h1' | 'h2'
  intro: Omit<SectionIntroContent, 'description'> & { description?: RichTextInput | null }
  checklistTitle?: string | null
  checklistItems: ChecklistItemContent[]
  ctaGroup?: CtaGroup | Cta[] | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
  /** Runtime `collageNavigation`: the page passes the eligible compliance sections in page order. */
  collage?: ComplianceCollageTile[]
  /** Hover / focus label on collage tiles. */
  collageLinkLabel?: string
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'dark', headingLevel = 'h1', intro, checklistTitle, checklistItems = [], ctaGroup, collage = [], collageLinkLabel = 'Learn more', mediaLoading = 'lazy' } = Astro.props
const toHtml = (value: RichTextInput | null | undefined, field: string): string => {
  if (value == null || value === '') return ''
  if (typeof value === 'string') return value.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean).map((part) => richTextToHtml(part, field)).join('')
  if (typeof value.html === 'string') return value.html
  return richTextToHtml(value, field)
}
const introContent: SectionIntroContent = { ...intro, description: intro.description == null || typeof intro.description === 'string' ? intro.description ?? undefined : { html: toHtml(intro.description, 'intro.description') } }
const items = checklistItems.filter((item) => item?.text)
const ChecklistTitle = headingLevel === 'h1' ? 'h2' : 'h3'
const actions = ctaGroupActions(ctaGroup)
for (const cta of actions) if (!isSafeWebUrl(cta.href)) throw new Error('ctaGroup buttons must use an HTTP(S) or root-relative URL.')
const tiles = collage.filter((tile) => typeof tile?.anchor === 'string' && /^[A-Za-z][\w:.-]*$/.test(tile.anchor) && tile.certImage?.url)
// Figma's arrow-down-right is the shared arrow-up-left stroke icon turned 180° (no separate CtaIcon needed).
const tileIcon = ctaIconPaths['arrow-up-left']
---
<section class:list={['compliance-overview-allentown', tiles.length > 0 && 'compliance-overview-allentown--with-collage']} id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="compliance-overview-allentown__container">
    <div class="compliance-overview-allentown__content">
      <div class="compliance-overview-allentown__lead">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
        {items.length > 0 && (
          <div class="compliance-overview-allentown__summary">
            {checklistTitle && <ChecklistTitle class="compliance-overview-allentown__checklist-title">{checklistTitle}</ChecklistTitle>}
            <ul class="compliance-overview-allentown__checklist">
              {items.map((item) => <ChecklistItem item={item} />)}
            </ul>
          </div>
        )}
      </div>
      {actions.length > 0 && (
        <div class="compliance-overview-allentown__actions">
          {actions.map((action, index) => {
            const icon = isCtaIcon(action.icon) ? ctaIconPaths[action.icon] : undefined
            return <Button class="compliance-overview-allentown__action" size={index === 0 ? 'l' : undefined} href={action.href} label={action.label} style={action.style ?? (index === 0 ? 'primary' : 'clear')}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="none"><path d={icon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>
          })}
        </div>
      )}
    </div>
    {tiles.length > 0 && (
      <nav class="compliance-overview-allentown__collage" aria-label={intro.heading}>
        <ul class="compliance-overview-allentown__tiles">
          {tiles.map((tile) => (
            <li class="compliance-overview-allentown__tile-item">
              <a class="compliance-overview-allentown__tile" href={`#${tile.anchor}`} aria-label={tile.label || undefined}>
                <KinektMedia media={tile.certImage} class="compliance-overview-allentown__tile-media" imageClass="compliance-overview-allentown__tile-image" loading={mediaLoading} />
                <span class="compliance-overview-allentown__tile-label">{collageLinkLabel}<svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={tileIcon.viewBox} fill="none"><path d={tileIcon.path} stroke="currentColor" stroke-width="2" /></svg></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</section>
<style is:global>
