</style>
<style is:global>
  /*
   * Figma "Main section" (5240:413425, dark + accent gradient): 1440 container, space-between: content 864 (intro + checklist summary, divider, CTAs; gap section-xs)
   * and a 2 × 3 collage of 144 cert tiles (gap 20 = space-m) that link to the compliance sections on the page.
   */
  :where(.compliance-overview-allentown) {
    --kiw--compliance-overview-allentown-content-max-width: var(--width-l);
    --kiw--compliance-overview-allentown-column-gap: var(--section-space-l);
    --kiw--compliance-overview-allentown-stack-gap: var(--section-space-m);
    --kiw--compliance-overview-allentown-content-gap: var(--section-space-xs);
    --kiw--compliance-overview-allentown-lead-gap: var(--space-xxl);
    --kiw--compliance-overview-allentown-intro-gap: var(--space-m);
    --kiw--compliance-overview-allentown-intro-copy-size: var(--kiw--section-text-l-size);
    --kiw--compliance-overview-allentown-summary-gap: var(--space-l);
    --kiw--compliance-overview-allentown-checklist-title-size: var(--kiw--section-text-xl-size);
    --kiw--compliance-overview-allentown-checklist-title-weight: 600;
    --kiw--compliance-overview-allentown-checklist-gap: var(--space-m);
    --kiw--compliance-overview-allentown-divider-color: var(--kinekt-component-line);
    --kiw--compliance-overview-allentown-actions-gap: var(--space-l);
    --kiw--compliance-overview-allentown-tile-size: var(--desktop-width-xs);
    --kiw--compliance-overview-allentown-tile-gap: var(--space-m);
    --kiw--compliance-overview-allentown-tile-padding: 0px;
    --kiw--compliance-overview-allentown-tile-background: var(--kinekt-component-surface);
    --kiw--compliance-overview-allentown-tile-border-color: var(--kinekt-component-line);
    --kiw--compliance-overview-allentown-tile-label-color: var(--kinekt-component-accent);
    --kiw--compliance-overview-allentown-tile-label-inset: calc((var(--space-xxs) + var(--space-xs)) / 2);
    /* Figma's heading-page accent (text-l) and h1 at line-height 1.05; both feed the shared SectionIntro. */
    --kiw--section-intro-accent-font-size: var(--kiw--section-text-l-size);
    --kiw--compliance-overview-allentown-heading-line-height: 1.05;
    box-sizing: border-box;
    padding-block: var(--kinekt-component-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--kinekt-component-font);
    font-size: var(--kiw--section-text-m-size);
    font-weight: var(--kiw--section-text-font-weight);
    line-height: var(--kiw--section-text-line-height);
    letter-spacing: var(--kiw--section-text-letter-spacing);
  }
  /* Figma tiles on the dark frame sit on primary-dark (off-role); the other themes use the surface role (inferred). */
  :where(.compliance-overview-allentown[data-kinekt-theme='dark']) { --kiw--compliance-overview-allentown-tile-background: var(--primary-dark); }
  :where(.compliance-overview-allentown) *, :where(.compliance-overview-allentown) *::before, :where(.compliance-overview-allentown) *::after { box-sizing: border-box; }
  :where(.compliance-overview-allentown) [hidden] { display: none !important; }
  :where(.compliance-overview-allentown) :is(p, ul, h2, h3) { margin-block: 0; }

  .compliance-overview-allentown > .compliance-overview-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); row-gap: var(--kiw--compliance-overview-allentown-stack-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .compliance-overview-allentown .compliance-overview-allentown__content { display: grid; gap: var(--kiw--compliance-overview-allentown-content-gap); min-width: 0; }
  .compliance-overview-allentown .compliance-overview-allentown__lead { display: grid; gap: var(--kiw--compliance-overview-allentown-lead-gap); min-width: 0; }
  .compliance-overview-allentown .section-intro { display: grid; justify-items: start; gap: var(--kiw--compliance-overview-allentown-intro-gap); }
  .compliance-overview-allentown .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .compliance-overview-allentown .section-intro__heading { max-width: none; }
  .compliance-overview-allentown .section-intro__description { max-width: none; font-size: var(--kiw--compliance-overview-allentown-intro-copy-size); line-height: var(--kinekt-component-text-line-height); }
  .compliance-overview-allentown .section-intro__description > * { margin-block: 0; }
  .compliance-overview-allentown .section-intro__description > * + * { margin-block-start: var(--space-s); }
  .compliance-overview-allentown .compliance-overview-allentown__summary { display: grid; gap: var(--kiw--compliance-overview-allentown-summary-gap); }
  .compliance-overview-allentown .compliance-overview-allentown__checklist-title { color: var(--kinekt-component-ink); font-family: var(--kiw--section-heading-font-family); font-size: var(--kiw--compliance-overview-allentown-checklist-title-size); font-weight: var(--kiw--compliance-overview-allentown-checklist-title-weight); line-height: 1; letter-spacing: var(--kiw--section-heading-letter-spacing); }
  .compliance-overview-allentown .compliance-overview-allentown__checklist { display: grid; gap: var(--kiw--compliance-overview-allentown-checklist-gap); margin: 0; padding: 0; list-style: none; }
