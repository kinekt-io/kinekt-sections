    --kiw--section-border-width: var(--kiw--compliance-overview-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--compliance-overview-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--compliance-overview-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--compliance-overview-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--compliance-overview-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--compliance-overview-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--compliance-overview-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--compliance-overview-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--compliance-overview-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--compliance-overview-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--compliance-overview-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--compliance-overview-allentown-heading-font-weight, var(--heading-font-weight));
