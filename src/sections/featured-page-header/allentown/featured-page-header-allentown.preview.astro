---
import FeaturedPageHeaderAllentown from './featured-page-header-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ Knowledge base',
    heading: 'Industry Insights',
  },
  insightSources: [
    {
      title: 'How system constraints shape battery design',
      excerpt: 'Duty cycle, enclosure and thermal limits decide most of a pack before the first cell is chosen. A practical look at the trade-offs.',
      href: '#',
      publishedAt: '2026-10-01',
      kind: 'Article',
      featured: true,
      image: { url: placeholder('placeholder-800x600.svg'), alt: 'Neutral wireframe placeholder for an engineering team reviewing test data', width: 800, height: 600 },
    },
    {
      title: 'Making validation data useful for integration teams',
      excerpt: 'The system is configured around the duty cycle, environmental demands and evidence needed for a reliable release.',
      href: '#',
      publishedAt: '2026-10-08',
      kind: 'Article',
      image: { url: placeholder('placeholder-800x600.svg'), alt: 'Neutral wireframe placeholder for a battery system integration', width: 800, height: 600 },
    },
    {
      title: 'Electrifying a regional bus fleet',
      excerpt: 'Structured content keeps performance requirements, technical context and implementation choices easy to compare.',
      href: '#',
      publishedAt: '2026-10-12',
      kind: 'Case',
      image: { url: placeholder('placeholder-800x600.svg'), alt: 'Neutral wireframe placeholder for an electric bus', width: 800, height: 600 },
    },
  ],
}
---
<FeaturedPageHeaderAllentown {...content} />
