{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/featured-page-header/allentown",
  "slug": "featured-page-header-allentown",
  "title": "Featured Page Header Allentown",
  "description": "A reusable index-page header with a localized Intro and one renderer-selected featured insight from selected platform-managed sources.",
  "category": "sections",
  "role": "featured-page-header",
  "variation": "allentown",
  "status": "planned",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-411660&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:411660"
  },
  "fields": {
    "theme": {"kind":"select","required":true,"localized":false,"options":["light","dark"],"description":"CMS-selected presentation setting passed to the renderer."},
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true,
      "description": "Use the optional Intro description only in a renderer variation that supports it."
    },
    "insightSources": {
      "kind": "insightSourceList",
      "required": true,
      "localized": true,
      "minItems": 1,
      "description": "One or more active platform-managed Insight Sources."
    }
  },
  "runtimeProps": {
    "featuredSelection": {
      "kind": "newestFeaturedThenNewestPublished",
      "source": "renderer"
    },
    "contentScope": {
      "kind": "activeRegionAndLocale",
      "source": "renderer"
    },
    "featuredCardFields": {
      "kind": "sourceMappingMediaTitleExcerptUrl",
      "source": "renderer"
    }
  }
}
