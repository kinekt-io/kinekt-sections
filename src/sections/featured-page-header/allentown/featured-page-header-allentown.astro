    --kiw--section-text-xxl-size: var(--kiw--featured-page-header-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--featured-page-header-allentown-carousel-gap, var(--content-gap));
