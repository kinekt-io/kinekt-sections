---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { ctaIconPaths } from '../../../shared/cta-icons.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type HeadingLevel = 'h1' | 'h2' | 'h3'

// Mirrors the manifest's `insightSourceList` item (see `createManifestBlock`): the Payload
// adapter passes items through unchanged, so `image` may arrive as a Media object or an ID.
interface InsightSource {
  title: string
  excerpt?: string
  href: string
  publishedAt?: string
  kind?: string
  featured?: boolean
  image?: unknown
}

interface Props {
  contentWidth?: import('../../../shared/section-width.js').SectionContentWidth
  id?: string
  theme?: Theme
  headingLevel?: HeadingLevel
  intro: SectionIntroContent
  insightSources?: InsightSource[]
  mediaLoading?: 'eager' | 'lazy'
}

const { id, theme = 'light', headingLevel = 'h2', intro, insightSources = [], mediaLoading = 'lazy' } = Astro.props as Props

// runtimeProps.featuredSelection = newestFeaturedThenNewestPublished
const publishedTime = (source: InsightSource): number => {
  const time = source.publishedAt ? Date.parse(source.publishedAt) : Number.NaN
  return Number.isNaN(time) ? Number.NEGATIVE_INFINITY : time
}
const newest = (sources: InsightSource[]): InsightSource | undefined => sources.reduce<InsightSource | undefined>((best, source) => (!best || publishedTime(source) > publishedTime(best) ? source : best), undefined)
const valid = insightSources.filter((source) => source && typeof source.title === 'string' && typeof source.href === 'string')
const featured = newest(valid.filter((source) => source.featured)) ?? newest(valid)

const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string'
const media = featured && isMedia(featured.image) ? { ...featured.image, alt: typeof featured.image.alt === 'string' ? featured.image.alt : '' } : undefined
const kind = featured?.kind?.trim() || 'Article'
const FeaturedHeading = headingLevel === 'h1' ? 'h2' : headingLevel === 'h2' ? 'h3' : 'h4'
const ctaIcon = ctaIconPaths('arrow-right')
---
<section class="featured-page-header-allentown" id={id} data-kinekt-section data-kinekt-content-width={Astro.props.contentWidth ?? 'standard'} data-kinekt-theme={theme}>
  <div class="featured-page-header-allentown__container">
    <header class="featured-page-header-allentown__intro">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
    </header>
    {featured && <article class="featured-page-header-allentown__featured">
      <SubtitleFlightPath class="featured-page-header-allentown__featured-label" text={`Featured ${kind}`} size="small" />
      <div class:list={['featured-page-header-allentown__featured-body', media && 'featured-page-header-allentown__featured-body--media']}>
        {media && <KinektMedia media={media} class="featured-page-header-allentown__media" imageClass="featured-page-header-allentown__image" loading={mediaLoading} />}
        <div class="featured-page-header-allentown__featured-content">
          <div class="featured-page-header-allentown__featured-copy">
            <FeaturedHeading class="featured-page-header-allentown__featured-title">{featured.title}</FeaturedHeading>
            {featured.excerpt && <p class="featured-page-header-allentown__featured-excerpt">{featured.excerpt}</p>}
          </div>
          <Button class="featured-page-header-allentown__featured-link" href={featured.href} label={`View ${kind.toLowerCase()}`} style="clear">{ctaIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={ctaIcon.viewBox} fill="currentColor"><path d={ctaIcon.path} /></svg>}</Button>
        </div>
      </div>
    </article>}
  </div>
</section>
<style is:global>
