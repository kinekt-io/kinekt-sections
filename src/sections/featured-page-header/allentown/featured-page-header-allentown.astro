    --kiw--section-site-width: var(--kiw--featured-page-header-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--featured-page-header-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--featured-page-header-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--featured-page-header-allentown-inline-space, var(--section-gutter));
