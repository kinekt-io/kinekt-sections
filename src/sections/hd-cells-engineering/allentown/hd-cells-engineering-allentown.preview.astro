---
import HdCellsEngineering from './hd-cells-engineering-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name
const cellMedia = (alt: string) => ({ url: placeholder('placeholder-1000x800.svg'), alt, width: 1000, height: 800 })
const topicMedia = (alt: string) => ({ url: placeholder('placeholder-800x1000.svg'), alt, width: 800, height: 1000 })

const content = {
  theme: 'dark' as const,
  cellsIntro: {
    accentHeading: '/ High-density cells',
    heading: 'More energy starts at cell level',
    description: 'The performance of a battery pack begins with the cells inside it. Tulip selects high-density cell technologies that store more usable energy within the same weight.',
  },
  cellItems: [
    {
      media: cellMedia('High-density cylindrical cells arranged in a module'),
      title: 'Higher energy density',
      subtitle: 'Smarter use of space',
      description: 'High-density cells increase the amount of usable energy available per kilogram and per liter. That creates more performance potential without simply making the battery larger or heavier.',
    },
    {
      media: cellMedia('Compact battery module inside a drone airframe'),
      title: 'Smarter use of space',
      subtitle: 'Get more from the space you already have',
      description: 'More energy in the same envelope lets platforms fly longer or carry more payload without redesigning the airframe around the battery.',
    },
    {
      media: cellMedia('Cell samples on a test bench'),
      title: 'Selected for the mission',
      subtitle: 'The right cell depends on what the platform needs',
      description: 'Cell chemistry and format are chosen for the duty cycle: high discharge for lift-off and manoeuvres, or maximum capacity for long endurance missions.',
    },
  ],
  engineeringIntro: {
    accentHeading: '/ High-density engineering',
    heading: 'Turn cell performance into platform performance',
    description: 'High-density cells are only part of the equation. The way they are configured, packaged, cooled and integrated determines how much of that performance reaches the platform.',
  },
  engineeringTopics: [
    {
      media: topicMedia('Exploded view of the pack architecture'),
      title: 'Pack architecture',
      description: 'Cell layout, enclosure and internal architecture are optimized to maximize usable energy within available space and weight.',
      labels: [
        { label: 'Assembly time', value: { text: '18% faster', icon: 'stopwatch' } },
        { label: 'Service access', value: { text: 'Tool-free', icon: 'screwdriver-wrench' } },
      ],
    },
    {
      media: topicMedia('Battery management system board'),
      title: 'Electrical optimization',
      description: 'Interconnects, busbars and the battery management system are tuned to keep losses low and deliver stable power under peak load.',
    },
    {
      media: topicMedia('Thermal image of a pack under load'),
      title: 'Thermal performance',
      description: 'Heat paths and spacing between cells keep temperatures even, so the pack sustains high discharge rates without derating.',
    },
    {
      media: topicMedia('Battery pack mounted in a platform'),
      title: 'System integration',
      description: 'Connectors, mounting points and communication interfaces are matched to the platform, so the pack drops in without rework.',
    },
  ],
}
---
<HdCellsEngineering {...content} />
