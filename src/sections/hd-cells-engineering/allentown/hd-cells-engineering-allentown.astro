---
import '../../../styles/wireframe-tokens.css'
import HdCellItem, { type HdCellItemContent } from '../../../components/hd-cell-item/allentown/hd-cell-item-allentown.astro'
import HdEngineeringTopic, { type HdEngineeringTopicContent } from '../../../components/hd-engineering-topic/allentown/hd-engineering-topic-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { RichText, SectionIntro as SectionIntroContent, SectionTheme } from '../../../shared/content.js'
import { richTextToHtml } from '../../../shared/rich-text.js'
import type { BetaHdCellsEngineeringAllentownContent } from './hd-cells-engineering-allentown.types.js'

/** Rich text as it arrives: a plain string, pre-rendered `{ html }`, or raw Lexical JSON from the identity Payload adapter. */
type RichTextInput = string | RichText | Record<string, unknown>
type IntroInput = Omit<SectionIntroContent, 'description'> & { description?: RichTextInput | null }

// The generated .types.ts is still generic (Record<string, unknown>), so the renderer types its props from the manifest here.
interface Props extends BetaHdCellsEngineeringAllentownContent {
  id?: string
  theme?: SectionTheme
  headingLevel?: 'h2' | 'h3'
  cellsIntro: IntroInput
  cellItems: HdCellItemContent[]
  engineeringIntro: IntroInput
  engineeringTopics: HdEngineeringTopicContent[]
  /** Localised label of the control that reveals a topic's details. */
  moreInformationLabel?: string
  /** Accessible name of the topic tabs; defaults to the engineering heading. */
  topicsLabel?: string
  mediaLoading?: 'eager' | 'lazy'
}

const {
  id,
  theme = 'light',
  headingLevel = 'h2',
  cellsIntro,
  cellItems = [],
  engineeringIntro,
  engineeringTopics = [],
  moreInformationLabel = 'More information',
  topicsLabel,
  mediaLoading = 'lazy',
} = Astro.props as Props

const toHtml = (value: RichTextInput, field: string): string => {
  if (typeof value === 'string') return value.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean).map((part) => richTextToHtml(part, field)).join('')
  if (typeof value.html === 'string') return value.html
  return richTextToHtml(value, field)
}
const normaliseIntro = (value: IntroInput, field: string): SectionIntroContent => ({
  ...value,
  description: value.description == null || typeof value.description === 'string' ? value.description ?? undefined : { html: toHtml(value.description, field) },
})
const cellsIntroContent = normaliseIntro(cellsIntro, 'cellsIntro.description')
const engineeringIntroContent = normaliseIntro(engineeringIntro, 'engineeringIntro.description')
const topicHeadingLevel = headingLevel === 'h2' ? 'h3' : 'h4'

const hasMedia = (media: unknown): boolean => Boolean(media && typeof media === 'object' && typeof (media as { url?: unknown }).url === 'string' && (media as { url: string }).url !== '')
const cells = cellItems.filter((item) => item && typeof item.title === 'string' && item.title !== '')
const cellMedia = cells.map((item, index) => ({ media: item.media, index })).filter((entry) => hasMedia(entry.media))
const topics = engineeringTopics.filter((topic) => topic && typeof topic.title === 'string' && topic.title !== '')
// Figma places the topics on both sides of the image: the first half on the start side, the rest on the end side (DOM order = tab order).
const startCount = Math.ceil(topics.length / 2)
const baseId = id ?? `hd-cells-engineering-${Math.random().toString(36).slice(2, 8)}`
const topicIds = topics.map((_, index) => `${baseId}-topic-${index + 1}`)
---
<section class="hd-cells-engineering-allentown" id={id} data-kinekt-section data-kinekt-content-width={Astro.props.contentWidth ?? 'standard'} data-kinekt-theme={theme}>
  <div class="hd-cells-engineering-allentown__container">
    <div class="hd-cells-engineering-allentown__cells">
      <header class="hd-cells-engineering-allentown__header">
        <SectionIntro intro={cellsIntroContent} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      <div class:list={['hd-cells-engineering-allentown__cells-body', { 'hd-cells-engineering-allentown__cells-body--media': cellMedia.length > 0 }]}>
        {cellMedia.length > 0 && (
          <div class="hd-cells-engineering-allentown__cells-media">
            {cellMedia.map(({ media, index }, position) => (
              <div class="hd-cells-engineering-allentown__cell-media" data-hd-cell-media={index} hidden={position !== 0}>
                <KinektMedia media={media} imageClass="hd-cells-engineering-allentown__cell-image" loading={mediaLoading} />
              </div>
            ))}
          </div>
        )}
        <ul class="hd-cells-engineering-allentown__cells-list" data-kinekt-disclosure-group>
          {cells.map((item, index) => (
            <li class="hd-cells-engineering-allentown__cell">
              <span class="hd-cells-engineering-allentown__cell-timer" aria-hidden="true"><span></span></span>
              <HdCellItem item={item} index={index} open={index === 0} />
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hd-cells-engineering-allentown__engineering">
      <header class="hd-cells-engineering-allentown__header">
        <SectionIntro intro={engineeringIntroContent} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      {topics.length > 0 && (
        <div class="hd-cells-engineering-allentown__topics" data-hd-engineering-tabs>
          <!-- runtimeProps.activeEngineeringTopic = firstListItem. The tablist stays hidden until the script turns these buttons into tabs; without JavaScript every topic panel shows. -->
          {topics.length > 1 && (
            <div class="hd-cells-engineering-allentown__tablist" aria-label={topicsLabel ?? engineeringIntroContent.heading} data-hd-engineering-tablist hidden>
              {[topics.slice(0, startCount), topics.slice(startCount)].map((group, side) => (
                <div class:list={['hd-cells-engineering-allentown__tab-column', side === 0 ? 'hd-cells-engineering-allentown__tab-column--start' : 'hd-cells-engineering-allentown__tab-column--end']}>
                  {group.map((topic, groupIndex) => {
                    const index = side === 0 ? groupIndex : startCount + groupIndex
                    return <button class="hd-cells-engineering-allentown__tab" type="button" id={`${topicIds[index]}-tab`} aria-controls={`${topicIds[index]}-panel`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-hd-engineering-tab>{topic.title}</button>
                  })}
                </div>
              ))}
            </div>
          )}
          <div class="hd-cells-engineering-allentown__panels">
            {topics.map((topic, index) => (
              <div class="hd-cells-engineering-allentown__panel" id={`${topicIds[index]}-panel`} aria-labelledby={topics.length > 1 ? `${topicIds[index]}-tab` : undefined} data-hd-engineering-panel>
                <HdEngineeringTopic topic={topic} id={topicIds[index]} moreInformationLabel={moreInformationLabel} titleAs={topicHeadingLevel} mediaLoading={mediaLoading} />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
<script>
  import { initializeKinektInteractions } from '../../../shared/interactions'

  // runtimeProps.engineeringInteraction = handImplementedTopicHotspotsAndTransitions (progressive enhancement; transitions in CSS honour prefers-reduced-motion).
  document.querySelectorAll<HTMLElement>('.hd-cells-engineering-allentown[data-kinekt-section]').forEach((section) => {
    if (section.hasAttribute('data-hd-cells-engineering-enhanced')) return
    section.setAttribute('data-hd-cells-engineering-enhanced', '')

    // Cells: the media column follows the open cell (single-open via the shared disclosure group).
    const media = Array.from(section.querySelectorAll<HTMLElement>('[data-hd-cell-media]'))
    section.querySelectorAll<HTMLDetailsElement>('details[data-hd-cell-item]').forEach((details) => {
      details.addEventListener('toggle', () => {
        const index = details.dataset.hdCellItem
        if (!details.open || !media.some((item) => item.dataset.hdCellMedia === index)) return
        media.forEach((item) => { item.hidden = item.dataset.hdCellMedia !== index })
      })
    })

    const cellsBody = section.querySelector<HTMLElement>('.hd-cells-engineering-allentown__cells-body--media')
    const disclosures = Array.from(cellsBody?.querySelectorAll<HTMLDetailsElement>('details[data-hd-cell-item]') ?? [])
    if (cellsBody && disclosures.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const rows = disclosures.map((details) => details.parentElement!)
      let activeIndex = 0
      let hovered = cellsBody.matches(':hover')
      let visible = false
      let stopped = false
      cellsBody.dataset.hdCellTimed = 'true'

      const syncTimer = () => {
        cellsBody.dataset.hdCellTimerState = stopped || hovered || !visible ? 'paused' : 'running'
      }
      const show = (index: number) => {
        activeIndex = index
        disclosures.forEach((details, itemIndex) => {
          const active = itemIndex === index
          rows[itemIndex].toggleAttribute('data-hd-cell-active', active)
          details.open = active
        })
      }
      cellsBody.addEventListener('animationend', (event) => {
        if (stopped || event.animationName !== 'hd-cells-engineering-timer') return
        if (event.target !== rows[activeIndex].querySelector('.hd-cells-engineering-allentown__cell-timer > span')) return
        show((activeIndex + 1) % disclosures.length)
      })
      cellsBody.addEventListener('pointerenter', () => {
        hovered = true
        syncTimer()
      })
      cellsBody.addEventListener('pointerleave', () => {
        hovered = false
        syncTimer()
      })
      disclosures.forEach((details, index) => {
        details.querySelector('summary')?.addEventListener('click', (event) => {
          event.preventDefault()
          stopped = true
          cellsBody.dataset.hdCellStopped = 'true'
          show(index)
          syncTimer()
        })
      })
      show(0)
      syncTimer()
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting
        syncTimer()
      }, { threshold: 0.2 })
      observer.observe(cellsBody)
    }

    // Topics: turn the buttons into a tablist (first topic active) for the shared tabs helper.
    const tabsRoot = section.querySelector<HTMLElement>('[data-hd-engineering-tabs]')
    const tablist = tabsRoot?.querySelector<HTMLElement>('[data-hd-engineering-tablist]')
    const tabs = Array.from(tabsRoot?.querySelectorAll<HTMLButtonElement>('[data-hd-engineering-tab]') ?? [])
    const panels = Array.from(tabsRoot?.querySelectorAll<HTMLElement>('[data-hd-engineering-panel]') ?? [])
    if (tabsRoot && tablist && tabs.length > 1 && tabs.length === panels.length) {
      tablist.setAttribute('role', 'tablist')
      tablist.hidden = false
      tabs.forEach((tab, index) => {
        tab.setAttribute('role', 'tab')
        tab.setAttribute('aria-selected', String(index === 0))
        tab.tabIndex = index === 0 ? 0 : -1
      })
      panels.forEach((panel, index) => {
        panel.setAttribute('role', 'tabpanel')
        panel.hidden = index !== 0
      })
      tabsRoot.setAttribute('data-kinekt-tabs', '')
    }

    // Topic details: collapsed behind the "More information" toggle.
    section.querySelectorAll<HTMLButtonElement>('[data-hd-engineering-topic-toggle]').forEach((toggle) => {
      const details = document.getElementById(toggle.getAttribute('aria-controls') ?? '')
      if (!details) return
      const setExpanded = (expanded: boolean) => {
        toggle.setAttribute('aria-expanded', String(expanded))
        details.hidden = !expanded
      }
      setExpanded(false)
      toggle.hidden = false
      toggle.addEventListener('click', () => setExpanded(toggle.getAttribute('aria-expanded') !== 'true'))
    })

    initializeKinektInteractions(section)
  })
</script>
<style is:global>
  .hd-cells-engineering-allentown {
    --kiw--section-site-width: var(--kiw--hd-cells-engineering-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--hd-cells-engineering-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--hd-cells-engineering-allentown-reading-width, var(--width-m));
    --kiw--section-inline-space: var(--kiw--hd-cells-engineering-allentown-inline-space, var(--section-gutter));
    --kiw--section-block-space: var(--kiw--hd-cells-engineering-allentown-block-space, var(--section-space-l));
    --kiw--section-gap: var(--kiw--hd-cells-engineering-allentown-gap, var(--content-gap));
    --kiw--section-radius: var(--kiw--hd-cells-engineering-allentown-radius, var(--radius-none));
    --kiw--section-border-width: var(--kiw--hd-cells-engineering-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--hd-cells-engineering-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--hd-cells-engineering-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--hd-cells-engineering-allentown-intro-description-gap, var(--space-m));
    --kiw--section-heading-1-size: var(--kiw--hd-cells-engineering-allentown-heading-1-size, var(--h1));
    --kiw--section-heading-2-size: var(--kiw--hd-cells-engineering-allentown-heading-2-size, var(--h2));
    --kiw--section-heading-3-size: var(--kiw--hd-cells-engineering-allentown-heading-3-size, var(--h3));
    --kiw--section-heading-4-size: var(--kiw--hd-cells-engineering-allentown-heading-4-size, var(--h4));
    --kiw--section-heading-5-size: var(--kiw--hd-cells-engineering-allentown-heading-5-size, var(--h5));
    --kiw--section-heading-6-size: var(--kiw--hd-cells-engineering-allentown-heading-6-size, var(--h6));
    --kiw--section-heading-font-family: var(--kiw--hd-cells-engineering-allentown-heading-font-family, var(--heading-font-family));
    --kiw--section-heading-font-weight: var(--kiw--hd-cells-engineering-allentown-heading-font-weight, var(--heading-font-weight));
    --kiw--section-heading-line-height: var(--kiw--hd-cells-engineering-allentown-heading-line-height, var(--heading-line-height));
    --kiw--section-heading-letter-spacing: var(--kiw--hd-cells-engineering-allentown-heading-letter-spacing, var(--heading-letter-spacing));
    --kiw--section-text-font-family: var(--kiw--hd-cells-engineering-allentown-text-font-family, var(--text-font-family));
    --kiw--section-text-font-weight: var(--kiw--hd-cells-engineering-allentown-text-font-weight, var(--text-font-weight));
    --kiw--section-text-line-height: var(--kiw--hd-cells-engineering-allentown-text-line-height, var(--text-line-height));
    --kiw--section-text-letter-spacing: var(--kiw--hd-cells-engineering-allentown-text-letter-spacing, var(--text-letter-spacing));
    --kiw--section-mono-font-family: var(--kiw--hd-cells-engineering-allentown-mono-font-family, var(--mono-font-family));
    --kiw--section-text-xs-size: var(--kiw--hd-cells-engineering-allentown-text-xs-size, var(--text-xs));
    --kiw--section-text-s-size: var(--kiw--hd-cells-engineering-allentown-text-s-size, var(--text-s));
    --kiw--section-text-m-size: var(--kiw--hd-cells-engineering-allentown-text-m-size, var(--text-m));
    --kiw--section-text-l-size: var(--kiw--hd-cells-engineering-allentown-text-l-size, var(--text-l));
    --kiw--section-text-xl-size: var(--kiw--hd-cells-engineering-allentown-text-xl-size, var(--text-xl));
    --kiw--section-text-xxl-size: var(--kiw--hd-cells-engineering-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--hd-cells-engineering-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--hd-cells-engineering-allentown-actions-gap, var(--space-l));
    --kiw--section-actions-margin: var(--kiw--hd-cells-engineering-allentown-actions-margin, var(--section-space-xs));
    --kiw--section-button-height: var(--kiw--hd-cells-engineering-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--hd-cells-engineering-allentown-button-padding-block, var(--space-s));
    --kiw--section-button-padding-inline: var(--kiw--hd-cells-engineering-allentown-button-padding-inline, var(--space-l));
    --kiw--section-button-radius: var(--kiw--hd-cells-engineering-allentown-button-radius, var(--buttons-radius));
    --kiw--section-input-height: var(--kiw--hd-cells-engineering-allentown-input-height, var(--input-height));
    --kiw--section-editorial-gap: var(--kiw--hd-cells-engineering-allentown-editorial-gap, var(--section-space-xxl));
    --kiw--section-card-padding: var(--kiw--hd-cells-engineering-allentown-card-padding, var(--space-l));
    --kiw--section-header-to-content-gap: var(--kiw--hd-cells-engineering-allentown-header-to-content-gap, var(--section-space-s));
    --kiw--section-table-offset: var(--kiw--hd-cells-engineering-allentown-table-offset, var(--space-xl));
    --kiw--section-canvas: var(--kiw--hd-cells-engineering-allentown-canvas);
    --kiw--section-surface: var(--kiw--hd-cells-engineering-allentown-surface);
    --kiw--section-ink: var(--kiw--hd-cells-engineering-allentown-ink);
    --kiw--section-muted: var(--kiw--hd-cells-engineering-allentown-muted);
    --kiw--section-line: var(--kiw--hd-cells-engineering-allentown-line);
    --kiw--section-action: var(--kiw--hd-cells-engineering-allentown-action);
    --kiw--section-action-text: var(--kiw--hd-cells-engineering-allentown-action-text);
    --kiw--section-accent: var(--kiw--hd-cells-engineering-allentown-accent);
    --kiw--section-action-icon: var(--kiw--hd-cells-engineering-allentown-action-icon);
    --kiw--section-subtle: var(--kiw--hd-cells-engineering-allentown-subtle);
  }
</style>
<style is:global>
  .hd-cells-engineering-allentown[data-kinekt-section] > .hd-cells-engineering-allentown__container { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); }
  .hd-cells-engineering-allentown :is(h1, h2, h3, h4, h5, h6) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; }
  .hd-cells-engineering-allentown :is(p, ul, ol) { margin-block: 0; }
</style>
<style is:global>
  /* Figma "Section - HD Cells + Engineering" (5240:412556), dark (+ a faint accent gradient, not reproduced): two stacked parts, 210 apart.
     "High-density cells" (1296): centred intro Column 864 → section-l → 5:4 image 608 + section-l + cell list 608 (gap section-s).
     "High-density engineering" (1440): centred intro Column 864 → section-l → topics | 576 × 720 image | topics (gap section-m),
     each side a centred column of h4 topic tabs (gap section-xxl), the active one in ink with an accent underline. */
  :where(.hd-cells-engineering-allentown) {
    --kiw--hd-cells-engineering-major-gap: var(--section-space-xxl);
    --kiw--hd-cells-engineering-part-gap: var(--section-space-l);
    --kiw--hd-cells-engineering-header-width: var(--width-l);
    --kiw--hd-cells-engineering-intro-gap: var(--space-m);
    --kiw--hd-cells-engineering-heading-stack-gap: var(--space-xxs);
    --kiw--hd-cells-engineering-heading-size: var(--h2);
    --kiw--hd-cells-engineering-description-font-size: var(--text-xl);
    --kiw--hd-cells-engineering-description-color: var(--primary-light);
    --kiw--hd-cells-engineering-cells-width: var(--width-xxl);
    --kiw--hd-cells-engineering-cells-gap: var(--section-space-l);
    --kiw--hd-cells-engineering-cells-media-ratio: 5 / 4;
    --kiw--hd-cells-engineering-cells-media-background: var(--kinekt-component-surface);
    --kiw--hd-cells-engineering-cells-list-gap: var(--section-space-s);
    --kiw--hd-cells-engineering-topics-gap: var(--section-space-m);
    --kiw--hd-cells-engineering-topics-media-width: var(--width-m);
    --kiw--hd-cells-engineering-tabs-gap: var(--section-space-xxl);
    --kiw--hd-cells-engineering-tab-size: var(--h4);
    --kiw--hd-cells-engineering-tab-padding-block: calc((var(--space-xxs) + var(--space-xs)) / 2);
    --kiw--hd-cells-engineering-tab-color: var(--kinekt-component-muted);
    --kiw--hd-cells-engineering-tab-active-color: var(--kinekt-component-ink);
    --kiw--hd-cells-engineering-tab-indicator-color: var(--kinekt-component-accent);
    --kinekt-section-gap: var(--kiw--hd-cells-engineering-major-gap);
  }

  .hd-cells-engineering-allentown :is(.hd-cells-engineering-allentown__cells, .hd-cells-engineering-allentown__engineering) { display: grid; gap: var(--kiw--hd-cells-engineering-part-gap); min-width: 0; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__header { display: grid; justify-items: center; width: 100%; margin-inline: auto; text-align: center; }
  .hd-cells-engineering-allentown .section-intro { display: grid; justify-items: center; gap: var(--kiw--hd-cells-engineering-intro-gap); }
  .hd-cells-engineering-allentown .section-intro :is(.section-intro__accent, .section-intro__heading, .section-intro__description) { margin: 0; }
  .hd-cells-engineering-allentown .section-intro__heading-group { display: grid; justify-items: center; gap: var(--kiw--hd-cells-engineering-heading-stack-gap); }
  .hd-cells-engineering-allentown .section-intro__heading { max-width: none; font-size: var(--kiw--hd-cells-engineering-heading-size); }
  .hd-cells-engineering-allentown .section-intro__description { max-width: none; color: var(--kiw--hd-cells-engineering-description-color); font-size: var(--kiw--hd-cells-engineering-description-font-size); line-height: var(--kinekt-component-text-line-height); }
  .hd-cells-engineering-allentown .section-intro__description > * { margin-block: 0; }

  /* High-density cells */
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cells { inline-size: 100%; margin-inline: auto; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cells-body { display: grid; gap: var(--kiw--hd-cells-engineering-cells-gap); min-width: 0; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cells-media { display: grid; min-width: 0; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cell-media { grid-area: 1 / 1; min-width: 0; background: var(--kiw--hd-cells-engineering-cells-media-background); }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cell-media > .kinekt-media { display: block; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cell-image { display: block; inline-size: 100%; max-inline-size: 100%; block-size: auto; aspect-ratio: var(--kiw--hd-cells-engineering-cells-media-ratio); object-fit: cover; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cells-list { display: grid; align-content: start; gap: var(--kiw--hd-cells-engineering-cells-list-gap); min-width: 0; margin: 0; padding: 0; list-style: none; }
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__cell { min-width: 0; }

  /* High-density engineering */
  .hd-cells-engineering-allentown .hd-cells-engineering-allentown__topics { display: grid; gap: var(--kiw--hd-cells-engineering-topics-gap); min-width: 0; }
