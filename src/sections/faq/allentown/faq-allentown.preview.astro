---
import FaqAllentown from './faq-allentown.astro'
---
<FaqAllentown
  theme="semi-light"
  intro={{
    accentHeading: 'Common questions',
    heading: 'The information teams need before integrating a new energy system',
    description: 'Clear answers for the technical, operational and delivery questions that shape a confident next step.',
  }}
  items={[
    {
      question: 'Which operating conditions can the system support?',
      answer: 'The final specification is validated against the intended operating range, integration constraints and relevant safety requirements.',
    },
    {
      question: 'How is the system validated before delivery?',
      answer: 'Each build follows a documented test sequence with traceable measurements and an agreed acceptance threshold.',
    },
    {
      question: 'Can the solution be adapted to a specific application?',
      answer: 'Yes. Our engineering team can shape the energy system around the airframe, operating profile and programme constraints.',
    },
  ]}
  overviewCta={{ cta: { label: 'View all questions', href: '#' } }}
  callout={{
    intro: {
      accentHeading: 'Need a specific answer?',
      heading: 'Talk through the technical details with an engineer',
      description: 'Bring your operating profile and integration question. We will help determine the right next step.',
    },
    ctaGroup: {
      primaryButton: { label: 'Contact an engineer', href: '#' },
    },
  }}
/>
