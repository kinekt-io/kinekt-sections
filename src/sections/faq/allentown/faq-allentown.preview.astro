---
import FaqAllentown from './faq-allentown.astro'
---
<FaqAllentown
  theme="semi-light"
  intro={{
    accentHeading: 'Common questions',
    heading: 'The information teams need before integrating a new energy system',
    description: 'Clear answers for the technical, operational and delivery questions that shape a confident next step.',
  }}
  faqs={[
    {
      question: 'Can I see the test report before ordering?',
      answer: 'We provide the UN38.3 test summary on request, and it accompanies every shipment.',
      reviewStatus: 'approved',
    },
    {
      question: 'Which charger do I need?',
      answer: 'The charger must match the pack chemistry, maximum cell voltage and permitted charge current. Smart packs report their limits to a compatible charger.',
      reviewStatus: 'needs-customer-verification',
    },
    {
      question: 'How should packs be stored?',
      answer: 'Storage conditions depend on the cell chemistry and pack configuration. Confirm the pack-specific instructions before publication.',
      reviewStatus: 'needs-customer-verification',
    },
  ]}
  overviewCta={{ cta: { label: 'View all questions', href: '#' } }}
  callout={{
    intro: {
      accentHeading: 'Need a specific answer?',
      heading: 'Talk through the technical details with an engineer',
      description: 'Bring your operating profile and integration question. We will help determine the right next step.',
    },
    ctaGroup: {
      primaryButton: { label: 'Contact an engineer', href: '#' },
    },
  }}
/>
