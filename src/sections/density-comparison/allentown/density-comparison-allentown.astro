---
import '../../../styles/wireframe-tokens.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'
import type { SectionIntro as SectionIntroContent } from '../../../shared/content.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type Status = 'positive' | 'negative'
interface Cta { label: string; href: string; icon?: string }
interface Cell { text: string; status: Status; icon?: string }
interface ComparisonRow { feature: string; cells: Cell[] }
interface Props {
  id?: string
  theme?: Theme
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro: SectionIntroContent
  comparison: { columns: string[]; rows: ComparisonRow[] }
  cta?: { cta: Cta } | Cta
}

const { id, theme = 'semi-light', headingLevel = 'h2', intro, comparison, cta } = Astro.props as Props
const action = cta && ('cta' in cta ? cta.cta : cta)
const actionIcon = action && isCtaIcon(action.icon) ? ctaIconPaths(action.icon) : undefined
---
<section class="density-comparison-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="density-comparison-allentown__container">
    <header class="density-comparison-allentown__intro"><SectionIntro intro={intro} headingLevel={headingLevel} /></header>
    <div class="density-comparison-allentown__table-wrap">
      <table class="density-comparison-allentown__table">
        <thead><tr><th scope="col"><span class="density-comparison-allentown__visually-hidden">Feature</span></th>{comparison.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
        <tbody>{comparison.rows.map((row) => <tr><th scope="row">{row.feature}</th>{comparison.columns.map((_, index) => {
          const cell = row.cells[index]
          if (!cell) return <td />
          const icon = ctaIconPaths(cell.icon || (cell.status === 'positive' ? 'circle-check' : 'circle-xmark'))
          return <td><span class:list={['density-comparison-allentown__value', `density-comparison-allentown__value--${cell.status}`]}>{icon && <svg viewBox={icon.viewBox} aria-hidden="true" focusable="false" fill="currentColor"><path d={icon.path} /></svg>}<span>{cell.text}</span></span></td>
        })}</tr>)}</tbody>
      </table>
    </div>
    {action && <div class="density-comparison-allentown__action"><Button href={action.href} label={action.label} style="clear" size="l">{actionIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={actionIcon.viewBox} fill="currentColor"><path d={actionIcon.path} /></svg>}</Button></div>}
  </div>
</section>
<style is:global>
  :where(.density-comparison-allentown) { box-sizing: border-box; padding-block: var(--kinekt-component-block-space); color: var(--kinekt-component-ink); background: var(--kinekt-component-canvas); font-family: var(--kinekt-component-font); font-size: var(--kiw--section-text-m-size); font-weight: var(--kiw--section-text-font-weight); line-height: var(--kiw--section-text-line-height); letter-spacing: var(--kiw--section-text-letter-spacing); } :where(.density-comparison-allentown) *, :where(.density-comparison-allentown) *::before, :where(.density-comparison-allentown) *::after { box-sizing: border-box; }
  :where(.density-comparison-allentown) { --kinekt-component-heading-2-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); --kinekt-component-text-xs-size: var(--kinekt-section-text-xs-size, var(--kiw--section-text-xs-size)); --kinekt-component-text-s-size: var(--kinekt-section-text-s-size, var(--kiw--section-text-s-size)); --kinekt-component-text-l-size: var(--kinekt-section-text-l-size, var(--kiw--section-text-l-size)); }
  :where(.density-comparison-allentown) > [class$='__container'] { display: grid; width: 100%; max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2))); gap: var(--kinekt-component-gap); margin-inline: auto; padding-inline: var(--kinekt-component-inline-space); } :where(.density-comparison-allentown) :is(h1, h2, h3, h4, h5, h6) { max-width: none; margin-block: 0; color: inherit; font-family: var(--kiw--section-heading-font-family); font-weight: var(--kiw--section-heading-font-weight); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kiw--section-heading-letter-spacing); text-wrap: balance; } :where(.density-comparison-allentown) h2 { font-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size)); }
  :where(.density-comparison-allentown) :is(p, li, dd, td, th, label, input, textarea, button) { font: inherit; line-height: var(--kinekt-component-text-line-height); } :where(.density-comparison-allentown) :is(p, ul, ol, dl, table, form) { margin-block: 0; } :where(.density-comparison-allentown) .section-intro__accent { margin-block: 0 var(--kinekt-component-intro-accent-gap); color: var(--kinekt-component-accent); font-family: var(--kinekt-component-mono); font-size: var(--kinekt-component-text-xs-size); font-weight: var(--kiw--section-heading-font-weight); letter-spacing: var(--kiw--section-text-letter-spacing); text-transform: uppercase; } :where(.density-comparison-allentown) .section-intro__heading { margin: 0; } :where(.density-comparison-allentown) .section-intro__description { max-width: var(--kinekt-component-reading-width); margin-block: var(--kinekt-component-intro-description-gap) 0; color: var(--kinekt-component-muted); font-size: var(--kinekt-component-text-l-size); }
  :where(.density-comparison-allentown) table { width: 100%; border-collapse: collapse; overflow: hidden; border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); } :where(.density-comparison-allentown) :is(th, td) { padding: var(--space-s); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); text-align: left; vertical-align: top; } :where(.density-comparison-allentown) th { font-weight: var(--heading-font-weight); background: var(--kinekt-component-surface); }
 
</style>
