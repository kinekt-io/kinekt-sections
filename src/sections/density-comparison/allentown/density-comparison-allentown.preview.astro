---
import DensityComparisonAllentown from './density-comparison-allentown.astro'

const intro = {
  accentHeading: 'High output versus standard output',
  heading: 'What a compact system architecture changes',
}
const comparison = {
  columns: ['High-output system', 'Standard system'],
  rows: [
    { feature: 'Footprint', cells: [{ status: 'positive', text: 'More capacity in less space' }, { status: 'negative', text: 'Larger enclosure for equal capacity' }] },
    { feature: 'Mass efficiency', cells: [{ status: 'positive', text: 'More capacity per kilogram' }, { status: 'negative', text: 'Higher mass for equal capacity' }] },
    { feature: 'Operating range', cells: [{ status: 'positive', text: 'Extended range between cycles' }, { status: 'negative', text: 'Shorter range between cycles' }] },
    { feature: 'Payload allowance', cells: [{ status: 'positive', text: 'More remaining payload' }, { status: 'negative', text: 'Less remaining payload' }] },
    { feature: 'Integration freedom', cells: [{ status: 'positive', text: 'More packaging flexibility' }, { status: 'negative', text: 'Tighter packaging constraints' }] },
    { feature: 'Programme potential', cells: [{ status: 'positive', text: 'More room for future demands' }, { status: 'negative', text: 'Lower headroom for expansion' }] },
  ],
}
---
<DensityComparisonAllentown
  theme="semi-light"
  intro={intro}
  comparison={comparison as any}
  cta={{ cta: { label: 'Explore system options', href: '#' } }}
/>
