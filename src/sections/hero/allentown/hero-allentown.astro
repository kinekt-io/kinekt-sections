---
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import type { Media } from '../../../shared/content.js'
import type { HeroContent } from './hero-allentown.types.js'
import { isSafeWebUrl } from '../../../urls.js'
interface Props extends HeroContent { id?: string; headingLevel?: 'h1' | 'h2' }
function assertSafeImage(image: Media, name: string): void {
  if (!isSafeWebUrl(image.url)) throw new Error(`${name}.url must be an HTTP(S) or root-relative URL.`)
  if (image.fallbackUrl !== undefined && !isSafeWebUrl(image.fallbackUrl)) throw new Error(`${name}.fallbackUrl must be an HTTP(S) or root-relative URL.`)
  if (!Number.isSafeInteger(image.width) || image.width <= 0) throw new Error(`${name}.width must be a positive integer.`)
  if (!Number.isSafeInteger(image.height) || image.height <= 0) throw new Error(`${name}.height must be a positive integer.`)
}
const { id, headingLevel = 'h1', intro, ctas, image, mobileImage } = Astro.props
for (const cta of [ctas?.primary, ctas?.secondary]) if (cta && !isSafeWebUrl(cta.href)) throw new Error('ctas must use an HTTP(S) or root-relative URL.')
assertSafeImage(image, 'image')
if (mobileImage) assertSafeImage(mobileImage, 'mobileImage')
---
<section class="hero-allentown" id={id}>
  <div class="hero-allentown__inner">
    <header class="hero-allentown__content">
      <SectionIntro intro={intro} headingLevel={headingLevel} />
      {(ctas?.primary || ctas?.secondary) && <div class="hero-allentown__actions">
        {ctas.primary && <a class="hero-allentown__action hero-allentown__action--primary" href={ctas.primary.href}>{ctas.primary.label}<svg aria-hidden="true" width="11" height="18" viewBox="0 0 11 18" fill="none"><path d="m2 2 7 7-7 7" stroke="currentColor" stroke-width="2" /></svg></a>}
        {ctas.secondary && <a class="hero-allentown__action hero-allentown__action--secondary" href={ctas.secondary.href}>{ctas.secondary.label}</a>}
      </div>}
    </header>
    <KinektMedia class="hero-allentown__media" imageClass="hero-allentown__image" media={image} mobileMedia={mobileImage} loading="eager" fetchpriority="high" />
  </div>
</section>
<style>
@layer ki-sections-wireframe {
.hero-allentown { --hero-allentown-background:#6C6C6C; --hero-allentown-accent:#A4A4A4; --hero-allentown-accent-hover:color-mix(in srgb,var(--hero-allentown-accent),#000 30%); --hero-allentown-text:#000; --hero-allentown-cta-text:#000; --hero-allentown-heading-font:var(--kinekt-sections-heading-font-family,'Brockmann',sans-serif); --hero-allentown-body-font:var(--kinekt-sections-body-font-family,'Urbanist',sans-serif); background:var(--hero-allentown-background); color:var(--hero-allentown-text); }
.hero-allentown__inner { display:grid; width:min(calc(100% - clamp(3rem,11.11vw,10rem)),80rem); margin-inline:auto; padding-block:3.5rem; gap:2.5rem; align-items:center; }
.hero-allentown__content { max-width:34.375rem; }
.hero-allentown .section-intro__accent { margin:0 0 .9375rem; font-family:var(--hero-allentown-body-font); font-size:1.125rem; font-weight:500; line-height:1.3; letter-spacing:.04em; }
.hero-allentown .section-intro__accent::before { display:inline-block; margin-right:.5rem; color:var(--hero-allentown-accent); content:'→'; }
.hero-allentown .section-intro__heading { margin:0; font-family:var(--hero-allentown-heading-font); font-size:clamp(2.5rem,10vw,3.41875rem); font-weight:500; line-height:1.03; letter-spacing:.03em; }
.hero-allentown .section-intro__description { max-width:35rem; margin:2.5rem 0 0; font-family:var(--hero-allentown-body-font); font-size:1.125rem; line-height:1.5; }
.hero-allentown .section-intro__description > :first-child { margin-top:0; }.hero-allentown .section-intro__description > :last-child { margin-bottom:0; }
.hero-allentown__actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2.5rem; }
.hero-allentown__action { display:inline-flex; box-sizing:border-box; align-items:center; gap:.625rem; min-height:3rem; padding:1.2rem 1.4rem; font-family:var(--hero-allentown-heading-font); font-size:1rem; font-weight:600; line-height:1; text-decoration:none; }
.hero-allentown__action--primary { background:var(--hero-allentown-accent); color:var(--hero-allentown-cta-text); }.hero-allentown__action--primary:hover { background:var(--hero-allentown-accent-hover); }.hero-allentown__action--secondary { border:1px solid currentColor; color:var(--hero-allentown-text); }.hero-allentown__action:focus-visible { outline:3px solid var(--hero-allentown-text); outline-offset:4px; box-shadow:0 0 0 6px var(--hero-allentown-background); }
.hero-allentown__media { display:block; }.hero-allentown__image { display:block; width:100%; height:auto; }
@media (min-width:768px) { .hero-allentown__inner { grid-template-columns:repeat(2,minmax(0,1fr)); padding-block:4.375rem; gap:1.25rem; } }
}
</style>
