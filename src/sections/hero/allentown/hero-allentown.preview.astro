---
import HeroAllentown from './hero-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<HeroAllentown
  intro={{
    accentHeading: '/ Built for demanding systems',
    heading: 'Powering the next generation of electric mobility',
    description: 'Modular battery systems designed around the performance, lifecycle and integration requirements of your application.',
  }}
  ctas={{
    primary: { label: 'Talk to an expert', href: '/' },
    secondary: { label: 'Explore the platform', href: '/' },
  }}
  image={{
    url: `${catalogueBase}placeholders/hero-allentown-buses.webp`,
    alt: 'Electric buses used as a mobility placeholder',
    width: 1600,
    height: 900,
  }}
/>
