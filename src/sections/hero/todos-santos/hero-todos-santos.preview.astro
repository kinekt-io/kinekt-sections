---
import HeroTodosSantos from './hero-todos-santos.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<HeroTodosSantos
  theme="dark"
  intro={{
    accentHeading: 'System catalogue',
    heading: 'Energy storage, made application-ready',
    description: 'A configurable energy platform for teams balancing electrical requirements, packaging constraints and production-ready integration.',
  }}
  featureHeading="Designed for real-world operation"
  features={[
    { label: 'Voltage range', value: '24–800 V' },
    { label: 'Operating temperature', value: '−20 to 55 °C' },
    { label: 'Integration support', value: 'From prototype to production' },
  ]}
  ctas={{
    primary: { label: 'Review technical data', href: '/' },
    secondary: { label: 'Explore configurations', href: '/' },
  }}
  image={{
    url: `${catalogueBase}placeholders/hero-todos-santos-towers.webp`,
    alt: 'Industrial energy system modules in an urban setting',
    width: 1600,
    height: 900,
  }}
/>
