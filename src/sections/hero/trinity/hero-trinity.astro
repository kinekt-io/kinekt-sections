      <SectionIntro intro={intro} headingLevel={headingLevel} />
      {(ctas?.primary || ctas?.secondary) && <div class="hero-trinity__actions">
        {ctas.primary && <Button class="hero-trinity__action hero-trinity__action--primary" href={ctas.primary.href} label={ctas.primary.label} />}
        {ctas.secondary && <Button class="hero-trinity__action hero-trinity__action--secondary" href={ctas.secondary.href} label={ctas.secondary.label} style="secondary" />}
      </div>}
    </header>
  </div>
</section>
