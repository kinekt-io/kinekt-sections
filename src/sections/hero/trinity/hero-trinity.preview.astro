---
import HeroTrinity from './hero-trinity.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<HeroTrinity
  intro={{
    accentHeading: '/ High-density energy',
    heading: 'Engineered to keep critical systems moving',
    description: 'Reliable, compact energy storage for applications where uptime, safety and control cannot be compromised.',
  }}
  theme="dark"
  ctas={{
    primary: { label: 'Read more', href: '/' },
    secondary: { label: 'Talk to an expert', href: '/' },
  }}
  image={{
    url: `${catalogueBase}placeholders/hero-trinity-street.webp`,
    alt: 'City street used as an energy-infrastructure placeholder',
    width: 1600,
    height: 900,
  }}
/>
