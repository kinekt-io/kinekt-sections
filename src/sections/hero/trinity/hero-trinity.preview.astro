---
import HeroTrinity from './hero-trinity.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<HeroTrinity
  theme="dark"
  intro={{
    accentHeading: '/ Energy systems',
    heading: 'Power for work that cannot pause',
    description: 'Compact energy storage for teams managing critical duty cycles, strict safety conditions and demanding deployment environments.',
  }}
  ctas={{
    primary: { label: 'Review the system', href: '/' },
    secondary: { label: 'Discuss requirements', href: '/' },
  }}
  image={{
    url: `${catalogueBase}placeholders/hero-trinity-street.webp`,
    alt: 'City street served by an integrated energy system',
    width: 1600,
    height: 900,
  }}
/>
