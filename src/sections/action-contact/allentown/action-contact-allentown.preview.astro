---
import ActionContactAllentown from './action-contact-allentown.astro'

const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<ActionContactAllentown
  theme="dark"
  intro={{
    accentHeading: 'Engineering partnership',
    heading: 'Turn an operating brief into a battery-system plan',
    description: 'Bring the application, duty cycle and integration constraints. We will help turn them into a clear technical starting point.',
  }}
  image={{
    url: `${catalogueBase}placeholders/pexels-industrial-building.webp`,
    alt: 'Monochrome industrial building with external service equipment',
    width: 1200,
    height: 627,
  }}
  actionHeading="Start with a focused conversation"
  actions={{
    primary: { label: 'Talk to an engineer', href: '#' },
    secondary: { label: 'Share a project brief', href: '#' },
  }}
  actionNote="We use the first call to understand the operating conditions, delivery window and technical questions that matter most."
  contactHeading="Reach the right team directly"
  contactMethods={[
    { icon: 'whatsapp', label: 'Message our engineering team', href: 'https://wa.me/15550101111' },
    { icon: 'phone', label: 'Call +1 555 010 111', href: 'tel:+15550101111' },
    { icon: 'email', label: 'Email engineering', href: 'mailto:engineering@example.test' },
  ]}
/>
