---
import '../../../styles/wireframe.css'
import Button from '../../../controls/button/allentown/button-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'

interface Cta {
  label: string
  href: string
}

interface ContactMethod {
  icon?: string
  label: string
  href: string
}

interface Props {
  id?: string
  theme?: 'light' | 'semi-light' | 'semi-dark' | 'dark'
  intro: SectionIntroContent
  image: Media
  actionHeading: string
  actions: Record<string, Cta | undefined>
  actionNote?: string
  contactHeading: string
  contactMethods: ContactMethod[]
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const {
  id,
  theme = 'light',
  intro,
  image,
  actionHeading,
  actions,
  actionNote,
  contactHeading,
  contactMethods,
  headingLevel = 'h2',
} = Astro.props as Props

const actionList = Object.values(actions).filter((action): action is Cta => Boolean(action?.label && action.href))
---
<section class="beta-action-contact-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="beta-action-contact-allentown__container">
    <div class="beta-action-contact-allentown__body">
      <div class="beta-action-contact-allentown__content">
        <header class="beta-action-contact-allentown__header">
          <SectionIntro intro={intro} headingLevel={headingLevel} />
        </header>

        <section class="beta-action-contact-allentown__action">
          <h3 class="beta-action-contact-allentown__action-heading">{actionHeading}</h3>
          {actionList.length > 0 && (
            <nav class="beta-action-contact-allentown__actions" aria-label="Contact actions">
              {actionList.map((action, index) => (
                <Button href={action.href} label={action.label} style={index === 0 ? 'primary' : 'secondary'} />
              ))}
            </nav>
          )}
          {actionNote && <p class="beta-action-contact-allentown__action-note">{actionNote}</p>}
        </section>

        <section class="beta-action-contact-allentown__contact">
          <h3 class="beta-action-contact-allentown__contact-heading">{contactHeading}</h3>
          <ul class="beta-action-contact-allentown__contact-methods">
            {contactMethods.map((method) => (
              <li class="beta-action-contact-allentown__contact-method">
                <a href={method.href}>
                  {method.icon && <span class="beta-action-contact-allentown__contact-icon" aria-hidden="true">{method.icon}</span>}
                  <span>{method.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <KinektMedia class="beta-action-contact-allentown__media" imageClass="beta-action-contact-allentown__image" media={image} />
    </div>
  </div>
</section>
