{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.11.0-beta.0",
  "id": "sections/progress-roadmap/allentown",
  "slug": "progress-roadmap-allentown",
  "title": "Progress Roadmap Allentown",
  "description": "A filterable roadmap of detailed progress items with media, references and optional facts.",
  "category": "sections",
  "tags": ["progress", "roadmap", "filter", "prerelease"],
  "role": "progress-roadmap",
  "variation": "allentown",
  "status": "prerelease",
  "figma": { "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5744-796023", "nodeId": "5744:796023" },
  "fields": {
    "contentWidth": { "kind": "select", "required": false, "localized": true, "defaultValue": "standard", "options": ["standard", "80", "70"] },
    "theme": { "kind": "select", "required": true, "localized": true, "defaultValue": "semi-light", "options": ["light", "semi-light", "semi-dark", "dark"] },
    "intro": { "kind": "component", "componentId": "components/intro/allentown", "required": true, "localized": true },
    "filterLabels": {
      "kind": "component", "required": false, "localized": true,
      "fields": {
        "all": { "kind": "text", "required": false, "localized": true, "defaultValue": "All" },
        "delayed": { "kind": "text", "required": false, "localized": true, "defaultValue": "Delayed" },
        "done": { "kind": "text", "required": false, "localized": true, "defaultValue": "Done" },
        "inProgress": { "kind": "text", "required": false, "localized": true, "defaultValue": "In progress" },
        "todo": { "kind": "text", "required": false, "localized": true, "defaultValue": "To do" },
        "custom": { "kind": "text", "required": false, "localized": true, "defaultValue": "Custom" },
        "canceled": { "kind": "text", "required": false, "localized": true, "defaultValue": "Canceled" }
      }
    },
    "items": {
      "kind": "componentList", "required": true, "localized": true, "minItems": 1,
      "admin": { "initCollapsed": true },
      "fields": {
        "title": { "kind": "text", "required": true, "localized": true },
        "media": { "kind": "media", "required": false, "localized": true, "description": "Optional image or logo; takes priority over the icon." },
        "icon": { "kind": "text", "required": false, "localized": true, "description": "Optional Font Awesome SVG icon name, used when no image is selected." },
        "referenceLabel": { "kind": "text", "required": false, "localized": true },
        "reference": { "kind": "text", "required": false, "localized": true },
        "status": { "kind": "select", "required": true, "localized": true, "defaultValue": "todo", "options": ["delayed", "done", "in-progress", "todo", "custom", "canceled"] },
        "statusLabel": { "kind": "text", "required": false, "localized": true, "description": "Optional visible status text override; required for custom status." },
        "customIcon": { "kind": "text", "required": false, "localized": true },
        "customTone": { "kind": "select", "required": false, "localized": true, "defaultValue": "neutral", "options": ["neutral", "info", "success", "warning", "error"] },
        "description": { "kind": "richText", "required": false, "localized": true },
        "facts": {
          "kind": "componentList", "required": false, "localized": true, "minItems": 0,
          "fields": {
            "label": { "kind": "text", "required": true, "localized": true },
            "value": { "kind": "text", "required": true, "localized": true }
          }
        }
      }
    }
  },
  "runtimeProps": { "headingLevel": { "kind": "headingLevel", "source": "renderer" } }
}
