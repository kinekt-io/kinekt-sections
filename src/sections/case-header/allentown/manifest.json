{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "sections/case-header/allentown",
  "slug": "case-header-allentown",
  "title": "Case Header Allentown",
  "description": "A case-study page header with editorial intro, optional customer logo and reusable image or video hero media.",
  "category": "sections",
  "tags": ["case-study", "header", "content"],
  "role": "case-header",
  "variation": "allentown",
  "status": "prerelease",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5639-524477",
    "nodeId": "5639:524477"
  },
  "fields": {
    "contentWidth": {
        "kind": "select",
        "required": false,
        "localized": true,
        "defaultValue": "standard",
        "options": ["standard", "80", "70"],
        "description": "Maximum content width: Standard (100%), 80%, or 70%."
    },
    "theme": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["light", "semi-light", "semi-dark", "dark"],
      "description": "CMS-selected presentation setting passed to the renderer."
    },
    "intro": {
      "kind": "component",
      "componentId": "components/intro/allentown",
      "required": true,
      "localized": true
    },
    "customerLogo": {
      "kind": "media",
      "required": false,
      "localized": true,
      "description": "Optional customer logo displayed beside the Case Header introduction."
    },
    "heroMedia": {
      "kind": "component",
      "componentId": "components/content-hero-media/allentown",
      "required": true,
      "localized": true
    }
  },
  "runtimeProps": {
    "breadcrumb": {
      "kind": "contentContext",
      "source": "renderer"
    }
  }
}
