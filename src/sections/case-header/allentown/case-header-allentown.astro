---
import '../../../styles/wireframe-tokens.css'
import { faChevronRight } from '@fortawesome/sharp-solid-svg-icons'
import ContentHeroMedia, { type ContentHeroMediaContent } from '../../../components/content-hero-media/allentown/content-hero-media-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { isSafeWebUrl } from '../../../urls.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
/** Route-derived trail (runtimeProps.breadcrumb, source renderer); the last item is the current page. */
type BreadcrumbItem = { label: string; href?: string }
interface Props {
  id?: string
  theme?: Theme
  headingLevel?: 'h1' | 'h2'
  intro: SectionIntroContent
  customerLogo?: unknown
  heroMedia: ContentHeroMediaContent
  mediaLoading?: 'eager' | 'lazy'
  breadcrumb?: BreadcrumbItem[]
  /** Accessible name of the breadcrumb navigation. */
  breadcrumbLabel?: string
  /** Accent label above the customer logo (Figma "/ Client"); not in the contract yet, so nothing renders without it. */
  customerLogoLabel?: string
  /** Accessible name of the play button on uploaded video. */
  playLabel?: string
}

const { id, theme = 'dark', headingLevel = 'h1', intro, customerLogo, heroMedia, mediaLoading = 'eager', breadcrumb = [], breadcrumbLabel = 'Breadcrumb', customerLogoLabel, playLabel } = Astro.props as Props
const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string' && isSafeWebUrl((value as Media).url)
const logo = isMedia(customerLogo) ? customerLogo : undefined
const trail = Array.isArray(breadcrumb) ? breadcrumb.filter((item) => typeof item?.label === 'string' && item.label.length > 0) : []
const [chevronWidth, chevronHeight, , , chevronPath] = faChevronRight.icon
---
<section class="case-header-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="case-header-allentown__container">
    {trail.length > 0 && (
      <nav class="case-header-allentown__breadcrumb" aria-label={breadcrumbLabel}>
        <ol class="case-header-allentown__breadcrumb-list">
          {trail.map((item, index) => {
            const current = index === trail.length - 1
            return (
              <li class="case-header-allentown__breadcrumb-item">
                {index > 0 && <svg class="case-header-allentown__breadcrumb-separator" aria-hidden="true" focusable="false" viewBox={`0 0 ${chevronWidth} ${chevronHeight}`} fill="currentColor"><path d={chevronPath as string} /></svg>}
                {current
                  ? <span class="case-header-allentown__breadcrumb-current" aria-current="page">{item.label}</span>
                  : isSafeWebUrl(item.href) ? <a class="case-header-allentown__breadcrumb-link" href={item.href}>{item.label}</a> : <span class="case-header-allentown__breadcrumb-link">{item.label}</span>}
              </li>
            )
          })}
        </ol>
      </nav>
    )}
    <div class="case-header-allentown__body">
      <header class="case-header-allentown__header">
        <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
        {logo && (
          <div class="case-header-allentown__customer">
            {customerLogoLabel && <p class="case-header-allentown__customer-label">{customerLogoLabel}</p>}
            <KinektMedia media={logo} class="case-header-allentown__logo" imageClass="case-header-allentown__logo-image" loading="eager" />
          </div>
        )}
      </header>
      <figure class="case-header-allentown__media">
        <ContentHeroMedia media={heroMedia} title={intro.heading} playLabel={playLabel} loading={mediaLoading} />
      </figure>
    </div>
  </div>
</section>

<style is:global>
  /*
   * Figma "Section" 5639:524477 (Case Template, dark): 1152 container (D Width XL); breadcrumb → body 100 (section-xl);
   * header (intro 864 + "/ Client" logo, bottom-aligned, space-between) → 16:9 video 64 (section-m).
   * Intro: accent text-l, XS to an H2-sized h1, space-m to a text-xl description at 1.4 in the subtle role.
   */
  :where(.case-header-allentown) {
    --kiw--case-header-allentown-inline-space: var(--section-gutter);
    --kiw--case-header-allentown-block-space: var(--section-space-xl);
    --kiw--case-header-allentown-content-width: var(--content-width);
    --kiw--case-header-allentown-breadcrumb-gap: var(--section-space-xl);
    --kiw--case-header-allentown-gap: var(--section-space-m);
    --kiw--case-header-allentown-header-gap: var(--space-l);
    --kiw--case-header-allentown-intro-width: var(--width-l);
    --kiw--case-header-allentown-heading-size: var(--h2);
    --kiw--case-header-allentown-accent-size: var(--text-l);
    --kiw--case-header-allentown-accent-gap: var(--space-xs);
    --kiw--case-header-allentown-description-size: var(--text-xl);
    --kiw--case-header-allentown-description-line-height: 1.4;
    --kiw--case-header-allentown-customer-gap: var(--space-l);
    --kiw--case-header-allentown-logo-height: var(--section-space-xs);
    /* Cap only; the fluid width-s would shrink a logo to 78 px on phones. */
    --kiw--case-header-allentown-logo-width: var(--desktop-width-s);
    --kiw--case-header-allentown-media-ratio: 16 / 9;

    @media (min-width: 50rem) { --kiw--case-header-allentown-content-width: var(--width-xl); }
  }

  .case-header-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark));
    /* Off-role Figma colour for the breadcrumb trail: primary-semi-light on light frames, the subtle role's tone on dark (Figma: primary-ultra-light). */
    --kiw--case-header-allentown-breadcrumb-color: var(--primary-semi-light);
    --kinekt-component-radius: var(--kinekt-section-radius, var(--radius-none));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--media-filter));
    --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--kiw--case-header-allentown-intro-width));
    --kinekt-component-intro-accent-gap: var(--kiw--case-header-allentown-accent-gap);
    --kinekt-component-intro-description-gap: var(--space-m);
    --kinekt-component-heading-1-size: var(--kiw--case-header-allentown-heading-size);
    --kinekt-component-heading-2-size: var(--kiw--case-header-allentown-heading-size);
    --kiw--section-intro-accent-font-size: var(--kiw--case-header-allentown-accent-size);
    --kiw--content-hero-media-allentown-ratio: var(--kiw--case-header-allentown-media-ratio);
    box-sizing: border-box;
    padding-block: var(--kiw--case-header-allentown-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--text-font-family);
    font-size: var(--text-m);
    line-height: var(--text-line-height);

    &[data-kinekt-theme='semi-light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light)); }
    &[data-kinekt-theme='semi-dark'] {
      --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-dark));
      --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
      --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-light));
      --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary-light));
      --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
      --kiw--case-header-allentown-breadcrumb-color: var(--primary-light);
      color-scheme: dark;
    }
    &[data-kinekt-theme='dark'] {
      --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark));
      --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
      --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light));
      --kinekt-component-subtle: var(--kinekt-section-subtle, var(--primary-ultra-light));
      --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
      --kiw--case-header-allentown-breadcrumb-color: var(--primary-ultra-light);
      color-scheme: dark;
    }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .case-header-allentown__container { display: grid; width: 100%; max-width: min(var(--website-width), calc(var(--kiw--case-header-allentown-content-width) + (var(--kiw--case-header-allentown-inline-space) * 2))); gap: var(--kiw--case-header-allentown-breadcrumb-gap); margin-inline: auto; padding-inline: var(--kiw--case-header-allentown-inline-space); }

    & .case-header-allentown__breadcrumb-list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xxs); margin: 0; padding: 0; list-style: none; color: var(--kiw--case-header-allentown-breadcrumb-color); font-size: var(--text-m); line-height: 1; }
    & .case-header-allentown__breadcrumb-item { display: inline-flex; align-items: center; gap: var(--space-xxs); min-width: 0; }
    & .case-header-allentown__breadcrumb-separator { flex: none; inline-size: auto; block-size: var(--text-xs); fill: currentColor; }
    & .case-header-allentown__breadcrumb-link { color: inherit; text-decoration: none; }
    & a.case-header-allentown__breadcrumb-link:hover { text-decoration: underline; }
    & .case-header-allentown__breadcrumb-current { color: var(--kinekt-component-accent); }

    & .case-header-allentown__body { display: grid; gap: var(--kiw--case-header-allentown-gap); min-width: 0; }
    & .case-header-allentown__header { display: grid; align-items: end; gap: var(--kiw--case-header-allentown-header-gap); min-width: 0; }
    & .section-intro { min-width: 0; }
    & .section-intro__heading { max-width: none; }
    & .section-intro__description { max-width: none; color: var(--kinekt-component-subtle); font-size: var(--kiw--case-header-allentown-description-size); line-height: var(--kiw--case-header-allentown-description-line-height); }
    & .section-intro__description > * { margin-block: 0; }
    & .section-intro__description > * + * { margin-block-start: var(--space-xs); }

    & .case-header-allentown__customer { display: grid; justify-items: start; gap: var(--kiw--case-header-allentown-customer-gap); }
    /* Same type as the intro accent heading (Figma "/ Client": heading font 500, text-l, 0.05em, line-height 1, uppercase). */
    & .case-header-allentown__customer-label { margin: 0; color: var(--kinekt-component-accent); font-family: var(--heading-font-family); font-size: var(--kiw--case-header-allentown-accent-size); font-weight: var(--heading-font-weight); line-height: 1; letter-spacing: 0.05em; text-transform: uppercase; }
    & .case-header-allentown__logo { display: block; max-inline-size: min(100%, var(--kiw--case-header-allentown-logo-width)); }
    & .case-header-allentown__logo-image { display: block; inline-size: auto; max-inline-size: 100%; block-size: var(--kiw--case-header-allentown-logo-height); object-fit: contain; object-position: left center; }

    & .case-header-allentown__media { min-width: 0; margin: 0; }

    @media (min-width: 50rem) {
      & .case-header-allentown__header { grid-template-columns: minmax(0, var(--kiw--case-header-allentown-intro-width)) auto; justify-content: space-between; }
      & .case-header-allentown__customer { justify-items: end; text-align: end; }
      & .case-header-allentown__logo-image { object-position: right center; }
    }
  }
</style>
