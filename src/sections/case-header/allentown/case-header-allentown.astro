---
import '../../../styles/wireframe-tokens.css'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import { isSafeWebUrl } from '../../../urls.js'

type Theme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
type HeroMedia = { sourceType?: string; image?: unknown; video?: unknown; externalVideoUrl?: unknown; poster?: unknown }
interface Props { id?: string; theme?: Theme; headingLevel?: 'h1' | 'h2'; intro: SectionIntroContent; customerLogo?: unknown; heroMedia: HeroMedia; mediaLoading?: 'eager' | 'lazy' }

const { id, theme = 'dark', headingLevel = 'h1', intro, customerLogo, heroMedia, mediaLoading = 'eager' } = Astro.props as Props
const isMedia = (value: unknown): value is Media => typeof value === 'object' && value !== null && typeof (value as Media).url === 'string' && isSafeWebUrl((value as Media).url)
const logo = isMedia(customerLogo) ? customerLogo : undefined
const image = isMedia(heroMedia?.image) ? heroMedia.image : undefined
const video = isMedia(heroMedia?.video) ? heroMedia.video : undefined
const poster = isMedia(heroMedia?.poster) ? heroMedia.poster : undefined
const externalVideoUrl = typeof heroMedia?.externalVideoUrl === 'string' && isSafeWebUrl(heroMedia.externalVideoUrl) ? heroMedia.externalVideoUrl : undefined
const sourceType = heroMedia?.sourceType
---
<section class="case-header-allentown" id={id} data-kinekt-section data-kinekt-theme={theme}>
  <div class="case-header-allentown__container">
    <header class="case-header-allentown__header">
      <SectionIntro intro={intro} headingLevel={headingLevel} accentStyle="heading" />
      {logo && <KinektMedia media={logo} class="case-header-allentown__logo" imageClass="case-header-allentown__logo-image" loading="eager" />}
    </header>
    <figure class="case-header-allentown__media">
      {sourceType === 'image' && image && <KinektMedia media={image} class="case-header-allentown__picture" imageClass="case-header-allentown__image" loading={mediaLoading} fetchpriority="high" />}
      {sourceType === 'uploaded-video' && video && <video class="case-header-allentown__video" controls preload="metadata" poster={poster?.url}><source src={video.url} /></video>}
      {sourceType === 'external-video' && externalVideoUrl && <iframe class="case-header-allentown__embed" src={externalVideoUrl} title={intro.heading} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />}
    </figure>
  </div>
</section>

<style is:global>
  :where(.case-header-allentown) {
    --kiw--case-header-allentown-inline-space: var(--section-gutter);
    --kiw--case-header-allentown-block-space: var(--section-space-xl);
    --kiw--case-header-allentown-gap: var(--section-space-m);
    --kiw--case-header-allentown-logo-width: var(--width-s);
    --kiw--case-header-allentown-media-ratio: 16 / 9;
  }

  .case-header-allentown {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-ultra-light));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--primary-ultra-dark));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-semi-dark));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--accent-semi-dark));
    --kinekt-component-radius: var(--kinekt-section-radius, var(--radius-none));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--media-filter));
    --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--width-l));
    padding-block: var(--kiw--case-header-allentown-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);

    &[data-kinekt-theme='semi-light'] { --kinekt-component-canvas: var(--kinekt-section-canvas, var(--neutral-light)); }
    &:is([data-kinekt-theme='dark'], [data-kinekt-theme='semi-dark']) {
      --kinekt-component-canvas: var(--kinekt-section-canvas, var(--primary-ultra-dark));
      --kinekt-component-ink: var(--kinekt-section-ink, var(--white));
      --kinekt-component-muted: var(--kinekt-section-muted, var(--primary-ultra-light));
      --kinekt-component-accent: var(--kinekt-section-accent, var(--accent));
    }

    & *, & *::before, & *::after { box-sizing: border-box; }
    & .case-header-allentown__container { display: grid; width: 100%; max-width: min(var(--website-width), calc(var(--content-width) + (var(--kiw--case-header-allentown-inline-space) * 2))); gap: var(--kiw--case-header-allentown-gap); margin-inline: auto; padding-inline: var(--kiw--case-header-allentown-inline-space); }
    & .case-header-allentown__header { display: grid; align-items: end; gap: var(--space-l); }
    & .case-header-allentown__logo { inline-size: var(--kiw--case-header-allentown-logo-width); max-inline-size: 100%; }
    & .case-header-allentown__logo-image { display: block; inline-size: 100%; block-size: auto; object-fit: contain; }
    & .case-header-allentown__media { min-width: 0; margin: 0; }
    & :is(.case-header-allentown__picture, .case-header-allentown__video, .case-header-allentown__embed) { display: block; inline-size: 100%; aspect-ratio: var(--kiw--case-header-allentown-media-ratio); border: 0; border-radius: var(--kinekt-component-radius); object-fit: cover; filter: var(--kinekt-component-media-filter); }
    & .case-header-allentown__embed { background: var(--kinekt-component-canvas); }

    @media (min-width: 50rem) {
      & .case-header-allentown__container { gap: var(--section-space-l); }
      & .case-header-allentown__header { grid-template-columns: minmax(0, 1fr) auto; }
    }
  }
</style>
