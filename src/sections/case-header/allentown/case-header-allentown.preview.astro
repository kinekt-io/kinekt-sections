---
import CaseHeaderAllentown from './case-header-allentown.astro'

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const placeholder = (name: string) => `${base}placeholders/${name}`
---
<CaseHeaderAllentown
  theme="dark"
  breadcrumb={[{ label: 'Cases', href: '/cases' }, { label: 'Northstar Aviation' }]}
  intro={{ accentHeading: '/ Northstar Aviation', heading: 'Building a dependable aerial platform for long-range survey flights', description: 'A collaborative development programme that turned ambitious performance targets into a repeatable flight-ready system.' }}
  customerLogo={{ url: placeholder('placeholder-180x48.svg'), alt: 'Northstar Aviation wordmark', width: 180, height: 48 }}
  customerLogoLabel="/ Client"
  heroMedia={{ sourceType: 'image', image: { url: placeholder('placeholder-1600x900.svg'), alt: 'Aerial platform in flight testing', width: 1600, height: 900 } }}
  mediaLoading="eager"
/>
