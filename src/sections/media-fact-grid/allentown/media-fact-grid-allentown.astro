    --kiw--section-text-xxl-size: var(--kiw--media-fact-grid-allentown-text-xxl-size, var(--text-xxl));
    --kiw--section-carousel-gap: var(--kiw--media-fact-grid-allentown-carousel-gap, var(--content-gap));
    --kiw--section-actions-gap: var(--kiw--media-fact-grid-allentown-actions-gap, var(--space-s));
    --kiw--section-actions-margin: var(--kiw--media-fact-grid-allentown-actions-margin, var(--space-xl));
    --kiw--section-button-height: var(--kiw--media-fact-grid-allentown-button-height, var(--input-height));
    --kiw--section-button-padding-block: var(--kiw--media-fact-grid-allentown-button-padding-block, var(--space-s));
