    --kiw--section-border-width: var(--kiw--media-fact-grid-allentown-border-width, var(--border-width));
    --kiw--section-media-filter: var(--kiw--media-fact-grid-allentown-media-filter, var(--media-filter));
    --kiw--section-intro-accent-gap: var(--kiw--media-fact-grid-allentown-intro-accent-gap, var(--space-xxs));
    --kiw--section-intro-description-gap: var(--kiw--media-fact-grid-allentown-intro-description-gap, var(--space-m));
