---
import '../../../styles/wireframe-tokens.css'
import FactCard from '../../../components/fact-card/allentown/fact-card-allentown.astro'
import KinektMedia from '../../../primitives/kinekt-media/kinekt-media.astro'
import SectionIntro from '../../../primitives/section-intro/section-intro.astro'
import type { Media, RichText, SectionIntro as SectionIntroContent } from '../../../shared/content.js'
import type { BetaTheme } from '../../../shared/payload.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

// The generated .types.ts is still generic (Record<string, unknown>), so the renderer types its props from the manifest here.
interface FactCardContent { title: string; description: string | RichText | Record<string, unknown>; value: string }
interface Props {
  theme: BetaTheme
  intro: Omit<SectionIntroContent, 'description'> & { description?: string | RichText | Record<string, unknown> | null }
  media?: Media | null
  facts: FactCardContent[]
  headingLevel?: 'h1' | 'h2' | 'h3'
  mediaLoading?: 'eager' | 'lazy'
}

const { theme, intro, media, facts = [], headingLevel = 'h2', mediaLoading = 'lazy' } = Astro.props
const factHeadingLevel = ({ h1: 'h2', h2: 'h3', h3: 'h4' } as const)[headingLevel] ?? 'h3'
const introDescription = intro.description == null || typeof intro.description === 'string'
  ? intro.description ?? undefined
  : { html: typeof intro.description.html === 'string' ? intro.description.html : richTextToHtml(intro.description, 'intro.description') }
const introContent: SectionIntroContent = { ...intro, description: introDescription }
const hasMedia = Boolean(media && typeof media === 'object' && typeof media.url === 'string')
---
<section class="media-fact-grid-allentown" data-kinekt-section data-kinekt-theme={theme}>
  <div class="media-fact-grid-allentown__container">
    <div class:list={['media-fact-grid-allentown__lead', { 'media-fact-grid-allentown__lead--media': hasMedia }]}>
      <header class="media-fact-grid-allentown__intro">
        <SectionIntro intro={introContent} headingLevel={headingLevel} accentStyle="heading" />
      </header>
      {hasMedia && media && <KinektMedia media={media} class="media-fact-grid-allentown__media" imageClass="media-fact-grid-allentown__image" loading={mediaLoading} />}
    </div>

    <ul class="media-fact-grid-allentown__facts">
      {facts.map((fact) => (
        <li class="media-fact-grid-allentown__fact">
          <FactCard title={fact.title} description={fact.description} value={fact.value} headingLevel={factHeadingLevel} />
        </li>
      ))}
    </ul>
  </div>
</section>
<style is:global>
  .media-fact-grid-allentown {
    --kiw--section-site-width: var(--kiw--media-fact-grid-allentown-site-width, var(--website-width));
    --kiw--section-content-width: var(--kiw--media-fact-grid-allentown-content-width, var(--content-width));
    --kiw--section-reading-width: var(--kiw--media-fact-grid-allentown-reading-width, var(--width-m));
