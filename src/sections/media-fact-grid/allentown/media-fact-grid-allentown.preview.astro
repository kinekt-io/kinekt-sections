import StructuralSection from '../../../shared/structural-section.astro'

const content = {
  "theme": "light",
  "intro": {
    "accentHeading": "Energy systems built around real operating conditions",
    "heading": "Energy systems built around real operating conditions",
    "description": "Clear technical information helps teams assess operating conditions, integration constraints and the next engineering decision."
  },
  "media": {
    "url": "https://placehold.co/1600x900/png?text=Media",
    "alt": "Battery module and electrical interface",
    "width": 1600,
    "height": 900
  },
  "facts": [
    {
      "title": "Energy systems built around real operating conditions",
      "description": "Clear technical information helps teams assess operating conditions, integration constraints and the next engineering decision.",
      "value": "Clear technical information helps teams assess operating conditions, integration constraints and the next engineering decision."
    },
    {
      "title": "Designed for the constraints that shape delivery",
      "description": "The system is configured around the duty cycle, environmental demands and evidence needed for a reliable release.",
      "value": "The system is configured around the duty cycle, environmental demands and evidence needed for a reliable release."
    },
    {
      "title": "Performance data teams can use with confidence",
      "description": "Structured content keeps performance requirements, technical context and implementation choices easy to compare.",
      "value": "Structured content keeps performance requirements, technical context and implementation choices easy to compare."
    }
  ]
}
const fields = {
  "theme": {
    "kind": "select"
  },
  "intro": {
    "kind": "component",
    "id": "components/intro/allentown",
    "role": "intro",
    "fields": {
      "accentHeading": {
        "kind": "text"
      },
      "heading": {
        "kind": "text"
      },
      "description": {
        "kind": "richText"
      }
    }
  },
  "media": {
    "kind": "media"
  },
  "facts": {
    "kind": "componentList",
    "id": "components/fact-card/allentown",
    "role": "fact-card",
    "fields": {
      "title": {
        "kind": "text"
      },
      "description": {
        "kind": "richText"
      },
      "value": {
        "kind": "text"
      }
    }
  }
}
const intro = {
  "accentHeading": "Energy systems built around real operating conditions",
  "heading": "Energy systems built around real operating conditions",
  "description": "Clear technical information helps teams assess operating conditions, integration constraints and the next engineering decision."
}
const ctas = undefined
const media = {
  "url": "https://placehold.co/1600x900/png?text=Media",
  "alt": "Battery module and electrical interface",
  "width": 1600,
  "height": 900
}
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`

function resolveCatalogueAssets(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(resolveCatalogueAssets)
  if (!value || typeof value !== 'object') return value
  const record = Object.fromEntries(Object.entries(value).map(([key, item]) => [key, resolveCatalogueAssets(item)]))
  if (typeof record.url === 'string' && record.url.startsWith('catalogue-asset:')) {
    record.url = `${catalogueBase}placeholders/${record.url.slice('catalogue-asset:'.length)}`
  }
  return record
}

const resolvedContent = resolveCatalogueAssets(content) as Record<string, unknown>
---
<StructuralSection block="beta-media-fact-grid-allentown" intro={intro} ctas={ctas} media={media} content={resolvedContent} fields={fields} />
