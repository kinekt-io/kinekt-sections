---
import MediaFactGrid from './media-fact-grid-allentown.astro'
const placeholder = (name: string) => (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'placeholders/' + name

const content = {
  theme: 'semi-light' as const,
  intro: {
    accentHeading: '/ Strongly tested',
    heading: 'Reliable and thoroughly tested batteries',
    description: {
      html: '<p>Every battery system is validated against the conditions it will meet in operation, from early prototypes through to series production and field deployment.</p><p>Test evidence is documented for each stage, so integration teams can review performance, safety and endurance before release.</p>',
    },
  },
  media: {
    url: placeholder('placeholder-688x406.svg'),
    alt: 'Battery pack on a test bench',
    width: 688,
    height: 406,
  },
  facts: [
    {
      title: 'Tested early',
      description: { html: '<p>Validation &amp; test time</p>' },
      value: 'XX+ hours',
    },
    {
      title: 'Tested under load',
      description: { html: '<p>Validation &amp; test time</p>' },
      value: 'XX+ hours',
    },
    {
      title: 'Tested every pack',
      description: { html: '<p>Packs tested before delivery</p>' },
      value: '100%',
    },
    {
      title: 'Tested in the field',
      description: { html: '<p>Operational hours validated</p>' },
      value: 'XX,000+ hours',
    },
  ],
}
---
<MediaFactGrid {...content} />
