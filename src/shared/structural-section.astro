---
import SectionIntro from '../primitives/section-intro/section-intro.astro'
import StructuralContent from './structural-content.astro'

interface Cta {
  label?: string
  href?: string
}

interface Media {
  url?: string
  alt?: string
  width?: number
  height?: number
}

interface StructuralField {
  kind: string
  fields?: Record<string, StructuralField>
}

interface Props {
  block: string
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro?: {
    accentHeading?: string
    heading: string
    description?: string | { html: string }
  }
  ctas?: {
    primary?: Cta
    secondary?: Cta
  }
  media?: Media
  content?: Record<string, unknown>
  fields?: Record<string, StructuralField>
}

const { block, id, headingLevel = 'h2', intro, ctas, media, content, fields } = Astro.props
const actions = [ctas?.primary, ctas?.secondary].filter((cta): cta is Cta => Boolean(cta?.label && cta.href))
---
<section class={block} id={id}>
  <div class={`${block}__container`}>
    {intro && <SectionIntro class={`${block}__header`} intro={intro} headingLevel={headingLevel} />}
    {actions.length > 0 && (
      <nav class={`${block}__actions`} aria-label="Section actions">
        {actions.map((cta, index) => <a class={`${block}__action ${block}__action--${index === 0 ? 'primary' : 'secondary'}`} href={cta.href}>{cta.label}</a>)}
      </nav>
    )}
    {content && fields && <StructuralContent block={block} content={content} fields={fields} omit={['theme', 'intro', 'ctas', 'media']} />}
    {media?.url && (
      <picture class={`${block}__media`}>
        <img class={`${block}__image`} src={media.url} alt={media.alt ?? ''} width={media.width} height={media.height} />
      </picture>
    )}
  </div>
</section>
