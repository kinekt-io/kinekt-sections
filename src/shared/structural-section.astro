---
import Button from '../controls/button/allentown/button-allentown.astro'
import SectionIntro from '../primitives/section-intro/section-intro.astro'
import StructuralContent from './structural-content.astro'


interface Cta {
  label?: string
  href?: string
}

interface Media {
  url?: string
  alt?: string
  width?: number
  height?: number
}

interface StructuralField {
  kind: string
  id?: string
  role?: string | null
  fields?: Record<string, StructuralField>
}

interface Props {
  block: string
  id?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  intro?: {
    accentHeading?: string
    heading: string
    description?: string | { html: string }
  }
  ctas?: Record<string, unknown>
  media?: Media
  content?: Record<string, unknown>
  pagefindUrl?: string
  pagefindFilters?: Record<string, unknown>
  fields: Record<string, StructuralField>
  carouselControlStyle?: 'text' | 'icon'
  carouselControls?: 'next' | 'previous-next'
  carouselLoop?: boolean
}

function isCta(value: unknown): value is Required<Cta> {
  return typeof value === 'object'
    && value !== null
    && typeof (value as Cta).label === 'string'
    && typeof (value as Cta).href === 'string'
}

function collectCtas(value: unknown): Required<Cta>[] {
  if (!value || typeof value !== 'object') return []
  return Object.values(value as Record<string, unknown>).flatMap((candidate) => {
    if (isCta(candidate)) return [candidate]
    if (!candidate || typeof candidate !== 'object') return []
    return Object.values(candidate as Record<string, unknown>).filter(isCta)
  })
}

const { block, id, headingLevel = 'h2', intro, ctas, media, fields, content: explicitContent, pagefindUrl, pagefindFilters, carouselControlStyle = 'icon', carouselControls = 'previous-next', carouselLoop = false, ...implicitContent } = Astro.props
const content = (explicitContent ?? implicitContent) as Record<string, unknown>
const theme = content.theme === 'dark' || content.theme === 'semi-dark' || content.theme === 'semi-light' ? content.theme : 'light'
const actions = collectCtas(ctas)
const caseStudyAction = block.includes('case-studies') ? collectCtas(content.cta)[0] : undefined
const contentOmit = caseStudyAction ? ['theme', 'intro', 'ctas', 'media', 'cta'] : ['theme', 'intro', 'ctas', 'media']
---
<section class={block} id={id} data-kinekt-section data-kinekt-structural-section data-kinekt-theme={theme}>
  <div class={`${block}__container`}>
    {(intro || actions.length > 0 || caseStudyAction) && (
      <header class={`${block}__header`}>
        {intro && <div class={`${block}__header-content`}><SectionIntro intro={intro} headingLevel={headingLevel} /></div>}
        {caseStudyAction ? (
          <div class={`${block}__cta`}><Button class={`${block}__cta`} href={caseStudyAction.href} label={caseStudyAction.label} /></div>
        ) : actions.length > 0 && (
          <nav class={`${block}__actions`} aria-label="Section actions">
            {actions.map((cta, index) => <Button class={`${block}__action ${block}__action--${index === 0 ? 'primary' : 'secondary'}`} href={cta.href} label={cta.label} style={index === 0 ? 'primary' : 'secondary'} />)}
          </nav>
        )}
      </header>
    )}
    <StructuralContent block={block} instanceId={id ?? block} content={content} fields={fields} pagefindUrl={pagefindUrl} pagefindFilters={pagefindFilters} carouselControlStyle={carouselControlStyle} carouselControls={carouselControls} carouselLoop={carouselLoop} omit={contentOmit} />
    {media?.url && (
      <picture class={`${block}__media`}>
        <img class={`${block}__image`} src={media.url} alt={media.alt ?? ''} width={media.width} height={media.height} />
      </picture>
    )}
  </div>
</section>

<style is:global>
  :where([data-kinekt-structural-section]) {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-ultra-light)));
    --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white)));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark)));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark)));
    --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light)));
    --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary)));
    --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white)));
    --kinekt-component-font: var(--kinekt-section-font, var(--kiw--section-text-font-family, var(--text-font-family)));
    --kinekt-component-mono: var(--kinekt-section-mono, var(--kiw--section-mono-font-family, var(--mono-font-family)));
    --kinekt-component-site-width: var(--kinekt-section-site-width, var(--kiw--section-site-width, var(--website-width)));
    --kinekt-component-content-width: var(--kinekt-section-content-width, var(--kiw--section-content-width, var(--content-width)));
    --kinekt-component-reading-width: var(--kinekt-section-reading-width, var(--kiw--section-reading-width, var(--width-m)));
    --kinekt-component-inline-space: var(--kinekt-section-inline-space, var(--kiw--section-inline-space, var(--section-gutter)));
    --kinekt-component-block-space: var(--kinekt-section-block-space, var(--kiw--section-block-space, var(--section-space-l)));
    --kinekt-component-gap: var(--kinekt-section-gap, var(--kiw--section-gap, var(--content-gap)));
    --kinekt-component-radius: var(--kinekt-section-radius, var(--kiw--section-radius, var(--radius-none)));
    --kinekt-component-border-width: var(--kinekt-section-border-width, var(--kiw--section-border-width, var(--border-width)));
    --kinekt-component-media-filter: var(--kinekt-section-media-filter, var(--kiw--section-media-filter, var(--media-filter)));
    --kinekt-component-intro-accent-gap: var(--kinekt-section-intro-accent-gap, var(--kiw--section-intro-accent-gap, var(--space-xxs)));
    --kinekt-component-intro-description-gap: var(--kinekt-section-intro-description-gap, var(--kiw--section-intro-description-gap, var(--space-m)));
    --kinekt-component-heading-1-size: var(--kinekt-section-heading-1-size, var(--kiw--section-heading-1-size, var(--h1)));
    --kinekt-component-heading-2-size: var(--kinekt-section-heading-2-size, var(--kiw--section-heading-2-size, var(--h2)));
    --kinekt-component-heading-3-size: var(--kinekt-section-heading-3-size, var(--kiw--section-heading-3-size, var(--h3)));
    --kinekt-component-heading-4-size: var(--kinekt-section-heading-4-size, var(--kiw--section-heading-4-size, var(--h4)));
    --kinekt-component-heading-5-size: var(--kinekt-section-heading-5-size, var(--kiw--section-heading-5-size, var(--h5)));
    --kinekt-component-heading-6-size: var(--kinekt-section-heading-6-size, var(--kiw--section-heading-6-size, var(--h6)));
    --kinekt-component-heading-line-height: var(--kinekt-section-heading-line-height, var(--kiw--section-heading-line-height, var(--heading-line-height)));
    --kinekt-component-text-xs-size: var(--kinekt-section-text-xs-size, var(--kiw--section-text-xs-size, var(--text-xs)));
    --kinekt-component-text-s-size: var(--kinekt-section-text-s-size, var(--kiw--section-text-s-size, var(--text-s)));
    --kinekt-component-text-m-size: var(--kinekt-section-text-m-size, var(--kiw--section-text-m-size, var(--text-m)));
    --kinekt-component-text-l-size: var(--kinekt-section-text-l-size, var(--kiw--section-text-l-size, var(--text-l)));
    --kinekt-component-text-xl-size: var(--kinekt-section-text-xl-size, var(--kiw--section-text-xl-size, var(--text-xl)));
    --kinekt-component-text-xxl-size: var(--kinekt-section-text-xxl-size, var(--kiw--section-text-xxl-size, var(--text-xxl)));
    --kinekt-component-text-line-height: var(--kinekt-section-text-line-height, var(--kiw--section-text-line-height, var(--text-line-height)));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark)));
    --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent)));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary)));
    box-sizing: border-box;
    padding-block: var(--kinekt-component-block-space);
    color: var(--kinekt-component-ink);
    background: var(--kinekt-component-canvas);
    font-family: var(--kinekt-component-font);
    font-size: var(--kinekt-component-text-m-size);
    font-weight: var(--kinekt-section-text-font-weight, var(--kiw--section-text-font-weight, var(--text-font-weight)));
    line-height: var(--kinekt-component-text-line-height);
    letter-spacing: var(--kinekt-section-text-letter-spacing, var(--kiw--section-text-letter-spacing, var(--text-letter-spacing)));
  }

  :where([data-kinekt-structural-section][data-kinekt-theme='light'], [data-kinekt-structural-section][data-kinekt-theme='semi-light']) { color-scheme: light; }
  :where([data-kinekt-structural-section][data-kinekt-theme='semi-light']) {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--neutral-light)));
    --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--white)));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-semi-dark)));
    --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary-ultra-light)));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--primary-ultra-dark)));
    --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary-semi-dark)));
    --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white)));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent-semi-dark)));
    --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent)));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary)));
  }
  :where([data-kinekt-structural-section][data-kinekt-theme='dark'], [data-kinekt-structural-section][data-kinekt-theme='semi-dark']) {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--primary-ultra-dark)));
    --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--primary-semi-dark)));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--white)));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-ultra-light)));
    --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary)));
    --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary)));
    --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white)));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent)));
    --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent)));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary-ultra-light)));
    color-scheme: dark;
  }
  :where([data-kinekt-structural-section][data-kinekt-theme='semi-dark']) {
    --kinekt-component-canvas: var(--kinekt-section-canvas, var(--kiw--section-canvas, var(--primary-dark)));
    --kinekt-component-surface: var(--kinekt-section-surface, var(--kiw--section-surface, var(--primary-semi-dark)));
    --kinekt-component-muted: var(--kinekt-section-muted, var(--kiw--section-muted, var(--primary-light)));
    --kinekt-component-ink: var(--kinekt-section-ink, var(--kiw--section-ink, var(--white)));
    --kinekt-component-line: var(--kinekt-section-line, var(--kiw--section-line, var(--primary)));
    --kinekt-component-action: var(--kinekt-section-action, var(--kiw--section-action, var(--primary)));
    --kinekt-component-action-text: var(--kinekt-section-action-text, var(--kiw--section-action-text, var(--white)));
    --kinekt-component-accent: var(--kinekt-section-accent, var(--kiw--section-accent, var(--accent)));
    --kinekt-component-action-icon: var(--kinekt-section-action-icon, var(--kiw--section-action-icon, var(--accent)));
    --kinekt-component-subtle: var(--kinekt-section-subtle, var(--kiw--section-subtle, var(--primary-light)));
  }

  :where([data-kinekt-structural-section]) *,
  :where([data-kinekt-structural-section]) *::before,
  :where([data-kinekt-structural-section]) *::after { box-sizing: border-box; }
  :where([data-kinekt-structural-section]) [hidden] { display: none !important; }
  :where([data-kinekt-structural-section]) > [class$='__container'] {
    display: grid;
    width: 100%;
    max-width: min(var(--kinekt-component-site-width), calc(var(--kinekt-component-content-width) + (var(--kinekt-component-inline-space) * 2)));
    gap: var(--kinekt-component-gap);
    margin-inline: auto;
    padding-inline: var(--kinekt-component-inline-space);
  }
  :where([data-kinekt-structural-section]) :is([class$='__header'], [class$='__intro']) { max-width: none; }
  :where([data-kinekt-structural-section]) [class$='__header-content'] { max-width: var(--kinekt-component-reading-width); }
  :where([data-kinekt-structural-section]) :is(h1, h2, h3, h4, h5, h6):not(.section-intro__heading) { max-width: var(--kinekt-component-reading-width); margin-block: 0; color: inherit; font-family: var(--kinekt-section-heading-font-family, var(--kiw--section-heading-font-family, var(--heading-font-family))); font-weight: var(--kinekt-section-heading-font-weight, var(--kiw--section-heading-font-weight, var(--heading-font-weight))); line-height: var(--kinekt-component-heading-line-height); letter-spacing: var(--kinekt-section-heading-letter-spacing, var(--kiw--section-heading-letter-spacing, var(--heading-letter-spacing))); text-wrap: balance; }
  :where([data-kinekt-structural-section]) h1:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-1-size); }
  :where([data-kinekt-structural-section]) h2:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-2-size); }
  :where([data-kinekt-structural-section]) h3:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-3-size); }
  :where([data-kinekt-structural-section]) h4:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-4-size); }
  :where([data-kinekt-structural-section]) h5:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-5-size); }
  :where([data-kinekt-structural-section]) h6:not(.section-intro__heading) { font-size: var(--kinekt-component-heading-6-size); }
  :where([data-kinekt-structural-section]) :is(p, li, dd, td, th, label, input, textarea, button):where(:not(.callout-allentown__label, .button, .section-intro__description)) { font: inherit; line-height: var(--kinekt-component-text-line-height); }
  :where([data-kinekt-structural-section]) button.button { width: fit-content; font-family: var(--kinekt-component-font); }
  :where([data-kinekt-structural-section]) :is(p, ul, ol, dl, table, form):where(:not(.section-intro__description, .section-intro__accent)) { margin-block: 0; }
  :where([data-kinekt-structural-section]) :is([class$='__actions'], [class*='__cta-group']) { display: flex; flex-wrap: wrap; gap: var(--kinekt-section-actions-gap, var(--kiw--section-actions-gap, var(--space-s))); margin-top: var(--kinekt-section-actions-margin, var(--kiw--section-actions-margin, var(--space-xl))); }
  :where([data-kinekt-structural-section]) [class$='__header'] > :is([class$='__actions'], [class$='__cta']) { margin-top: 0; }
  /* Button owns its defaults; sections only set its inherited token context. */
  :where([data-kinekt-structural-section]) :is([class$='__media'], [class*='__media-'], [class*='__image']) { display: block; max-width: 100%; }
  :where([data-kinekt-structural-section]) picture { display: block; }
  :where([data-kinekt-structural-section]) img { display: block; width: 100%; height: auto; border-radius: var(--kinekt-component-radius); filter: var(--kinekt-component-media-filter); }
  :where([data-kinekt-structural-section]) [class$='__media'] img,
  :where([data-kinekt-structural-section]) [class$='__image'] { aspect-ratio: var(--kinekt-section-media-ratio, 4 / 3); object-fit: cover; }
  :where([data-kinekt-structural-section]) :is(ul, ol)[class*='__'] { display: grid; padding: 0; list-style: none; }
  :where([data-kinekt-structural-section]) :is(ul, ol)[class*='__'] > li { min-width: 0; }
  :where([data-kinekt-structural-section]) :is(ul, ol):not([class]) { display: grid; gap: var(--space-xs); padding-left: var(--space-l); }
  :where([data-kinekt-structural-section]) :is([class$='__cards'], [class$='__insight-sources']) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  :where([data-kinekt-structural-section]) li > article { display: grid; gap: var(--space-s); padding: var(--kinekt-component-gap); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); background: var(--kinekt-component-surface); }
  :where([data-kinekt-structural-section]) :is([class$='__cards'], [class$='__results'], [class$='__items'], [class$='__models'], [class$='__options'], [class$='__insight-sources']) > li > article { align-content: start; gap: var(--space-m); padding: var(--kinekt-section-card-padding, var(--kiw--section-card-padding, var(--space-l))); }
  :where([data-kinekt-structural-section]) :is([class$='__cards'], [class$='__results'], [class$='__items'], [class$='__models'], [class$='__options'], [class$='__insight-sources']) > li > article > picture:first-child img { aspect-ratio: var(--kinekt-section-card-media-ratio, 4 / 3); object-fit: cover; }
  :where([data-kinekt-structural-section]) :is([class$='__cards'], [class$='__results'], [class$='__items'], [class$='__models'], [class$='__options'], [class$='__insight-sources']) > li > article :is(h3, h4) { font-size: var(--h4); line-height: var(--heading-line-height); }
  :where([data-kinekt-structural-section]) :is([class$='__cards'], [class$='__results'], [class$='__items'], [class$='__models'], [class$='__options'], [class$='__insight-sources']) > li > article :is(p, [class*='__description']) { color: var(--kinekt-component-muted); }
  :where([data-kinekt-structural-section]) [class$='__cards'] { gap: var(--border-width); background: var(--kinekt-component-line); }
  :where([data-kinekt-structural-section]) [class$='__cards'] > li > article { min-height: 100%; padding: var(--kinekt-section-card-padding, var(--kiw--section-card-padding, var(--space-l))); border: 0; border-radius: 0; background: var(--kinekt-component-canvas); }
  :where([data-kinekt-structural-section]) :is([class$='__features'], [class$='__checklist'], [class$='__specifications'], [class$='__facts'], [class$='__metrics']) { border-top: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
  :where([data-kinekt-structural-section]) :is([class$='__features'], [class$='__checklist'], [class$='__specifications'], [class$='__facts'], [class$='__metrics']) > li { padding-block: var(--space-l); border-bottom: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
  :where([data-kinekt-structural-section]) :is([class$='__features'], [class$='__checklist'], [class$='__specifications'], [class$='__facts'], [class$='__metrics']) > li > article { padding: 0; border: 0; background: transparent; }
  :where([data-kinekt-structural-section]) [class$='__features'] { gap: 0; margin-top: var(--section-space-xs); }
  :where([data-kinekt-structural-section]) [class$='__features'] > li > article { padding: var(--space-m) 0; border-width: var(--kinekt-component-border-width) 0 0; border-radius: 0; background: transparent; }
  :where([data-kinekt-structural-section]) dl > div { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); padding: var(--space-m) 0; border-bottom: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
  :where([data-kinekt-structural-section]) dl > div:first-child { border-top: var(--kinekt-component-border-width) solid var(--kinekt-component-line); }
  :where([data-kinekt-structural-section]) :is(dt, dd) { margin: 0; }
  :where([data-kinekt-structural-section]) dd { font-weight: var(--heading-font-weight); }
  :where([data-kinekt-structural-section]) aside:not(.callout-allentown) { display: grid; gap: var(--space-m); margin-top: var(--section-space-xs); padding: var(--space-l); background: var(--kinekt-component-surface); }
  :where([data-kinekt-structural-section]) table { width: 100%; border-collapse: collapse; overflow: hidden; border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); border-radius: var(--kinekt-component-radius); }
  :where([data-kinekt-structural-section]) :is(th, td) { padding: var(--space-s); border: var(--kinekt-component-border-width) solid var(--kinekt-component-line); text-align: left; vertical-align: top; }
  :where([data-kinekt-structural-section]) th { font-weight: var(--heading-font-weight); background: var(--kinekt-component-surface); }
  :where([data-kinekt-structural-section]) form[class*='__'] { display: grid; gap: var(--kinekt-component-gap); }
  :where([data-kinekt-structural-section]) form label { display: grid; gap: var(--space-xxs); font-weight: var(--heading-font-weight); }
