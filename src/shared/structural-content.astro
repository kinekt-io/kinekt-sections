---
interface Field {
  kind: string
  id?: string
  role?: string | null
  fields?: Record<string, Field>
}

interface Props {
  block: string
  instanceId: string
  content: Record<string, unknown>
  fields: Record<string, Field>
  pagefindUrl?: string
  pagefindFilters?: Record<string, unknown>
  carouselControlStyle?: 'text' | 'icon'
  carouselControls?: 'next' | 'previous-next'
  carouselLoop?: boolean
  omit?: string[]
  level?: 2 | 3 | 4
}

const { block, instanceId, content, fields, pagefindUrl = '/pagefind/pagefind.js', pagefindFilters, carouselControlStyle = 'icon', carouselControls = 'previous-next', carouselLoop = false, omit = [], level = 2 } = Astro.props
const entries = Object.entries(fields).filter(([key]) => key in content && !omit.includes(key))
const Heading = `h${Math.min(level, 4)}` as 'h2' | 'h3' | 'h4'
const comparison = fields.columns?.kind === 'infoItems' && fields.rows?.kind === 'componentList'
const columns = Array.isArray(content.columns) ? content.columns : []
const rows = Array.isArray(content.rows) ? content.rows : []
const accordionRoles = new Set(['accordion-item', 'faq-item', 'product-detail-item', 'step'])

function classFor(key: string) {
  return `${block}__${key.replace(/([a-z])([A-Z])/g, '$1-$2').replace(/[_\s]+/g, '-').toLowerCase()}`
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value)
}

function isHeading(key: string) {
  return /(heading|title|name)$/i.test(key)
}

function text(value: unknown) {
  return typeof value === 'string' || typeof value === 'number' ? String(value) : ''
}

function values(value: unknown) {
  return Array.isArray(value) ? value.map(text).filter(Boolean) : text(value) ? [text(value)] : []
}

function identifier(value: string) {
  return value.replace(/[^a-zA-Z0-9_-]/g, '-')
}
---
{comparison ? (
  <table class={`${block}__table`}>
    <thead><tr><th scope="col">Feature</th>{columns.map((column) => <th scope="col">{String(column)}</th>)}</tr></thead>
    <tbody>{rows.map((row) => {
      const record = row as Record<string, unknown>
      const cells = Array.isArray(record.cells) ? record.cells : []
      return <tr><th scope="row">{String(record.feature ?? '')}</th>{cells.map((cell) => <td>{isRecord(cell) ? String(cell.text ?? cell.status ?? '') : String(cell)}</td>)}</tr>
    })}</tbody>
  </table>
) : entries.map(([key, field]) => {
  const value = content[key]
  const className = classFor(key)

  if (field.kind === 'component' && field.role === 'case-study-carousel' && isRecord(value)) {
    const items = Array.isArray(value.items) ? value.items : []
    const sectionLabel = text(content.sectionLabel)
    const itemFields = field.fields?.items?.fields ?? {}
    return <div class={className} data-kinekt-carousel data-kinekt-carousel-controls={carouselControls} data-kinekt-carousel-control-style={carouselControlStyle} data-kinekt-carousel-loop={carouselLoop ? 'true' : 'false'} role="region" aria-label="Case studies carousel">
      {sectionLabel && <div class={`${className}-label`} data-kinekt-carousel-label><p>{sectionLabel}</p><span aria-hidden="true"></span></div>}
      <div class={`${className}-viewport`} data-kinekt-carousel-viewport>
        <ul class={`${className}-slides`} data-kinekt-carousel-container>
          {items.map((item, index) => <li class={`${className}-slide`} data-kinekt-carousel-slide><article><Astro.self block={block} instanceId={`${instanceId}-${key}-${index}`} content={item as Record<string, unknown>} fields={itemFields} omit={['image', 'results', 'quote', 'cta']} level={Math.min(level + 1, 4) as 2 | 3 | 4} /><div class={`${className}-slide-content`}><Astro.self block={block} instanceId={`${instanceId}-${key}-${index}-image`} content={item as Record<string, unknown>} fields={itemFields} omit={['logo', 'title', 'description', 'results', 'quote', 'cta']} level={Math.min(level + 1, 4) as 2 | 3 | 4} /><div class={`${className}-slide-details`}><Astro.self block={block} instanceId={`${instanceId}-${key}-${index}-details`} content={item as Record<string, unknown>} fields={itemFields} omit={['logo', 'title', 'description', 'image']} level={Math.min(level + 1, 4) as 2 | 3 | 4} /></div></div></article></li>)}
        </ul>
      </div>
      <div class={`${className}-pagination`} data-kinekt-carousel-pagination>
        {carouselControls === 'previous-next' && <button type="button" data-kinekt-carousel-previous aria-label="Previous case study"><span data-kinekt-carousel-control-icon aria-hidden="true">←</span><span data-kinekt-carousel-control-text>Previous</span></button>}
        <p class={`${className}-counter`} data-kinekt-carousel-counter aria-live="polite" aria-atomic="true">
          <span data-kinekt-carousel-current aria-hidden="true">1</span><span data-kinekt-carousel-separator aria-hidden="true"> / </span><span data-kinekt-carousel-total aria-hidden="true">{items.length}</span><span class={`${className}-status`} data-kinekt-carousel-status>Slide 1 of {items.length}</span>
        </p>
        <button type="button" data-kinekt-carousel-next aria-label="Next case study"><span data-kinekt-carousel-control-icon aria-hidden="true">→</span><span data-kinekt-carousel-control-text>Next</span></button>
        <div class={`${className}-indicators`} data-kinekt-carousel-indicators role="group" aria-label="Case study pagination">
          {items.map((_, index) => <button type="button" data-kinekt-carousel-dot data-kinekt-carousel-index={index} aria-label={`Go to case study ${index + 1}`} aria-current={index === 0 ? 'true' : undefined}></button>)}
        </div>
      </div>
    </div>
  }
  if (key === 'sectionLabel' && block.includes('case-studies')) return null
  if (field.kind === 'component' && field.role === 'quote' && isRecord(value)) {
    const avatar = isRecord(value.avatar) ? value.avatar : null
    const quote = text(value.quote)
    const authorName = text(value.authorName)
    const authorRole = text(value.authorRole)
    return <figure class={className}>
      {quote && <blockquote><p class={`${className}-text`}>{quote}</p></blockquote>}
      {(avatar || authorName || authorRole) && <figcaption class={`${className}-attribution`}>
        {avatar && typeof avatar.url === 'string' && <picture class={`${className}-avatar`}><img src={avatar.url} alt={typeof avatar.alt === 'string' ? avatar.alt : ''} width={typeof avatar.width === 'number' ? avatar.width : undefined} height={typeof avatar.height === 'number' ? avatar.height : undefined} /></picture>}
        {(authorName || authorRole) && <div class={`${className}-author`}>
          {authorName && <p class={`${className}-author-name`}>{authorName}</p>}
          {authorRole && <p class={`${className}-author-role`}>{authorRole}</p>}
        </div>}
      </figcaption>}
    </figure>
  }


  if (field.kind === 'component' && isRecord(value)) {
    return <div class={className}><Astro.self block={block} instanceId={`${instanceId}-${key}`} content={value} fields={field.fields ?? {}} level={Math.min(level + 1, 4) as 2 | 3 | 4} /></div>
  }

  if (field.kind === 'componentList' && field.role === 'tab-item' && Array.isArray(value)) {
    return <div class={className} data-kinekt-tabs>
      <div class={`${className}-tablist`} role="tablist" aria-label="Section tabs">
        {value.map((item, index) => {
          const record = item as Record<string, unknown>
          const id = `${identifier(instanceId)}-${key}-${index}`
          return <button id={`${id}-tab`} class={`${className}-tab`} type="button" role="tab" aria-controls={`${id}-panel`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{text(record.label) || `Tab ${index + 1}`}</button>
        })}
      </div>
      {value.map((item, index) => {
        const id = `${identifier(instanceId)}-${key}-${index}`
        return <div id={`${id}-panel`} class={`${className}-panel`} role="tabpanel" aria-labelledby={`${id}-tab`} hidden={index !== 0}><Astro.self block={block} instanceId={`${id}-panel`} content={item as Record<string, unknown>} fields={field.fields ?? {}} omit={['label']} level={Math.min(level + 1, 4) as 2 | 3 | 4} /></div>
      })}
    </div>
  }

  if (field.kind === 'componentList' && accordionRoles.has(field.role ?? '') && Array.isArray(value)) {
    return <ul class={className} data-kinekt-disclosure-group>
      {value.map((item, index) => {
        const record = item as Record<string, unknown>
        const title = field.role === 'faq-item'
          ? text(record.question)
          : text(record.title) || text(record.label) || `Item ${index + 1}`
        const subtitle = text(record.subtitle)
        return <li class={`${className}-item`}><details open={index === 0} data-kinekt-disclosure><summary><span class={`${className}-title`}>{title}</span>{subtitle && <span class={`${className}-subtitle`}>{subtitle}</span>}</summary><div class={`${className}-body`}><Astro.self block={block} instanceId={`${instanceId}-${key}-${index}`} content={record} fields={field.fields ?? {}} omit={['title', 'label', 'subtitle', 'marker', 'detailHeading', 'question']} level={Math.min(level + 1, 4) as 2 | 3 | 4} /></div></details></li>
      })}
    </ul>
  }

  if (field.kind === 'componentList' && Array.isArray(value)) {
    return <ul class={className}>{value.map((item, index) => <li class={`${className}-item`}><article><Astro.self block={block} instanceId={`${instanceId}-${key}-${index}`} content={item as Record<string, unknown>} fields={field.fields ?? {}} level={Math.min(level + 1, 4) as 2 | 3 | 4} /></article></li>)}</ul>
  }

  if ((field.kind === 'media' || field.kind === 'video') && isRecord(value) && typeof value.url === 'string') {
    return <picture class={className}><img src={value.url} alt={typeof value.alt === 'string' ? value.alt : ''} width={typeof value.width === 'number' ? value.width : undefined} height={typeof value.height === 'number' ? value.height : undefined} /></picture>
  }

  if (field.kind === 'mediaList' && Array.isArray(value)) {
    return <ul class={className}>{value.map((media) => isRecord(media) && typeof media.url === 'string' && <li class={`${className}-item`}><picture><img src={media.url} alt={typeof media.alt === 'string' ? media.alt : ''} width={typeof media.width === 'number' ? media.width : undefined} height={typeof media.height === 'number' ? media.height : undefined} /></picture></li>)}</ul>
  }

  if (field.kind === 'insightSourceList' && Array.isArray(value) && block.includes('insight-index')) {
    return <div class={className} data-kinekt-search-grid data-kinekt-pagefind-url={pagefindUrl} data-kinekt-pagefind-filters={pagefindFilters ? JSON.stringify(pagefindFilters) : undefined}>
      <form class={`${className}-search`} role="search" data-kinekt-search-form>
        <label>Search insights <input type="search" name="query" data-kinekt-search-query autocomplete="off" /></label>
        <label>Type <select name="type" data-kinekt-search-facet="type"><option value="">All types</option>{[...new Set(value.map((item) => text((item as Record<string, unknown>).type) || 'Article'))].map((type) => <option value={type}>{type}</option>)}</select></label>
        <label>Subject <select name="subject" data-kinekt-search-facet="subject"><option value="">All subjects</option>{[...new Set(value.flatMap((item) => values((item as Record<string, unknown>).subjects).length ? values((item as Record<string, unknown>).subjects) : ['General']))].map((subject) => <option value={subject}>{subject}</option>)}</select></label>
        <button type="submit">Search</button>
      </form>
      <p class={`${className}-status`} data-kinekt-search-status aria-live="polite"></p>
      <ul class={`${className}-results`} data-kinekt-search-results>
        {value.map((insight) => {
          const item = insight as Record<string, unknown>
          const image = isRecord(item.image) ? item.image : null
          const type = text(item.type) || 'Article'
          const subjects = values(item.subjects).length ? values(item.subjects) : ['General']
          const searchText = [item.title, item.excerpt, type, ...subjects].map(text).join(' ').toLowerCase()
          return <li class={`${className}-item`} data-kinekt-search-item data-kinekt-search-text={searchText} data-kinekt-search-type={type} data-kinekt-search-subjects={subjects.join('|')}><article>{image && typeof image.url === 'string' && <picture><img src={image.url} alt={typeof image.alt === 'string' ? image.alt : ''} width={typeof image.width === 'number' ? image.width : undefined} height={typeof image.height === 'number' ? image.height : undefined} /></picture>}<p>{type} · {String(item.publishedAt ?? '')}</p><h3>{String(item.title ?? '')}</h3><p>{String(item.excerpt ?? '')}</p>{typeof item.href === 'string' && <a href={item.href}>Read insight</a>}</article></li>
        })}
      </ul>
    </div>
  }

  if (field.kind === 'insightSourceList' && Array.isArray(value)) {
    return <ul class={className}>{value.map((insight) => {
      const item = insight as Record<string, unknown>
      const image = isRecord(item.image) ? item.image : null
      return <li class={`${className}-item`}><article>{image && typeof image.url === 'string' && <picture><img src={image.url} alt={typeof image.alt === 'string' ? image.alt : ''} width={typeof image.width === 'number' ? image.width : undefined} height={typeof image.height === 'number' ? image.height : undefined} /></picture>}<p>{String(item.publishedAt ?? '')}</p><h3>{String(item.title ?? '')}</h3><p>{String(item.excerpt ?? '')}</p>{typeof item.href === 'string' && <a href={item.href}>Read insight</a>}</article></li>
    })}</ul>
  }

  if (field.kind === 'cta' && isRecord(value) && typeof value.href === 'string' && typeof value.label === 'string') {
    return <a class={className} href={value.href}>{value.label}</a>
  }

  if (field.kind === 'ctaGroup' && isRecord(value)) {
    return <nav class={className} aria-label="Section actions">{Object.values(value).map((cta) => isRecord(cta) && typeof cta.href === 'string' && typeof cta.label === 'string' && <a href={cta.href}>{cta.label}</a>)}</nav>
  }

  if (field.kind === 'formReference' && isRecord(value)) {
    return <form class={className} action="#" method="get"><p>{typeof value.name === 'string' ? value.name : 'Example form'}</p><label>Name <input name="name" autocomplete="name" required /></label><label>Email <input name="email" type="email" autocomplete="email" required /></label><label>Message <textarea name="message" required></textarea></label><button type="submit">Submit test form</button></form>
  }

  if ((field.kind === 'infoItems' || field.kind === 'featureItems') && Array.isArray(value)) {
    return <ul class={className}>{value.map((item) => <li class={`${className}-item`}>{String(item)}</li>)}</ul>
  }

  if (Array.isArray(value)) {
    return <ul class={className}>{value.map((item) => <li class={`${className}-item`}>{typeof item === 'string' ? item : JSON.stringify(item)}</li>)}</ul>
  }

  if (typeof value === 'string' || typeof value === 'number') {
    return isHeading(key) ? <Heading class={className}>{String(value)}</Heading> : <p class={className}>{String(value)}</p>
  }

  return null
})}

