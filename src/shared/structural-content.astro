---
interface Props {
  block: string
  content: Record<string, unknown>
  omit?: string[]
}

const { block, content, omit = [] } = Astro.props
const visibleEntries = Object.entries(content).filter(([key, value]) => value !== undefined && value !== null && !omit.includes(key))

function labelFor(key: string) {
  return key.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/[-_]/g, ' ').replace(/^./, (character) => character.toUpperCase())
}

function textFor(value: unknown) {
  if (typeof value === 'string' || typeof value === 'number') return String(value)
  return null
}
---
{visibleEntries.length > 0 && (
  <dl class={`${block}__details`}>
    {visibleEntries.map(([key, value]) => (
      <div class={`${block}__detail`}>
        <dt>{labelFor(key)}</dt>
        <dd>
          {textFor(value) && <p>{textFor(value)}</p>}
          {Array.isArray(value) && (
            <ul class={`${block}__items`}>
              {value.map((item) => (
                <li class={`${block}__item`}>
                  {textFor(item) && <p>{textFor(item)}</p>}
                  {typeof item === 'object' && item && <Astro.self block={block} content={item as Record<string, unknown>} />}
                </li>
              ))}
            </ul>
          )}
          {typeof value === 'object' && value && !Array.isArray(value) && (
            <Astro.self block={block} content={value as Record<string, unknown>} />
          )}
        </dd>
      </div>
    ))}
  </dl>
)}
