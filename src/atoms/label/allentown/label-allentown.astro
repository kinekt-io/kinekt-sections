---
import { fas } from '@fortawesome/free-solid-svg-icons'

interface Props { text: string; icon?: string; class?: string }
const { text, icon, class: className } = Astro.props
const classes = ['label-allentown', className].filter(Boolean).join(' ')
const fontAwesomeIcon = (name?: string) => {
  if (!name || !/^[a-z0-9-]+$/.test(name)) return undefined
  const key = `fa${name.split('-').map((part) => part[0].toUpperCase() + part.slice(1)).join('')}`
  return fas[key]
}
const iconDefinition = fontAwesomeIcon(icon)
---
<span class={classes}>{iconDefinition && <svg class="label-allentown__icon" aria-hidden="true" focusable="false" viewBox={`0 0 ${iconDefinition.icon[0]} ${iconDefinition.icon[1]}`}><path d={iconDefinition.icon[4] as string} /></svg>}<span class="label-allentown__text">{text}</span></span>
<style is:global>
  :where(.label-allentown) {
    --kiw--label-allentown-accent: var(--kinekt-component-accent, var(--accent-semi-dark));
    --kiw--label-allentown-align-items: center;
    --kiw--label-allentown-gap: var(--space-xs);
    --kiw--label-allentown-padding-block: calc((var(--space-xxs) + var(--space-xs)) / 2);
    --kiw--label-allentown-padding-inline: var(--space-s);
    --kiw--label-allentown-radius: var(--radius-l);
    --kiw--label-allentown-border-width: var(--border-width);
    --kiw--label-allentown-border-color: color-mix(in srgb, var(--kiw--label-allentown-accent) 25%, transparent);
    --kiw--label-allentown-ink: var(--kiw--label-allentown-accent);
    --kiw--label-allentown-background: color-mix(in srgb, var(--kiw--label-allentown-accent) 8%, transparent);
    --kiw--label-allentown-font-family: var(--mono-font-family);
    --kiw--label-allentown-font-size: var(--text-l);
    --kiw--label-allentown-font-weight: var(--heading-font-weight);
    --kiw--label-allentown-line-height: 1;
    --kiw--label-allentown-letter-spacing: var(--text-letter-spacing);
    --kiw--label-allentown-text-wrap: balance;
    --kiw--label-allentown-text-transform: uppercase;
    --kiw--label-allentown-icon-size: var(--text-m);
  }

  .label-allentown {
    display: inline-flex;
    align-items: var(--kiw--label-allentown-align-items);
    gap: var(--kiw--label-allentown-gap);
    box-sizing: border-box;
    inline-size: fit-content;
    max-inline-size: 100%;
    min-inline-size: 0;
    text-wrap: var(--kiw--label-allentown-text-wrap);
    margin: 0;
    padding: var(--kiw--label-allentown-padding-block) var(--kiw--label-allentown-padding-inline);
    border: var(--kiw--label-allentown-border-width) solid var(--kiw--label-allentown-border-color);
    border-radius: var(--kiw--label-allentown-radius);
    color: var(--kiw--label-allentown-ink);
    background: var(--kiw--label-allentown-background);
    font-family: var(--kiw--label-allentown-font-family);
    font-size: var(--kiw--label-allentown-font-size);
    font-weight: var(--kiw--label-allentown-font-weight);
    line-height: var(--kiw--label-allentown-line-height);
    letter-spacing: var(--kiw--label-allentown-letter-spacing);
    text-transform: var(--kiw--label-allentown-text-transform);
  }

  .label-allentown :where(.label-allentown__text) {
    min-inline-size: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .label-allentown :where(.label-allentown__icon) {
    flex: none;
    inline-size: var(--kiw--label-allentown-icon-size);
    block-size: var(--kiw--label-allentown-icon-size);
    fill: currentColor;
  }
</style>
