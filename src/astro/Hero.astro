---
import type { HeroContent, HeroImage } from '../types.js'
import { isSafeWebUrl } from '../urls.js'

interface Props extends HeroContent {
  id?: string
  headingLevel?: 'h1' | 'h2'
}

function assertSafeImage(image: HeroImage, name: string): void {
  if (!isSafeWebUrl(image.url)) {
    throw new Error(`${name}.url must be an HTTP(S) or root-relative URL.`)
  }

  if (!Number.isSafeInteger(image.width) || image.width <= 0) {
    throw new Error(`${name}.width must be a positive integer.`)
  }

  if (!Number.isSafeInteger(image.height) || image.height <= 0) {
    throw new Error(`${name}.height must be a positive integer.`)
  }
}

const {
  id,
  headingLevel = 'h1',
  eyebrow,
  title,
  highlight,
  titleSuffix,
  description,
  cta,
  image,
  mobileImage,
} = Astro.props

if (!isSafeWebUrl(cta.href)) {
  throw new Error('cta.href must be an HTTP(S) or root-relative URL.')
}

assertSafeImage(image, 'image')

if (mobileImage) {
  assertSafeImage(mobileImage, 'mobileImage')
}

const Heading = headingLevel
const titleLines = title.split('\n')
---

<section class="hero-section" id={id}>
  <div class="hero-section__inner">
    <div class="hero-section__content">
      <p class="hero-section__eyebrow">
        <span class="hero-section__eyebrow-arrow" aria-hidden="true">→</span>
        {eyebrow}
      </p>

      <Heading class="hero-section__title">
        {titleLines.map((line, index) => (
          <Fragment>
            {index > 0 && <br />}
            {line}
          </Fragment>
        ))}
        {highlight && <><span class="hero-section__title-highlight"> {highlight}</span>{titleSuffix}</>}
        {!highlight && titleSuffix}
      </Heading>

      <p class="hero-section__description">{description}</p>

      <a class="hero-section__cta" href={cta.href}>
        {cta.label}<svg aria-hidden="true" width="11" height="18" viewBox="0 0 11 18" fill="none"><path d="m2 2 7 7-7 7" stroke="currentColor" stroke-width="2" /></svg>
      </a>
    </div>

    <picture class="hero-section__media">
      {mobileImage && <source media="(max-width: 767px)" srcset={mobileImage.url} width={mobileImage.width} height={mobileImage.height} />}
      <img
        class="hero-section__image"
        src={image.url}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>

<style>
  .hero-section {
    --hero-section-background: #003d47;
    --hero-section-accent: #fb3261;
    --hero-section-text: #ffffff;
    --hero-section-cta-text: #001d22;
    --hero-section-heading-font: var(--kinekt-sections-heading-font-family, 'Brockmann', sans-serif);
    --hero-section-body-font: var(--kinekt-sections-body-font-family, 'Urbanist', sans-serif);

    background-color: var(--hero-section-background);
    color: var(--hero-section-text);
  }

  .hero-section__inner {
    display: grid;
    width: min(calc(100% - clamp(3rem, 11.11vw, 10rem)), 80rem);
    margin-inline: auto;
    padding-block: 3.5rem;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-section__content {
    max-width: 34.375rem;
  }

  .hero-section__eyebrow {
    margin: 0 0 0.9375rem;
    font-family: var(--hero-section-body-font);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .hero-section__eyebrow-arrow {
    display: inline-block;
    margin-right: 0.5rem;
    color: var(--hero-section-accent);
  }

  .hero-section__title {
    margin: 0;
    font-family: var(--hero-section-heading-font);
    font-size: clamp(2.5rem, 10vw, 3.41875rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: 0.03em;
  }

  .hero-section__title-highlight {
    color: var(--hero-section-accent);
  }

  .hero-section__description {
    max-width: 35rem;
    margin: 2.5rem 0 0;
    font-family: var(--hero-section-body-font);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .hero-section__cta {
    display: inline-flex;
    box-sizing: border-box;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    margin-top: 2.5rem;
    padding: 1.2rem 1.4rem;
    background-color: var(--hero-section-accent);
    color: var(--hero-section-cta-text);
    font-family: var(--hero-section-heading-font);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .hero-section__cta:hover {
    background-color: #ff5479;
  }

  .hero-section__cta:focus-visible {
    outline: 3px solid var(--hero-section-text);
    outline-offset: 4px;
    box-shadow: 0 0 0 6px var(--hero-section-background);
  }

  .hero-section__media {
    display: block;
  }

  .hero-section__image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .hero-section__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 4.375rem;
      gap: 1.25rem;
    }

    .hero-section__title {
      font-size: 3.41875rem;
    }
  }
</style>
