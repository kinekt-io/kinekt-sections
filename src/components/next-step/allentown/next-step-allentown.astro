---
import Button from '../../../controls/button/allentown/button-allentown.astro'
import { ctaGroupActions, type Cta, type CtaGroup } from '../../../shared/content.js'
import { ctaIconPaths, isCtaIcon } from '../../../shared/cta-icons.js'

export interface NextStepContent {
  title: string
  description: string
  ctaGroup?: CtaGroup | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
}

interface Props {
  step: NextStepContent
  /** Renderer-derived list position (1-based); shown as a zero-padded number. */
  number: number
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  class?: string
}


const { step, number, headingLevel = 'h3', class: className } = Astro.props
const Heading = headingLevel
const displayNumber = String(number).padStart(2, '0')
const actions = ctaGroupActions(step.ctaGroup)
const classes = ['next-step-allentown', className].filter(Boolean).join(' ')
---
<article class={classes}>
  <div class="next-step-allentown__copy">
    <Heading class="next-step-allentown__heading"><span class="next-step-allentown__number" aria-hidden="true">{displayNumber}</span><span class="next-step-allentown__title">{step.title}</span></Heading>
    <p class="next-step-allentown__description">{step.description}</p>
  </div>
  {actions.length > 0 && (
    <div class="next-step-allentown__actions">
      {actions.map((cta) => {
        const icon = isCtaIcon(cta.icon) ? ctaIconPaths[cta.icon] : undefined
        return <Button href={cta.href} label={cta.label} style={cta.style ?? 'clear'}>{icon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={icon.viewBox} fill="none"><path d={icon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>
      })}
    </div>
  )}
</article>
<style is:global>
  :where(.next-step-allentown) {
    --kiw--next-step-allentown-gap: var(--space-l);
    --kiw--next-step-allentown-copy-gap: var(--space-xs);
    --kiw--next-step-allentown-heading-gap: var(--space-xs);
    --kiw--next-step-allentown-actions-gap: var(--space-l);
    --kiw--next-step-allentown-heading-size: var(--h5);
    --kiw--next-step-allentown-number-color: var(--kinekt-component-accent, var(--accent-semi-dark));
    --kiw--next-step-allentown-number-font-family: var(--mono-font-family);
    --kiw--next-step-allentown-number-line-height: var(--heading-line-height);
    --kiw--next-step-allentown-title-color: var(--kinekt-component-ink, inherit);
    --kiw--next-step-allentown-description-color: var(--kinekt-component-subtle, var(--kinekt-component-muted, inherit));
    --kiw--next-step-allentown-description-size: var(--text-m);
  }

  .next-step-allentown { display: grid; align-content: start; gap: var(--kiw--next-step-allentown-gap); min-width: 0; }
  .next-step-allentown .next-step-allentown__copy { display: grid; gap: var(--kiw--next-step-allentown-copy-gap); }
  .next-step-allentown .next-step-allentown__heading { display: flex; align-items: center; gap: var(--kiw--next-step-allentown-heading-gap); max-width: none; margin: 0; font-size: var(--kiw--next-step-allentown-heading-size); }
  .next-step-allentown .next-step-allentown__number { flex: none; color: var(--kiw--next-step-allentown-number-color); font-family: var(--kiw--next-step-allentown-number-font-family); font-weight: 500; line-height: var(--kiw--next-step-allentown-number-line-height); }
  .next-step-allentown .next-step-allentown__title { min-width: 0; color: var(--kiw--next-step-allentown-title-color); font-family: var(--kinekt-component-heading-font-family, var(--heading-font-family)); font-weight: var(--kinekt-component-heading-font-weight, var(--heading-font-weight)); line-height: 1; }
  .next-step-allentown .next-step-allentown__description { margin: 0; color: var(--kiw--next-step-allentown-description-color); font-size: var(--kiw--next-step-allentown-description-size); line-height: var(--kinekt-component-text-line-height, var(--text-line-height)); }
  .next-step-allentown .next-step-allentown__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--kiw--next-step-allentown-actions-gap); }
</style>
