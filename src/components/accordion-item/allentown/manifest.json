{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "components/accordion-item/allentown",
  "slug": "accordion-item-allentown",
  "title": "Accordion Item Allentown",
  "description": "A reusable accordion item with an optional automatic number or Font Awesome 7 Sharp Solid marker, required title and description, and optional subtitle.",
  "category": "components",
  "role": "accordion-item",
  "variation": "allentown",
  "status": "planned",
  "figma": {
    "url": "https://www.figma.com/design/7rHrxb3twyBvPo9QxkOBly/KSW-1-Tulip-Tech-Website?node-id=5240-412615&t=mG3L6xlBzomA03GY-11",
    "nodeId": "5240:412615"
  },
  "fields": {
    "markerType": {
      "kind": "select",
      "required": true,
      "localized": true,
      "options": ["none", "number", "icon"],
      "description": "When number is selected, the renderer derives the marker from the item's list position. When icon is selected, icon is required."
    },
    "icon": {
      "kind": "text",
      "required": false,
      "localized": true,
      "description": "Required when markerType is icon. Font Awesome 7 Sharp Solid icon name."
    },
    "title": {
      "kind": "text",
      "required": true,
      "localized": true
    },
    "subtitle": {
      "kind": "text",
      "required": false,
      "localized": true
    },
    "description": {
      "kind": "richText",
      "required": true,
      "localized": true
    }
  }
}
