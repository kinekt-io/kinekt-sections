---
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'

export interface ProcessItemContent {
  label: string
  title: string
  description: string
}

interface Props {
  item: ProcessItemContent
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  class?: string
}

const { item, headingLevel = 'h3', class: className } = Astro.props
const Heading = headingLevel
const classes = ['process-item-allentown', className].filter(Boolean).join(' ')
---
<div class={classes}>
  {item.label && <SubtitleFlightPath text={item.label} caps />}
  {(item.title || item.description) && (
    <div class="process-item-allentown__copy">
      {item.title && <Heading class="process-item-allentown__title">{item.title}</Heading>}
      {item.description && <p class="process-item-allentown__description">{item.description}</p>}
    </div>
  )}
</div>
<style is:global>
  :where(.process-item-allentown) {
    --kiw--process-item-allentown-gap: var(--space-xl);
    --kiw--process-item-allentown-copy-gap: var(--space-xs);
    --kiw--process-item-allentown-title-size: var(--h4);
    --kiw--process-item-allentown-title-color: var(--kinekt-component-ink, currentColor);
    --kiw--process-item-allentown-description-size: var(--text-l);
    --kiw--process-item-allentown-description-line-height: 1.5;
    --kiw--process-item-allentown-description-color: var(--kinekt-component-muted, currentColor);
  }

  .process-item-allentown { display: grid; gap: var(--kiw--process-item-allentown-gap); min-width: 0; }
  .process-item-allentown .process-item-allentown__copy { display: grid; gap: var(--kiw--process-item-allentown-copy-gap); }
  .process-item-allentown .process-item-allentown__title { max-width: none; margin: 0; color: var(--kiw--process-item-allentown-title-color); font-family: var(--heading-font-family); font-size: var(--kiw--process-item-allentown-title-size); font-weight: var(--heading-font-weight); line-height: 1.2; letter-spacing: var(--heading-letter-spacing); text-wrap: balance; }
  .process-item-allentown .process-item-allentown__description { margin: 0; color: var(--kiw--process-item-allentown-description-color); font-size: var(--kiw--process-item-allentown-description-size); line-height: var(--kiw--process-item-allentown-description-line-height); white-space: pre-line; }
</style>
