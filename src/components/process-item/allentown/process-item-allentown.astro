---
import CtaAction from '../../../shared/cta-action-allentown.astro'
import SubtitleFlightPath from '../../../primitives/subtitle-flight-path/subtitle-flight-path.astro'
import { ctaGroupActions, type Cta, type CtaGroup, type RichText } from '../../../shared/content.js'
import { richTextToHtml } from '../../../shared/rich-text.js'

export interface ProcessItemContent {
  label?: string
  title: string
  description: string | RichText
  ctaGroup?: CtaGroup | { primaryButton?: Cta | null; secondaryButton?: Cta | null } | null
}

interface Props {
  item: ProcessItemContent
  markerType?: 'label' | 'number' | 'label-number'
  number?: number
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  class?: string
}

const { item, markerType = 'label', number = 1, headingLevel = 'h3', class: className } = Astro.props
const actions = ctaGroupActions(item.ctaGroup)
const Heading = headingLevel
const displayNumber = String(number).padStart(2, '0')
const hasNumberMarker = markerType === 'number' || markerType === 'label-number'
const classes = ['process-item-allentown', className].filter(Boolean).join(' ')
const descriptionHtml = typeof item.description === 'string'
  ? richTextToHtml(item.description, 'process item description')
  : item.description.html

---
<div class={classes}>
  {markerType !== 'number' && item.label && <SubtitleFlightPath text={item.label} caps />}
  {(item.title || item.description) && (
    <div class="process-item-allentown__copy">
      {item.title && <Heading class:list={['process-item-allentown__title', hasNumberMarker && 'process-item-allentown__title--numbered']}>{hasNumberMarker && <span class="process-item-allentown__number">{displayNumber}</span>}<span class="process-item-allentown__title-text">{item.title}</span></Heading>}
      <div class="process-item-allentown__description" set:html={descriptionHtml} />
    </div>
  )}
  {actions.length > 0 && (
    <div class="process-item-allentown__actions">
      {actions.map((action) => (
        <CtaAction cta={action} style={action.style ?? 'primary'} />
      ))}
    </div>
  )}
</div>
<style is:global>
  :where(.process-item-allentown) {
    --kiw--process-item-allentown-gap: var(--space-xl);
    --kiw--process-item-allentown-copy-gap: var(--space-xs);
    --kiw--process-item-allentown-actions-gap: var(--space-l);
    --kiw--process-item-allentown-title-size: var(--h4);
    --kiw--process-item-allentown-title-color: var(--kinekt-component-ink, currentColor);
    --kiw--process-item-allentown-description-size: var(--text-l);
    --kiw--process-item-allentown-description-line-height: 1.5;
    --kiw--process-item-allentown-description-color: var(--kinekt-component-muted, currentColor);
    --kiw--process-item-allentown-number-color: var(--kinekt-component-accent, var(--accent-semi-dark));
    --kiw--process-item-allentown-number-font-family: var(--mono-font-family);
    --kiw--process-item-allentown-number-font-weight: 400;
  }

  .process-item-allentown { display: grid; gap: var(--kiw--process-item-allentown-gap); min-width: 0; }
  .process-item-allentown .process-item-allentown__copy { display: grid; gap: var(--kiw--process-item-allentown-copy-gap); }
  .process-item-allentown .process-item-allentown__title { max-width: none; margin: 0; color: var(--kiw--process-item-allentown-title-color); font-family: var(--heading-font-family); font-size: var(--kiw--process-item-allentown-title-size); font-weight: var(--heading-font-weight); line-height: 1.2; letter-spacing: var(--heading-letter-spacing); text-wrap: balance; }
  .process-item-allentown .process-item-allentown__title--numbered { display: flex; align-items: baseline; gap: var(--space-s); }
  .process-item-allentown .process-item-allentown__title-text { min-width: 0; }
  .process-item-allentown .process-item-allentown__number { flex: 0 0 auto; margin: 0; color: var(--kiw--process-item-allentown-number-color); font-family: var(--kiw--process-item-allentown-number-font-family); font-size: inherit; font-weight: var(--kiw--process-item-allentown-number-font-weight); line-height: inherit; }
  .process-item-allentown .process-item-allentown__description { margin: 0; color: var(--kiw--process-item-allentown-description-color); font-size: var(--kiw--process-item-allentown-description-size); line-height: var(--kiw--process-item-allentown-description-line-height); white-space: pre-line; }
  .process-item-allentown .process-item-allentown__description > * { margin-block: 0; }
  .process-item-allentown .process-item-allentown__description > * + * { margin-block-start: var(--space-xs); }

  .process-item-allentown .process-item-allentown__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--kiw--process-item-allentown-actions-gap); }
</style>
