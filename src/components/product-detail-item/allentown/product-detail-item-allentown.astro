---
import { faMinus, faPlus } from '@fortawesome/free-solid-svg-icons'
import Label from '../../../atoms/label/allentown/label-allentown.astro'

export interface ProductDetailItemContent {
  title: string
  subtitle?: string | null
  description: string
  detailHeading?: string | null
  details?: Array<{ text: string; icon?: string | null }> | null
}

interface Props {
  item: ProductDetailItemContent
  /** Renderer-controlled initial state (the section opens its first item, manifest `initialOpenItem`). */
  open?: boolean
  headingLevel?: 'h3' | 'h4' | 'h5' | 'h6'
  class?: string
}

const { item, open = false, headingLevel = 'h3', class: className } = Astro.props
const Heading = headingLevel
const details = (item.details ?? []).filter((detail) => typeof detail?.text === 'string' && detail.text !== '')
const classes = ['product-detail-item-allentown', className].filter(Boolean).join(' ')
const [plusWidth, plusHeight, , , plusPath] = faPlus.icon
const [minusWidth, minusHeight, , , minusPath] = faMinus.icon
---
<details class={classes} open={open} data-kinekt-disclosure>
  <summary class="product-detail-item-allentown__summary">
    <span class="product-detail-item-allentown__header">
      <Heading class="product-detail-item-allentown__title">{item.title}</Heading>
      {item.subtitle && <span class="product-detail-item-allentown__subtitle">{item.subtitle}</span>}
    </span>
    <svg class="product-detail-item-allentown__icon product-detail-item-allentown__icon--open" aria-hidden="true" focusable="false" viewBox={`0 0 ${plusWidth} ${plusHeight}`}><path d={plusPath as string} /></svg>
    <svg class="product-detail-item-allentown__icon product-detail-item-allentown__icon--close" aria-hidden="true" focusable="false" viewBox={`0 0 ${minusWidth} ${minusHeight}`}><path d={minusPath as string} /></svg>
  </summary>
  <div class="product-detail-item-allentown__content">
    <p class="product-detail-item-allentown__description">{item.description}</p>
    {(item.detailHeading || details.length > 0) && (
      <div class="product-detail-item-allentown__feature">
        {item.detailHeading && <p class="product-detail-item-allentown__detail-heading">{item.detailHeading}</p>}
        {details.length > 0 && (
          <ul class="product-detail-item-allentown__details">
            {details.map((detail) => <li><Label size="s" text={detail.text} icon={detail.icon ?? undefined} /></li>)}
          </ul>
        )}
      </div>
    )}
  </div>
</details>
<style is:global>
  /* Figma "Feature Section" (5240:411610): accordion header (h4 title + subtitle, plus/minus icon) and content (description, detail heading, Label Size=Small list). */
  :where(.product-detail-item-allentown) {
    --kiw--product-detail-item-allentown-content-gap: var(--space-xl);
    --kiw--product-detail-item-allentown-header-gap: var(--space-s);
    --kiw--product-detail-item-allentown-title-gap: var(--space-xxs);
    --kiw--product-detail-item-allentown-title-size: var(--h4);
    --kiw--product-detail-item-allentown-title-color: var(--kinekt-component-ink, currentColor);
    --kiw--product-detail-item-allentown-subtitle-size: var(--text-m);
    --kiw--product-detail-item-allentown-text-color: var(--kinekt-component-muted, currentColor);
    --kiw--product-detail-item-allentown-icon-size: var(--text-xl);
    --kiw--product-detail-item-allentown-icon-color: var(--kinekt-component-accent, currentColor);
    --kiw--product-detail-item-allentown-body-gap: var(--space-l);
    --kiw--product-detail-item-allentown-description-size: var(--text-m);
    --kiw--product-detail-item-allentown-feature-gap: var(--space-s);
    --kiw--product-detail-item-allentown-detail-heading-size: var(--text-m);
    --kiw--product-detail-item-allentown-details-gap: var(--space-xxs);
  }

  .product-detail-item-allentown { display: block; min-width: 0; }
  .product-detail-item-allentown > .product-detail-item-allentown__summary { display: flex; align-items: center; justify-content: space-between; gap: var(--kiw--product-detail-item-allentown-header-gap); list-style: none; cursor: pointer; }
  .product-detail-item-allentown > .product-detail-item-allentown__summary::-webkit-details-marker { display: none; }
  .product-detail-item-allentown > .product-detail-item-allentown__summary:focus-visible { outline: calc(var(--border-width) * 2) solid var(--kinekt-component-accent, currentColor); outline-offset: var(--space-xxs); }
  .product-detail-item-allentown .product-detail-item-allentown__header { display: grid; gap: var(--kiw--product-detail-item-allentown-title-gap); min-width: 0; }
  .product-detail-item-allentown .product-detail-item-allentown__title { max-width: none; margin: 0; color: var(--kiw--product-detail-item-allentown-title-color); font-family: var(--heading-font-family); font-size: var(--kiw--product-detail-item-allentown-title-size); font-weight: var(--heading-font-weight); line-height: 1; letter-spacing: var(--heading-letter-spacing); text-wrap: balance; }
  .product-detail-item-allentown .product-detail-item-allentown__subtitle { display: block; color: var(--kiw--product-detail-item-allentown-text-color); font-size: var(--kiw--product-detail-item-allentown-subtitle-size); line-height: var(--text-line-height); }
  .product-detail-item-allentown .product-detail-item-allentown__icon { flex: none; width: var(--kiw--product-detail-item-allentown-icon-size); height: var(--kiw--product-detail-item-allentown-icon-size); fill: var(--kiw--product-detail-item-allentown-icon-color); }
  .product-detail-item-allentown .product-detail-item-allentown__icon--close,
  .product-detail-item-allentown[open] .product-detail-item-allentown__icon--open { display: none; }
  .product-detail-item-allentown[open] .product-detail-item-allentown__icon--close { display: block; }

  .product-detail-item-allentown .product-detail-item-allentown__content { display: grid; gap: var(--kiw--product-detail-item-allentown-body-gap); margin-block-start: var(--kiw--product-detail-item-allentown-content-gap); }
  .product-detail-item-allentown .product-detail-item-allentown__description { margin: 0; color: var(--kiw--product-detail-item-allentown-text-color); font-size: var(--kiw--product-detail-item-allentown-description-size); line-height: var(--text-line-height); white-space: pre-line; }
  .product-detail-item-allentown .product-detail-item-allentown__feature { display: grid; gap: var(--kiw--product-detail-item-allentown-feature-gap); }
  .product-detail-item-allentown .product-detail-item-allentown__detail-heading { margin: 0; color: var(--kiw--product-detail-item-allentown-title-color); font-family: var(--heading-font-family); font-size: var(--kiw--product-detail-item-allentown-detail-heading-size); font-weight: var(--heading-font-weight); line-height: 1; }
  .product-detail-item-allentown .product-detail-item-allentown__details { display: flex; flex-wrap: wrap; gap: var(--kiw--product-detail-item-allentown-details-gap); margin: 0; padding: 0; list-style: none; }
  .product-detail-item-allentown .product-detail-item-allentown__details > li { display: flex; min-width: 0; max-width: 100%; }
</style>
