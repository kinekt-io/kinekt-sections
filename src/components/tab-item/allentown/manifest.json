{
  "$schema": "https://kinekt.io/schemas/component-manifest.schema.json",
  "schemaVersion": 1,
  "version": "26.10.0-beta.0",
  "id": "components/tab-item/allentown",
  "slug": "tab-item-allentown",
  "title": "Tab Item Allentown",
  "description": "A localized tab with a label and at least a description or selected Form record.",
  "category": "components",
  "role": "tab-item",
  "variation": "allentown",
  "status": "planned",
  "requiresAnyOf": ["description", "form"],
  "fields": {
    "label": {
      "kind": "text",
      "required": true,
      "localized": true
    },
    "description": {
      "kind": "richText",
      "required": false,
      "localized": true
    },
    "form": {
      "kind": "formEmbed",
      "required": false,
      "localized": true,
      "description": "HubSpot embed code. The catalogue renders a safe placeholder through components/form-embed/allentown; the integration owns execution of the embed."
    }
  }
}
