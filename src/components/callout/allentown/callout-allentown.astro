---
import SectionIntro from "../../../primitives/section-intro/section-intro.astro";
import Button from "../../../controls/button/allentown/button-allentown.astro";
import type {
  CtaGroup,
  SectionIntro as SectionIntroContent,
} from "../../../shared/content.js";

interface Props {
  callout: {
    intro: SectionIntroContent;
    ctaGroup?: CtaGroup | { primaryButton?: CtaGroup['primary']; secondaryButton?: CtaGroup['secondary'] };
  };
  headingLevel?: "h1" | "h2" | "h3";
  class?: string;
}

const { callout, headingLevel = "h3", class: className } = Astro.props;
const actions = (callout.ctaGroup ?? {}) as CtaGroup & { primaryButton?: CtaGroup['primary']; secondaryButton?: CtaGroup['secondary'] };
const primary = actions.primary ?? actions.primaryButton;
const secondary = actions.secondary ?? actions.secondaryButton;
const hasActions = Boolean(primary || secondary);
const classes = ["callout-allentown", className].filter(Boolean).join(" ");
const contentIntro = { ...callout.intro, accentHeading: undefined };
---

<aside class={classes}>
  {
    callout.intro.accentHeading && (
      <header class="callout-allentown__header">
        <>
          <p class="callout-allentown__label">{callout.intro.accentHeading}</p>
          <span class="callout-allentown__line" aria-hidden="true" />
        </>
      </header>
    )
  }
  <div class="callout-allentown__body">
    <div class="callout-allentown__content">
      <SectionIntro intro={contentIntro} headingLevel={headingLevel} />
    </div>
    {
      hasActions && (
        <div class="callout-allentown__action">
          {primary && <Button href={primary.href} label={primary.label} />}
          {secondary && <Button href={secondary.href} label={secondary.label} style="secondary" />}
        </div>
      )
    }
  </div>
</aside>

<style is:global>
  :where(.callout-allentown) {
    --kiw--callout-allentown-header-align-items: center;
    --kiw--callout-allentown-gap: var(--space-l);
    --kiw--callout-allentown-header-gap: var(--space-xs);
    --kiw--callout-allentown-label-ink: var(--kinekt-component-action);
    --kiw--callout-allentown-label-font-family: var(--mono-font-family);
    --kiw--callout-allentown-label-font-size: var(--text-xs);
    --kiw--callout-allentown-label-font-weight: var(--heading-font-weight);
    --kiw--callout-allentown-label-line-height: var(--text-line-height);
    --kiw--callout-allentown-label-letter-spacing: var(--heading-letter-spacing);
    --kiw--callout-allentown-label-text-transform: uppercase;
    --kiw--callout-allentown-line-width: var(--border-width);
    --kiw--callout-allentown-line-color: var(--kinekt-component-line);
    --kiw--callout-allentown-body-gap: var(--space-l);
    --kiw--callout-allentown-content-width: var(--kinekt-component-reading-width);
    --kiw--callout-allentown-action-align-items: end;
    --kiw--callout-allentown-action-gap: var(--space-s);
    --kiw--callout-allentown-desktop-body-align-items: end;
    --kiw--callout-allentown-desktop-body-gap: var(--section-space-m);
  }

  .callout-allentown {
    display: grid;
    width: 100%;
    max-width: none;
    gap: var(--kiw--callout-allentown-gap);
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;

    & .callout-allentown__header {
      display: flex;
      align-items: var(--kiw--callout-allentown-header-align-items);
      gap: var(--kiw--callout-allentown-header-gap);
      margin: 0;
    }
    & .callout-allentown__label {
      margin: 0;
      color: var(--kiw--callout-allentown-label-ink);
      font-family: var(--kiw--callout-allentown-label-font-family);
      font-size: var(--kiw--callout-allentown-label-font-size);
      font-weight: var(--kiw--callout-allentown-label-font-weight);
      line-height: var(--kiw--callout-allentown-label-line-height);
      letter-spacing: var(--kiw--callout-allentown-label-letter-spacing);
      text-transform: var(--kiw--callout-allentown-label-text-transform);
    }
    & .callout-allentown__line {
      flex: 1;
      height: var(--kiw--callout-allentown-line-width);
      background: var(--kiw--callout-allentown-line-color);
    }
    & .callout-allentown__body {
      display: grid;
      gap: var(--kiw--callout-allentown-body-gap);
    }
    & .callout-allentown__content {
      max-width: var(--kiw--callout-allentown-content-width);
    }
    & .callout-allentown__action {
      display: flex;
      flex-wrap: wrap;
      align-items: var(--kiw--callout-allentown-action-align-items);
      gap: var(--kiw--callout-allentown-action-gap);
    }
    @media (min-width: 50rem) {
      & .callout-allentown__body {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: var(--kiw--callout-allentown-desktop-body-align-items);
        gap: var(--kiw--callout-allentown-desktop-body-gap);
      }
    }
  }
</style>
