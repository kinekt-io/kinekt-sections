---
import SectionIntro from "../../../primitives/section-intro/section-intro.astro";
import SubtitleFlightPath from "../../../primitives/subtitle-flight-path/subtitle-flight-path.astro";
import Button from "../../../controls/button/allentown/button-allentown.astro";
import { ctaIconPaths } from "../../../shared/cta-icons.js";
import type {
  CtaGroup,
  SectionIntro as SectionIntroContent,
} from "../../../shared/content.js";

interface Props {
  callout: {
    intro: SectionIntroContent;
    ctaGroup?: CtaGroup | { primaryButton?: CtaGroup['primary']; secondaryButton?: CtaGroup['secondary'] };
  };
  headingLevel?: "h1" | "h2" | "h3";
  size?: "medium" | "large";
  class?: string;
}

const { callout, headingLevel = "h3", size = "large", class: className } = Astro.props;
const actions = (callout.ctaGroup ?? {}) as CtaGroup & { primaryButton?: CtaGroup['primary']; secondaryButton?: CtaGroup['secondary'] };
const primary = actions.primary ?? actions.primaryButton;
const secondary = actions.secondary ?? actions.secondaryButton;
const primaryIcon = primary?.icon ? ctaIconPaths[primary.icon] : undefined;
const secondaryIcon = secondary?.icon ? ctaIconPaths[secondary.icon] : undefined;
const hasCustomActions = Astro.slots.has("actions");
const hasActions = hasCustomActions || Boolean(primary || secondary);
const classes = ["callout-allentown", `callout-allentown--${size}`, className].filter(Boolean).join(" ");
const contentIntro = { ...callout.intro, accentHeading: undefined };
---

<aside class={classes}>
  {
    callout.intro.accentHeading && (
      <header class="callout-allentown__header">
        <SubtitleFlightPath text={callout.intro.accentHeading} labelClass="callout-allentown__label" />
      </header>
    )
  }
  <div class="callout-allentown__body">
    <div class="callout-allentown__content">
      <SectionIntro intro={contentIntro} headingLevel={headingLevel} />
    </div>
    {
      hasActions && (
        <div class="callout-allentown__action">
          {hasCustomActions ? <slot name="actions" /> : (
            <>
              {primary && <Button href={primary.href} label={primary.label}>{primaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={primaryIcon.viewBox} fill="none"><path d={primaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
              {secondary && <Button href={secondary.href} label={secondary.label} style="clear">{secondaryIcon && <svg data-kinekt-cta-icon aria-hidden="true" width="1em" height="1em" viewBox={secondaryIcon.viewBox} fill="none"><path d={secondaryIcon.path} stroke="currentColor" stroke-width="2" /></svg>}</Button>}
            </>
          )}
        </div>
      )
    }
  </div>
</aside>

<style is:global>
  :where(.callout-allentown) {
    --kiw--callout-allentown-gap: var(--space-l);
    --kiw--callout-allentown-body-gap: var(--section-space-xs);
    --kiw--callout-allentown-copy-gap: var(--space-xs);
    --kiw--callout-allentown-title-size: var(--h3);
    --kiw--callout-allentown-title-line-height: 1.2;
    --kiw--callout-allentown-description-size: var(--text-l);
    --kiw--callout-allentown-description-width: var(--width-l);
    --kiw--callout-allentown-content-width: none;
    --kiw--callout-allentown-action-align-items: center;
    --kiw--callout-allentown-action-gap: var(--space-l);
    --kiw--callout-allentown-action-item-flex: 0 1 auto;
    --kiw--callout-allentown-desktop-body-columns: minmax(0, 1fr) auto;
    --kiw--callout-allentown-desktop-body-align-items: end;
    --kiw--callout-allentown-desktop-body-gap: var(--section-space-xxl);
    --kiw--callout-allentown-wide-body-columns: var(--kiw--callout-allentown-desktop-body-columns);
    --kiw--callout-allentown-wide-body-gap: var(--kiw--callout-allentown-desktop-body-gap);
  }

  :where(.callout-allentown--medium) {
    --kiw--callout-allentown-title-size: var(--h5);
    --kiw--callout-allentown-description-size: var(--text-m);
  }

  .callout-allentown {
    display: grid;
    width: 100%;
    max-width: none;
    gap: var(--kiw--callout-allentown-gap);
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .callout-allentown .callout-allentown__header {
    margin: 0;
  }

  .callout-allentown .callout-allentown__body {
    display: grid;
    gap: var(--kiw--callout-allentown-body-gap);
  }

  .callout-allentown .callout-allentown__content {
    min-width: 0;
    max-width: var(--kiw--callout-allentown-content-width);
  }

  .callout-allentown .callout-allentown__content .section-intro {
    display: grid;
    gap: var(--kiw--callout-allentown-copy-gap);
  }

  .callout-allentown .callout-allentown__content :is(.section-intro__heading, .section-intro__description) {
    max-width: none;
    margin: 0;
  }

  .callout-allentown .callout-allentown__content .section-intro__heading {
    font-size: var(--kiw--callout-allentown-title-size);
    line-height: var(--kiw--callout-allentown-title-line-height);
  }

  .callout-allentown .callout-allentown__content .section-intro__description {
    font-size: var(--kiw--callout-allentown-description-size);
  }

  .callout-allentown .callout-allentown__action {
    display: flex;
    flex-wrap: wrap;
    align-items: var(--kiw--callout-allentown-action-align-items);
    gap: var(--kiw--callout-allentown-action-gap);
  }

  .callout-allentown .callout-allentown__action > * {
    flex: var(--kiw--callout-allentown-action-item-flex);
  }

  @media (min-width: 50rem) {
    .callout-allentown .callout-allentown__body {
      grid-template-columns: var(--kiw--callout-allentown-desktop-body-columns);
      align-items: var(--kiw--callout-allentown-desktop-body-align-items);
      gap: var(--kiw--callout-allentown-desktop-body-gap);
    }

    .callout-allentown .callout-allentown__content .section-intro__description {
      max-width: var(--kiw--callout-allentown-description-width);
    }
  }

  /* Wide layouts, e.g. a fixed copy column next to actions that fill the rest (set both columns variables). */
  @media (min-width: 90rem) {
    .callout-allentown .callout-allentown__body {
      grid-template-columns: var(--kiw--callout-allentown-wide-body-columns);
      gap: var(--kiw--callout-allentown-wide-body-gap);
    }
  }
</style>
