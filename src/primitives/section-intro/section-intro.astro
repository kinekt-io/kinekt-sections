---
import type { SectionIntro } from '../../shared/content.js'
interface Props { intro: SectionIntro; headingLevel?: 'h1' | 'h2' | 'h3' }
const { intro, headingLevel = 'h2' } = Astro.props
const Heading = headingLevel
---
<div class="section-intro">
  <div class="section-intro__heading-group">
    {intro.accentHeading && <p class="section-intro__accent">{intro.accentHeading}</p>}
    <Heading class="section-intro__heading">{intro.heading}</Heading>
  </div>
  <slot name="after-heading" />
  {typeof intro.description === 'string' && <p class="section-intro__description">{intro.description}</p>}
  {typeof intro.description === 'object' && <div class="section-intro__description" set:html={intro.description.html} />}
</div>

<style is:global>
  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__accent {
    margin-block: 0 var(--kinekt-component-intro-accent-gap, var(--space-xxs));
    color: var(--kinekt-component-accent, var(--kinekt-component-muted, var(--neutral-ultra-dark)));
    font: inherit;
    line-height: var(--kinekt-component-text-line-height, var(--text-line-height));
    text-transform: uppercase;
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading {
    max-width: var(--kinekt-component-reading-width, var(--width-m));
    margin: 0;
    color: inherit;
    font-family: var(--kinekt-component-heading-font-family, var(--heading-font-family));
    font-weight: var(--kinekt-component-heading-font-weight, var(--heading-font-weight));
    line-height: var(--kinekt-component-heading-line-height, var(--heading-line-height));
    letter-spacing: var(--kinekt-component-heading-letter-spacing, var(--heading-letter-spacing));
    text-wrap: balance;
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h1) {
    font-size: var(--kinekt-component-heading-1-size, var(--h1));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h2) {
    font-size: var(--kinekt-component-heading-2-size, var(--h2));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h3) {
    font-size: var(--kinekt-component-heading-3-size, var(--h3));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h4) {
    font-size: var(--kinekt-component-heading-4-size, var(--h4));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h5) {
    font-size: var(--kinekt-component-heading-5-size, var(--h5));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__heading:is(h6) {
    font-size: var(--kinekt-component-heading-6-size, var(--h6));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__description {
    max-width: var(--kinekt-component-reading-width, var(--width-m));
    margin-block: var(--kinekt-component-intro-description-gap, var(--space-m)) 0;
    color: var(--kinekt-component-muted, var(--neutral-ultra-dark));
    font: inherit;
    font-size: var(--kinekt-component-text-l-size, var(--text-l));
    line-height: var(--kinekt-component-text-line-height, var(--text-line-height));
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__description > :first-child {
    margin-top: 0;
  }

  :where([data-kinekt-section], [data-kinekt-structural-section]) .section-intro__description > :last-child {
    margin-bottom: 0;
  }
</style>
