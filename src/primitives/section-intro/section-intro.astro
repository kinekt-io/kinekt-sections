---
import type { SectionIntro } from '../../shared/content.js'
interface Props { intro: SectionIntro; headingLevel?: 'h1' | 'h2' | 'h3' }
const { intro, headingLevel = 'h2' } = Astro.props
const Heading = headingLevel
---
{intro.accentHeading && <p class="section-intro__accent">{intro.accentHeading}</p>}
<Heading class="section-intro__heading">{intro.heading}</Heading>
{typeof intro.description === 'string' && <p class="section-intro__description">{intro.description}</p>}
{typeof intro.description === 'object' && <div class="section-intro__description" set:html={intro.description.html} />}
