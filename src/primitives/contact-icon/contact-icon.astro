---
import { ctaIconPaths } from '../../shared/cta-icons.js'

interface Props {
  name: string
}

const { name } = Astro.props
const icon = ctaIconPaths(name)
---
{icon && <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={icon.viewBox} fill="currentColor"><path d={icon.path} /></svg>}
