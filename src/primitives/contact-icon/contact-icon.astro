---
import { faComment, faEnvelope, faPhone } from '@fortawesome/sharp-solid-svg-icons'

interface Props {
  name: 'whatsapp' | 'phone' | 'email'
}

const { name } = Astro.props
const icons = { whatsapp: faComment, phone: faPhone, email: faEnvelope } as const
const icon = icons[name]
---
<svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox={`0 0 ${icon.icon[0]} ${icon.icon[1]}`} fill="currentColor"><path d={icon.icon[4] as string} /></svg>
