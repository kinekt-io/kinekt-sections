{
  "name": "@kinekt-io/components",
  "version": "26.10.2-beta.8",
  "description": "Paired Astro sections and Payload blocks for Kinekt websites",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinekt-io/kinekt-sections.git"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./primitives/kinekt-media.astro": "./src/primitives/kinekt-media/kinekt-media.astro",
    "./primitives/section-intro.astro": "./src/primitives/section-intro/section-intro.astro",
    "./sections/compatibility-specifications-allentown.astro": "./src/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.astro",
    "./sections/compatibility-specifications-allentown.payload": {
      "default": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.payload.js",
      "import": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.payload.js",
      "types": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.payload.d.ts"
    },
    "./sections/compatibility-specifications-allentown.types": {
      "default": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.types.js",
      "import": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.types.js",
      "types": "./dist/sections/compatibility-specifications/allentown/compatibility-specifications-allentown.types.d.ts"
    },
    "./sections/hero-allentown.astro": "./src/sections/hero/allentown/hero-allentown.astro",
    "./sections/hero-allentown.payload": {
      "default": "./dist/sections/hero/allentown/hero-allentown.payload.js",
      "import": "./dist/sections/hero/allentown/hero-allentown.payload.js",
      "types": "./dist/sections/hero/allentown/hero-allentown.payload.d.ts"
    },
    "./sections/hero-allentown.types": {
      "default": "./dist/sections/hero/allentown/hero-allentown.types.js",
      "import": "./dist/sections/hero/allentown/hero-allentown.types.js",
      "types": "./dist/sections/hero/allentown/hero-allentown.types.d.ts"
    },
    "./sections/hero-trinity.astro": "./src/sections/hero/trinity/hero-trinity.astro",
    "./sections/hero-trinity.payload": {
      "default": "./dist/sections/hero/trinity/hero-trinity.payload.js",
      "import": "./dist/sections/hero/trinity/hero-trinity.payload.js",
      "types": "./dist/sections/hero/trinity/hero-trinity.payload.d.ts"
    },
    "./sections/hero-trinity.types": {
      "default": "./dist/sections/hero/trinity/hero-trinity.types.js",
      "import": "./dist/sections/hero/trinity/hero-trinity.types.js",
      "types": "./dist/sections/hero/trinity/hero-trinity.types.d.ts"
    },
    "./sections/media-feature-list-allentown.astro": "./src/sections/media-feature-list/allentown/media-feature-list-allentown.astro",
    "./sections/media-feature-list-allentown.payload": {
      "default": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.payload.js",
      "import": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.payload.js",
      "types": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.payload.d.ts"
    },
    "./sections/media-feature-list-allentown.types": {
      "default": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.types.js",
      "import": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.types.js",
      "types": "./dist/sections/media-feature-list/allentown/media-feature-list-allentown.types.d.ts"
    },
    "./sections/output-card-grid-allentown.astro": "./src/sections/output-card-grid/allentown/output-card-grid-allentown.astro",
    "./sections/output-card-grid-allentown.payload": {
      "default": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.payload.js",
      "import": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.payload.js",
      "types": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.payload.d.ts"
    },
    "./sections/output-card-grid-allentown.types": {
      "default": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.types.js",
      "import": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.types.js",
      "types": "./dist/sections/output-card-grid/allentown/output-card-grid-allentown.types.d.ts"
    },
    "./sections/read-more-allentown.astro": "./src/sections/read-more/allentown/read-more-allentown.astro",
    "./sections/read-more-allentown.payload": {
      "default": "./dist/sections/read-more/allentown/read-more-allentown.payload.js",
      "import": "./dist/sections/read-more/allentown/read-more-allentown.payload.js",
      "types": "./dist/sections/read-more/allentown/read-more-allentown.payload.d.ts"
    },
    "./sections/read-more-allentown.types": {
      "default": "./dist/sections/read-more/allentown/read-more-allentown.types.js",
      "import": "./dist/sections/read-more/allentown/read-more-allentown.types.js",
      "types": "./dist/sections/read-more/allentown/read-more-allentown.types.d.ts"
    }
  },
  "scripts": {
    "exports:generate": "node scripts/generate-exports.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build": "pnpm exports:generate && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm exports:generate && astro check --root examples/astro && astro check --root examples/catalog",
    "dev": "pnpm build && astro dev --root examples/astro --host 127.0.0.1",
    "build:example": "astro build --root examples/astro",
    "build:catalog": "pnpm exports:generate && astro build --root examples/catalog",
    "dev:catalog": "pnpm exports:generate && astro dev --root examples/catalog --host 127.0.0.1",
    "prepack": "pnpm exports:generate",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "astro": "^7.1.3",
    "payload": "^3.86.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "payload": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@payloadcms/db-sqlite": "3.88.0",
    "@types/node": "22.18.12",
    "astro": "7.1.3",
    "payload": "3.88.0",
    "sharp": "0.35.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
