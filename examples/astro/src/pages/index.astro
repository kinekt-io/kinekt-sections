---
import '@kinekt-io/components/styles/wireframe-tokens.css'
import Hero from '@kinekt-io/components/sections/hero-allentown.astro'
import { hero } from '../data/hero'

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Kinekt hero package preview</title>
  </head>
  <body class="astro-preview-page"><main><Hero {...hero} /></main></body>
</html>
<style is:global>
  :where(.astro-preview-page) {
    --kiw--astro-preview-canvas: var(--white);
    --kiw--astro-preview-ink: var(--base);
    --kiw--astro-preview-font: var(--text-font-family);
  }

  .astro-preview-page { margin: 0; color: var(--kiw--astro-preview-ink); background: var(--kiw--astro-preview-canvas); font-family: var(--kiw--astro-preview-font); }
</style>
