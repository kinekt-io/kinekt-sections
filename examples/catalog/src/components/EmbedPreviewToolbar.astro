---
// Floating theme controls for standalone embed previews (dev/designer tool).
// Only visible while preview tools are enabled (see PreviewToolsHead.astro) and
// never inside framed thumbnails. ?theme=light|semi-light|semi-dark|dark
// selects a theme for direct links.
---
<div class="embed-preview-toolbar" role="group" aria-label="Preview theme" hidden>
  <span class="embed-preview-toolbar__label">Theme</span>
  <button type="button" data-embed-preview-theme="light" aria-pressed="false">Light</button>
  <button type="button" data-embed-preview-theme="semi-light" aria-pressed="false">Semi-light</button>
  <button type="button" data-embed-preview-theme="semi-dark" aria-pressed="false">Semi-dark</button>
  <button type="button" data-embed-preview-theme="dark" aria-pressed="false">Dark</button>
</div>
<script>
  type PreviewTheme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
  const themes: PreviewTheme[] = ['light', 'semi-light', 'semi-dark', 'dark']
  const isTheme = (value: unknown): value is PreviewTheme => themes.includes(value as PreviewTheme)

  const toolbar = document.querySelector<HTMLElement>('.embed-preview-toolbar')
  const sections = document.querySelectorAll<HTMLElement>('[data-kinekt-section]')
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-embed-preview-theme]')

  function setTheme(theme: PreviewTheme) {
    sections.forEach((section) => { section.dataset.kinektTheme = theme })
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.embedPreviewTheme === theme)))
  }

  if (toolbar && sections.length > 0) {
    toolbar.hidden = false
    const requested = new URLSearchParams(location.search).get('theme')
    const initial = sections[0].dataset.kinektTheme
    setTheme(isTheme(requested) ? requested : isTheme(initial) ? initial : 'light')
    buttons.forEach((button) => button.addEventListener('click', () => {
      const theme = button.dataset.embedPreviewTheme
      if (isTheme(theme)) setTheme(theme)
    }))
  }
</script>
<style is:global>
  :root:not([data-catalogue-tools]) .embed-preview-toolbar, :root[data-catalogue-framed] .embed-preview-toolbar { display: none; }
  .embed-preview-toolbar { position: fixed; left: 1rem; bottom: 1rem; z-index: 1000; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; max-width: calc(100% - 2rem); padding: 0.25rem 0.25rem 0.25rem 0.75rem; border: 1px solid #d4d4d4; border-radius: 999px; color: #111; background: #fff; box-shadow: 0 4px 16px rgb(0 0 0 / 0.15); font: 500 0.8125rem/1.2 system-ui, sans-serif; }
  .embed-preview-toolbar[hidden] { display: none; }
  .embed-preview-toolbar__label { margin-right: 0.25rem; }
  .embed-preview-toolbar button { min-height: 2rem; padding: 0.25rem 0.75rem; border: 0; border-radius: 999px; color: inherit; background: transparent; font: inherit; cursor: pointer; }
  .embed-preview-toolbar button[aria-pressed='true'] { color: #fff; background: #111; }
  .embed-preview-toolbar button:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
  @media (max-width: 40rem) { .embed-preview-toolbar { bottom: 4.5rem; border-radius: 1rem; } }
</style>
