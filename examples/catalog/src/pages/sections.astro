---
import components from '../generated/components.json'

const previewModules = import.meta.glob('@package-src/**/*.preview.astro', { eager: true })
const sections = components
  .filter((component) => component.category === 'sections' && component.previewSource)
  .map((component) => {
    const previewSource = component.previewSource
    if (!previewSource) throw new Error(`No preview source configured for ${component.id}.`)
    const module = Object.entries(previewModules).find(([path]) => path.endsWith(previewSource))?.[1]
    if (!module) throw new Error(`No preview module found for ${component.id}.`)
    return { component, Preview: (module as { default: any }).default, reviewStatus: component.status === 'planned' ? 'beta' : component.status }
  })
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Rendered structural preview of every Kinekt section." />
    <title>All sections · Kinekt components</title>
  </head>
  <body>
    <header class="masthead">
      <a href={import.meta.env.BASE_URL}>← Component catalogue</a>
      <p>Wireframe section previews</p>
      <h1>All sections</h1>
      <p>{sections.length} reusable section contracts rendered in catalogue order.</p>
    </header>
    <main>
      {sections.map(({ component, Preview, reviewStatus }) => (
        <article class="section-preview" id={component.slug}>
          <header class="section-preview__meta">
            <p>{reviewStatus} / {component.slug}</p>
            <h2>{component.title}</h2>
            <ul class="section-preview__tags" aria-label={`${component.title} tags`}>
              {component.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="section-preview__tools">
              <div class="theme-switch" aria-label={`Preview theme for ${component.title}`}>
                <button type="button" data-kinekt-preview-theme="light" aria-pressed="true">Light</button>
                <button type="button" data-kinekt-preview-theme="semi-light" aria-pressed="false">Semi-light</button>
                <button type="button" data-kinekt-preview-theme="semi-dark" aria-pressed="false">Semi-dark</button>
                <button type="button" data-kinekt-preview-theme="dark" aria-pressed="false">Dark</button>
              </div>
              <a href={`${catalogueBase}components/${component.id}/`}>Open isolated preview →</a>
            </div>
          </header>
          <Preview />
        </article>
      ))}
    </main>
    <script>
      type PreviewTheme = 'light' | 'semi-light' | 'semi-dark' | 'dark'

      function setPreviewTheme(preview: HTMLElement, theme: PreviewTheme) {
        const section = preview.querySelector<HTMLElement>('[data-kinekt-section]')
        if (!section) return
        section.dataset.kinektTheme = theme
        preview.querySelectorAll<HTMLButtonElement>('[data-kinekt-preview-theme]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.kinektPreviewTheme === theme))
        })
      }

      document.querySelectorAll<HTMLElement>('.section-preview').forEach((preview) => {
        const theme = preview.querySelector<HTMLElement>('[data-kinekt-section]')?.dataset.kinektTheme
        setPreviewTheme(preview, theme === 'semi-light' || theme === 'dark' || theme === 'semi-dark' ? theme : 'light')
      })

      document.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-kinekt-preview-theme]')
        const preview = button?.closest<HTMLElement>('.section-preview')
        const theme = button?.dataset.kinektPreviewTheme
        if (!preview || (theme !== 'light' && theme !== 'semi-light' && theme !== 'semi-dark' && theme !== 'dark')) return
        setPreviewTheme(preview, theme)
      })
    </script>
  </body>
</html>

<style>
  :root { color: #111; background: #f1f1f1; font-family: system-ui, sans-serif; }
  body { margin: 0; }
  .masthead { padding: clamp(2rem, 6vw, 5rem); color: #fff; background: #111; }
  .masthead a { color: inherit; font-weight: 700; text-underline-offset: 0.18em; }
  .masthead p { max-width: 44rem; color: #d2d2d2; line-height: 1.5; }
  .masthead h1 { margin: 1.25rem 0 0.75rem; font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 400; letter-spacing: -0.06em; text-wrap: balance; }
  main { display: grid; gap: 1px; background: #bdbdbd; }
  .section-preview { padding: clamp(1.5rem, 4vw, 3.5rem); background: #fff; }
  .section-preview__meta { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem 2rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #bdbdbd; }
  .section-preview__meta p { margin: 0; color: #5e5e5e; font: 600 0.75rem/1.2 ui-monospace, monospace; }
  .section-preview__meta h2 { flex-basis: 100%; order: -1; margin: 0; font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 400; letter-spacing: -0.05em; text-wrap: balance; }
  .section-preview__tags { display: flex; flex-basis: 100%; flex-wrap: wrap; gap: 0.5rem; order: -1; margin: 0; padding: 0; list-style: none; }
  .section-preview__tags li { padding: 0.3rem 0.5rem; border: 1px solid #bdbdbd; color: #4f4f4f; font: 700 0.6875rem/1 ui-monospace, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .section-preview__tools { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; }
  .theme-switch { display: flex; flex-wrap: wrap; padding: 0.1875rem; border: 1px solid #777; border-radius: 0; }
  .theme-switch button { min-height: 2rem; padding: 0.25rem 0.75rem; border: 0; border-radius: 0; color: #111; background: transparent; font: inherit; font-size: 0.8125rem; font-weight: 700; cursor: pointer; }
  .theme-switch button[aria-pressed='true'] { color: #fff; background: #111; }
  .theme-switch button:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
  .section-preview__meta a { color: inherit; font-weight: 700; text-underline-offset: 0.18em; }
</style>
