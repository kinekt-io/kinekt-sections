---
import PreviewToolsHead from '../components/PreviewToolsHead.astro'
import BrandSwitch from '../components/BrandSwitch.astro'
import '@package-src/styles/wireframe-tokens.css'
import components from '../generated/components.json'

const previewModules = import.meta.glob('@package-src/**/*.preview.astro', { eager: true })
const maturityTags = ['alpha', 'beta', 'prerelease', 'release'] as const
const sections = components
  .filter((component) => component.category === 'sections' && component.previewSource)
  .map((component) => {
    const previewSource = component.previewSource
    if (!previewSource) throw new Error(`No preview source configured for ${component.id}.`)
    const module = Object.entries(previewModules).find(([path]) => path.endsWith(previewSource))?.[1]
    if (!module) throw new Error(`No preview module found for ${component.id}.`)
    return { component, Preview: (module as { default: any }).default, reviewStatus: component.tags.find((tag) => maturityTags.includes(tag as typeof maturityTags[number])) ?? 'alpha' }
  })
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Rendered structural preview of every Kinekt section." />
    <title>All sections · Kinekt components</title>
    <PreviewToolsHead />
  </head>
  <body class="sections-page">
    <header class="masthead">
      <a href={import.meta.env.BASE_URL}>← Component catalogue</a>
      <p>Wireframe section previews</p>
      <h1>All sections</h1>
      <p>{sections.length} reusable section contracts rendered in catalogue order.</p>
    </header>
    <main>
      {sections.map(({ component, Preview, reviewStatus }) => (
        <article class="section-preview" id={component.slug}>
          <header class="section-preview__meta">
            <p>{reviewStatus} / {component.slug}</p>
            <h2>{component.title}</h2>
            <ul class="section-preview__tags" aria-label={`${component.title} tags`}>
              {component.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="section-preview__tools">
              <div class="theme-switch" aria-label={`Preview theme for ${component.title}`}>
                <button type="button" data-kinekt-preview-theme="light" aria-pressed="true">Light</button>
                <button type="button" data-kinekt-preview-theme="semi-light" aria-pressed="false">Semi-light</button>
                <button type="button" data-kinekt-preview-theme="semi-dark" aria-pressed="false">Semi-dark</button>
                <button type="button" data-kinekt-preview-theme="dark" aria-pressed="false">Dark</button>
              </div>
              <a href={`${catalogueBase}components/${component.id}/`}>Open isolated preview →</a>
            </div>
          </header>
          <Preview />
        </article>
      ))}
    </main>
    <script>
      type PreviewTheme = 'light' | 'semi-light' | 'semi-dark' | 'dark'

      function setPreviewTheme(preview: HTMLElement, theme: PreviewTheme) {
        const section = preview.querySelector<HTMLElement>('[data-kinekt-section]')
        if (!section) return
        section.dataset.kinektTheme = theme
        preview.querySelectorAll<HTMLButtonElement>('[data-kinekt-preview-theme]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.kinektPreviewTheme === theme))
        })
      }

      document.querySelectorAll<HTMLElement>('.section-preview').forEach((preview) => {
        const theme = preview.querySelector<HTMLElement>('[data-kinekt-section]')?.dataset.kinektTheme
        setPreviewTheme(preview, theme === 'semi-light' || theme === 'dark' || theme === 'semi-dark' ? theme : 'light')
      })

      document.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-kinekt-preview-theme]')
        const preview = button?.closest<HTMLElement>('.section-preview')
        const theme = button?.dataset.kinektPreviewTheme
        if (!preview || (theme !== 'light' && theme !== 'semi-light' && theme !== 'semi-dark' && theme !== 'dark')) return
        setPreviewTheme(preview, theme)
      })
    </script>
    <BrandSwitch />
  </body>
</html>

<style is:global>
  :where(.sections-page) {
    --kiw--sections-ink: var(--base); --kiw--sections-canvas: var(--white); --kiw--sections-surface: var(--neutral-light); --kiw--sections-dark: var(--primary-ultra-dark); --kiw--sections-dark-muted: var(--primary-ultra-light); --kiw--sections-muted: var(--primary-semi-light); --kiw--sections-line: var(--neutral-semi-dark); --kiw--sections-action: var(--primary); --kiw--sections-focus: var(--accent); --kiw--sections-text-font: var(--text-font-family); --kiw--sections-heading-font: var(--heading-font-family); --kiw--sections-mono-font: var(--mono-font-family); --kiw--sections-text-weight: var(--text-font-weight); --kiw--sections-heading-weight: var(--heading-font-weight); --kiw--sections-text-tracking: var(--text-letter-spacing); --kiw--sections-heading-tracking: var(--heading-letter-spacing); --kiw--sections-text-line-height: var(--text-line-height); --kiw--sections-heading-line-height: var(--heading-line-height); --kiw--sections-text-xs: var(--text-xs); --kiw--sections-text-s: var(--text-s); --kiw--sections-h1: var(--h1); --kiw--sections-h2: var(--h2); --kiw--sections-gutter: var(--section-gutter); --kiw--sections-space-xxxs: var(--space-xxxs); --kiw--sections-space-xs: var(--space-xs); --kiw--sections-space-s: var(--space-s); --kiw--sections-space-m: var(--space-m); --kiw--sections-space-l: var(--space-l); --kiw--sections-space-xl: var(--space-xl); --kiw--sections-section-space-xs: var(--section-space-xs); --kiw--sections-section-space-l: var(--section-space-l); --kiw--sections-border: var(--border-width); --kiw--sections-radius: var(--radius-s); --kiw--sections-theme-button-radius: var(--buttons-radius); --kiw--sections-theme-button-radius-switch: var(--buttons-has-radius);
  }
  .sections-page { margin: 0; color: var(--kiw--sections-ink); background: var(--kiw--sections-surface); font-family: var(--kiw--sections-text-font); font-weight: var(--kiw--sections-text-weight); letter-spacing: var(--kiw--sections-text-tracking); }
  .sections-page body { margin: 0; }
  .sections-page .masthead { padding: var(--kiw--sections-section-space-l) var(--kiw--sections-gutter); color: var(--kiw--sections-canvas); background: var(--kiw--sections-dark); }
  .sections-page .masthead a { color: inherit; font-weight: var(--kiw--sections-heading-weight); text-underline-offset: 0.18em; }
  .sections-page .masthead p { max-width: 44rem; color: var(--kiw--sections-dark-muted); line-height: var(--kiw--sections-text-line-height); }
  .sections-page .masthead h1 { margin: var(--kiw--sections-space-l) 0 var(--kiw--sections-space-s); font-family: var(--kiw--sections-heading-font); font-size: var(--kiw--sections-h1); font-weight: var(--kiw--sections-heading-weight); letter-spacing: var(--kiw--sections-heading-tracking); line-height: var(--kiw--sections-heading-line-height); text-wrap: balance; }
  .sections-page main { display: grid; gap: var(--kiw--sections-border); background: var(--kiw--sections-line); }
  .sections-page .section-preview { padding: var(--kiw--sections-section-space-xs) var(--kiw--sections-gutter); background: var(--kiw--sections-canvas); }
  .sections-page .section-preview__meta { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--kiw--sections-space-s) var(--kiw--sections-space-xl); margin-bottom: var(--kiw--sections-space-xl); padding-bottom: var(--kiw--sections-space-m); border-bottom: var(--kiw--sections-border) solid var(--kiw--sections-line); }
  .sections-page .section-preview__meta p { margin: 0; color: var(--kiw--sections-muted); font-family: var(--kiw--sections-mono-font); font-size: var(--kiw--sections-text-xs); font-weight: var(--kiw--sections-heading-weight); line-height: var(--kiw--sections-text-line-height); }
  .sections-page .section-preview__meta h2 { flex-basis: 100%; order: -1; margin: 0; font-family: var(--kiw--sections-heading-font); font-size: var(--kiw--sections-h2); font-weight: var(--kiw--sections-heading-weight); letter-spacing: var(--kiw--sections-heading-tracking); line-height: var(--kiw--sections-heading-line-height); text-wrap: balance; }
  .sections-page .section-preview__tags { display: flex; flex-basis: 100%; flex-wrap: wrap; gap: var(--kiw--sections-space-xxxs); order: -1; margin: 0; padding: 0; list-style: none; }
  .sections-page .section-preview__tags li { padding: var(--kiw--sections-space-xxxs) var(--kiw--sections-space-xs); border: var(--kiw--sections-border) solid var(--kiw--sections-line); border-radius: var(--kiw--sections-radius); color: var(--kiw--sections-action); font-family: var(--kiw--sections-mono-font); font-size: var(--kiw--sections-text-xs); font-weight: var(--kiw--sections-heading-weight); letter-spacing: var(--kiw--sections-heading-tracking); text-transform: uppercase; }
  .sections-page .section-preview__tools { display: flex; align-items: center; flex-wrap: wrap; gap: var(--kiw--sections-space-s); }
  .sections-page .theme-switch { display: flex; flex-wrap: wrap; padding: var(--kiw--sections-space-xxxs); border: var(--kiw--sections-border) solid var(--kiw--sections-muted); border-radius: var(--kiw--sections-radius); }
  .sections-page .theme-switch button { min-height: 2rem; padding: var(--kiw--sections-space-xxxs) var(--kiw--sections-space-s); border: 0; border-radius: calc(var(--kiw--sections-theme-button-radius-switch) * var(--kiw--sections-theme-button-radius)); color: var(--kiw--sections-ink); background: transparent; font: inherit; font-size: var(--kiw--sections-text-s); font-weight: var(--kiw--sections-heading-weight); cursor: pointer; }
  .sections-page .theme-switch button[aria-pressed='true'] { color: var(--kiw--sections-canvas); background: var(--kiw--sections-action); }
  .sections-page .theme-switch button:focus-visible { outline: var(--kiw--sections-border) solid var(--kiw--sections-focus); outline-offset: var(--kiw--sections-space-xxxs); }
  .sections-page .section-preview__meta a { color: inherit; font-weight: var(--kiw--sections-heading-weight); text-underline-offset: 0.18em; }
</style>
