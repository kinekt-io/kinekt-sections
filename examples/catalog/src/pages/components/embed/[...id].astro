---
import PreviewToolsHead from '../../../components/PreviewToolsHead.astro'
import '@package-src/styles/wireframe-tokens.css'
import components from '../../../generated/components.json'


const previewModules = import.meta.glob('@package-src/**/*.preview.astro', { eager: true })

export function getStaticPaths() {
  return components
    .filter((component) => component.previewSource)
    .map((component) => ({ params: { id: component.id }, props: { component } }))
}

const { component } = Astro.props
const previewModule = Object.entries(previewModules).find(([path]) => path.endsWith(component.previewSource!))?.[1]
if (!previewModule) throw new Error(`No preview module found for ${component.id}.`)
const Preview = (previewModule as { default: any }).default
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{component.title} preview</title>
    <PreviewToolsHead />
  </head>
  <body class="component-embed-page">
    <Preview />
  </body>
</html>

<style is:global>
  :where(.component-embed-page) {
    --kiw--component-embed-canvas: var(--white);
    --kiw--component-embed-ink: var(--base);
    --kiw--component-embed-font: var(--text-font-family);
  }

  .component-embed-page { margin: 0; color: var(--kiw--component-embed-ink); background: var(--kiw--component-embed-canvas); font-family: var(--kiw--component-embed-font); }
</style>
