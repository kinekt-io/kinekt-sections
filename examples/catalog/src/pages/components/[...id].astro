---
import '@package-src/styles/wireframe-tokens.css'
import components from '../../generated/components.json'

const previewModules = import.meta.glob('@package-src/**/*.preview.astro', { eager: true })


export function getStaticPaths() {
  return components
    .filter((component) => component.previewSource)
    .map((component) => ({ params: { id: component.id }, props: { component } }))
}

const { component } = Astro.props
const previewModule = Object.entries(previewModules).find(([path]) => path.endsWith(component.previewSource!))?.[1]
if (!previewModule) throw new Error(`No preview module found for ${component.id}.`)
const Preview = (previewModule as { default: any }).default

const catalogueBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const previewFallbackAsset = `${catalogueBase}placeholders/hero-trinity-street.webp`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`Preview of ${component.title}.`} />
    <title>{component.title} · Kinekt components</title>
  </head>
  <body class="component-preview-page">
    <header class="bar">
      <a href={import.meta.env.BASE_URL}>← Component catalogue</a>
      <p>{component.category} / {component.role ?? 'component'} / {component.variation ?? component.title}</p>
    </header>
    <main data-pagefind-body>
      <div class="intro">
        <p>Live wireframe preview</p>
        <h1>{component.title}</h1>
        <span>Representative content from <code>src/{component.previewSource}</code></span>
        <ul class="component-tags" aria-label="Component tags">
          {component.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <div class="pagefind-tags" aria-hidden="true">{component.tags.map((tag) => <span data-pagefind-filter="category">{tag}</span>)}</div>
      {component.category === 'sections' && (
        <aside class="preview-options" aria-label="Preview options">
          <p>Inspect options</p>
          <fieldset>
            <legend>Theme</legend>
            <label><input type="radio" name="theme" value="light" checked /> Light</label>
            <label><input type="radio" name="theme" value="semi-light" /> Semi-light</label>
            <label><input type="radio" name="theme" value="semi-dark" /> Semi-dark</label>
            <label><input type="radio" name="theme" value="dark" /> Dark</label>
          </fieldset>
          <fieldset data-kinekt-intro-heading-options hidden>
            <legend>First intro heading</legend>
            <label><input type="radio" name="intro-heading-level" value="h1" /> H1</label>
            <label><input type="radio" name="intro-heading-level" value="h2" checked /> H2</label>
            <label><input type="radio" name="intro-heading-level" value="h3" /> H3</label>
            <label><input type="radio" name="intro-heading-level" value="h4" /> H4</label>
          </fieldset>
          {component.id === 'sections/hero/allentown' && (
            <>
              <fieldset>
                <legend>Call-to-action buttons</legend>
                <label><input type="checkbox" name="hero-primary-cta" checked /> Primary</label>
                <label><input type="checkbox" name="hero-secondary-cta" checked /> Clear</label>
              </fieldset>
              <fieldset>
                <legend>Call-to-action icons</legend>
                <label><input type="checkbox" name="hero-primary-icon" checked /> Primary icon</label>
                <label><input type="checkbox" name="hero-secondary-icon" checked /> Clear icon</label>
              </fieldset>
            </>
          )}
          {component.id === 'sections/case-studies/allentown' && (
            <>
              <fieldset>
                <legend>Case study display</legend>
                <label><input type="radio" name="case-study-display" value="carousel" checked /> Carousel</label>
                <label><input type="radio" name="case-study-display" value="single" /> One static case</label>
              </fieldset>
              <fieldset>
                <legend>Carousel controls</legend>
                <label><input type="radio" name="carousel-controls" value="previous-next" checked /> Previous + next</label>
                <label><input type="radio" name="carousel-controls" value="next" /> Next only</label>
              </fieldset>
              <fieldset>
                <legend>Pagination controls</legend>
                <label><input type="radio" name="carousel-control-style" value="icon" checked /> Icons</label>
                <label><input type="radio" name="carousel-control-style" value="text" /> Text</label>
              </fieldset>
              <fieldset>
                <legend>Carousel label</legend>
                <label><input type="checkbox" name="carousel-label" checked /> Show label and line</label>
              </fieldset>
              <fieldset>
                <legend>Carousel behaviour</legend>
                <label><input type="checkbox" name="carousel-loop" /> Loop infinitely</label>
              </fieldset>
              <fieldset>
                <legend>Call-to-action icons</legend>
                <label><input type="checkbox" name="case-action-icon" /> Header action</label>
                <label><input type="checkbox" name="slide-action-icons" /> Slide action</label>
              </fieldset>
            </>
          )}
          {component.id === 'sections/process-story/trinity' && (
            <fieldset>
              <legend>Step marker</legend>
              <label><input type="radio" name="process-story-marker" value="number" checked /> Numbers</label>
              <label><input type="radio" name="process-story-marker" value="icon" /> Icons</label>
            </fieldset>
          )}
          {component.id === 'sections/form-section/allentown' && (
            <>
              <fieldset>
                <legend>Formuliergrootte</legend>
                <label><input type="radio" name="form-section-variation" value="compact" checked /> Compact e-mailveld</label>
                <label><input type="radio" name="form-section-variation" value="expanded" /> Uitgebreid formulier</label>
              </fieldset>
              <fieldset>
                <legend>Media-positie</legend>
                <label><input type="radio" name="form-section-image-position" value="left" checked /> Links</label>
                <label><input type="radio" name="form-section-image-position" value="right" /> Rechts</label>
              </fieldset>
            </>
          )}
        </aside>
      )}
      <div data-kinekt-preview-surface><Preview /></div>
    </main>
    <script define:vars={{ previewFallbackAsset }}>
      const replaceExternalPreviewMedia = (root = document) => {
        root.querySelectorAll('source[srcset*="placehold.co"]').forEach((source) => source.remove())

        root.querySelectorAll('img[src*="placehold.co"]').forEach((image) => {
          image.setAttribute('src', previewFallbackAsset)
          image.removeAttribute('srcset')
        })
      }

      replaceExternalPreviewMedia()

      new MutationObserver((records) => {
        for (const record of records) {
          for (const node of record.addedNodes) {
            if (node instanceof Element) replaceExternalPreviewMedia(node)
          }
        }
      }).observe(document.body, { childList: true, subtree: true })
    </script>
    <script>
      import { initializeKinektInteractions } from '../../../../../src/shared/interactions'

      const surface = document.querySelector<HTMLElement>('[data-kinekt-preview-surface]')
      const initialProcessStoryMarker = document.querySelector<HTMLInputElement>('.preview-options input[name="process-story-marker"]:checked')
      const processStory = surface?.querySelector<HTMLElement>('.process-story-trinity')
      if (initialProcessStoryMarker && processStory) processStory.dataset.processStoryMarker = initialProcessStoryMarker.value
      const initialTheme = surface?.querySelector<HTMLElement>('[data-kinekt-section]')?.dataset.kinektTheme
      const initialThemeControl = Array.from(document.querySelectorAll<HTMLInputElement>('.preview-options input[name="theme"]'))
        .find((input) => input.value === initialTheme)
      if (initialThemeControl) initialThemeControl.checked = true
      const initialIntroHeading = surface?.querySelector<HTMLHeadingElement>(':is(.section-intro__heading, [data-kinekt-intro-heading])')
      const introHeadingOptions = document.querySelector<HTMLFieldSetElement>('[data-kinekt-intro-heading-options]')
      if (initialIntroHeading && introHeadingOptions) {
        introHeadingOptions.hidden = false
        const initialHeadingControl = Array.from(document.querySelectorAll<HTMLInputElement>('.preview-options input[name="intro-heading-level"]'))
          .find((input) => input.value === initialIntroHeading.tagName.toLowerCase())
        if (initialHeadingControl) initialHeadingControl.checked = true
      }
      function setIntroHeadingLevel(level: 'h1' | 'h2' | 'h3' | 'h4') {
        const heading = surface?.querySelector<HTMLHeadingElement>(':is(.section-intro__heading, [data-kinekt-intro-heading])')
        if (!heading || heading.tagName.toLowerCase() === level) return
        const replacement = document.createElement(level)
        for (const attribute of heading.attributes) replacement.setAttribute(attribute.name, attribute.value)
        replacement.replaceChildren(...Array.from(heading.childNodes))
        heading.replaceWith(replacement)
      }
      function toggleCtaIcons(links: NodeListOf<HTMLAnchorElement>, visible: boolean) {
        links.forEach((link) => {
          const icon = link.querySelector('[data-kinekt-cta-icon]')
          if (visible && !icon) {
            const nextIcon = document.createElement('span')
            nextIcon.setAttribute('data-kinekt-cta-icon', '')
            nextIcon.setAttribute('aria-hidden', 'true')
            nextIcon.textContent = '→'
            link.append(nextIcon)
          }
          if (!visible) icon?.remove()
        })
      }
      function setCaseStudyDisplay(display: 'carousel' | 'single') {
        const carousel = surface?.querySelector<HTMLElement>('.case-studies-allentown__carousel')
        if (!carousel) return
        const isSingle = display === 'single'
        carousel.dataset.kinektCarouselStatic = String(isSingle)
        carousel.querySelectorAll<HTMLElement>('[data-kinekt-carousel-slide]').forEach((slide, index) => {
          slide.hidden = isSingle && index > 0
        })
        carousel.querySelector<HTMLElement>('[data-kinekt-carousel-pagination]')?.toggleAttribute('hidden', isSingle)
        if (isSingle) {
          carousel.dispatchEvent(new CustomEvent('kinekt:carousel-reinitialize'))
          carousel.removeAttribute('data-kinekt-carousel')
          return
        }
        carousel.setAttribute('data-kinekt-carousel', '')
        initializeKinektInteractions(carousel.parentElement ?? document)
      }

      document.querySelectorAll<HTMLInputElement>('.preview-options input').forEach((input) => {
        input.addEventListener('change', () => {
          if (!surface || (input.type === 'radio' && !input.checked)) return
          if (input.name === 'theme') {
            const section = surface.querySelector<HTMLElement>('[data-kinekt-section]')
            if (section) section.dataset.kinektTheme = input.value
          }
          if (input.name === 'intro-heading-level' && (input.value === 'h1' || input.value === 'h2' || input.value === 'h3' || input.value === 'h4')) {
            setIntroHeadingLevel(input.value)
          }
          if (input.name === 'process-story-marker' && (input.value === 'number' || input.value === 'icon')) {
            const processStory = surface.querySelector<HTMLElement>('.process-story-trinity')
            if (processStory) processStory.dataset.processStoryMarker = input.value
          }
          if (input.name === 'form-section-variation' && (input.value === 'compact' || input.value === 'expanded')) {
            const formSection = surface.querySelector<HTMLElement>('.form-section-allentown')
            if (formSection) formSection.dataset.formVariation = input.value
          }
          if (input.name === 'form-section-image-position' && (input.value === 'left' || input.value === 'right')) {
            const formSection = surface.querySelector<HTMLElement>('.form-section-allentown')
            if (formSection) formSection.dataset.imagePosition = input.value
          }
          if (input.name === 'hero-primary-cta' || input.name === 'hero-secondary-cta') {
            const action = surface.querySelector<HTMLElement>(input.name === 'hero-primary-cta' ? '.hero-allentown__action--primary' : '.hero-allentown__action--secondary')
            if (action) action.hidden = !input.checked
            const actions = surface.querySelector<HTMLElement>('.hero-allentown__actions')
            if (actions) actions.hidden = !Array.from(actions.children).some((child) => !((child as HTMLElement).hidden))
          }
          if (input.name === 'hero-primary-icon' || input.name === 'hero-secondary-icon') {
            const action = surface.querySelector<HTMLElement>(input.name === 'hero-primary-icon' ? '.hero-allentown__action--primary' : '.hero-allentown__action--secondary')
            action?.querySelector<HTMLElement>('[data-kinekt-hero-cta-icon]')?.toggleAttribute('hidden', !input.checked)
          }
          if (input.name === 'case-study-display' && (input.value === 'carousel' || input.value === 'single')) {
            setCaseStudyDisplay(input.value)
          }
          if (input.name === 'carousel-controls') {
            const carousel = surface.querySelector<HTMLElement>('[data-kinekt-carousel]')
            if (carousel) carousel.dataset.kinektCarouselControls = input.value
          }
          if (input.name === 'carousel-control-style') {
            const carousel = surface.querySelector<HTMLElement>('[data-kinekt-carousel]')
            if (carousel) carousel.dataset.kinektCarouselControlStyle = input.value
          }
          if (input.name === 'carousel-label') {
            const label = surface.querySelector<HTMLElement>('[data-kinekt-carousel-label]')
            if (label) label.hidden = !input.checked
          }
          if (input.name === 'carousel-loop') {
            const carousel = surface.querySelector<HTMLElement>('[data-kinekt-carousel]')
            if (carousel) {
              carousel.dataset.kinektCarouselLoop = String(input.checked)
              carousel.dispatchEvent(new CustomEvent('kinekt:carousel-reinitialize'))
            }
          }
          if (input.name === 'case-action-icon') {
            const headerAction = surface.querySelector<HTMLElement>('.case-studies-allentown__header > .case-studies-allentown__cta')
            if (headerAction) toggleCtaIcons(headerAction.querySelectorAll<HTMLAnchorElement>('a'), input.checked)
          }
          if (input.name === 'slide-action-icons') {
            toggleCtaIcons(surface.querySelectorAll<HTMLAnchorElement>('[data-kinekt-carousel-slide] a[class*="__cta"]'), input.checked)
          }
        })
      })
    </script>
  </body>
</html>

<style is:global>
  :where(.component-preview-page) {
    --kiw--component-preview-ink: var(--base); --kiw--component-preview-canvas: var(--white); --kiw--component-preview-muted: var(--primary-semi-light); --kiw--component-preview-line: var(--neutral-semi-dark); --kiw--component-preview-action: var(--primary); --kiw--component-preview-accent: var(--accent); --kiw--component-preview-text-font: var(--text-font-family); --kiw--component-preview-heading-font: var(--heading-font-family); --kiw--component-preview-mono-font: var(--mono-font-family); --kiw--component-preview-text-weight: var(--text-font-weight); --kiw--component-preview-heading-weight: var(--heading-font-weight); --kiw--component-preview-text-tracking: var(--text-letter-spacing); --kiw--component-preview-heading-tracking: var(--heading-letter-spacing); --kiw--component-preview-text-line-height: var(--text-line-height); --kiw--component-preview-heading-line-height: var(--heading-line-height); --kiw--component-preview-text-xs: var(--text-xs); --kiw--component-preview-text-s: var(--text-s); --kiw--component-preview-h1: var(--h1); --kiw--component-preview-gutter: var(--section-gutter); --kiw--component-preview-width: var(--content-width); --kiw--component-preview-space-xxxs: var(--space-xxxs); --kiw--component-preview-space-s: var(--space-s); --kiw--component-preview-space-m: var(--space-m); --kiw--component-preview-space-xl: var(--space-xl); --kiw--component-preview-section-space: var(--section-space-xs); --kiw--component-preview-border: var(--border-width); --kiw--component-preview-radius-s: var(--radius-s); --kiw--component-preview-radius-m: var(--radius-m);
  }
  .component-preview-page { margin: 0; color: var(--kiw--component-preview-ink); background: var(--kiw--component-preview-canvas); font-family: var(--kiw--component-preview-text-font); font-weight: var(--kiw--component-preview-text-weight); letter-spacing: var(--kiw--component-preview-text-tracking); }
  .component-preview-page body { margin: 0; }
  .component-preview-page code { font-family: var(--kiw--component-preview-mono-font); font-size: 0.875em; }
  .component-preview-page .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--kiw--component-preview-space-m); padding: var(--kiw--component-preview-space-m) var(--kiw--component-preview-gutter); border-bottom: var(--kiw--component-preview-border) solid var(--kiw--component-preview-line); }
  .component-preview-page .bar a { color: inherit; font-weight: var(--kiw--component-preview-heading-weight); text-decoration-thickness: var(--kiw--component-preview-border); text-underline-offset: 0.18em; }
  .component-preview-page .bar p, .component-preview-page .intro p, .component-preview-page .preview-options > p { margin: 0; color: var(--kiw--component-preview-muted); font-family: var(--kiw--component-preview-mono-font); font-size: var(--kiw--component-preview-text-xs); font-weight: var(--kiw--component-preview-heading-weight); line-height: var(--kiw--component-preview-text-line-height); letter-spacing: var(--kiw--component-preview-heading-tracking); text-transform: uppercase; }
  .component-preview-page .intro { width: min(calc(100% - (var(--kiw--component-preview-gutter) * 2)), var(--kiw--component-preview-width)); margin: 0 auto; padding: var(--kiw--component-preview-section-space) 0 var(--kiw--component-preview-space-xl); }
  .component-preview-page .intro p { margin-bottom: var(--kiw--component-preview-space-s); }
  .component-preview-page .intro h1 { margin: 0 0 var(--kiw--component-preview-space-s); font-family: var(--kiw--component-preview-heading-font); font-size: var(--kiw--component-preview-h1); font-weight: var(--kiw--component-preview-heading-weight); letter-spacing: var(--kiw--component-preview-heading-tracking); line-height: var(--kiw--component-preview-heading-line-height); text-wrap: balance; }
  .component-preview-page .intro span { color: var(--kiw--component-preview-muted); }
  .component-preview-page .component-tags { display: flex; flex-wrap: wrap; gap: var(--kiw--component-preview-space-xxxs); margin: var(--kiw--component-preview-space-s) 0 0; padding: 0; list-style: none; }
  .component-preview-page .component-tags li { padding: var(--kiw--component-preview-space-xxxs) var(--kiw--component-preview-space-s); border: var(--kiw--component-preview-border) solid var(--kiw--component-preview-line); border-radius: var(--kiw--component-preview-radius-s); color: var(--kiw--component-preview-action); font-family: var(--kiw--component-preview-mono-font); font-size: var(--kiw--component-preview-text-xs); font-weight: var(--kiw--component-preview-heading-weight); letter-spacing: var(--kiw--component-preview-heading-tracking); text-transform: uppercase; }
  .component-preview-page .pagefind-tags { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .component-preview-page .preview-options { box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: start; gap: var(--kiw--component-preview-space-m) var(--kiw--component-preview-space-xl); width: min(calc(100% - (var(--kiw--component-preview-gutter) * 2)), var(--kiw--component-preview-width)); margin: 0 auto var(--kiw--component-preview-space-xl); padding: var(--kiw--component-preview-space-m); border: var(--kiw--component-preview-border) solid var(--kiw--component-preview-line); border-radius: var(--kiw--component-preview-radius-m); accent-color: var(--kiw--component-preview-accent); }
  .component-preview-page .preview-options fieldset { display: flex; flex-wrap: wrap; gap: var(--kiw--component-preview-space-xxxs) var(--kiw--component-preview-space-m); min-width: 0; margin: 0; padding: 0; border: 0; }
  .component-preview-page .preview-options legend { width: 100%; margin-bottom: var(--kiw--component-preview-space-xxxs); font-size: var(--kiw--component-preview-text-s); font-weight: var(--kiw--component-preview-heading-weight); }
  .component-preview-page .preview-options label { display: inline-flex; align-items: center; gap: var(--kiw--component-preview-space-xxxs); font-size: var(--kiw--component-preview-text-s); }
  .component-preview-page .preview-options [data-kinekt-cta-icon] { margin-inline-start: 0.8ch; }
  @media (max-width: 40rem) { .component-preview-page .bar { align-items: start; flex-direction: column; } }
</style>
