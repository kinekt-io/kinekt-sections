---
import PreviewToolsHead from '../components/PreviewToolsHead.astro'
import BrandSwitch from '../components/BrandSwitch.astro'
import '@package-src/styles/wireframe-tokens.css'
import components from '../generated/components.json'

const repositoryUrl = 'https://github.com/kinekt-io/kinekt-sections'
const tags = [...new Set(['alpha', 'beta', 'prerelease', 'release', ...components.flatMap((component) => component.tags)])].sort()
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const roles = new Set(components.map((component) => component.role).filter(Boolean))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Private Kinekt component package catalogue." />
    <title>Kinekt components</title>
    <PreviewToolsHead />
  </head>
  <body class="catalogue-page">
    <main>
      <header class="masthead">
        <div class="masthead__inner">
          <p class="masthead__label">Wireframe system</p>
          <h1>Kinekt sections</h1>
          <p class="masthead__intro">Inspect reusable Astro and Payload contracts in a neutral, site-overridable wireframe.</p>
          <dl class="stats" aria-label="Catalogue summary">
            <div><dt>Components</dt><dd>{components.length}</dd></div>
            <div><dt>Roles</dt><dd>{roles.size}</dd></div>
            <div><dt>Package</dt><dd><code>@kinekt-io/components</code></dd></div>
          </dl>
          <p><a href="sections/">View all rendered sections <span aria-hidden="true">→</span></a></p>
        </div>
      </header>

      <section class="catalogue" aria-labelledby="catalogue-title">
        <div class="catalogue__inner">
          <div class="catalogue__heading">
            <div>
              <p class="catalogue__label">Component inventory</p>
              <h2 id="catalogue-title">Browse the system</h2>
            </div>
            <a href={repositoryUrl}>View source on GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <form class="catalogue-search" role="search" data-catalogue-search>
            <label>Search components <input type="search" name="query" autocomplete="off" data-catalogue-search-query /></label>
            <label>Tag <select name="category" data-catalogue-category><option value="">All tags</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></label>
            <button type="submit">Search</button>
          </form>
          <p class="catalogue-search__status" data-catalogue-search-status aria-live="polite"></p>

          <ul class="components">
            {components.map((component) => (
              <li class:list={['component', { 'component--preview': Boolean(component.previewSource) }]} data-catalogue-component data-catalogue-id={component.id} data-tags={component.tags.join(' ')} data-search={[component.title, component.description, component.category, component.role, component.variation, component.id, ...component.tags].filter(Boolean).join(' ').toLowerCase()}>
                <div class="component__summary">
                  <div>
                    <p class="component__category">{component.category} / {component.role ?? 'component'}</p>
                    <p class="component__title">{component.title}</p>
                  </div>
                  <div class="component__controls">
                    {component.previewSource && (
                      <div class="theme-switch" aria-label={`Preview theme for ${component.title}`}>
                        <button type="button" data-catalogue-theme="light" aria-pressed="true">Light</button>
                        <button type="button" data-catalogue-theme="semi-light" aria-pressed="false">Semi-light</button>
                        <button type="button" data-catalogue-theme="semi-dark" aria-pressed="false">Semi-dark</button>
                        <button type="button" data-catalogue-theme="dark" aria-pressed="false">Dark</button>
                      </div>
                    )}
                    <button class="component__info" type="button" data-catalogue-info={component.slug} aria-label={`More information about ${component.title}`}>i</button>
                    {component.previewSource && <a class="component__action" href={`${catalogueBase}components/${component.id}/`}>Open preview <span aria-hidden="true">→</span></a>}
                  </div>
                </div>
                <dialog class="component__dialog" id={`component-${component.slug}`} aria-label={`${component.title} details`}>
                  <div class="component__dialog-content">
                    <div>
                      <p class="component__category">{component.category} / {component.role ?? 'component'}</p>
                      <p class="component__title">{component.title}</p>
                    </div>
                    <button class="component__dialog-close" type="button" data-catalogue-close aria-label="Close details">×</button>
                    <p>{component.description}</p>
                    <dl class="component__meta">
                      <div><dt>Variation</dt><dd>{component.variation ?? '—'}</dd></div>
                      <div><dt>Folder</dt><dd><code>src/{component.id}</code></dd></div>
                    </dl>
                    {component.tags.length > 0 && <p class="component__tags">{component.tags.join(' · ')}</p>}
                    <ul class="component__imports" aria-label="Public imports">
                      {Object.entries(component.entries).map(([kind, entrypoint]) => <li><span>{kind}</span><code>{entrypoint}</code></li>)}
                    </ul>
                    {component.figmaUrl && <a class="component__action" href={component.figmaUrl} target="_blank" rel="noreferrer">Open design frame <span aria-hidden="true">↗</span></a>}
                  </div>
                </dialog>
                {component.previewSource && (
                  <div class="component__thumbnail">
                    <iframe
                      title={`Scaled preview of ${component.title}`}
                      src={`${catalogueBase}components/embed/${component.id}/`}
                      loading="lazy"
                      tabindex="-1"
                    ></iframe>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
    <script>
      type PagefindData = { url: string; meta?: Record<string, string> }
      type PagefindResult = { data: () => Promise<PagefindData> }
      type PagefindModule = { init: () => Promise<void> | void; search: (query: string, options?: { filters?: { category: string } }) => Promise<{ results: PagefindResult[] }> }

      const form = document.querySelector<HTMLFormElement>('[data-catalogue-search]')
      const query = document.querySelector<HTMLInputElement>('[data-catalogue-search-query]')
      const category = document.querySelector<HTMLSelectElement>('[data-catalogue-category]')
      const status = document.querySelector<HTMLElement>('[data-catalogue-search-status]')
      const cards = [...document.querySelectorAll<HTMLElement>('[data-catalogue-component]')]
      let pagefind: Promise<PagefindModule> | undefined
      let pagefindSearchGeneration = 0

      type PreviewTheme = 'light' | 'semi-light' | 'semi-dark' | 'dark'
      const isPreviewTheme = (value: string | undefined): value is PreviewTheme =>
        value === 'light' || value === 'semi-light' || value === 'semi-dark' || value === 'dark'
      const applyTheme = (card: HTMLElement, theme: PreviewTheme) => {
        card.querySelectorAll<HTMLButtonElement>('[data-catalogue-theme]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.catalogueTheme === theme))
        })
        const frame = card.querySelector<HTMLIFrameElement>('iframe')
        const applyToFrame = () => frame?.contentDocument?.querySelector<HTMLElement>('[data-kinekt-section]')?.setAttribute('data-kinekt-theme', theme)
        applyToFrame()
        frame?.addEventListener('load', applyToFrame, { once: true })
      }

      document.addEventListener('click', (event) => {
        const target = event.target as Element
        const themeButton = target.closest<HTMLButtonElement>('[data-catalogue-theme]')
        const card = themeButton?.closest<HTMLElement>('[data-catalogue-component]')
        const theme = themeButton?.dataset.catalogueTheme
        if (card && isPreviewTheme(theme)) return applyTheme(card, theme)

        const info = target.closest<HTMLButtonElement>('[data-catalogue-info]')
        if (info) return (document.getElementById(`component-${info.dataset.catalogueInfo}`) as HTMLDialogElement | null)?.showModal()

        const close = target.closest<HTMLButtonElement>('[data-catalogue-close]')
        if (close) close.closest<HTMLDialogElement>('dialog')?.close()
      })

      cards.forEach((card) => {
        if (card.querySelector('iframe')) applyTheme(card, 'light')
      })

      function syncSearchUrl() {
        const url = new URL(window.location.href)
        const terms = query?.value.trim() ?? ''
        const selectedCategory = category?.value ?? ''
        if (terms) url.searchParams.set('q', terms)
        else url.searchParams.delete('q')
        if (selectedCategory) url.searchParams.set('category', selectedCategory)
        else url.searchParams.delete('category')
        window.history.replaceState(null, '', url)
      }

      function restoreSearchUrl() {
        const parameters = new URLSearchParams(window.location.search)
        if (query) query.value = parameters.get('q') ?? ''
        if (category) category.value = parameters.get('category') ?? ''
      }


      function filterCards() {
        pagefindSearchGeneration += 1
        const terms = query?.value.trim().toLowerCase() ?? ''
        const selectedCategory = category?.value ?? ''
        let matches = 0
        cards.forEach((card) => {
          const visible = (!terms || card.dataset.search?.includes(terms)) && (!selectedCategory || card.dataset.tags?.split(' ').includes(selectedCategory))
          card.hidden = !visible
          if (visible) matches += 1
        })
        if (status) status.textContent = `${matches} component${matches === 1 ? '' : 's'} shown.`
      }

      function componentIdFromPagefindUrl(url: string) {
        const pathname = new URL(url, window.location.href).pathname
        const componentPath = pathname.split('/components/')[1]
        return componentPath
          ? decodeURIComponent(componentPath).replace(/\/index\.html$/, '').replace(/\/$/, '')
          : undefined
      }

      async function searchPagefind() {
        const terms = query?.value.trim()
        if (!terms || !status) return
        const generation = ++pagefindSearchGeneration
        try {
          pagefind ??= import(/* @vite-ignore */ new URL('pagefind/pagefind.js', window.location.href).toString()) as Promise<PagefindModule>
          const engine = await pagefind
          await engine.init()
          const result = await engine.search(terms, category?.value ? { filters: { category: category.value } } : undefined)
          const matchedIds = new Set(
            (await Promise.all(result.results.map((entry) => entry.data())))
              .map((entry) => componentIdFromPagefindUrl(entry.url))
              .filter((id): id is string => Boolean(id)),
          )
          if (generation !== pagefindSearchGeneration) return
          let matches = 0
          cards.forEach((card) => {
            const visible = matchedIds.has(card.dataset.catalogueId ?? '')
            card.hidden = !visible
            if (visible) matches += 1
          })
          status.textContent = `${matches} component${matches === 1 ? '' : 's'} shown. ${result.results.length} indexed page${result.results.length === 1 ? '' : 's'} found.`
        } catch {
          // The local filter remains fully usable when the static Pagefind bundle is absent.
        }
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        syncSearchUrl()
        filterCards()
        void searchPagefind()
      })
      query?.addEventListener('input', () => {
        syncSearchUrl()
        filterCards()
      })
      category?.addEventListener('change', () => {
        syncSearchUrl()
        filterCards()
      })
      window.addEventListener('popstate', () => {
        restoreSearchUrl()
        filterCards()
        void searchPagefind()
      })
      restoreSearchUrl()
      filterCards()
      if (query?.value.trim()) void searchPagefind()
    </script>
    <BrandSwitch />
  </body>
</html>

<style is:global>
  :where(.catalogue-page) {
    --kiw--catalogue-ink: var(--base);
    --kiw--catalogue-canvas: var(--white);
    --kiw--catalogue-surface: var(--neutral-light);
    --kiw--catalogue-dark-canvas: var(--primary-ultra-dark);
    --kiw--catalogue-dark-line: var(--primary-dark);
    --kiw--catalogue-dark-muted: var(--primary-ultra-light);
    --kiw--catalogue-muted: var(--primary-semi-light);
    --kiw--catalogue-line: var(--neutral-semi-dark);
    --kiw--catalogue-action: var(--primary);
    --kiw--catalogue-focus: var(--accent);
    --kiw--catalogue-thumbnail: var(--neutral-ultra-light);
    --kiw--catalogue-text-font: var(--text-font-family);
    --kiw--catalogue-text-weight: var(--text-font-weight);
    --kiw--catalogue-text-tracking: var(--text-letter-spacing);
    --kiw--catalogue-heading-font: var(--heading-font-family);
    --kiw--catalogue-heading-weight: var(--heading-font-weight);
    --kiw--catalogue-heading-tracking: var(--heading-letter-spacing);
    --kiw--catalogue-mono-font: var(--mono-font-family);
    --kiw--catalogue-text-line-height: var(--text-line-height);
    --kiw--catalogue-heading-line-height: var(--heading-line-height);
    --kiw--catalogue-text-xs: var(--text-xs);
    --kiw--catalogue-text-s: var(--text-s);
    --kiw--catalogue-text-l: var(--text-l);
    --kiw--catalogue-h1: var(--h1);
    --kiw--catalogue-h2: var(--h2);
    --kiw--catalogue-h3: var(--h3);
    --kiw--catalogue-content-width: var(--content-width);
    --kiw--catalogue-width-s: var(--width-s);
    --kiw--catalogue-width-m: var(--width-m);
    --kiw--catalogue-width-l: var(--width-l);
    --kiw--catalogue-gutter: var(--section-gutter);
    --kiw--catalogue-space-xxxs: var(--space-xxxs);
    --kiw--catalogue-space-xs: var(--space-xs);
    --kiw--catalogue-space-s: var(--space-s);
    --kiw--catalogue-space-m: var(--space-m);
    --kiw--catalogue-space-l: var(--space-l);
    --kiw--catalogue-space-xl: var(--space-xl);
    --kiw--catalogue-section-space-xs: var(--section-space-xs);
    --kiw--catalogue-section-space-xl: var(--section-space-xl);
    --kiw--catalogue-section-space-xxl: var(--section-space-xxl);
    --kiw--catalogue-border-width: var(--border-width);
    --kiw--catalogue-radius-s: var(--radius-s);
    --kiw--catalogue-search-button-radius: var(--buttons-radius);
    --kiw--catalogue-search-button-radius-switch: var(--buttons-has-radius);
    --kiw--catalogue-radius-m: var(--radius-m);
  }

  .catalogue-page { margin: 0; color: var(--kiw--catalogue-ink); background: var(--kiw--catalogue-canvas); font-family: var(--kiw--catalogue-text-font); font-weight: var(--kiw--catalogue-text-weight); letter-spacing: var(--kiw--catalogue-text-tracking); }
  .catalogue-page body { margin: 0; }
  .catalogue-page code { font-family: var(--kiw--catalogue-mono-font); font-size: 0.875em; }
  .catalogue-page .masthead { border-bottom: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-dark-line); color: var(--kiw--catalogue-canvas); background: var(--kiw--catalogue-dark-canvas); }
  .catalogue-page :is(.masthead__inner, .catalogue__inner) { width: min(calc(100% - (var(--kiw--catalogue-gutter) * 2)), var(--kiw--catalogue-content-width)); margin-inline: auto; }
  .catalogue-page .masthead__inner { padding-block: var(--kiw--catalogue-section-space-xxl); }
  .catalogue-page :is(.masthead__label, .catalogue__label, .component__category) { margin: 0; color: var(--kiw--catalogue-dark-muted); font-family: var(--kiw--catalogue-mono-font); font-size: var(--kiw--catalogue-text-xs); font-weight: var(--kiw--catalogue-heading-weight); letter-spacing: var(--kiw--catalogue-heading-tracking); line-height: var(--kiw--catalogue-text-line-height); text-transform: uppercase; }
  .catalogue-page :is(h1, h2, h3, h4, p) { margin-top: 0; }
  .catalogue-page h1 { max-width: var(--kiw--catalogue-width-l); margin-bottom: var(--kiw--catalogue-space-m); font-family: var(--kiw--catalogue-heading-font); font-size: var(--kiw--catalogue-h1); font-weight: var(--kiw--catalogue-heading-weight); letter-spacing: var(--kiw--catalogue-heading-tracking); line-height: var(--kiw--catalogue-heading-line-height); text-wrap: balance; }
  .catalogue-page .masthead__intro { max-width: var(--kiw--catalogue-width-m); margin-bottom: var(--kiw--catalogue-section-space-xs); color: var(--kiw--catalogue-dark-muted); font-size: var(--kiw--catalogue-text-l); line-height: var(--kiw--catalogue-text-line-height); }
  .catalogue-page .masthead a { color: inherit; font-weight: var(--kiw--catalogue-heading-weight); text-underline-offset: 0.18em; }
  .catalogue-page .stats { display: flex; flex-wrap: wrap; gap: var(--kiw--catalogue-border-width); margin: 0; background: var(--kiw--catalogue-dark-line); }
  .catalogue-page .stats div { min-width: var(--kiw--catalogue-width-s); padding: var(--kiw--catalogue-space-m) var(--kiw--catalogue-space-l); background: var(--kiw--catalogue-dark-canvas); }
  .catalogue-page :is(.stats dt, .component__meta dt) { color: var(--kiw--catalogue-dark-muted); font-size: var(--kiw--catalogue-text-s); }
  .catalogue-page :is(.stats dd, .component__meta dd) { margin: var(--kiw--catalogue-space-xxxs) 0 0; font-size: var(--kiw--catalogue-text-l); font-weight: var(--kiw--catalogue-heading-weight); }
  .catalogue-page .catalogue { min-height: 50vh; background: var(--kiw--catalogue-surface); }
  .catalogue-page .catalogue__inner { padding-block: var(--kiw--catalogue-section-space-xl); }
  .catalogue-page .catalogue__heading { display: flex; align-items: end; justify-content: space-between; gap: var(--kiw--catalogue-space-xl); margin-bottom: var(--kiw--catalogue-space-xl); }
  .catalogue-page .catalogue__heading a { color: inherit; font-weight: var(--kiw--catalogue-heading-weight); }
  .catalogue-page .catalogue h2 { margin: var(--kiw--catalogue-space-xxxs) 0 0; font-family: var(--kiw--catalogue-heading-font); font-size: var(--kiw--catalogue-h2); font-weight: var(--kiw--catalogue-heading-weight); letter-spacing: var(--kiw--catalogue-heading-tracking); line-height: var(--kiw--catalogue-heading-line-height); text-wrap: balance; }
  .catalogue-page .catalogue-search { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.35fr) auto; gap: var(--kiw--catalogue-space-s); margin-bottom: var(--kiw--catalogue-space-xxxs); padding: var(--kiw--catalogue-space-m) 0 var(--kiw--catalogue-space-xl); border-bottom: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-line); }
  .catalogue-page .catalogue-search label { display: grid; gap: var(--kiw--catalogue-space-xxxs); font-size: var(--kiw--catalogue-text-s); font-weight: var(--kiw--catalogue-heading-weight); }
  .catalogue-page .catalogue-search :is(input, select, button) { min-height: 3rem; box-sizing: border-box; border: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-muted); font: inherit; }
  .catalogue-page .catalogue-search :is(input, select) { width: 100%; padding: var(--kiw--catalogue-space-s); border-radius: var(--kiw--catalogue-radius-s); color: var(--kiw--catalogue-ink); background: var(--kiw--catalogue-canvas); }
  .catalogue-page .catalogue-search button { align-self: end; padding: var(--kiw--catalogue-space-s) var(--kiw--catalogue-space-m); border-color: var(--kiw--catalogue-action); border-radius: calc(var(--kiw--catalogue-search-button-radius-switch) * var(--kiw--catalogue-search-button-radius)); color: var(--kiw--catalogue-canvas); background: var(--kiw--catalogue-action); font-weight: var(--kiw--catalogue-heading-weight); cursor: pointer; }
  .catalogue-page .catalogue-search__status { min-height: var(--kiw--catalogue-space-l); margin: 0 0 var(--kiw--catalogue-space-l); color: var(--kiw--catalogue-muted); font-size: var(--kiw--catalogue-text-s); }
  .catalogue-page .components { display: grid; gap: var(--kiw--catalogue-space-l); margin: 0; padding: 0; list-style: none; }
  .catalogue-page .component { display: grid; gap: var(--kiw--catalogue-space-l); padding: var(--kiw--catalogue-space-l); border: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-line); border-radius: var(--kiw--catalogue-radius-m); background: var(--kiw--catalogue-canvas); }
  .catalogue-page .component[hidden] { display: none; }
  .catalogue-page .component--preview { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; padding: 0; overflow: hidden; }
  .catalogue-page .component__summary { display: flex; align-items: center; justify-content: space-between; gap: var(--kiw--catalogue-space-m); padding: var(--kiw--catalogue-space-l); }
  .catalogue-page .component__category { margin: 0; color: var(--kiw--catalogue-muted); font-family: var(--kiw--catalogue-mono-font); font-size: var(--kiw--catalogue-text-xs); font-weight: var(--kiw--catalogue-heading-weight); letter-spacing: var(--kiw--catalogue-heading-tracking); text-transform: uppercase; }
  .catalogue-page .component__title { margin: var(--kiw--catalogue-space-xxxs) 0 0; font-family: var(--kiw--catalogue-heading-font); font-size: var(--kiw--catalogue-h3); font-weight: var(--kiw--catalogue-heading-weight); letter-spacing: var(--kiw--catalogue-heading-tracking); line-height: var(--kiw--catalogue-heading-line-height); }
  .catalogue-page .component__controls { display: flex; align-items: center; justify-content: end; flex-wrap: wrap; gap: var(--kiw--catalogue-space-s); }
  .catalogue-page .theme-switch { display: flex; padding: var(--kiw--catalogue-space-xxxs); border: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-line); border-radius: var(--kiw--catalogue-radius-s); }
  .catalogue-page .theme-switch button, .catalogue-page .component__info, .catalogue-page .component__dialog-close { min-height: 2rem; border: 0; color: var(--kiw--catalogue-ink); background: transparent; font: inherit; font-weight: var(--kiw--catalogue-heading-weight); cursor: pointer; }
  .catalogue-page .theme-switch button { padding-inline: var(--kiw--catalogue-space-xs); font-size: var(--kiw--catalogue-text-xs); }
  .catalogue-page .theme-switch button[aria-pressed='true'] { color: var(--kiw--catalogue-canvas); background: var(--kiw--catalogue-action); }
  .catalogue-page .component__info { width: 2rem; border: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-line); border-radius: 50%; font-family: var(--kiw--catalogue-heading-font); }
  .catalogue-page .component__action { display: flex; justify-content: space-between; gap: var(--kiw--catalogue-space-m); color: var(--kiw--catalogue-action); font-weight: var(--kiw--catalogue-heading-weight); text-decoration-thickness: var(--kiw--catalogue-border-width); text-underline-offset: 0.18em; }
  .catalogue-page .component__thumbnail { position: relative; min-height: 32rem; overflow: hidden; background: var(--kiw--catalogue-thumbnail); }
  .catalogue-page .component__thumbnail iframe { position: absolute; inset: 0; width: 200%; height: 200%; border: 0; pointer-events: none; transform: scale(0.5); transform-origin: top left; }
  .catalogue-page .component__dialog { width: min(100% - (var(--kiw--catalogue-gutter) * 2), var(--kiw--catalogue-width-l)); padding: 0; border: var(--kiw--catalogue-border-width) solid var(--kiw--catalogue-line); border-radius: var(--kiw--catalogue-radius-m); color: var(--kiw--catalogue-ink); background: var(--kiw--catalogue-canvas); }
  .catalogue-page .component__dialog::backdrop { background: rgb(0 0 0 / 0.5); }
  .catalogue-page .component__dialog-content { display: grid; grid-template-columns: 1fr auto; gap: var(--kiw--catalogue-space-l); padding: var(--kiw--catalogue-space-xl); }
  .catalogue-page .component__dialog-content > :is(p, .component__meta, .component__tags, .component__imports, .component__action) { grid-column: 1 / -1; margin: 0; }
  .catalogue-page .component__dialog-close { width: 2rem; font-size: var(--kiw--catalogue-text-l); }
