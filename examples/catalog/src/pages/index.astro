---
import components from '../generated/components.json'

const repositoryUrl = 'https://github.com/kinekt-io/kinekt-sections'
const tags = [...new Set(['alpha', 'beta', 'prerelease', 'release', ...components.flatMap((component) => component.tags)])].sort()
const catalogueBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const roles = new Set(components.map((component) => component.role).filter(Boolean))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Private Kinekt component package catalogue." />
    <title>Kinekt components</title>
  </head>
  <body>
    <main>
      <header class="masthead">
        <div class="masthead__inner">
          <p class="masthead__label">Wireframe system</p>
          <h1>Kinekt sections</h1>
          <p class="masthead__intro">Inspect reusable Astro and Payload contracts in a neutral, site-overridable wireframe.</p>
          <dl class="stats" aria-label="Catalogue summary">
            <div><dt>Components</dt><dd>{components.length}</dd></div>
            <div><dt>Roles</dt><dd>{roles.size}</dd></div>
            <div><dt>Package</dt><dd><code>@kinekt-io/components</code></dd></div>
          </dl>
          <p><a href="sections/">View all rendered sections <span aria-hidden="true">→</span></a></p>
        </div>
      </header>

      <section class="catalogue" aria-labelledby="catalogue-title">
        <div class="catalogue__inner">
          <div class="catalogue__heading">
            <div>
              <p class="catalogue__label">Component inventory</p>
              <h2 id="catalogue-title">Browse the system</h2>
            </div>
            <a href={repositoryUrl}>View source on GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <form class="catalogue-search" role="search" data-catalogue-search>
            <label>Search components <input type="search" name="query" autocomplete="off" data-catalogue-search-query /></label>
            <label>Tag <select name="category" data-catalogue-category><option value="">All tags</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></label>
            <button type="submit">Search</button>
          </form>
          <p class="catalogue-search__status" data-catalogue-search-status aria-live="polite"></p>

          <ul class="components">
            {components.map((component) => (
              <li class:list={['component', { 'component--preview': Boolean(component.previewSource) }]} data-catalogue-component data-catalogue-id={component.id} data-tags={component.tags.join(' ')} data-search={[component.title, component.description, component.category, component.role, component.variation, component.id, ...component.tags].filter(Boolean).join(' ').toLowerCase()}>
                <div class="component__details">
                  <div class="component__header">
                    <p class="component__category">{component.category} / {component.role ?? 'component'}</p>
                    <h3>{component.title}</h3>
                    <p>{component.description}</p>
                  </div>
                  <dl class="component__meta">
                    <div><dt>Variation</dt><dd>{component.variation ?? '—'}</dd></div>
                    <div><dt>Folder</dt><dd><code>src/{component.id}</code></dd></div>
                  </dl>
                  {component.tags.length > 0 && (
                    <ul class="component__tags" aria-label="Categories">
                      {component.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                  <div class="component__imports">
                    <h4>Public imports</h4>
                    <ul>
                      {Object.entries(component.entries).map(([kind, entrypoint]) => (
                        <li><span>{kind}</span><code>{entrypoint}</code></li>
                      ))}
                    </ul>
                  </div>
                  {(component.figmaUrl || component.previewSource) && (
                    <div class="component__actions">
                      {component.figmaUrl && (
                        <a class="component__action" href={component.figmaUrl} target="_blank" rel="noreferrer">
                          Open design frame <span aria-hidden="true">↗</span>
                        </a>
                      )}
                      {component.previewSource && (
                        <a class="component__action" href={`${catalogueBase}components/${component.id}/`}>
                          Open wireframe preview <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
                {component.previewSource && (
                  <div class="component__thumbnail">
                    <iframe
                      title={`Scaled preview of ${component.title}`}
                      src={`${catalogueBase}components/embed/${component.id}/`}
                      loading="lazy"
                      tabindex="-1"
                    ></iframe>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
    <script>
      type PagefindData = { url: string; meta?: Record<string, string> }
      type PagefindResult = { data: () => Promise<PagefindData> }
      type PagefindModule = { init: () => Promise<void> | void; search: (query: string, options?: { filters?: { category: string } }) => Promise<{ results: PagefindResult[] }> }

      const form = document.querySelector<HTMLFormElement>('[data-catalogue-search]')
      const query = document.querySelector<HTMLInputElement>('[data-catalogue-search-query]')
      const category = document.querySelector<HTMLSelectElement>('[data-catalogue-category]')
      const status = document.querySelector<HTMLElement>('[data-catalogue-search-status]')
      const cards = [...document.querySelectorAll<HTMLElement>('[data-catalogue-component]')]
      let pagefind: Promise<PagefindModule> | undefined
      let pagefindSearchGeneration = 0

      function syncSearchUrl() {
        const url = new URL(window.location.href)
        const terms = query?.value.trim() ?? ''
        const selectedCategory = category?.value ?? ''
        if (terms) url.searchParams.set('q', terms)
        else url.searchParams.delete('q')
        if (selectedCategory) url.searchParams.set('category', selectedCategory)
        else url.searchParams.delete('category')
        window.history.replaceState(null, '', url)
      }

      function restoreSearchUrl() {
        const parameters = new URLSearchParams(window.location.search)
        if (query) query.value = parameters.get('q') ?? ''
        if (category) category.value = parameters.get('category') ?? ''
      }


      function filterCards() {
        pagefindSearchGeneration += 1
        const terms = query?.value.trim().toLowerCase() ?? ''
        const selectedCategory = category?.value ?? ''
        let matches = 0
        cards.forEach((card) => {
          const visible = (!terms || card.dataset.search?.includes(terms)) && (!selectedCategory || card.dataset.tags?.split(' ').includes(selectedCategory))
          card.hidden = !visible
          if (visible) matches += 1
        })
        if (status) status.textContent = `${matches} component${matches === 1 ? '' : 's'} shown.`
      }

      function componentIdFromPagefindUrl(url: string) {
        const pathname = new URL(url, window.location.href).pathname
        const componentPath = pathname.split('/components/')[1]
        return componentPath
          ? decodeURIComponent(componentPath).replace(/\/index\.html$/, '').replace(/\/$/, '')
          : undefined
      }

      async function searchPagefind() {
        const terms = query?.value.trim()
        if (!terms || !status) return
        const generation = ++pagefindSearchGeneration
        try {
          pagefind ??= import(/* @vite-ignore */ new URL('pagefind/pagefind.js', window.location.href).toString()) as Promise<PagefindModule>
          const engine = await pagefind
          await engine.init()
          const result = await engine.search(terms, category?.value ? { filters: { category: category.value } } : undefined)
          const matchedIds = new Set(
            (await Promise.all(result.results.map((entry) => entry.data())))
              .map((entry) => componentIdFromPagefindUrl(entry.url))
              .filter((id): id is string => Boolean(id)),
          )
          if (generation !== pagefindSearchGeneration) return
          let matches = 0
          cards.forEach((card) => {
            const visible = matchedIds.has(card.dataset.catalogueId ?? '')
            card.hidden = !visible
            if (visible) matches += 1
          })
          status.textContent = `${matches} component${matches === 1 ? '' : 's'} shown. ${result.results.length} indexed page${result.results.length === 1 ? '' : 's'} found.`
        } catch {
          // The local filter remains fully usable when the static Pagefind bundle is absent.
        }
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        syncSearchUrl()
        filterCards()
        void searchPagefind()
      })
      query?.addEventListener('input', () => {
        syncSearchUrl()
        filterCards()
      })
      category?.addEventListener('change', () => {
        syncSearchUrl()
        filterCards()
      })
      window.addEventListener('popstate', () => {
        restoreSearchUrl()
        filterCards()
        void searchPagefind()
      })
      restoreSearchUrl()
      filterCards()
      if (query?.value.trim()) void searchPagefind()
    </script>
  </body>
</html>

<style>
  :root { color: #111; background: #fff; font-family: system-ui, sans-serif; }
  body { margin: 0; }
  code { font-family: ui-monospace, monospace; font-size: 0.875em; }
  .masthead { border-bottom: 1px solid #4f4f4f; color: #fff; background: #111; }
  .masthead__inner, .catalogue__inner { width: min(calc(100% - 2.5rem), 90rem); margin-inline: auto; }
  .masthead__inner { padding-block: clamp(4.5rem, 12vw, 9rem); }
  .masthead__label, .catalogue__label, .component__category { margin: 0; color: #9e9e9e; font: 700 0.75rem/1.2 ui-monospace, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  h1, h2, h3, h4, p { margin-top: 0; }
  h1 { max-width: 48rem; margin-bottom: 1.25rem; font-size: clamp(3rem, 8vw, 6.5rem); font-weight: 400; line-height: 0.9; letter-spacing: -0.065em; text-wrap: balance; }
  .masthead__intro { max-width: 38rem; margin-bottom: 2.5rem; color: #d2d2d2; font-size: clamp(1.125rem, 2vw, 1.375rem); line-height: 1.5; }
  .masthead a { color: inherit; font-weight: 700; text-underline-offset: 0.18em; }
  .stats { display: flex; flex-wrap: wrap; gap: 1px; margin: 0; background: #4f4f4f; }
  .stats div { min-width: 9rem; padding: 1rem 1.25rem; background: #111; }
  .stats dt, .component__meta dt { color: #9e9e9e; font-size: 0.8125rem; }
  .stats dd, .component__meta dd { margin: 0.25rem 0 0; font-size: 1.125rem; font-weight: 600; }
  .catalogue { min-height: 50vh; background: #f1f1f1; }
  .catalogue__inner { padding-block: clamp(3.5rem, 8vw, 7rem); }
  .catalogue__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .catalogue__heading a { color: inherit; font-weight: 600; }
  .catalogue h2 { margin: 0.5rem 0 0; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 400; letter-spacing: -0.05em; text-wrap: balance; }
  .catalogue-search { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.35fr) auto; gap: 0.75rem; margin-bottom: 0.5rem; padding: 1rem 0 2rem; border-bottom: 1px solid #bdbdbd; }
  .catalogue-search label { display: grid; gap: 0.4rem; font-size: 0.8125rem; font-weight: 700; }
  .catalogue-search :is(input, select, button) { min-height: 3rem; box-sizing: border-box; border: 1px solid #777; border-radius: 0; font: inherit; }
  .catalogue-search :is(input, select) { width: 100%; padding: 0.75rem; color: #111; background: #fff; }
  .catalogue-search button { align-self: end; padding: 0.75rem 1.15rem; color: #fff; background: #111; font-weight: 700; cursor: pointer; }
  .catalogue-search__status { min-height: 1.5rem; margin: 0 0 1.5rem; color: #5e5e5e; font-size: 0.875rem; }
  .components { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .component { display: grid; gap: 1.75rem; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid #bdbdbd; background: #fff; }
  .component[hidden] { display: none; }
  .component--preview { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; padding: 0; overflow: hidden; }
  .component__details { display: grid; align-content: start; gap: 1.75rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .component__header p:not(.component__category) { margin: 1rem 0 0; color: #5e5e5e; line-height: 1.5; }
  .component h3 { margin: 0.5rem 0 0; font-size: 1.75rem; font-weight: 400; letter-spacing: -0.045em; text-wrap: balance; }
  .component__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0; padding-block: 1rem; border-block: 1px solid #bdbdbd; }
  .component__meta dd { overflow-wrap: anywhere; font-size: 0.9rem; }
  .component__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: -0.75rem 0 0; padding: 0; list-style: none; }
  .component__tags li { padding: 0.3rem 0.5rem; border: 1px solid #bdbdbd; color: #4f4f4f; font: 700 0.6875rem/1 ui-monospace, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .component__imports h4 { margin-bottom: 0.75rem; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .component__imports ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .component__imports li { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr); gap: 0.75rem; align-items: baseline; }
  .component__imports span { color: #5e5e5e; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; }
  .component__imports code { overflow-wrap: anywhere; font-size: 0.75rem; }
  .component__actions { display: grid; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid #bdbdbd; }
  .component__action { display: flex; justify-content: space-between; gap: 1rem; color: #111; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .component__thumbnail { position: relative; min-height: 32rem; overflow: hidden; background: #e1e1e1; }
  .component__thumbnail iframe { position: absolute; inset: 0; width: 200%; height: 200%; border: 0; pointer-events: none; transform: scale(0.5); transform-origin: top left; }
  :is(a, button, input, select):focus-visible { outline: 3px solid #111; outline-offset: 3px; }
  @media (max-width: 52rem) { .component--preview { grid-template-columns: 1fr; } .component__thumbnail { min-height: 24rem; } }
  @media (max-width: 40rem) { .catalogue__heading { align-items: start; flex-direction: column; } .catalogue-search { grid-template-columns: 1fr; } .component__meta { grid-template-columns: 1fr; } }
</style>
